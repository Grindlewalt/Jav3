class DeskError(Exception):
    """A message for the user (CLI) or the server (a refused request)."""


# --- config files -------------------------------------------------------------------

def config_dir() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "jav3"


def _path(name: str) -> Path:
    return config_dir() / name


def _ensure_dir() -> int:
    """The config dir as an fd, created 0700; a symlink or foreign dir is
    refused (same rules as the jav3 CLI's credential store)."""
    d = config_dir()
    d.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.mkdir(d, 0o700)
    except FileExistsError:
        pass
    try:
        dfd = os.open(d, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
                      | getattr(os, "O_NOFOLLOW", 0))
    except OSError as e:
        raise DeskError(f"{d} is not a plain directory ({e.strerror})")
    st = os.fstat(dfd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        os.close(dfd)
        raise DeskError(f"{d} is not a directory you own")
    os.fchmod(dfd, 0o700)
    return dfd


def _write_private(name: str, data: bytes) -> Path:
    """Atomic 0600 write inside the config dir (O_EXCL temp + rename)."""
    dfd = _ensure_dir()
    tmp = f".{name}.{secrets.token_hex(8)}.tmp"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                     | getattr(os, "O_NOFOLLOW", 0), 0o600, dir_fd=dfd)
        try:
            while data:
                data = data[os.write(fd, data):]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dfd)
        except OSError:
            pass
        raise
    finally:
        os.close(dfd)
    return _path(name)


def load_credentials() -> dict | None:
    try:
        data = json.loads(_path("desk.json").read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict) or not data.get("token") or not data.get("address"):
        return None
    return data


def shell_allowed() -> bool:
    return _path("desk-shell").is_file()


def paused() -> bool:
    return _path("desk.paused").exists()


def ceiling() -> dict:
    """What this computer allows, whatever the server says. Screen and input
    follow the server's grants; shell needs the local flag too."""
    return {"screen": True, "input": True, "shell": shell_allowed()}


# --- login -----------------------------------------------------------------------------

def parse_login_line(line: str) -> tuple[str, str]:
    fields: dict[str, str] = {}
    for part in (line or "").strip().strip("'\"`").split():
        k, sep, v = part.partition("=")
        if sep and k in ("address", "code") and v:
            fields[k] = v.strip("'\"`")
    if "address" not in fields or "code" not in fields:
        raise DeskError("that doesn't look like the login line — expected "
                        "'address=<host:port> code=<code>' from Settings → Add computer")
    return fields["address"], fields["code"]


def base_url(address: str) -> str:
    a = address.strip().rstrip("/")
    if not a:
        raise DeskError("empty server address")
    if "://" in a:
        if not a.startswith(("http://", "https://")):
            raise DeskError(f"unsupported scheme in {address!r}")
        return a
    return "http://" + a


def ws_url(address: str) -> str:
    b = base_url(address)
    return ("wss://" + b[8:] if b.startswith("https://") else "ws://" + b[7:]) + "/api/desk/ws"


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):     # a bearer token never follows a 3xx
        return None


def _http(method: str, url: str, body: dict | None = None, token: str | None = None):
    req = urllib.request.Request(url, method=method,
                                 data=json.dumps(body).encode() if body is not None else None)
    req.add_header("User-Agent", USER_AGENT)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    opener = urllib.request.build_opener(_NoRedirect)
    try:
        with opener.open(req, timeout=20) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read() or b"{}")
        except ValueError:
            return e.code, {}
    except (urllib.error.URLError, OSError) as e:
        raise DeskError(f"could not reach {url}: {e}")


def cmd_login(args, read=None) -> int:
    read = read or (lambda: getpass.getpass(PROMPT) if sys.stdin.isatty()
                    else sys.stdin.readline())
    address, code = parse_login_line(read())
    base = base_url(args.server or address)
    if base.startswith("http://"):
        print(f"warning: {base} is plain http — the code and the token cross the "
              "network unencrypted. Only use it on a network you trust.", file=sys.stderr)
    host = socket.gethostname()
    status, body = _http("POST", base + "/api/devices/login",
                         {"code": code, "name": host, "hostname": host,
                          "platform": platform.system().lower(), "scope": "desk"})
    if status != 200 or not body.get("token"):
        raise DeskError(body.get("detail") or f"login failed ({status})")
    try:
        p = _write_private("desk.json", json.dumps(
            {"address": args.server or address, "token": body["token"]}).encode())
    except (OSError, DeskError) as e:
        _http("DELETE", base + "/api/devices/self", token=body["token"])
        raise DeskError(f"could not save credentials: {e}. The new token was revoked.")
    print(f"logged in to {base} as computer '{body.get('name')}' — {p}")
    print("next: turn on Screen / Input for it in Settings → Computer use, then "
          "`jav3-desk run` (or `jav3-desk install`).")
    return 0


# --- geometry ------------------------------------------------------------------------------

@dataclass
class Monitor:
    name: str
    x: int            # in the INPUT coordinate space of the backend
    y: int
    w: int
    h: int
    scale: float = 1.0


@dataclass
class Frame:
    """The last screenshot: which screen rect it shows and how big the image
    is. The model's coordinates are pixels of that image. `rect` is a zoom
    (desk_screenshot region=): a rect in the monitor's input units relative to
    its origin; None = the whole monitor. `region` is the zoom as the server
    asked for it, in pixels of the last FULL-frame image, echoed back."""
    monitor: Monitor
    iw: int
    ih: int
    rect: tuple[int, int, int, int] | None = None
    region: dict | None = None
    index: int = 0            # of `count` monitors, 0-based here, 1-based on the wire
    count: int = 1

    def screen_rect(self) -> tuple[int, int, int, int]:
        """(x, y, w, h) this image shows, in the backend's global input space."""
        m = self.monitor
        if self.rect is None:
            return m.x, m.y, m.w, m.h
        rx, ry, rw, rh = self.rect
        return m.x + rx, m.y + ry, rw, rh

    def to_screen(self, px: int, py: int) -> tuple[int, int]:
        sx, sy, sw, sh = self.screen_rect()
        x = sx + round(px * sw / self.iw)
        y = sy + round(py * sh / self.ih)
        return (min(max(x, sx), sx + sw - 1), min(max(y, sy), sy + sh - 1))

    def from_screen(self, gx: float, gy: float) -> tuple[float, float]:
        """A global screen point as (unclipped) pixels of this image."""
        sx, sy, sw, sh = self.screen_rect()
        return (gx - sx) * self.iw / sw, (gy - sy) * self.ih / sh

    def box_to_image(self, x: float, y: float, w: float, h: float
                     ) -> tuple[int, int, int, int] | None:
        """A global screen box as an image-pixel box clipped to the image;
        None when nothing of it is inside (the element is dropped)."""
        x0, y0 = self.from_screen(x, y)
        x1, y1 = self.from_screen(x + w, y + h)
        x0, y0 = max(0, round(x0)), max(0, round(y0))
        x1, y1 = min(self.iw, round(x1)), min(self.ih, round(y1))
        if x1 - x0 < 1 or y1 - y0 < 1:
            return None
        return x0, y0, x1 - x0, y1 - y0

    def wire(self) -> dict:
        return {"monitor": self.monitor.name, "index": self.index + 1, "count": self.count,
                "region": self.region, "screen": {"w": self.monitor.w, "h": self.monitor.h}}


def region_rect(full: Frame, region: dict) -> tuple[tuple[int, int, int, int], dict]:
    """A zoom request in pixels of the last full-frame image of a monitor ->
    (the screen rect relative to the monitor origin, the region actually
    shown). The region is clipped to that image rather than refused, and the
    clipped one is what gets echoed, so the echo says what the picture shows."""
    x0, y0 = max(0, region["x"]), max(0, region["y"])
    x1 = min(full.iw, region["x"] + region["w"])
    y1 = min(full.ih, region["y"] + region["h"])
    if x1 - x0 < 4 or y1 - y0 < 4:
        raise DeskError(f"region is outside the {full.iw}x{full.ih} screenshot "
                        "(or under 4 px)")
    m = full.monitor
    kx, ky = m.w / full.iw, m.h / full.ih
    rx, ry = int(x0 * kx), int(y0 * ky)
    rw = max(1, min(m.w - rx, round((x1 - x0) * kx)))
    rh = max(1, min(m.h - ry, round((y1 - y0) * ky)))
    return (rx, ry, rw, rh), {"x": x0, "y": y0, "w": x1 - x0, "h": y1 - y0}


def zoom_size(rw: int, rh: int, native: float = 1.0) -> tuple[int, int]:
    """Image size for a zoomed rect of rw x rh input units: the long edge
    goes to LONG_EDGE, but never more than ZOOM_MAX times the rect's native
    pixels (`native` = device pixels per input unit) — past that the model
    sees interpolation, not detail."""
    f = min(LONG_EDGE / max(rw, rh, 1), ZOOM_MAX * native)
    return max(1, round(rw * f)), max(1, round(rh * f))


def fit(w: int, h: int, long_edge: int = LONG_EDGE) -> float:
    """The downscale factor that brings the long edge to `long_edge` (≤ 1)."""
    return min(1.0, long_edge / max(w, h, 1))


def image_size(data: bytes) -> tuple[int, int] | None:
    """(w, h) of a PNG or JPEG from its header; None for anything else."""
    if data[:8] == b"\x89PNG\r\n\x1a\n" and len(data) >= 24:
        return struct.unpack(">II", data[16:24])
    if data[:3] == b"\xff\xd8\xff":
        i = 2
        while i + 9 < len(data):
            if data[i] != 0xFF:
                i += 1
                continue
            marker = data[i + 1]
            if marker in (0xD8, 0x01) or 0xD0 <= marker <= 0xD7:
                i += 2
                continue
            seg = struct.unpack(">H", data[i + 2:i + 4])[0]
            if marker in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9,
                          0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
                h, w = struct.unpack(">HH", data[i + 5:i + 9])
                return w, h
            i += 2 + seg
    return None


# --- settle: tiny thumbnails ---------------------------------------------------------------

def decode_thumb(data: bytes) -> tuple[int, int, bytes] | None:
    """(w, h, grey bytes) of a binary PNM (P5/P6: grim -t ppm, ImageMagick
    pgm:-) or an uncompressed 24/32-bit BMP (sips); None for anything else
    (JPEG/PNG would need a decoder, and this client has no dependencies —
    those are compared byte-for-byte instead)."""
    try:
        if data[:2] in (b"P5", b"P6"):
            fields, i = [], 2
            while len(fields) < 3:
                while data[i:i + 1].isspace():
                    i += 1
                if data[i:i + 1] == b"#":
                    i = data.index(b"\n", i)
                    continue
                j = i
                while data[j:j + 1] and not data[j:j + 1].isspace():
                    j += 1
                fields.append(int(data[i:j]))
                i = j
            w, h, maxv = fields
            px = data[i + 1:]
            if maxv > 255 or w <= 0 or h <= 0:
                return None
            if data[:2] == b"P5":
                return (w, h, bytes(px[:w * h])) if len(px) >= w * h else None
            if len(px) < w * h * 3:
                return None
            return w, h, bytes((px[k] + px[k + 1] + px[k + 1] + px[k + 2]) >> 2
                               for k in range(0, w * h * 3, 3))
        if data[:2] == b"BM" and len(data) >= 54:
            off = struct.unpack("<I", data[10:14])[0]
            w, h = struct.unpack("<ii", data[18:26])
            bpp, comp = struct.unpack("<HI", data[28:34])
            if bpp not in (24, 32) or comp not in (0, 3) or w <= 0 or not h:
                return None
            step = bpp // 8
            stride = (w * step + 3) & ~3
            rows = range(abs(h)) if h < 0 else range(h - 1, -1, -1)    # top-down
            out = bytearray()
            for r in rows:
                row = data[off + r * stride:off + r * stride + w * step]
                if len(row) < w * step:
                    return None
                out += bytes((row[k] + row[k + 1] + row[k + 1] + row[k + 2]) >> 2
                             for k in range(0, w * step, step))
            return w, abs(h), bytes(out)
    except (ValueError, IndexError, struct.error):
        return None
    return None


def thumbs_match(a: bytes | None, b: bytes | None) -> bool:
    """Same screen, for settle's purposes. Decodable thumbnails (raw pixels)
    match when at most 1 in 400 pixels differ by more than 24 grey levels, so
    a blinking caret does not keep the screen "changing"; anything else is
    byte-equal (a JPEG of the same pixels is the same bytes, but a caret blink
    reads as a change — the SETTLE_MAX_S ceiling bounds that)."""
    if a is None or b is None:
        return False
    if a == b:
        return True
    da, db = decode_thumb(a), decode_thumb(b)
    if not da or not db or da[:2] != db[:2]:
        return False
    n = len(da[2])
    diff = sum(1 for p, q in zip(da[2], db[2]) if abs(p - q) > 24)
    return diff <= max(1, n // 400)


# --- the element list (accessibility tree -> numbered, image-pixel boxes) ---------------------

# normalized roles the model sees; everything else is walked through, not listed
ROLES = ("button", "link", "textfield", "checkbox", "radio", "menuitem", "tab",
         "slider", "combobox", "listitem", "cell", "toggle")
# roles whose label is required: an empty list row is noise, an empty button
# is an icon-only control and stays (src tells the model it is real)
_NEEDS_LABEL = ("listitem", "cell")

AX_ROLES = {"AXButton": "button", "AXMenuButton": "button", "AXLink": "link",
            "AXTextField": "textfield", "AXTextArea": "textfield",
            "AXCheckBox": "checkbox", "AXRadioButton": "radio",
            "AXMenuItem": "menuitem", "AXMenuBarItem": "menuitem",
            "AXSlider": "slider", "AXIncrementor": "slider",
            "AXComboBox": "combobox", "AXPopUpButton": "combobox",
            "AXRow": "listitem", "AXDisclosureTriangle": "toggle",
            "AXStaticText": "text", "AXImage": "text"}
AX_SUBROLES = {"AXTabButton": "tab", "AXSwitch": "toggle", "AXToggle": "toggle",
               "AXSearchField": "textfield", "AXSecureTextField": "textfield"}
ATSPI_ROLES = {"push button": "button", "button": "button", "toggle button": "toggle",
               "switch": "toggle", "link": "link", "entry": "textfield",
               "password text": "textfield", "editbar": "textfield",
               "check box": "checkbox", "radio button": "radio",
               "menu item": "menuitem", "check menu item": "menuitem",
               "radio menu item": "menuitem", "menu": "menuitem",
               "page tab": "tab", "slider": "slider", "spin button": "slider",
               "combo box": "combobox", "list item": "listitem",
               "table cell": "cell", "label": "text", "static": "text",
               "image": "text", "icon": "text", "text": "text"}


def ax_role(role: str | None, subrole: str | None) -> str:
    return AX_SUBROLES.get(subrole or "") or AX_ROLES.get(role or "", "")


def atspi_role(name: str | None, *, editable: bool = False, selectable: bool = False) -> str:
    """AT-SPI role name -> ours. A `text` is a field only when editable; a
    table cell counts only when selectable (the cheap stand-in for "has an
    action" — asking the Action interface per cell costs a round trip)."""
    r = ATSPI_ROLES.get((name or "").lower(), "")
    if r == "text" and (name or "").lower() == "text" and editable:
        return "textfield"
    if r == "cell" and not selectable:
        return ""
    return r


def _intersects(a: tuple, b: tuple) -> bool:
    return a[0] < b[0] + b[2] and b[0] < a[0] + a[2] and a[1] < b[1] + b[3] \
        and b[1] < a[1] + a[3]


def walk_tree(roots, read, clip: tuple, deadline: float, *,
              max_depth: int = ELEMENTS_DEPTH, cap: int = ELEMENTS_CAP
              ) -> tuple[list[dict], bool]:
    """Depth-first over an accessibility tree, source-agnostic: `read(node)`
    returns {role (already ours, "" = structural, "text" = static text or a
    named image), label, value, focused, enabled, box: (x, y, w, h) global
    or None, children: [...], hidden: bool}. Returns (raw elements in
    global coordinates, partial). A subtree whose box is off `clip` is
    skipped; static text becomes the label of the nearest unlabeled control
    above it (within 3 levels) and is never listed itself. Stops at the
    deadline or the cap with partial=True."""
    out: list[dict] = []
    seen: set = set()
    stack = [(r, 0, None, 0) for r in reversed(list(roots))]
    while stack:
        if time.monotonic() > deadline or len(out) >= cap:
            return out, True
        node, depth, owner, owner_depth = stack.pop()
        try:
            info = read(node)
        except Exception:  # noqa: BLE001 — one dead node must not end the walk
            continue
        if not info or info.get("hidden"):
            continue
        box = info.get("box")
        if box and box[2] > 0 and box[3] > 0 and not _intersects(box, clip):
            continue
        role = info.get("role") or ""
        if role == "text":
            t = (info.get("label") or "").strip()
            if owner is not None and t and not out[owner]["label"] \
                    and depth - owner_depth <= 3:
                out[owner]["label"] = t[:200]
            continue
        if role in ROLES and box and box[2] > 0 and box[3] > 0:
            key = (role, tuple(round(v) for v in box))
            if key not in seen:
                seen.add(key)
                label = (info.get("label") or "").strip()[:200]
                el = {"role": role, "label": label, "box": box}
                v = info.get("value")
                if v not in (None, "") and str(v) != label:
                    el["value"] = str(v)[:200]
                if info.get("focused"):
                    el["focused"] = True
                if info.get("enabled") is False:
                    el["enabled"] = False
                out.append(el)
                if not label:
                    owner, owner_depth = len(out) - 1, depth
        if depth < max_depth:
            for c in reversed(list(info.get("children") or ())):
                stack.append((c, depth + 1, owner, owner_depth))
    return out, False


def build_elements(raw: list[dict], frame: Frame, src: str) -> list[dict]:
    """Global boxes -> image-pixel boxes of THIS image (crop + scale), clipped;
    elements outside dropped; unlabeled rows dropped; ids 1..N in reading
    order (rows of ROW_PX image px, then x)."""
    out = []
    for e in raw:
        if not e["label"] and e["role"] in _NEEDS_LABEL:
            continue
        b = frame.box_to_image(*e["box"])
        if b is None:
            continue
        el = {"role": e["role"], "label": e["label"], "x": b[0], "y": b[1],
              "w": b[2], "h": b[3], "src": src}
        for k in ("value", "focused", "enabled"):
            if k in e:
                el[k] = e[k]
        out.append(el)
    out.sort(key=lambda e: (e["y"] // ROW_PX, e["x"], e["y"]))
    return [{"id": i, **e} for i, e in enumerate(out[:ELEMENTS_CAP], 1)]


class ElementSource:
    """Where the element list comes from. `collect(clip, deadline)` returns
    (raw elements in global input coordinates, partial); `unavailable()`
    is the honest reason there are none, or None."""
    src = "none"

    def __init__(self, note: str = "not supported on this backend"):
        self.note = note

    def unavailable(self) -> str | None:
        return self.note

    def collect(self, clip: tuple, deadline: float) -> tuple[list[dict], bool]:
        return [], False


class FakeElementSource(ElementSource):
    """Tests: a recorded tree of dicts ({role, label, box, children, ...},
    roles already ours) walked by the real walker."""

    def __init__(self, roots: list[dict], src: str = "ax", note: str | None = None):
        super().__init__(note or "")
        self.roots, self.src = roots, src

    def unavailable(self):
        return self.note or None

    def collect(self, clip, deadline):
        return walk_tree(self.roots, lambda n: n, clip, deadline)


def ax_info(v: dict) -> dict:
    """AX attribute values (already Python) -> walk_tree's node info. Split
    out of the ctypes reader so a recorded tree tests it without the API."""
    role = ax_role(v.get("AXRole"), v.get("AXSubrole"))
    val = v.get("AXValue")
    if isinstance(val, float) and val.is_integer():
        val = int(val)
    if role == "text":
        label = (val if isinstance(val, str) else "") or v.get("AXDescription") \
            or v.get("AXTitle") or ""
    else:
        label = (v.get("AXTitle") or v.get("AXDescription")
                 or (val if isinstance(val, str) and role != "textfield" else "")
                 or v.get("AXPlaceholderValue") or v.get("AXHelp") or "")
    pos, size = v.get("AXPosition"), v.get("AXSize")
    return {"role": role, "label": label,
            "value": val if role in ("textfield", "checkbox", "radio", "slider",
                                     "combobox", "toggle") else None,
            "focused": v.get("AXFocused") is True, "enabled": v.get("AXEnabled"),
            "box": (pos[0], pos[1], size[0], size[1]) if pos and size else None,
            "children": v.get("AXChildren") or []}


def atspi_info(role_name: str, name: str, description: str, states: set[str],
               extents: tuple | None, children: list) -> dict:
    """AT-SPI node facts -> walk_tree's node info (testable without a bus).
    `states` are lowercase names: showing, focused, enabled, sensitive,
    editable, selectable, checked."""
    role = atspi_role(role_name, editable="editable" in states,
                      selectable="selectable" in states)
    value = None
    if role in ("checkbox", "radio", "toggle"):
        value = "checked" if "checked" in states else "unchecked"
    return {"role": role, "label": name or description or "", "value": value,
            "focused": "focused" in states,
            "enabled": "enabled" in states or "sensitive" in states,
            "hidden": "showing" not in states,
            "box": tuple(extents) if extents and extents[2] > 0 else None,
            "children": children}


class MacAXSource(ElementSource):
    """AXUIElement over ctypes (ApplicationServices + CoreFoundation, no
    PyObjC). The focused application's windows and menu bar first, then the
    other apps with on-screen windows, front to back (CGWindowList), while the
    budget lasts. AX positions are global points — the same space as the
    Quartz input events, so Frame maps them like any click."""
    src = "ax"
    ATTRS = ("AXRole", "AXSubrole", "AXTitle", "AXDescription", "AXValue", "AXHelp",
             "AXPlaceholderValue", "AXPosition", "AXSize", "AXFocused", "AXEnabled",
             "AXChildren")
    OTHER_APPS = 6

    def __init__(self):
        super().__init__("")
        import ctypes
        import ctypes.util
        c = self.ct = ctypes
        vp = c.c_void_p
        self.ax = c.cdll.LoadLibrary("/System/Library/Frameworks/ApplicationServices"
                                     ".framework/ApplicationServices")
        self.cf = c.cdll.LoadLibrary(ctypes.util.find_library("CoreFoundation"))
        self.cg = c.cdll.LoadLibrary(ctypes.util.find_library("CoreGraphics"))
        ax, cf = self.ax, self.cf
        ax.AXIsProcessTrusted.restype = c.c_bool
        ax.AXUIElementCreateSystemWide.restype = vp
        ax.AXUIElementCreateApplication.restype = vp
        ax.AXUIElementCreateApplication.argtypes = [c.c_int32]
        ax.AXUIElementCopyAttributeValue.argtypes = [vp, vp, c.POINTER(vp)]
        ax.AXUIElementCopyAttributeValue.restype = c.c_int32
        ax.AXUIElementCopyMultipleAttributeValues.argtypes = [vp, vp, c.c_uint32,
                                                              c.POINTER(vp)]
        ax.AXUIElementCopyMultipleAttributeValues.restype = c.c_int32
        ax.AXUIElementSetMessagingTimeout.argtypes = [vp, c.c_float]
        ax.AXUIElementGetPid.argtypes = [vp, c.POINTER(c.c_int32)]
        ax.AXValueGetTypeID.restype = c.c_ulong
        ax.AXValueGetType.argtypes = [vp]
        ax.AXValueGetType.restype = c.c_uint32
        ax.AXValueGetValue.argtypes = [vp, c.c_uint32, vp]
        ax.AXValueGetValue.restype = c.c_bool
        for fn, res, args in (("CFRelease", None, [vp]), ("CFGetTypeID", c.c_ulong, [vp]),
                              ("CFStringGetTypeID", c.c_ulong, []),
                              ("CFBooleanGetTypeID", c.c_ulong, []),
                              ("CFNumberGetTypeID", c.c_ulong, []),
                              ("CFArrayGetTypeID", c.c_ulong, []),
                              ("CFArrayGetCount", c.c_long, [vp]),
                              ("CFArrayGetValueAtIndex", vp, [vp, c.c_long]),
                              ("CFBooleanGetValue", c.c_bool, [vp]),
                              ("CFNumberGetValue", c.c_bool, [vp, c.c_int, vp]),
                              ("CFStringGetLength", c.c_long, [vp]),
                              ("CFStringGetCString", c.c_bool, [vp, c.c_char_p, c.c_long,
                                                                c.c_uint32]),
                              ("CFStringCreateWithCString", vp, [vp, c.c_char_p, c.c_uint32]),
                              ("CFArrayCreate", vp, [vp, vp, c.c_long, vp]),
                              ("CFDictionaryGetValue", vp, [vp, vp])):
            f = getattr(cf, fn)
            f.restype, f.argtypes = res, args
        self.cg.CGWindowListCopyWindowInfo.restype = vp
        self.cg.CGWindowListCopyWindowInfo.argtypes = [c.c_uint32, c.c_uint32]
        self.T = {n: getattr(cf, f"CF{n}GetTypeID")() for n in
                  ("String", "Boolean", "Number", "Array")}
        self.T["AXValue"] = ax.AXValueGetTypeID()
        self._keep: list = []
        self._s: dict = {}
        self._lock = threading.Lock()
        names = [self.cfstr(a) for a in self.ATTRS]
        arr = (vp * len(names))(*names)
        cb = c.addressof(c.c_char.in_dll(cf, "kCFTypeArrayCallBacks"))
        self.attr_array = cf.CFArrayCreate(None, arr, len(names), cb)

    def cfstr(self, s: str):
        """Interned CFString (kept for the process lifetime; a handful)."""
        if s not in self._s:
            self._s[s] = self.cf.CFStringCreateWithCString(None, s.encode(), 0x08000100)
        return self._s[s]

    def unavailable(self):
        if not self.ax.AXIsProcessTrusted():
            return "no Accessibility permission"
        return None

    def py(self, obj):
        """A CF object -> Python (str, bool, float, list of borrowed refs,
        (a, b) for an AXValue point/size); None for anything else, including
        the AXError values CopyMultiple puts in place of missing attributes."""
        if not obj:
            return None
        c, cf = self.ct, self.cf
        t = cf.CFGetTypeID(obj)
        if t == self.T["String"]:
            n = cf.CFStringGetLength(obj)
            buf = c.create_string_buffer(n * 4 + 1)
            if cf.CFStringGetCString(obj, buf, len(buf), 0x08000100):
                return buf.value.decode(errors="replace")[:400]
            return ""
        if t == self.T["Boolean"]:
            return bool(cf.CFBooleanGetValue(obj))
        if t == self.T["Number"]:
            d = c.c_double()
            cf.CFNumberGetValue(obj, 13, c.byref(d))        # kCFNumberDoubleType
            return d.value
        if t == self.T["Array"]:
            return [cf.CFArrayGetValueAtIndex(obj, i) for i in range(cf.CFArrayGetCount(obj))]
        if t == self.T["AXValue"]:
            kind = self.ax.AXValueGetType(obj)
            if kind in (1, 2):                              # CGPoint, CGSize
                pt = (c.c_double * 2)()
                self.ax.AXValueGetValue(obj, kind, c.cast(pt, c.c_void_p))
                return (pt[0], pt[1])
        return None

    def attr(self, el, name: str):
        out = self.ct.c_void_p()
        if self.ax.AXUIElementCopyAttributeValue(el, self.cfstr(name),
                                                 self.ct.byref(out)) != 0:
            return None
        self._keep.append(out.value)
        return out.value

    def read(self, el) -> dict:
        """One IPC per node (CopyMultipleAttributeValues), not one per attr."""
        out = self.ct.c_void_p()
        if self.ax.AXUIElementCopyMultipleAttributeValues(
                el, self.attr_array, 0, self.ct.byref(out)) != 0 or not out.value:
            return {}
        self._keep.append(out.value)
        return ax_info(dict(zip(self.ATTRS, (self.py(v) for v in self.py(out.value)))))

    def roots(self) -> list:
        c, ax, cf = self.ct, self.ax, self.cf
        out, pids = [], []
        sysw = ax.AXUIElementCreateSystemWide()
        self._keep.append(sysw)
        app = self.attr(sysw, "AXFocusedApplication")
        if app:
            pid = c.c_int32()
            ax.AXUIElementGetPid(app, c.byref(pid))
            pids.append(pid.value)
        info = self.cg.CGWindowListCopyWindowInfo(1 | 16, 0)   # on screen, no desktop
        if info:
            self._keep.append(info)
            for d in self.py(info) or []:
                layer = self.py(cf.CFDictionaryGetValue(d, self.cfstr("kCGWindowLayer")))
                pid = self.py(cf.CFDictionaryGetValue(d, self.cfstr("kCGWindowOwnerPID")))
                if layer == 0 and pid and int(pid) not in pids:
                    pids.append(int(pid))
        for i, pid in enumerate(pids[:1 + self.OTHER_APPS]):
            a = ax.AXUIElementCreateApplication(pid)
            if not a:
                continue
            self._keep.append(a)
            ax.AXUIElementSetMessagingTimeout(a, 0.25)   # a hung app costs 0.25 s, not 6
            out += self.py(self.attr(a, "AXWindows")) or []
            if i == 0:
                mb = self.attr(a, "AXMenuBar")
                if mb:
                    out.append(mb)
        return out

    def collect(self, clip, deadline):
        """One walk at a time: screenshots run concurrently in worker
        threads, and `_keep` (the CF objects released after a walk) must not
        be shared. A second caller waits inside the same budget, then gives up."""
        if not self._lock.acquire(timeout=max(0.0, deadline - time.monotonic())):
            return [], True
        try:
            return walk_tree(self.roots(), self.read, clip, deadline)
        finally:
            for o in self._keep:
                if o:
                    self.cf.CFRelease(o)
            self._keep = []
            self._lock.release()


class GiAtspiSource(ElementSource):
    """AT-SPI2 through gi.repository.Atspi (what pyatspi wraps, so a host
    with pyatspi has it). Active windows first. Screen coordinates, which on
    X11 are the xdotool input space."""
    src = "atspi"
    STATES = ("showing", "focused", "enabled", "sensitive", "editable",
              "selectable", "checked", "active")

    def __init__(self, Atspi):
        super().__init__("")
        self.A = Atspi

    def unavailable(self):
        return None

    def _states(self, acc) -> set[str]:
        ss = acc.get_state_set()
        return {n for n in self.STATES if ss.contains(getattr(self.A.StateType, n.upper()))}

    def read(self, acc) -> dict:
        kids = [acc.get_child_at_index(i) for i in range(min(acc.get_child_count(), 500))]
        try:
            r = acc.get_extents(self.A.CoordType.SCREEN)
            ext = (r.x, r.y, r.width, r.height)
        except Exception:  # noqa: BLE001 — no Component interface
            ext = None
        return atspi_info(acc.get_role_name(), acc.get_name(), acc.get_description(),
                          self._states(acc), ext, kids)

    def collect(self, clip, deadline):
        desk = self.A.get_desktop(0)
        wins = []
        for i in range(desk.get_child_count()):
            app = desk.get_child_at_index(i)
            for j in range(app.get_child_count() if app else 0):
                w = app.get_child_at_index(j)
                if w:
                    wins.append(w)
        wins.sort(key=lambda w: "active" not in self._states(w))
        return walk_tree(wins, self.read, clip, deadline)


class DbusAtspiSource(ElementSource):
    """AT-SPI2 over raw D-Bus (python3-dbus), for hosts without gi. A node is
    (bus name, object path); every fact is a round trip, so this is the
    slowest source and the budget decides how much of the screen it covers."""
    src = "atspi"
    BITS = {"active": 1, "checked": 4, "editable": 7, "enabled": 8, "focused": 12,
            "selectable": 22, "sensitive": 24, "showing": 25}
    ACC = "org.a11y.atspi.Accessible"

    def __init__(self, dbus):
        super().__init__("")
        self.dbus = dbus
        addr = dbus.SessionBus().get_object("org.a11y.Bus", "/org/a11y/bus") \
            .GetAddress(dbus_interface="org.a11y.Bus")
        self.bus = dbus.bus.BusConnection(addr)

    def unavailable(self):
        return None

    def _call(self, node, iface, method, *args):
        obj = self.bus.get_object(node[0], node[1], introspect=False)
        return getattr(obj, method)(*args, dbus_interface=iface, timeout=0.3)

    def _states(self, node) -> set[str]:
        try:
            lo, hi = (list(self._call(node, self.ACC, "GetState")) + [0, 0])[:2]
        except Exception:  # noqa: BLE001 — an app that went away
            return set()
        bits = int(lo) | (int(hi) << 32)
        return {n for n, b in self.BITS.items() if bits >> b & 1}

    def _prop(self, node, name):
        return str(self._call(node, "org.freedesktop.DBus.Properties", "Get",
                              self.ACC, name))

    def _kids(self, node) -> list:
        return [(str(b), str(p)) for b, p in self._call(node, self.ACC, "GetChildren")][:500]

    def read(self, node) -> dict:
        try:
            ext = tuple(int(v) for v in self._call(node, "org.a11y.atspi.Component",
                                                   "GetExtents", self.dbus.UInt32(0)))
        except Exception:  # noqa: BLE001 — no Component interface
            ext = None
        return atspi_info(str(self._call(node, self.ACC, "GetRoleName")),
                          self._prop(node, "Name"), self._prop(node, "Description"),
                          self._states(node), ext, self._kids(node))

    def collect(self, clip, deadline):
        wins = []
        for app in self._kids(("org.a11y.atspi.Registry", "/org/a11y/atspi/accessible/root")):
            try:
                wins += self._kids(app)
            except Exception:  # noqa: BLE001 — an app that went away
                continue
        wins.sort(key=lambda w: "active" not in self._states(w))
        return walk_tree(wins, self.read, clip, deadline)


def atspi_source() -> ElementSource:
    """The best AT-SPI binding on this host (gi, which pyatspi is built on;
    else raw python3-dbus), or an honest none."""
    try:
        import gi
        gi.require_version("Atspi", "2.0")
        from gi.repository import Atspi
        return GiAtspiSource(Atspi)
    except Exception:  # noqa: BLE001 — ImportError, or ValueError from require_version
        pass
    try:
        import dbus
        import dbus.bus  # noqa: F401
    except ImportError:
        return ElementSource("AT-SPI not installed (python3-gi + gir1.2-atspi-2.0, "
                             "or python3-dbus)")
    try:
        return DbusAtspiSource(dbus)
    except Exception as e:  # noqa: BLE001 — no accessibility bus running
        return ElementSource(f"AT-SPI bus not reachable ({type(e).__name__})")


# --- the closed action list -----------------------------------------------------------------

BUTTONS = ("left", "right", "middle")
MODIFIERS = {"ctrl": "ctrl", "control": "ctrl", "shift": "shift", "alt": "alt",
             "super": "super", "logo": "super", "win": "super", "meta": "super",
             "cmd": "super", "altgr": "altgr"}
# keysym names allowed as the final key: letters, digits, F-keys and a named set
_NAMED_KEYS = {"Return", "Enter", "Tab", "Escape", "BackSpace", "Delete", "Insert",
               "Home", "End", "Page_Up", "Page_Down", "Prior", "Next", "Left",
               "Right", "Up", "Down", "space", "minus", "equal", "comma", "period",
               "slash", "backslash", "semicolon", "apostrophe", "grave",
               "bracketleft", "bracketright", "Print", "Menu"}
# combos that end the session or hand the machine elsewhere; the backend adds
# whatever its compositor binds to exit (hyprctl binds)
DENY_KEYS = {"ctrl+alt+Delete", "ctrl+alt+BackSpace", "super+shift+e", "super+m",
             "super+shift+q", "super+ctrl+q", "super+alt+Escape"} | {
             f"ctrl+alt+F{i}" for i in range(1, 13)}
# typed text that would reach this client's own controls
_SELF_WORDS = ("jav3-desk", ".config/jav3", "desk-shell", "desk.paused")
_URL_RE = re.compile(r"^https?://[^\s]{1,2000}$")


def normalize_combo(combo: str) -> str:
    """'Ctrl+Shift+t' -> 'ctrl+shift+t'; modifiers canonical and ordered,
    the final key as given. Raises DeskError on anything else."""
    if not isinstance(combo, str) or not re.fullmatch(
            r"[A-Za-z0-9_]{1,32}(\+[A-Za-z0-9_]{1,32}){0,4}", combo.strip()):
        raise DeskError("bad key combo")
    parts = combo.strip().split("+")
    mods, key = parts[:-1], parts[-1]
    out = []
    for m in mods:
        c = MODIFIERS.get(m.lower())
        if c is None:
            raise DeskError(f"unknown modifier {m!r}")
        if c not in out:
            out.append(c)
    order = ["ctrl", "alt", "altgr", "shift", "super"]
    out.sort(key=order.index)
    if not (len(key) == 1 and key.isalnum()) and key not in _NAMED_KEYS \
            and not re.fullmatch(r"F([1-9]|1[0-9]|2[0-4])", key):
        raise DeskError(f"unknown key {key!r}")
    return "+".join([*out, key])


def _deny_set(extra) -> set[str]:
    """DENY_KEYS + a backend's own, normalized; an entry that is not a combo
    this grammar can express (a mouse bind) is skipped, not fatal."""
    out = set()
    for d in set(extra) | DENY_KEYS:
        try:
            out.add(normalize_combo(d).lower())
        except DeskError:
            continue
    return out


def _num(p: dict, k: str, lo: int, hi: int, default=None) -> int:
    v = p.get(k, default)
    if isinstance(v, bool) or not isinstance(v, int):
        raise DeskError(f"{k} must be an integer")
    if not lo <= v <= hi:
        raise DeskError(f"{k} out of range")
    return v


def validate(verb: str, p: dict, frame: Frame | None, apps: dict,
             deny: set[str] = frozenset()) -> dict:
    """Re-check a request from the server. The server already validated it;
    this side does not assume the server is honest."""
    if not isinstance(p, dict):
        raise DeskError("params must be an object")
    out: dict = {}
    if verb == "screenshot":
        if p.get("monitor") is not None:
            out["monitor"] = str(p["monitor"])[:32]
        r = p.get("region")
        if r is not None:
            # shape only: the bounds are the last full-frame image of that
            # monitor, which the session checks (and clips to)
            if not isinstance(r, dict):
                raise DeskError("region must be {x, y, w, h}")
            out["region"] = {"x": _num(r, "x", 0, 100_000), "y": _num(r, "y", 0, 100_000),
                             "w": _num(r, "w", 4, 100_000), "h": _num(r, "h", 4, 100_000)}
        out["elements"] = p.get("elements", True) is not False
        return out
    if verb == "wait":
        if p.get("mode", "stable") not in ("stable", "change"):
            raise DeskError("mode must be stable or change")
        out["mode"] = p.get("mode", "stable")
        out["timeout_ms"] = _num(p, "timeout_ms", 0, WAIT_MAX_MS, 3000)
        return out
    if verb in ("move", "click", "drag") or (verb == "scroll" and "x" in p):
        if frame is None:
            raise DeskError("no screenshot yet; coordinates have nothing to refer to")
        out["x"] = _num(p, "x", 0, frame.iw - 1)
        out["y"] = _num(p, "y", 0, frame.ih - 1)
    if verb in ("move", "click", "scroll", "type", "key", "open", "drag"):
        out["screenshot_after"] = p.get("screenshot_after", True) is not False
    if verb == "move":
        return out
    if verb == "drag":
        out["to_x"] = _num(p, "to_x", 0, frame.iw - 1)
        out["to_y"] = _num(p, "to_y", 0, frame.ih - 1)
        if p.get("button", "left") not in BUTTONS:
            raise DeskError("bad button")
        out["button"] = p.get("button", "left")
        return out
    if verb == "click":
        if p.get("button", "left") not in BUTTONS:
            raise DeskError("bad button")
        out["button"] = p.get("button", "left")
        out["count"] = _num(p, "count", 1, 3, 1)
        return out
    if verb == "scroll":
        out["dx"] = _num(p, "dx", -20, 20, 0)
        out["dy"] = _num(p, "dy", -20, 20, 0)
        return out
    if verb == "type":
        t = p.get("text")
        if not isinstance(t, str) or not t or len(t) > TEXT_CAP or "\x00" in t:
            raise DeskError("bad text")
        if any(w in t for w in _SELF_WORDS):
            raise DeskError("refused: that text would reach jav3-desk's own controls")
        out["text"] = t
        return out
    if verb == "key":
        c = normalize_combo(p.get("combo"))
        if c.lower() in _deny_set(deny):
            raise DeskError(f"refused: {c} is on this computer's denylist")
        out["combo"] = c
        return out
    if verb == "open":
        url, app = p.get("url"), p.get("app")
        if isinstance(url, str) and url:
            if not _URL_RE.match(url):
                raise DeskError("only http(s) URLs")
            out["url"] = url
        elif isinstance(app, str) and app in apps:
            out["app"] = app
        else:
            raise DeskError("open needs an http(s) url or one of this computer's apps")
        return out
    if verb == "shell":
        cmd = p.get("cmd")
        if not isinstance(cmd, str) or not cmd.strip() or len(cmd) > 4000:
            raise DeskError("bad cmd")
        mode = p.get("mode")
        if mode not in ("argv", "shell"):
            raise DeskError("bad shell mode")
        out.update(cmd=cmd, mode=mode, timeout=_num(p, "timeout", 1, 120, 60))
        if mode == "argv":
            argv = p.get("argv")
            if not (isinstance(argv, list) and argv and len(argv) <= 256
                    and all(isinstance(a, str) and "\x00" not in a for a in argv)):
                raise DeskError("bad argv")
            out["argv"] = argv
        cwd = p.get("cwd")
        if cwd is not None:
            if not isinstance(cwd, str) or "\x00" in cwd or len(cwd) > 512:
                raise DeskError("bad cwd")
            out["cwd"] = cwd
        return out
    raise DeskError(f"unknown verb {verb!r}")


