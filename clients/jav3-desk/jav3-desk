        self.cg.CGEventCreate.restype = ctypes.c_void_p
        self.cg.CGEventCreate.argtypes = [ctypes.c_void_p]
        self.cg.CGEventGetLocation.restype = Pt
        self.cg.CGEventGetLocation.argtypes = [ctypes.c_void_p]
        # lock / sleep: a capture of a locked screen fails ("could not create
        # image from display") or shows only the lock screen
        self.cg.CGSessionCopyCurrentDictionary.restype = ctypes.c_void_p
        self.cg.CGSessionCopyCurrentDictionary.argtypes = []
        self.cg.CGDisplayIsAsleep.restype = ctypes.c_uint32
        self.cg.CGDisplayIsAsleep.argtypes = [ctypes.c_uint32]
        self.cf.CFStringCreateWithCString.restype = ctypes.c_void_p
        self.cf.CFStringCreateWithCString.argtypes = [ctypes.c_void_p, ctypes.c_char_p,
                                                      ctypes.c_uint32]
        self.cf.CFDictionaryGetValue.restype = ctypes.c_void_p
        self.cf.CFDictionaryGetValue.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
        self.cf.CFGetTypeID.restype = ctypes.c_ulong
        self.cf.CFGetTypeID.argtypes = [ctypes.c_void_p]
        self.cf.CFBooleanGetTypeID.restype = ctypes.c_ulong
        self.cf.CFBooleanGetValue.restype = ctypes.c_bool
        self.cf.CFBooleanGetValue.argtypes = [ctypes.c_void_p]
        self.cf.CFNumberGetValue.restype = ctypes.c_bool
        self.cf.CFNumberGetValue.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p]
        self.pos = (0, 0)
        self._ax: ElementSource | None = None
        self._dids: dict[str, int] = {}
        try:
            self._cg_thumb_setup()
            self.cheap_thumb = True
        except (OSError, AttributeError):
            self.cheap_thumb = False

    def _cg_thumb_setup(self) -> None:
        """In-process thumbnails: CGDisplayCreateImageForRect drawn into a
        THUMB_EDGE grey bitmap — ~40 ms against ~200-400 ms for screencapture
        + sips, twice or more per action while settling."""
        ct, cg, vp = self.ct, self.cg, self.ct.c_void_p

        class Rect(ct.Structure):
            _fields_ = [("origin", self.Pt), ("size", self.Pt)]
        self.CGRect = Rect
        cg.CGDisplayCreateImageForRect.restype = vp
        cg.CGDisplayCreateImageForRect.argtypes = [ct.c_uint32, Rect]
        cg.CGColorSpaceCreateDeviceGray.restype = vp
        cg.CGBitmapContextCreate.restype = vp
        cg.CGBitmapContextCreate.argtypes = [vp, ct.c_size_t, ct.c_size_t, ct.c_size_t,
                                             ct.c_size_t, vp, ct.c_uint32]
        cg.CGContextDrawImage.argtypes = [vp, Rect, vp]
        cg.CGContextSetInterpolationQuality.argtypes = [vp, ct.c_int]
        cg.CGContextRelease.argtypes = [vp]
        cg.CGImageRelease.argtypes = [vp]
        cg.CGPreflightScreenCaptureAccess.restype = ct.c_bool
        cg.CGImageGetWidth.restype = ct.c_size_t
        cg.CGImageGetWidth.argtypes = [vp]
        cg.CGImageGetHeight.restype = ct.c_size_t
        cg.CGImageGetHeight.argtypes = [vp]
        cg.CGColorSpaceCreateDeviceRGB.restype = vp
        cg.CGBitmapContextCreateImage.restype = vp
        cg.CGBitmapContextCreateImage.argtypes = [vp]
        self._grey = cg.CGColorSpaceCreateDeviceGray()
        self._rgb = cg.CGColorSpaceCreateDeviceRGB()
        io = self.imageio = ct.cdll.LoadLibrary(
            "/System/Library/Frameworks/ImageIO.framework/ImageIO")
        io.CGImageDestinationCreateWithData.restype = vp
        io.CGImageDestinationCreateWithData.argtypes = [vp, vp, ct.c_size_t, vp]
        io.CGImageDestinationAddImage.argtypes = [vp, vp, vp]
        io.CGImageDestinationFinalize.restype = ct.c_bool
        io.CGImageDestinationFinalize.argtypes = [vp]
        cf = self.cf
        cf.CFDataCreateMutable.restype = vp
        cf.CFDataCreateMutable.argtypes = [vp, ct.c_long]
        cf.CFDataGetLength.restype = ct.c_long
        cf.CFDataGetLength.argtypes = [vp]
        cf.CFDataGetBytePtr.restype = vp
        cf.CFDataGetBytePtr.argtypes = [vp]
        self._jpeg_uti = cf.CFStringCreateWithCString(None, b"public.jpeg", 0x08000100)

    def _cg_image(self, mon: Monitor, rect):
        """(CGImage, native w, h) of the monitor or `rect` (points relative
        to it), captured in process; None when this path cannot vouch for
        the picture: no display id yet, or no Screen Recording permission
        (the image would then hold only the wallpaper). The caller releases."""
        did = self._dids.get(mon.name)
        if not self.cheap_thumb or did is None or not self.cg.CGPreflightScreenCaptureAccess():
            return None
        why = screen_refusal(self.screen_state())
        if why:
            raise DeskError(why)
        x, y, w, h = (0, 0, mon.w, mon.h) if rect is None else rect
        img = self.cg.CGDisplayCreateImageForRect(
            did, self.CGRect(self.Pt(x, y), self.Pt(w, h)))
        if not img:
            return None
        return img, self.cg.CGImageGetWidth(img), self.cg.CGImageGetHeight(img)

    def _draw(self, img, tw: int, th: int, grey: bool):
        """`img` scaled into a fresh tw x th bitmap context: (ctx, buffer)."""
        n = 1 if grey else 4
        buf = (self.ct.c_uint8 * (tw * th * n))()
        # RGB: kCGImageAlphaNoneSkipLast (5); grey: kCGImageAlphaNone (0)
        ctx = self.cg.CGBitmapContextCreate(buf, tw, th, 8, tw * n,
                                            self._grey if grey else self._rgb,
                                            0 if grey else 5)
        if not ctx:
            return None, None
        self.cg.CGContextSetInterpolationQuality(ctx, 2 if grey else 3)
        self.cg.CGContextDrawImage(ctx, self.CGRect(self.Pt(0, 0), self.Pt(tw, th)), img)
        return ctx, buf

    def _cg_screenshot(self, mon: Monitor, rect) -> bytes | None:
        """The screenshot as a JPEG, captured, scaled and encoded in process
        (CoreGraphics + ImageIO): no screencapture, no sips, no temp file."""
        got = self._cg_image(mon, rect)
        if got is None:
            return None
        img, nw, nh = got
        ctx = out = data = dest = None
        try:
            if rect is None:
                target = min(LONG_EDGE, max(nw, nh))
            else:
                target = max(zoom_size(rect[2], rect[3], max(nw, nh) / max(rect[2], rect[3])))
            k = target / max(nw, nh, 1)
            tw, th = max(1, round(nw * k)), max(1, round(nh * k))
            ctx, _buf = self._draw(img, tw, th, grey=False)
            if not ctx:
                return None
            out = self.cg.CGBitmapContextCreateImage(ctx)
            data = self.cf.CFDataCreateMutable(None, 0)
            dest = self.imageio.CGImageDestinationCreateWithData(data, self._jpeg_uti, 1, None)
            if not (out and data and dest):
                return None
            self.imageio.CGImageDestinationAddImage(dest, out, None)
            if not self.imageio.CGImageDestinationFinalize(dest):
                return None
            return self.ct.string_at(self.cf.CFDataGetBytePtr(data),
                                     self.cf.CFDataGetLength(data))
        finally:
            for o in (dest, data):
                if o:
                    self.cf.CFRelease(o)
            if out:
                self.cg.CGImageRelease(out)
            if ctx:
                self.cg.CGContextRelease(ctx)
            self.cg.CGImageRelease(img)

    def _post(self, ev) -> None:
        self.cg.CGEventPost(0, ev)          # kCGHIDEventTap
        self.cf.CFRelease(ev)

    def monitors(self):
        """Every active display in global points, the main one first (named
        "main" as before; the others "display-2", ...)."""
        main = self.cg.CGMainDisplayID()
        ids = (self.ct.c_uint32 * 16)()
        n = self.ct.c_uint32(0)
        if self.cg.CGGetActiveDisplayList(16, ids, self.ct.byref(n)) != 0 or not n.value:
            ids, n = (self.ct.c_uint32 * 1)(main), self.ct.c_uint32(1)
        order = sorted(ids[:n.value], key=lambda d: d != main)
        out = []
        for i, d in enumerate(order):
            r = self.cg.CGDisplayBounds(d)
            out.append(Monitor(name="main" if d == main else f"display-{i + 1}",
                               x=int(r.origin.x), y=int(r.origin.y),
                               w=int(r.size.x), h=int(r.size.y)))
            self._dids[out[-1].name] = d
        return out

    def _locked(self) -> bool:
        """CGSessionCopyCurrentDictionary()["CGSSessionScreenIsLocked"]: the
        key is present (true) only while the lock screen is up. No session
        dictionary (no GUI login) reads as unlocked."""
        ct, cf = self.ct, self.cf
        d = self.cg.CGSessionCopyCurrentDictionary()
        if not d:
            return False
        key = cf.CFStringCreateWithCString(None, b"CGSSessionScreenIsLocked",
                                           0x08000100)          # UTF-8
        try:
            v = cf.CFDictionaryGetValue(d, key) if key else None
            if not v:
                return False
            if cf.CFGetTypeID(v) == cf.CFBooleanGetTypeID():
                return bool(cf.CFBooleanGetValue(v))
            n = ct.c_int32(0)                                   # a CFNumber, if ever
            return bool(cf.CFNumberGetValue(v, 3, ct.byref(n)) and n.value)
        finally:
            if key:
                cf.CFRelease(key)
            cf.CFRelease(d)

    def screen_state(self) -> dict:
        return {"locked": self._locked(),
                "asleep": bool(self.cg.CGDisplayIsAsleep(self.cg.CGMainDisplayID()))}

    def _capture(self, mon: Monitor, rect, f: str) -> tuple[int, int]:
        """screencapture -R takes a rect in global points and writes it at
        the display's native (Retina: 2x) pixels; returns that native size.
        A locked screen or a sleeping display is refused first, in words."""
        why = screen_refusal(self.screen_state())
        if why:
            raise DeskError(why)
        x, y, w, h = (mon.x, mon.y, mon.w, mon.h) if rect is None else (
            mon.x + rect[0], mon.y + rect[1], rect[2], rect[3])
        run_argv([self.bin["screencapture"], "-x", "-R", f"{x},{y},{w},{h}", "-t", "jpg", f])
        return image_size(Path(f).read_bytes()[:65536]) or (w, h)

    def screenshot(self, mon, rect=None):
        """In process when it can (_cg_screenshot); else screencapture + sips."""
        data = self._cg_screenshot(mon, rect)
        if data is not None and image_size(data):
            return data
        with tempfile.TemporaryDirectory() as d:
            f = os.path.join(d, "s.jpg")
            nw, nh = self._capture(mon, rect, f)
            if rect is None:
                target = min(LONG_EDGE, max(nw, nh))
            else:
                target = max(zoom_size(rect[2], rect[3], max(nw, nh) / max(rect[2], rect[3])))
            if target != max(nw, nh):
                run_argv([self.bin["sips"], "-Z", str(target), f])
            return Path(f).read_bytes()

    def _cg_thumbnail(self, mon: Monitor, rect) -> bytes | None:
        """A binary PGM (P5) of the monitor or `rect` at THUMB_EDGE, drawn in
        process; None when _cg_image cannot vouch for the picture."""
        got = self._cg_image(mon, rect)
        if got is None:
            return None
        img, nw, nh = got
        ctx = None
        try:
            k = THUMB_EDGE / max(nw, nh, 1)
            tw, th = max(1, round(nw * k)), max(1, round(nh * k))
            ctx, buf = self._draw(img, tw, th, grey=True)
            if not ctx:
                return None
            return b"P5\n%d %d\n255\n" % (tw, th) + bytes(buf)
        finally:
            if ctx:
                self.cg.CGContextRelease(ctx)
            self.cg.CGImageRelease(img)

    def thumbnail(self, mon, rect=None):
        """In process (CoreGraphics, a PGM) when it can; else an uncompressed
        BMP from screencapture + sips (decodable without a library)."""
        t = self._cg_thumbnail(mon, rect)
        if t is not None:
            return t
        with tempfile.TemporaryDirectory() as d:
            f, t = os.path.join(d, "s.jpg"), os.path.join(d, "t.bmp")
            nw, nh = self._capture(mon, rect, f)
            k = THUMB_EDGE / max(nw, nh)
            run_argv([self.bin["sips"], "-z", str(max(1, round(nh * k))),
                      str(max(1, round(nw * k))), "-s", "format", "bmp", f, "--out", t])
            return Path(t).read_bytes()

    def cursor(self):
        ev = self.cg.CGEventCreate(None)
        if not ev:
            return None
        p = self.cg.CGEventGetLocation(ev)
        self.cf.CFRelease(ev)
        return round(p.x), round(p.y)

    def elements_source(self) -> ElementSource:
        if self._ax is None:
            try:
                self._ax = MacAXSource()
            except (OSError, AttributeError, ValueError) as e:
                self._ax = ElementSource(f"accessibility API unavailable ({e})"[:120])
        return self._ax

    def move(self, x, y):
        self.pos = (x, y)
        self._post(self.cg.CGEventCreateMouseEvent(None, 5, self.Pt(x, y), 0))

    def drag(self, x0, y0, x1, y1, button):
        """Quartz wants down, then *Dragged* events (not Moved), then up."""
        down, up, dragged, btn = {"left": (1, 2, 6, 0), "right": (3, 4, 7, 1),
                                  "middle": (25, 26, 27, 2)}[button]
        self.move(x0, y0)
        self._post(self.cg.CGEventCreateMouseEvent(None, down, self.Pt(x0, y0), btn))
        try:
            for x, y in drag_path(x0, y0, x1, y1):
                time.sleep(0.015)
                self._post(self.cg.CGEventCreateMouseEvent(None, dragged, self.Pt(x, y), btn))
        finally:
            self._post(self.cg.CGEventCreateMouseEvent(None, up, self.Pt(x1, y1), btn))
            self.pos = (x1, y1)

    def click(self, button, count):
        down, up, btn = {"left": (1, 2, 0), "right": (3, 4, 1), "middle": (25, 26, 2)}[button]
        for i in range(1, count + 1):
            for kind in (down, up):
                ev = self.cg.CGEventCreateMouseEvent(None, kind, self.Pt(*self.pos), btn)
                self.cg.CGEventSetIntegerValueField(ev, 1, i)    # click state
                self._post(ev)

    def scroll(self, dx, dy):
        self._post(self.cg.CGEventCreateScrollWheelEvent(None, 1, 2, -dy, -dx))

    _SHIFTED = {**{c.upper(): c for c in "abcdefghijklmnopqrstuvwxyz"},
                "!": "1", "@": "2", "#": "3", "$": "4", "%": "5", "^": "6", "&": "7",
                "*": "8", "(": "9", ")": "0", "?": "slash", "<": "comma", ">": "period",
                "_": "minus", "+": "equal"}
    _PLAIN = {" ": "space", ".": "period", ",": "comma", "/": "slash", "-": "minus",
              "=": "equal"}

    def _source(self):
        """A private HID-state event source, so posted keys carry their own
        modifier state instead of whatever the operator is holding."""
        if getattr(self, "_src", None) is None:
            self.cg.CGEventSourceCreate.restype = self.ct.c_void_p
            self.cg.CGEventSourceCreate.argtypes = [self.ct.c_int32]
            self._src = self.cg.CGEventSourceCreate(1) or None   # HIDSystemState
        return self._src

    def type_text(self, text):
        """Each character is a key down/up pair posted to the HID tap
        (kCGHIDEventTap, as every event here) with the character attached
        (CGEventKeyboardSetUnicodeString, as UTF-16 units) and the matching
        US key code when there is one, so apps that read the key code see
        the same key; flags are set explicitly (shift or none), never
        inherited from keys the operator is holding."""
        src = self._source()
        for ch in text:
            name = self._PLAIN.get(ch) or self._SHIFTED.get(ch) or ch
            known = ch.isascii() and name in self._KEYCODES
            code = self._KEYCODES[name] if known else 0
            flags = self._FLAGS["shift"] if known and ch in self._SHIFTED else 0
            units = ch.encode("utf-16-le")
            buf = (self.ct.c_uint16 * (len(units) // 2)).from_buffer_copy(units)
            for down in (True, False):
                ev = self.cg.CGEventCreateKeyboardEvent(src, code, down)
                self.cg.CGEventSetFlags(ev, flags)
                self.cg.CGEventKeyboardSetUnicodeString(ev, len(buf), buf)
                self._post(ev)
                time.sleep(0.004)
            time.sleep(0.008)

    def secure_input(self) -> bool:
        try:
            carbon = self.ct.cdll.LoadLibrary(
                "/System/Library/Frameworks/Carbon.framework/Carbon")
            carbon.IsSecureEventInputEnabled.restype = self.ct.c_bool
            return bool(carbon.IsSecureEventInputEnabled())
        except (OSError, AttributeError):
            return False

    def key(self, combo):
        *mods, k = combo.split("+")
        code = self._KEYCODES.get(k if len(k) > 1 else k.lower())
        if code is None:
            raise DeskError(f"no macOS key code for {k!r}")
        flags = 0
        for m in mods:
            flags |= self._FLAGS.get(m, 0)
        for down in (True, False):
            ev = self.cg.CGEventCreateKeyboardEvent(None, code, down)
            self.cg.CGEventSetFlags(ev, flags)
            self._post(ev)

    def notify(self, text):
        n = find_bin("terminal-notifier")      # never osascript: AppleScript can shell
        if n:
            subprocess.Popen([n, "-title", "jav3-desk", "-message", text], shell=False,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


