def detect_backend(env=os.environ, plat=sys.platform) -> str:
    if plat == "darwin":
        return "macos"
    if env.get("WAYLAND_DISPLAY"):
        if env.get("HYPRLAND_INSTANCE_SIGNATURE"):
            return "hyprland"
        if env.get("SWAYSOCK"):
            return "sway"
        raise DeskError("this Wayland session is not Hyprland or Sway; GNOME/KDE "
                        "need the portal backend (not built yet, M2)")
    if env.get("DISPLAY"):
        return "x11"
    raise DeskError("no graphical session found (no WAYLAND_DISPLAY or DISPLAY); "
                    "for the service run: systemctl --user import-environment "
                    "WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK")


MAC_APP_DIRS = ("/Applications", "/System/Applications", "/System/Applications/Utilities",
                "~/Applications")
LINUX_APP_DIRS = ("/usr/share/applications",)
APPS_CAP = 200            # names offered in hello (the server keeps as many)
_APP_NAME_RE = re.compile(r"[A-Za-z0-9 ._+-]{1,64}")      # the server's rule too
# never offered, whatever is installed: a terminal or a script runner, opened
# and typed into, is shell by other means (shell has its own grant)
NOT_OFFERED = frozenset({
    "terminal", "iterm", "iterm2", "warp", "alacritty", "kitty", "wezterm", "ghostty",
    "hyper", "tabby", "script editor", "automator", "shortcuts", "xterm", "uxterm",
    "konsole", "gnome-terminal", "xfce4-terminal", "terminator", "tilix", "foot",
    "console", "gnome-console", "kgx", "ptyxis", "lxterminal", "mate-terminal",
    "qterminal", "rxvt", "urxvt", "st", "cool-retro-term", "yakuake", "guake"})


def _offerable(name: str) -> bool:
    return bool(_APP_NAME_RE.fullmatch(name)) and name.lower() not in NOT_OFFERED \
        and "terminal" not in name.lower()


def mac_bundles(dirs=MAC_APP_DIRS) -> list[str]:
    """The .app bundles directly inside `dirs` (one level, no recursion),
    names without the extension, sorted case-insensitively, one per name,
    at most APPS_CAP."""
    seen: dict[str, str] = {}
    for d in dirs:
        try:
            names = os.listdir(os.path.expanduser(d))
        except OSError:
            continue
        for n in names:
            if n.endswith(".app") and not n.startswith("."):
                n = n[:-4]
                if _offerable(n):
                    seen.setdefault(n.lower(), n)
    return sorted(seen.values(), key=str.lower)[:APPS_CAP]


def desktop_entries(dirs=LINUX_APP_DIRS) -> dict[str, str]:
    """Name -> desktop-file id of the launchable, visible, non-terminal
    entries in `dirs` (flat, no recursion)."""
    out: dict[str, str] = {}
    have: set[str] = set()
    for d in dirs:
        try:
            files = sorted(os.listdir(d))
        except OSError:
            continue
        for fn in files:
            if not fn.endswith(".desktop"):
                continue
            try:
                text = Path(d, fn).read_text(errors="replace")[:65536]
            except OSError:
                continue
            kv: dict[str, str] = {}
            in_entry = False
            for line in text.splitlines():
                line = line.strip()
                if line.startswith("["):
                    in_entry = line == "[Desktop Entry]"
                elif in_entry and "=" in line:
                    k, v = line.split("=", 1)
                    kv.setdefault(k.strip(), v.strip())
            if kv.get("Type", "Application") != "Application" \
                    or kv.get("NoDisplay", "").lower() == "true" \
                    or kv.get("Hidden", "").lower() == "true" \
                    or kv.get("Terminal", "").lower() == "true" \
                    or "TerminalEmulator" in kv.get("Categories", ""):
                continue
            name = kv.get("Name", "")
            if _offerable(name) and name.lower() not in have:
                out[name] = fn[:-len(".desktop")]
                have.add(name.lower())
    return out


def apps_override() -> tuple[dict[str, list[str]], list[str]] | None:
    """(kept, dropped names) from desk-apps.json; None when there is no usable
    file. The operator's list is taken as is, except that the terminal /
    script-runner exclusion applies to it too: a file that lists "Terminal"
    would otherwise hand the model a shell the shell grant does not cover."""
    try:
        raw = json.loads(_path("desk-apps.json").read_text())
        items = list(raw.items())
    except (OSError, ValueError, AttributeError):
        return None
    kept, dropped = {}, []
    for k, v in items:
        if not (isinstance(k, str) and _APP_NAME_RE.fullmatch(k)
                and isinstance(v, list) and v and all(isinstance(a, str) for a in v)):
            continue
        if _offerable(k):
            kept[k] = v
        else:
            dropped.append(k)
    return kept, dropped


def local_apps(plat=sys.platform, *, mac_dirs=MAC_APP_DIRS,
               linux_dirs=LINUX_APP_DIRS) -> dict[str, list[str]]:
    """name -> argv for desk_open app=. From desk-apps.json if present (the
    operator's list, as is), else what is installed here: on macOS every
    .app bundle in the usual folders, launched with `open -a <Name>`; on
    Linux the browsers/editors found on PATH plus the .desktop entries
    (through gtk-launch, when it exists). A terminal or script runner is
    never offered by default: opening one and typing into it would be shell
    by other means."""
    over = apps_override()
    if over is not None:
        return over[0]
    if plat == "darwin":
        return {n: ["/usr/bin/open", "-a", n] for n in mac_bundles(mac_dirs)}
    apps = {}
    for n in ("firefox", "chromium", "google-chrome", "code", "nautilus", "thunar"):
        p = find_bin(n)
        if p:
            apps[n] = [p]
    launcher = find_bin("gtk-launch")
    if launcher:
        have = {k.lower() for k in apps}
        for name, did in desktop_entries(linux_dirs).items():
            if len(apps) >= APPS_CAP:
                break
            if name.lower() not in have:
                apps[name] = [launcher, did]
                have.add(name.lower())
    return apps


def app_named(apps: dict, name) -> str | None:
    """The offered app `name` refers to: exact, else case-insensitive."""
    if not isinstance(name, str) or not name.strip():
        return None
    name = name.strip()
    if name in apps:
        return name
    low = name.lower()
    return next((k for k in apps if k.lower() == low), None)


# --- the connection ------------------------------------------------------------------------------

class Session:
    def __init__(self, backend: Backend, address: str, token: str):
        self.b = backend
        self.address, self.token = address, token
        self.frame: Frame | None = None
        self.full: dict[str, Frame] = {}          # last full-frame shot per monitor
        self.elements: ElementSource | None = None
        self.walk = "front"                       # the last screenshot's walk
        # what the last response showed, as the next input verb's "before":
        # {"at", "key": (monitor, rect), "sig", "thumb"}; see _before()
        self.pre: dict | None = None
        self.settled_thumb: bytes | None = None   # settle's last capture
        self.tm: dict = {}                        # this request's phase timings (ms)
        self.grants = {"screen": False, "input": False, "shell": "off"}
        self.apps = local_apps()
        self.deny = backend.deny_keys()
        self.input_lock = asyncio.Lock()
        self.shell_busy = False
        self.last_action = 0.0
        self.sent_ceiling = ceiling()
        self.sent_state: dict | None = None
        self.inflight: set[asyncio.Task] = set()

    def state(self) -> dict:
        """{"locked", "asleep"} from the backend; a probe that breaks reads
        as neither (the capture itself will then say what is wrong)."""
        try:
            st = self.b.screen_state()
        except Exception:  # noqa: BLE001
            st = {}
        # locked: True / False, or None = unknown (Linux with no answer)
        lk = st.get("locked", False)
        return {"locked": lk if lk is None or isinstance(lk, bool) else False,
                "asleep": st.get("asleep") is True}

    def hello(self) -> dict:
        try:
            mons = [m.__dict__ for m in self.b.monitors()]
        except Exception:  # noqa: BLE001 — hello must not die on a probe
            mons = []
        self.sent_state = self.state()
        return {"type": "hello", "v": PROTOCOL_V, "host": socket.gethostname(),
                "platform": sys.platform, "session": self.b.session,
                "backend": self.b.name, "monitors": mons,
                "apps": sorted(self.apps), "ceiling": ceiling(), **self.sent_state}

    def allowed(self, verb: str) -> str | None:
        cap = {"screenshot": "screen", "wait": "screen", "shell": "shell"}.get(verb, "input")
        c = ceiling()
        g = self.grants.get(cap)
        if cap == "shell":
            if not c["shell"]:
                return "shell is off at this computer (jav3-desk allow-shell)"
            if g not in ("ask", "trusted"):
                return "shell is not granted"
        elif not g:
            return f"{cap} is not granted"
        return None

    def _pick(self, monitor: str | None) -> tuple[Monitor, int, int]:
        ms = self.b.monitors()
        if monitor is None:
            return ms[0], 0, len(ms)
        # indices are 1-based on the wire: the model reads "monitor 1 of 2" in
        # the screenshot text and the server matches zoom regions on that
        for i, m in enumerate(ms):
            if m.name == monitor or str(i + 1) == monitor:
                return m, i, len(ms)
        raise DeskError(f"no monitor {monitor!r} (have: {', '.join(m.name for m in ms)}); "
                        f'use monitor="{ms[0].name if ms else 'main'}" or an index from 1')

    def _elements(self, frame: Frame, walk: str | None = None) -> dict:
        """The element list for `frame`, within ELEMENTS_BUDGET_S; never
        raises (a broken accessibility API costs the list, not the shot).
        `walk` (default: what the last screenshot asked) "front" caps the
        background windows, "all" walks every window in full."""
        if self.elements is None:
            try:
                self.elements = self.b.elements_source()
            except Exception as e:  # noqa: BLE001
                self.elements = ElementSource(f"accessibility unavailable ({type(e).__name__})")
        es = self.elements
        t0 = time.monotonic()
        try:
            return self._walk(es, frame, walk)
        finally:
            self._tick("elements_ms", t0)

    def _tick(self, phase: str, t0: float) -> None:
        self.tm[phase] = self.tm.get(phase, 0) + int((time.monotonic() - t0) * 1000)

    def _walk(self, es: ElementSource, frame: Frame, walk: str | None) -> dict:
        try:
            why = es.unavailable()
            if why:
                return {"elements": [], "elements_src": "none", "elements_note": why}
            wins: dict = {}
            raw, partial = es.collect(frame.screen_rect(),
                                      time.monotonic() + ELEMENTS_BUDGET_S,
                                      walk or self.walk, wins)
        except Exception as e:  # noqa: BLE001
            return {"elements": [], "elements_src": "none",
                    "elements_note": f"accessibility tree failed ({type(e).__name__})"}
        els = build_elements(raw, frame, es.src)
        out = {"elements": els, "elements_src": es.src}
        if wins:
            # background windows: how many of their elements are listed of
            # how many there are (the server says so in the group header)
            shown: dict = {}
            for e in els:
                shown[e.get("window")] = shown.get(e.get("window"), 0) + 1
            out["windows"] = [{"window": g, "background": True, "shown": shown.get(g, 0),
                               "total": w["total"], **({"more": True} if w["more"] else {})}
                              for g, w in wins.items()]
        if partial:
            out["elements_note"] = "partial"
        return out

    def _shot(self, monitor: str | None = None, region: dict | None = None,
              elements: bool = True, rect: tuple | None = None) -> dict:
        """A screenshot response body: image, frame, elements, cursor. A
        `region` (full-frame image px of that monitor's last full shot) is
        turned into a screen rect here; an auto-shot passes the current
        frame's `rect` + `region` straight through so the model keeps its zoom."""
        mon, idx, count = self._pick(monitor)
        if region is not None and rect is None:
            full = self.full.get(mon.name)
            if full is None:
                raise DeskError(f"no full screenshot of {mon.name!r} yet; region is in "
                                "the pixels of that one — take it first")
            rect, region = region_rect(full, region)
        t0 = time.monotonic()
        data = self.b.screenshot(mon) if rect is None else self.b.screenshot(mon, rect)
        self._tick("capture_ms", t0)
        size = image_size(data)
        if size is None:
            raise DeskError("the screenshot tool returned something that is not an image")
        frame = Frame(mon, *size, rect=rect, region=region if rect else None,
                      index=idx, count=count)
        self.frame = frame
        if rect is None:
            self.full[mon.name] = frame
        mime = "image/png" if data[:4] == b"\x89PNG" else "image/jpeg"
        out = {"image": {"mime": mime, "w": size[0], "h": size[1],
                         "b64": base64.b64encode(data).decode()},
               "frame": frame.wire()}
        if elements:
            out.update(self._elements(frame))
        else:
            out.update(elements=[], elements_src="none", elements_note="not requested")
        try:
            c = self.b.cursor()
        except Exception:  # noqa: BLE001 — optional
            c = None
        if c is not None:
            cx, cy = frame.from_screen(*c)
            if 0 <= cx < frame.iw and 0 <= cy < frame.ih:
                out["cursor"] = {"x": int(cx), "y": int(cy)}
        return out

    def _thumb(self, frame: Frame | None) -> bytes | None:
        try:
            if frame is None:
                return self.b.thumbnail(self._pick(None)[0])
            return self.b.thumbnail(frame.monitor, frame.rect) if frame.rect \
                else self.b.thumbnail(frame.monitor)
        except Exception:  # noqa: BLE001 — settle is best effort; never fail the action
            return None

    def settle(self, before: bytes | None, floor: float = SETTLE_S,
               ceiling_s: float = SETTLE_MAX_S, until_change: bool = False,
               frame: Frame | None = None) -> tuple[bool | None, int]:
        """A.4: after `floor`, capture thumbnails until two consecutive match
        (or, until_change, until one differs from `before` and then settles),
        up to `ceiling_s`. Returns (changed vs `before` — None when unknown,
        settled_ms). Thumbnails are the backend's cheapest capture: raw
        pixels where the tool can emit them (grim ppm, ImageMagick pgm, sips
        bmp), else a full JPEG compared byte-for-byte (see thumbs_match)."""
        t0 = time.monotonic()
        self.settled_thumb = None
        if floor > 0:
            time.sleep(floor)
        f = frame or self.frame
        prev = self._thumb(f)
        if until_change:
            while thumbs_match(before, prev) and time.monotonic() - t0 < ceiling_s:
                time.sleep(SETTLE_POLL_S)
                prev = self._thumb(f)
        cur = prev
        while time.monotonic() - t0 < ceiling_s:
            time.sleep(SETTLE_POLL_S)
            cur = self._thumb(f)
            if cur is None or thumbs_match(prev, cur):
                break
            prev = cur
        changed = None if before is None or cur is None else not thumbs_match(before, cur)
        self.settled_thumb = cur
        self._tick("settle_ms", t0)
        return changed, int((time.monotonic() - t0) * 1000)

    def execute(self, verb: str, p: dict) -> dict:
        """Blocking: runs in a worker thread. The response carries `timing`
        {capture_ms, settle_ms, elements_ms, total_ms}, also logged at debug."""
        self.tm = {"capture_ms": 0, "settle_ms": 0, "elements_ms": 0}
        t0 = time.monotonic()
        out = self._execute(verb, p)
        self._tick("total_ms", t0)
        timing = dict(self.tm)
        log.debug("%s: %s", verb, " ".join(f"{k}={v}" for k, v in timing.items()))
        return {**out, "timing": timing}

    def _remember(self, f: Frame | None, res: dict, thumb: bytes | None) -> None:
        """Keep what this response showed (element sig + thumbnail of the
        screen it describes) as the next input verb's "before"."""
        if f is None:
            self.pre = None
            return
        self.pre = {"at": time.monotonic(), "key": (f.monitor.name, f.rect),
                    "sig": self._sig_of(res), "thumb": thumb}

    def _before(self, f: Frame | None) -> tuple[str | None, bytes | None]:
        """(element sig, thumbnail) of the screen right before an action. The
        last response's, when it is under PRE_REUSE_S old and of this same
        frame: the model acted on that screen, and walking it again costs a
        second tree walk per action. Else a fresh walk and capture."""
        pre, self.pre = self.pre, None
        if (pre is not None and f is not None
                and time.monotonic() - pre["at"] < PRE_REUSE_S
                and pre["key"] == (f.monitor.name, f.rect)):
            return pre["sig"], pre["thumb"] if pre["thumb"] is not None else self._thumb(f)
        sig = self._sig(f)
        return sig, self._thumb(f)

    def _execute(self, verb: str, p: dict) -> dict:
        if verb == "screenshot":
            self.walk = p.get("walk", "front")
            out = self._shot(p.get("monitor"), p.get("region"), p.get("elements", True))
            img = out["image"]
            what = f" zoomed on {out['frame']['region']}" if out["frame"]["region"] else ""
            # a cheap thumbnail now saves the next action a capture before it
            self._remember(self.frame, out, self._thumb(self.frame)
                           if getattr(self.b, "cheap_thumb", False) else None)
            return {"ok": True, "text": f"screenshot {img['w']}x{img['h']}{what}", **out}
        f = self.frame
        # A zoom is a look, not a mode: the coordinates of this action are in
        # the zoomed frame `f`, but what changed and what comes back are the
        # whole monitor `g`.
        g = f
        if f is not None and f.rect:
            g = self.full.get(f.monitor.name) or f
        if verb == "wait":
            before = self._thumb(g)
            changed, ms = self.settle(before, floor=0, ceiling_s=p["timeout_ms"] / 1000,
                                      until_change=p["mode"] == "change", frame=g)
            out = {"ok": True, "text": f"wait {p['mode']}: "
                   f"{'changed' if changed else 'no change'} after {ms} ms",
                   "changed": changed, "settled_ms": ms}
            if changed is None:
                del out["changed"]
            shot = self._auto_shot(g)
            self._remember(self.frame, shot, self.settled_thumb)
            if g is not f:
                out["note"] = ZOOM_ENDED_NOTE
            out.update(shot)
            return out
        sig_before, before = self._before(g)
        typing_before = self._focus() if verb == "type" else None
        if verb in ("move", "click") or (verb == "scroll" and "x" in p):
            self.b.move(*f.to_screen(p["x"], p["y"]))
        if verb == "click":
            self.b.click(p["button"], p["count"])
        elif verb == "drag":
            self.b.drag(*f.to_screen(p["x"], p["y"]), *f.to_screen(p["to_x"], p["to_y"]),
                        p["button"])
        elif verb == "scroll":
            self.b.scroll(p["dx"], p["dy"])
        elif verb == "type":
            self.b.type_text(p["text"])
        elif verb == "key":
            self.b.key(p["combo"])
        elif verb == "open":
            if "url" in p:
                self.b.open_url(p["url"])
            else:
                subprocess.Popen(self.apps[p["app"]], shell=False, start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        changed, ms = self.settle(before, floor=SETTLE_S * (3 if verb == "open" else 1),
                                  frame=g)
        # the post-action comparisons use the SETTLED screen: the auto-shot
        # (taken now) or, without one, a fresh walk
        # The input is already posted: nothing below may turn this into an
        # error that invites the model to repeat it.
        note = None
        try:
            shot = self._auto_shot(g) if p.get("screenshot_after") else None
            if shot is not None and g is not f:
                note = ZOOM_ENDED_NOTE
        except Exception:  # noqa: BLE001
            shot, note = None, SHOT_LOST_NOTE
        settled = self.settled_thumb
        els_changed = None
        try:
            after = shot if shot is not None else self._elements(g) if g is not None else {}
        except Exception:  # noqa: BLE001 — a second signal only
            after = {}
        sig_after = self._sig_of(after)
        if sig_before is not None and sig_after is not None:
            els_changed = sig_after != sig_before
        out = {"ok": True, "text": f"{verb} done", "settled_ms": ms}
        if changed is not None:
            out["pixels_changed"] = changed
        if els_changed is not None:
            out["elements_changed"] = els_changed
        if changed is not None or els_changed is not None:
            out["changed"] = bool(changed) or bool(els_changed)
        changed = out.get("changed")
        if verb == "type":
            why, diff_note = typed_result(p["text"], self._focus(), changed, typing_before)
            note = note or diff_note
            if why:
                if self._secure():
                    why += (" (secure keyboard entry is on in another app, which "
                            "blocks typed keys)")
                out.update(ok=False, err=why)
                if shot is None:                      # the model sees where it went
                    try:
                        shot = self._auto_shot(g)
                        settled = None                # the thumb predates this shot
                    except Exception:  # noqa: BLE001
                        note = note or SHOT_LOST_NOTE
        if note and out.get("ok") is not False:
            out["note"] = note
            out["text"] = f"{out['text']}\nnote: {note}"
        if shot is not None:
            out.update(shot)
            self._remember(self.frame, shot, settled)
        else:
            self._remember(g, after, settled)
        return out

    def _sig(self, frame: Frame | None) -> str | None:
        """elements_sig of what the tree shows in `frame` now; None when there
        is no tree or the walk was partial (a cut list proves nothing)."""
        if frame is None:
            return None
        try:
            return self._sig_of(self._elements(frame))
        except Exception:  # noqa: BLE001 — a second signal only
            return None

    @staticmethod
    def _sig_of(res: dict) -> str | None:
        if res.get("elements_src", "none") == "none" or res.get("elements_note"):
            return None
        return elements_sig(res.get("elements") or [])

    def _focus(self) -> dict | None:
        """The focused element, from the element source; None = cannot tell."""
        try:
            if self.elements is None:
                self.elements = self.b.elements_source()
            return self.elements.focused()
        except Exception:  # noqa: BLE001 — a broken reader never fails the typing
            return None

    def _secure(self) -> bool:
        try:
            return self.b.secure_input()
        except Exception:  # noqa: BLE001
            return False

    def _auto_shot(self, f: Frame | None) -> dict:
        """The screenshot an input verb returns: same monitor, same zoom."""
        if f is None:
            return self._shot()
        return self._shot(f.monitor.name, rect=f.rect, region=f.region)

    async def shell(self, p: dict) -> dict:
        if p["mode"] == "argv":
            exe = find_bin(p["argv"][0]) if "/" not in p["argv"][0] else p["argv"][0]
            if not exe:
                return {"ok": False, "err": f"{p['argv'][0]}: command not found"}
            argv = [exe, *p["argv"][1:]]
        else:
            argv = [os.environ.get("SHELL") or "/bin/sh", "-c", p["cmd"]]
        self.b.notify(f"running: {p['cmd'][:120]}")
        cwd = os.path.expanduser(p.get("cwd") or "~")
        try:
            proc = await asyncio.create_subprocess_exec(
                *argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT, start_new_session=True)
        except OSError as e:
            return {"ok": False, "err": str(e)}
        try:
            out, _ = await asyncio.wait_for(proc.communicate(), p["timeout"])
        except asyncio.TimeoutError:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except OSError:
                pass
            await proc.wait()
            return {"ok": False, "err": f"timed out after {p['timeout']} s"}
        text = out.decode(errors="replace")
        if len(text) > OUTPUT_CAP:
            text = text[:OUTPUT_CAP] + "\n…(cut)"
        return {"ok": proc.returncode == 0,
                "text": f"{text}\n[exit {proc.returncode}]",
                "err": None if proc.returncode == 0 else f"exit {proc.returncode}"}

    async def handle(self, ws, m: dict) -> None:
        rid, verb = m.get("id"), m.get("verb")
        try:
            if paused():
                raise DeskError("paused at the computer (jav3-desk resume)")
            why = self.allowed(verb)
            if why:
                raise DeskError(why)
            p = validate(verb, m.get("params") or {}, self.frame, self.apps, self.deny)
            if verb != "shell":
                st = await asyncio.to_thread(self.state)
                why = screen_refusal(st)
                if why:
                    if st != self.sent_state:          # the server learns it now
                        self.sent_state = st
                        await ws.send(json.dumps({"type": "state", **st}))
                    raise DeskError(why)
            if time.time() - self.last_action > 300:
                self.b.notify("Jav3 is using this computer")
            self.last_action = time.time()
            if verb == "shell":
                if self.shell_busy:
                    raise DeskError("a command is already running")
                self.shell_busy = True
                try:
                    res = await self.shell(p)
                finally:
                    self.shell_busy = False
            elif verb in ("screenshot", "wait"):
                res = await asyncio.to_thread(self.execute, verb, p)
            else:
                async with self.input_lock:
                    res = await asyncio.to_thread(self.execute, verb, p)
        except DeskError as e:
            res = {"ok": False, "err": str(e)}
        except Exception as e:  # noqa: BLE001 — report, never die
            res = {"ok": False, "err": f"{type(e).__name__}: {e}"[:500]}
        await ws.send(json.dumps({"type": "res", "id": rid, **res}))

    async def serve(self) -> str:
        import inspect

        import websockets
        # the token rides the upgrade's Authorization header, never the URL
        hdr = {"Authorization": f"Bearer {self.token}"}
        # websockets >= 14 renamed extra_headers; support both
        key = ("additional_headers" if "additional_headers"
               in inspect.signature(websockets.connect).parameters else "extra_headers")
        conn = websockets.connect(ws_url(self.address), max_size=1 << 20,
                                  ping_interval=None, user_agent_header=USER_AGENT,
                                  **{key: hdr})
        async with conn as ws:
            await ws.send(json.dumps(self.hello()))
            pinger = asyncio.create_task(self._ping(ws))
            watcher = asyncio.create_task(self._watch_state(ws))
            try:
                async for raw in ws:
                    try:
                        m = json.loads(raw)
                    except ValueError:
                        continue
                    t = m.get("type") if isinstance(m, dict) else None
                    if t == "grants":
                        self.grants = {k: m.get(k) for k in ("screen", "input", "shell")}
                    elif t == "req":
                        task = asyncio.create_task(self.handle(ws, m))
                        self.inflight.add(task)
                        task.add_done_callback(self.inflight.discard)
                    elif t == "kill":
                        for task in list(self.inflight):
                            task.cancel()
                        self.grants = {"screen": False, "input": False, "shell": "off"}
                        return "killed: " + str(m.get("reason") or "")
            finally:
                pinger.cancel()
                watcher.cancel()
        return "closed"

    async def _watch_state(self, ws) -> None:
        """C->S state {locked, asleep} whenever it changes, so the server can
        refuse a screenshot before asking for one."""
        while True:
            await asyncio.sleep(STATE_POLL_S)
            st = await asyncio.to_thread(self.state)
            if st != self.sent_state:
                self.sent_state = st
                await ws.send(json.dumps({"type": "state", **st}))

    async def _ping(self, ws) -> None:
        while True:
            await asyncio.sleep(PING_S)
            if paused():
                await ws.close()
                return
            c = ceiling()
            if c != self.sent_ceiling:
                self.sent_ceiling = c
                await ws.send(json.dumps({"type": "ceiling", "ceiling": c}))
            await ws.send(json.dumps({"type": "ping"}))


def cmd_run(args) -> int:
    import importlib.util
    if importlib.util.find_spec("websockets") is None:
        raise DeskError("jav3-desk needs websockets: install python-websockets "
                        "(Arch) / python3-websockets (Debian) or pip install websockets")
    creds = load_credentials()
    if not creds:
        raise DeskError("not logged in — run: jav3-desk login")
    # JAV3_DESK_DEBUG=1: per-request phase timings (capture, settle, elements)
    logging.basicConfig(level=logging.DEBUG if os.environ.get("JAV3_DESK_DEBUG")
                        else logging.WARNING, format="jav3-desk: %(message)s")
    b = BACKENDS[args.backend or detect_backend()]()
    _write_private("desk.pid", str(os.getpid()).encode())
    print(f"jav3-desk: {b.name} backend, server {base_url(args.server or creds['address'])}",
          flush=True)

    async def loop():
        delay = 2
        while True:
            if paused():
                await asyncio.sleep(5)
                continue
            s = Session(b, args.server or creds["address"], creds["token"])
            try:
                why = await s.serve()
                delay = 2
            except Exception as e:  # noqa: BLE001 — reconnect forever, loudly
                why = f"{type(e).__name__}: {e}"
                if "HTTP 403" in why:
                    # refused before the upgrade: revoked, expired, or not a
                    # desk token. Keep trying, slowly — a new login fixes it.
                    why += " — the token was refused; run jav3-desk login"
                    delay = 300
            print(f"jav3-desk: connection ended ({why}); retrying in {delay} s", flush=True)
            await asyncio.sleep(delay)
            delay = min(delay * 2, 60)
    try:
        return asyncio.run(loop()) or 0
    except KeyboardInterrupt:
        return 130


