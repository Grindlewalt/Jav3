        _path("desk-shell").unlink()
    except FileNotFoundError:
        pass
    print("shell is off at this computer.")
    return 0


def cmd_panic(args) -> int:
    """Stop now: flag paused (a restarted service stays idle), stop the
    service, kill a foreground `run`. Needs `jav3-desk resume` to undo."""
    _write_private("desk.paused", b"panic\n")
    if sys.platform == "darwin":
        subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{LABEL}"],
                       capture_output=True, shell=False)
    elif find_bin("systemctl"):
        subprocess.run([find_bin("systemctl"), "--user", "stop", UNIT_NAME],
                       capture_output=True, shell=False)
    try:
        pid = int(_path("desk.pid").read_text().strip())
        if pid != os.getpid():
            os.kill(pid, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    print("jav3-desk stopped and paused. `jav3-desk resume` to allow it again.")
    return 0


def cmd_resume(args) -> int:
    try:
        _path("desk.paused").unlink()
    except FileNotFoundError:
        pass
    print("resumed. Start it again with `jav3-desk run` or your service manager.")
    return 0


def cmd_status(args) -> int:
    creds = load_credentials()
    print(f"server:  {base_url(creds['address']) if creds else '(not logged in)'}")
    try:
        print(f"backend: {args.backend or detect_backend()}")
    except DeskError as e:
        print(f"backend: {e}")
    print(f"shell:   {'allowed' if shell_allowed() else 'off'} at this computer")
    print(f"paused:  {'yes' if paused() else 'no'}")
    try:
        st = BACKENDS[args.backend or detect_backend()]().screen_state()
        lk = st.get("locked")
        print(f"screen:  {'unknown' if lk is None else 'locked' if lk else 'unlocked'}, display "
              f"{'asleep' if st.get('asleep') else 'awake'}")
    except Exception as e:  # noqa: BLE001 — status reports, never dies
        print(f"screen:  unknown ({e})")
    over = apps_override()
    if over is not None and over[1]:
        print(f"apps:    desk-apps.json entries not offered (a terminal or script runner is "
              f"shell by other means): {', '.join(over[1])}")
    if sys.platform == "darwin":
        print(f"grant Accessibility + Screen Recording to: {sys.executable}")
    return 0


# --- service definitions ------------------------------------------------------------------------------

def systemd_unit(script: Path) -> str:
    return f"""\
[Unit]
Description=jav3-desk (Jav3 computer use)
After=graphical-session.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# no secrets here: a unit file is world-readable; the token is in
# ~/.config/jav3/desk.json (0600)
ExecStart={sys.executable} {script} run
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
"""


def launchd_plist(script: Path) -> bytes:
    logs = Path.home() / "Library" / "Logs"
    return plistlib.dumps({
        "Label": LABEL, "ProgramArguments": [sys.executable, str(script), "run"],
        "RunAtLoad": True, "KeepAlive": True, "ThrottleInterval": 5,
        "ProcessType": "Interactive",
        "StandardOutPath": str(logs / "jav3-desk.log"),
        "StandardErrorPath": str(logs / "jav3-desk.err.log")})


def service_path(plat=sys.platform) -> Path:
    if plat == "darwin":
        return Path.home() / "Library" / "LaunchAgents" / f"{LABEL}.plist"
    return (Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
            / "systemd" / "user" / UNIT_NAME)


def cmd_install(args) -> int:
    script = Path(__file__).resolve()
    target = service_path()
    target.parent.mkdir(parents=True, exist_ok=True)
    if sys.platform == "darwin":
        target.write_bytes(launchd_plist(script))
        steps = [f"launchctl bootstrap gui/{os.getuid()} {target}",
                 f"# then grant Accessibility + Screen Recording to {sys.executable}",
                 "# (System Settings → Privacy & Security) and restart the agent:",
                 f"launchctl kickstart -k gui/{os.getuid()}/{LABEL}"]
    else:
        target.write_text(systemd_unit(script))
        steps = ["systemctl --user import-environment WAYLAND_DISPLAY DISPLAY "
                 "XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK",
                 "systemctl --user daemon-reload",
                 f"systemctl --user enable --now {UNIT_NAME}",
                 f"# logs: journalctl --user -u {UNIT_NAME} -f",
                 "# panic key, e.g. Hyprland: bind = SUPER SHIFT, Escape, exec, "
                 f"{script} panic"]
    print(f"wrote {target}\nnext:\n  " + "\n  ".join(steps))
    return 0


def cmd_uninstall(args) -> int:
    target = service_path()
    if target.exists():
        target.unlink()
        print(f"removed {target}")
    print("stop it with: " + (f"launchctl bootout gui/{os.getuid()}/{LABEL}"
                              if sys.platform == "darwin"
                              else f"systemctl --user disable --now {UNIT_NAME}"))
    return 0


# --- main ------------------------------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="jav3-desk",
                                description="Let a Jav3 server use this computer.")
    p.add_argument("--server", help="server address, overriding the saved one")
    p.add_argument("--backend", choices=sorted(BACKENDS))
    sub = p.add_subparsers(dest="cmd", required=True)
    for name, help_ in (("login", "log in with the line from Settings → Add computer"),
                        ("run", "connect and serve"),
                        ("install", "write the systemd --user unit / launchd agent"),
                        ("uninstall", "remove it"),
                        ("allow-shell", "allow shell commands at this computer"),
                        ("deny-shell", "turn shell off at this computer"),
                        ("panic", "stop now and stay stopped until resume"),
                        ("resume", "undo panic"),
                        ("status", "show what this computer allows")):
        sub.add_parser(name, help=help_)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    cmds = {"login": cmd_login, "run": cmd_run, "install": cmd_install,
            "uninstall": cmd_uninstall, "allow-shell": cmd_allow_shell,
            "deny-shell": cmd_deny_shell, "panic": cmd_panic, "resume": cmd_resume,
            "status": cmd_status}
    try:
        return cmds[args.cmd](args)
    except DeskError as e:
        print(f"jav3-desk: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
