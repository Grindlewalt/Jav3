class Session:
    def __init__(self, backend: Backend, address: str, token: str):
        self.b = backend
        self.address, self.token = address, token
        self.frame: Frame | None = None
        self.grants = {"screen": False, "input": False, "shell": "off"}
        self.apps = local_apps()
        self.deny = backend.deny_keys()
        self.input_lock = asyncio.Lock()
        self.shell_busy = False
        self.last_action = 0.0
        self.sent_ceiling = ceiling()
        self.inflight: set[asyncio.Task] = set()

    def hello(self) -> dict:
        try:
            mons = [m.__dict__ for m in self.b.monitors()]
        except Exception:  # noqa: BLE001 — hello must not die on a probe
            mons = []
        return {"type": "hello", "v": PROTOCOL_V, "host": socket.gethostname(),
                "platform": sys.platform, "session": self.b.session,
                "backend": self.b.name, "monitors": mons,
                "apps": sorted(self.apps), "ceiling": ceiling()}

    def allowed(self, verb: str) -> str | None:
        cap = {"screenshot": "screen", "shell": "shell"}.get(verb, "input")
        c = ceiling()
        g = self.grants.get(cap)
        if cap == "shell":
            if not c["shell"]:
                return "shell is off at this computer (jav3-desk allow-shell)"
            if g not in ("ask", "trusted"):
                return "shell is not granted"
        elif not g:
            return f"{cap} is not granted"
        return None

    def _shot(self, monitor: str | None = None) -> dict:
        ms = self.b.monitors()
        mon = ms[0]
        if monitor is not None:
            pick = [m for i, m in enumerate(ms) if m.name == monitor or str(i) == monitor]
            if not pick:
                raise DeskError(f"no monitor {monitor!r} (have: "
                                f"{', '.join(m.name for m in ms)})")
            mon = pick[0]
        data = self.b.screenshot(mon)
        size = image_size(data)
        if size is None:
            raise DeskError("the screenshot tool returned something that is not an image")
        self.frame = Frame(mon, *size)
        mime = "image/png" if data[:4] == b"\x89PNG" else "image/jpeg"
        return {"mime": mime, "w": size[0], "h": size[1],
                "b64": base64.b64encode(data).decode()}

    def execute(self, verb: str, p: dict) -> dict:
        """Blocking: runs in a worker thread."""
        if verb == "screenshot":
            img = self._shot(p.get("monitor"))
            return {"ok": True, "text": f"screenshot {img['w']}x{img['h']}", "image": img}
        f = self.frame
        if verb in ("move", "click") or (verb == "scroll" and "x" in p):
            self.b.move(*f.to_screen(p["x"], p["y"]))
        if verb == "click":
            self.b.click(p["button"], p["count"])
        elif verb == "scroll":
            self.b.scroll(p["dx"], p["dy"])
        elif verb == "type":
            self.b.type_text(p["text"])
        elif verb == "key":
            self.b.key(p["combo"])
        elif verb == "open":
            if "url" in p:
                self.b.open_url(p["url"])
            else:
                subprocess.Popen(self.apps[p["app"]], shell=False, start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        out = {"ok": True, "text": f"{verb} done"}
        if p.get("screenshot_after"):
            time.sleep(SETTLE_S * (3 if verb == "open" else 1))
            out["image"] = self._shot(self.frame.monitor.name if self.frame else None)
        return out

    async def shell(self, p: dict) -> dict:
        if p["mode"] == "argv":
            exe = find_bin(p["argv"][0]) if "/" not in p["argv"][0] else p["argv"][0]
            if not exe:
                return {"ok": False, "err": f"{p['argv'][0]}: command not found"}
            argv = [exe, *p["argv"][1:]]
        else:
            argv = [os.environ.get("SHELL") or "/bin/sh", "-c", p["cmd"]]
        self.b.notify(f"running: {p['cmd'][:120]}")
        cwd = os.path.expanduser(p.get("cwd") or "~")
        try:
            proc = await asyncio.create_subprocess_exec(
                *argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT, start_new_session=True)
        except OSError as e:
            return {"ok": False, "err": str(e)}
        try:
            out, _ = await asyncio.wait_for(proc.communicate(), p["timeout"])
        except asyncio.TimeoutError:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except OSError:
                pass
            await proc.wait()
            return {"ok": False, "err": f"timed out after {p['timeout']} s"}
        text = out.decode(errors="replace")
        if len(text) > OUTPUT_CAP:
            text = text[:OUTPUT_CAP] + "\n…(cut)"
        return {"ok": proc.returncode == 0,
                "text": f"{text}\n[exit {proc.returncode}]",
                "err": None if proc.returncode == 0 else f"exit {proc.returncode}"}

    async def handle(self, ws, m: dict) -> None:
        rid, verb = m.get("id"), m.get("verb")
        try:
            if paused():
                raise DeskError("paused at the computer (jav3-desk resume)")
            why = self.allowed(verb)
            if why:
                raise DeskError(why)
            p = validate(verb, m.get("params") or {}, self.frame, self.apps, self.deny)
            if time.time() - self.last_action > 300:
                self.b.notify("Jav3 is using this computer")
            self.last_action = time.time()
            if verb == "shell":
                if self.shell_busy:
                    raise DeskError("a command is already running")
                self.shell_busy = True
                try:
                    res = await self.shell(p)
                finally:
                    self.shell_busy = False
            elif verb == "screenshot":
                res = await asyncio.to_thread(self.execute, verb, p)
            else:
                async with self.input_lock:
                    res = await asyncio.to_thread(self.execute, verb, p)
        except DeskError as e:
            res = {"ok": False, "err": str(e)}
        except Exception as e:  # noqa: BLE001 — report, never die
            res = {"ok": False, "err": f"{type(e).__name__}: {e}"[:500]}
        await ws.send(json.dumps({"type": "res", "id": rid, **res}))

    async def serve(self) -> str:
        import inspect

        import websockets
        # the token rides the upgrade's Authorization header, never the URL
        hdr = {"Authorization": f"Bearer {self.token}"}
        # websockets >= 14 renamed extra_headers; support both
        key = ("additional_headers" if "additional_headers"
               in inspect.signature(websockets.connect).parameters else "extra_headers")
        conn = websockets.connect(ws_url(self.address), max_size=1 << 20,
                                  ping_interval=None, user_agent_header=USER_AGENT,
                                  **{key: hdr})
        async with conn as ws:
            await ws.send(json.dumps(self.hello()))
            pinger = asyncio.create_task(self._ping(ws))
            try:
                async for raw in ws:
                    try:
                        m = json.loads(raw)
                    except ValueError:
                        continue
                    t = m.get("type") if isinstance(m, dict) else None
                    if t == "grants":
                        self.grants = {k: m.get(k) for k in ("screen", "input", "shell")}
                    elif t == "req":
                        task = asyncio.create_task(self.handle(ws, m))
                        self.inflight.add(task)
                        task.add_done_callback(self.inflight.discard)
                    elif t == "kill":
                        for task in list(self.inflight):
                            task.cancel()
                        self.grants = {"screen": False, "input": False, "shell": "off"}
                        return "killed: " + str(m.get("reason") or "")
            finally:
                pinger.cancel()
        return "closed"

    async def _ping(self, ws) -> None:
        while True:
            await asyncio.sleep(PING_S)
            if paused():
                await ws.close()
                return
            c = ceiling()
            if c != self.sent_ceiling:
                self.sent_ceiling = c
                await ws.send(json.dumps({"type": "ceiling", "ceiling": c}))
            await ws.send(json.dumps({"type": "ping"}))


def cmd_run(args) -> int:
    try:
        import websockets  # noqa: F401
    except ImportError:
        raise DeskError("jav3-desk needs websockets: install python-websockets "
                        "(Arch) / python3-websockets (Debian) or pip install websockets")
    creds = load_credentials()
    if not creds:
        raise DeskError("not logged in — run: jav3-desk login")
    b = BACKENDS[args.backend or detect_backend()]()
    _write_private("desk.pid", str(os.getpid()).encode())
    print(f"jav3-desk: {b.name} backend, server {base_url(args.server or creds['address'])}",
          flush=True)

    async def loop():
        delay = 2
        while True:
            if paused():
                await asyncio.sleep(5)
                continue
            s = Session(b, args.server or creds["address"], creds["token"])
            try:
                why = await s.serve()
                delay = 2
            except Exception as e:  # noqa: BLE001 — reconnect forever, loudly
                why = f"{type(e).__name__}: {e}"
                if "HTTP 403" in why:
                    # refused before the upgrade: revoked, expired, or not a
                    # desk token. Keep trying, slowly — a new login fixes it.
                    why += " — the token was refused; run jav3-desk login"
                    delay = 300
            print(f"jav3-desk: connection ended ({why}); retrying in {delay} s", flush=True)
            await asyncio.sleep(delay)
            delay = min(delay * 2, 60)
    try:
        return asyncio.run(loop()) or 0
    except KeyboardInterrupt:
        return 130


# --- local switches ----------------------------------------------------------------------------------

def cmd_allow_shell(args) -> int:
    _write_private("desk-shell", b"allowed at the keyboard\n")
    print("shell allowed at this computer. The server still needs Shell turned on "
          "in Settings, and asks you there for anything off the allowlist.")
    return 0


def cmd_deny_shell(args) -> int:
    try:
        _path("desk-shell").unlink()
    except FileNotFoundError:
        pass
    print("shell is off at this computer.")
    return 0


def cmd_panic(args) -> int:
    """Stop now: flag paused (a restarted service stays idle), stop the
    service, kill a foreground `run`. Needs `jav3-desk resume` to undo."""
    _write_private("desk.paused", b"panic\n")
    if sys.platform == "darwin":
        subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{LABEL}"],
                       capture_output=True, shell=False)
    elif find_bin("systemctl"):
        subprocess.run([find_bin("systemctl"), "--user", "stop", UNIT_NAME],
                       capture_output=True, shell=False)
    try:
        pid = int(_path("desk.pid").read_text().strip())
        if pid != os.getpid():
            os.kill(pid, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    print("jav3-desk stopped and paused. `jav3-desk resume` to allow it again.")
    return 0


def cmd_resume(args) -> int:
    try:
        _path("desk.paused").unlink()
    except FileNotFoundError:
        pass
    print("resumed. Start it again with `jav3-desk run` or your service manager.")
    return 0


def cmd_status(args) -> int:
    creds = load_credentials()
    print(f"server:  {base_url(creds['address']) if creds else '(not logged in)'}")
    try:
        print(f"backend: {args.backend or detect_backend()}")
    except DeskError as e:
        print(f"backend: {e}")
    print(f"shell:   {'allowed' if shell_allowed() else 'off'} at this computer")
    print(f"paused:  {'yes' if paused() else 'no'}")
    if sys.platform == "darwin":
        print(f"grant Accessibility + Screen Recording to: {sys.executable}")
    return 0


# --- service definitions ------------------------------------------------------------------------------

def systemd_unit(script: Path) -> str:
    return f"""\
[Unit]
Description=jav3-desk (Jav3 computer use)
After=graphical-session.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# no secrets here: a unit file is world-readable; the token is in
# ~/.config/jav3/desk.json (0600)
ExecStart={sys.executable} {script} run
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
"""


def launchd_plist(script: Path) -> bytes:
    logs = Path.home() / "Library" / "Logs"
    return plistlib.dumps({
        "Label": LABEL, "ProgramArguments": [sys.executable, str(script), "run"],
        "RunAtLoad": True, "KeepAlive": True, "ThrottleInterval": 5,
        "ProcessType": "Interactive",
        "StandardOutPath": str(logs / "jav3-desk.log"),
        "StandardErrorPath": str(logs / "jav3-desk.err.log")})


def service_path(plat=sys.platform) -> Path:
    if plat == "darwin":
        return Path.home() / "Library" / "LaunchAgents" / f"{LABEL}.plist"
    return (Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
            / "systemd" / "user" / UNIT_NAME)


def cmd_install(args) -> int:
    script = Path(__file__).resolve()
    target = service_path()
    target.parent.mkdir(parents=True, exist_ok=True)
    if sys.platform == "darwin":
        target.write_bytes(launchd_plist(script))
        steps = [f"launchctl bootstrap gui/{os.getuid()} {target}",
                 f"# then grant Accessibility + Screen Recording to {sys.executable}",
                 "# (System Settings → Privacy & Security) and restart the agent:",
                 f"launchctl kickstart -k gui/{os.getuid()}/{LABEL}"]
    else:
        target.write_text(systemd_unit(script))
        steps = ["systemctl --user import-environment WAYLAND_DISPLAY DISPLAY "
                 "XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK",
                 "systemctl --user daemon-reload",
                 f"systemctl --user enable --now {UNIT_NAME}",
                 f"# logs: journalctl --user -u {UNIT_NAME} -f",
                 "# panic key, e.g. Hyprland: bind = SUPER SHIFT, Escape, exec, "
                 f"{script} panic"]
    print(f"wrote {target}\nnext:\n  " + "\n  ".join(steps))
    return 0


def cmd_uninstall(args) -> int:
    target = service_path()
    if target.exists():
        target.unlink()
        print(f"removed {target}")
    print("stop it with: " + (f"launchctl bootout gui/{os.getuid()}/{LABEL}"
                              if sys.platform == "darwin"
                              else f"systemctl --user disable --now {UNIT_NAME}"))
    return 0


# --- main ------------------------------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="jav3-desk",
                                description="Let a Jav3 server use this computer.")
    p.add_argument("--server", help="server address, overriding the saved one")
    p.add_argument("--backend", choices=sorted(BACKENDS))
    sub = p.add_subparsers(dest="cmd", required=True)
    for name, help_ in (("login", "log in with the line from Settings → Add computer"),
                        ("run", "connect and serve"),
                        ("install", "write the systemd --user unit / launchd agent"),
                        ("uninstall", "remove it"),
                        ("allow-shell", "allow shell commands at this computer"),
                        ("deny-shell", "turn shell off at this computer"),
                        ("panic", "stop now and stay stopped until resume"),
                        ("resume", "undo panic"),
                        ("status", "show what this computer allows")):
        sub.add_parser(name, help=help_)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    cmds = {"login": cmd_login, "run": cmd_run, "install": cmd_install,
            "uninstall": cmd_uninstall, "allow-shell": cmd_allow_shell,
            "deny-shell": cmd_deny_shell, "panic": cmd_panic, "resume": cmd_resume,
            "status": cmd_status}
    try:
        return cmds[args.cmd](args)
    except DeskError as e:
        print(f"jav3-desk: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
