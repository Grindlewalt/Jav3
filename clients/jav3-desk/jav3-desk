USER_AGENT = "jav3-desk/1"
PROTOCOL_V = 1
PROMPT = "Paste the line from Settings → Add computer: "
LONG_EDGE = 1280          # screenshots are downscaled to this long edge
SETTLE_S = 0.3            # settle floor after an input action (A.4 minimum)
SETTLE_MAX_S = 3.0        # settle ceiling: a clock or a video never "settles"
SETTLE_POLL_S = 0.08      # between thumbnails while settling
