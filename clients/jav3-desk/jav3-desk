def detect_backend(env=os.environ, plat=sys.platform) -> str:
    if plat == "darwin":
        return "macos"
    if env.get("WAYLAND_DISPLAY"):
        if env.get("HYPRLAND_INSTANCE_SIGNATURE"):
            return "hyprland"
        if env.get("SWAYSOCK"):
            return "sway"
        raise DeskError("this Wayland session is not Hyprland or Sway; GNOME/KDE "
                        "need the portal backend (not built yet, M2)")
    if env.get("DISPLAY"):
        return "x11"
    raise DeskError("no graphical session found (no WAYLAND_DISPLAY or DISPLAY); "
                    "for the service run: systemctl --user import-environment "
                    "WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK")


def local_apps(plat=sys.platform) -> dict[str, list[str]]:
    """name -> argv for desk_open app=. From desk-apps.json if present, else
    the browsers/editors found here. A terminal is deliberately not offered
    by default: opening one and typing into it would be shell by other means."""
    try:
        raw = json.loads(_path("desk-apps.json").read_text())
        return {k: v for k, v in raw.items()
                if isinstance(k, str) and re.fullmatch(r"[A-Za-z0-9 ._+-]{1,64}", k)
                and isinstance(v, list) and v and all(isinstance(a, str) for a in v)}
    except (OSError, ValueError, AttributeError):
        pass
    if plat == "darwin":
        return {n: ["/usr/bin/open", "-a", n] for n in ("Safari", "Finder", "Notes")}
    apps = {}
    for n in ("firefox", "chromium", "google-chrome", "code", "nautilus", "thunar"):
        p = find_bin(n)
        if p:
            apps[n] = [p]
    return apps


