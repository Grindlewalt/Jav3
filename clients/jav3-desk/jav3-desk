def ax_role(role: str | None, subrole: str | None) -> str:
    return AX_SUBROLES.get(subrole or "") or AX_ROLES.get(role or "", "")


def atspi_role(name: str | None, *, editable: bool = False, selectable: bool = False) -> str:
    """AT-SPI role name -> ours. A `text` is a field only when editable; a
    table cell counts only when selectable (the cheap stand-in for "has an
    action" — asking the Action interface per cell costs a round trip)."""
    r = ATSPI_ROLES.get((name or "").lower(), "")
    if r == "text" and (name or "").lower() == "text" and editable:
        return "textfield"
    if r == "cell" and not selectable:
        return ""
    return r


def _intersects(a: tuple, b: tuple) -> bool:
    return a[0] < b[0] + b[2] and b[0] < a[0] + a[2] and a[1] < b[1] + b[3] \
        and b[1] < a[1] + a[3]


# roles a background window may show (its buttons and fields; never list rows)
BG_ROLES = ("button", "textfield", "combobox", "checkbox", "radio", "toggle", "tab", "link")
BG_SHOWN = 8              # a background window lists at most this many elements
BG_NODES = 400            # ...and its walk visits at most this many nodes
BG_TIME_S = 0.15          # ...within this long (a sluggish background app, System
                          # Settings at 150-250 ms a node, must not eat the budget)


def _contains(outer: tuple | None, inner: tuple | None) -> bool:
    return bool(outer and inner and inner[2] > 0 and inner[3] > 0
                and outer[0] <= inner[0] and outer[1] <= inner[1]
                and inner[0] + inner[2] <= outer[0] + outer[2]
                and inner[1] + inner[3] <= outer[1] + outer[3])


def walk_tree(roots, read, clip: tuple, deadline: float, *,
              max_depth: int = ELEMENTS_DEPTH, cap: int = ELEMENTS_CAP,
              groups: list | None = None, name_roots: bool = False,
              kinds: list | None = None, windows: dict | None = None
              ) -> tuple[list[dict], bool]:
    """Depth-first over an accessibility tree, source-agnostic: `read(node)`
    returns {role (already ours, "" = structural, "text" = static text or a
    named image), label, value, focused, enabled, box: (x, y, w, h) global
    or None, children: [...], hidden: bool}. Returns (raw elements in
    global coordinates, partial). A subtree whose box is off `clip` is
    skipped; static text becomes the label of the nearest unlabeled control
    above it (within 3 levels) and is never listed itself. Stops at the
    deadline or the cap with partial=True.

    Every element carries the `window` it belongs to (the group its root
    names): `groups[i]` for root i when given, else the root's own
    info["window"], else (name_roots) its label; no group, no key.

    `kinds[i]` is "front" (the frontmost
    app's windows), "menu" (its menu bar) or "background". Front and menu
    roots (and roots of no kind) are walked in full. A background window
    whose box lies inside the first front window's is covered and
    contributes nothing; any other lists at most BG_SHOWN of its buttons
    and fields (no rows) from a walk of at most BG_NODES nodes and BG_TIME_S
    seconds. `windows`,
    when given, receives per background group {"shown", "total", "more"}:
    how many it lists of how many the full walk would have (a lower bound
    when `more`: the node or time cap cut it)."""
    out: list[dict] = []
    seen: set = set()
    roots = list(roots)
    names = list(groups or []) + [None] * len(roots)
    kinds = list(kinds or []) + [None] * len(roots)
    front_box = None
    above: list[tuple] = []     # boxes of the windows walked before this one
    for i, root in enumerate(roots):
        if time.monotonic() > deadline or len(out) >= cap:
            return out, True
        try:
            info = read(root)
        except Exception:  # noqa: BLE001 — one dead window must not end the walk
            continue
        if not info or info.get("hidden"):
            continue
        group = names[i] or info.get("window") or (
            (info.get("label") or "window") if name_roots else None)
        kind = kinds[i]
        if kind == "front" and front_box is None:
            front_box = info.get("box")
        bg = kind == "background"
        if bg and _contains(front_box, info.get("box")):
            continue
        st = {"shown": 0, "total": 0, "more": False}
        partial = _walk_one(info, read, clip, deadline, out, seen, group,
                            max_depth, cap, st if bg else None,
                            above if kind in ("front", "background") else None)
        if kind in ("front", "background") and info.get("box"):
            above.append(tuple(info["box"]))
        if bg and windows is not None and st["total"]:
            w = windows.setdefault(str(group or "")[:80],
                                   {"shown": 0, "total": 0, "more": False})
            w["shown"] += st["shown"]
            w["total"] += st["total"]
            w["more"] = w["more"] or st["more"]
        if partial:
            return out, True
    return out, False


def _walk_one(info: dict, read, clip, deadline, out: list, seen: set, group,
              max_depth: int, cap: int, bg: dict | None,
              above: list | None = None) -> bool:
    """One root (already read) into `out`; True when the deadline or the cap
    cut it. `bg` (a background window's counters) limits what is kept.
    `above` are the boxes of windows in front of this one: a control whose
    centre lies under one of them cannot be clicked and is not listed."""
    stack = [(None, 0, None, 0)]
    nodes = 0
    until = time.monotonic() + BG_TIME_S
    while stack:
        if time.monotonic() > deadline or len(out) >= cap:
            return True
        node, depth, owner, owner_depth = stack.pop()
        if node is not None:
            if bg is not None and (nodes >= BG_NODES or time.monotonic() > until):
                bg["more"] = True
                return False
            try:
                info = read(node)
            except Exception:  # noqa: BLE001 — one dead node must not end the walk
                continue
            if not info or info.get("hidden"):
                continue
        nodes += 1
        box = info.get("box")
        if box and box[2] > 0 and box[3] > 0 and not _intersects(box, clip):
            continue
        role = info.get("role") or ""
        if role == "text":
            t = (info.get("label") or "").strip()
            if owner is not None and t and not out[owner]["label"] \
                    and depth - owner_depth <= 3:
                out[owner]["label"] = t[:200]
            continue
        if role in ROLES and box and box[2] > 0 and box[3] > 0:
            key = (role, tuple(round(v) for v in box))
            label = (info.get("label") or "").strip()[:200]
            cx, cy = box[0] + box[2] / 2, box[1] + box[3] / 2
            if above and any(a[0] <= cx < a[0] + a[2] and a[1] <= cy < a[1] + a[3]
                             for a in above):
                pass        # under a window in front: not reachable
            elif key not in seen:
                seen.add(key)
                keep = True
                if bg is not None:
                    if label or role not in _NEEDS_LABEL:
                        bg["total"] += 1
                    keep = role in BG_ROLES and bg["shown"] < BG_SHOWN
                    bg["shown"] += keep
                if keep:
                    el = {"role": role, "label": label, "box": box}
                    v = info.get("value")
                    if v not in (None, "") and str(v) != label:
                        el["value"] = str(v)[:200]
                    if info.get("focused"):
                        el["focused"] = True
                    if info.get("enabled") is False:
                        el["enabled"] = False
                    if group:
                        el["window"] = str(group)[:80]
                    out.append(el)
                    if not label:
                        owner, owner_depth = len(out) - 1, depth
        if depth < max_depth:
            for c in reversed(list(info.get("children") or ())):
                stack.append((c, depth + 1, owner, owner_depth))
    return False


def elements_sig(els: list[dict]) -> str:
    """What the element list says, independent of order and position: the
    count and the multiset of (role, label). Two frames with the same sig
    show the same controls."""
    h = hashlib.sha256(str(len(els)).encode())
    for k in sorted(f"{e.get('role')}\x1f{e.get('label')}" for e in els):
        h.update(b"\x1e" + k.encode(errors="replace"))
    return h.hexdigest()[:16]


def build_elements(raw: list[dict], frame: Frame, src: str) -> list[dict]:
    """Global boxes -> image-pixel boxes of THIS image (crop + scale), clipped;
    elements outside dropped; unlabeled rows dropped; ids 1..N global,
    grouped by window (the menu bar first, then windows in the order the
    source listed them: front to back), in reading order within a group
    (rows of ROW_PX image px, then x)."""
    out = []
    for e in raw:
        if not e["label"] and e["role"] in _NEEDS_LABEL:
            continue
        b = frame.box_to_image(*e["box"])
        if b is None:
            continue
        el = {"role": e["role"], "label": e["label"], "x": b[0], "y": b[1],
              "w": b[2], "h": b[3], "src": src}
        for k in ("value", "focused", "enabled", "window"):
            if k in e:
                el[k] = e[k]
        out.append(el)
    rank: dict = {MENU_BAR: -1}
    for e in out:
        rank.setdefault(e.get("window"), len(rank))
    out.sort(key=lambda e: (rank[e.get("window")], e["y"] // ROW_PX, e["x"], e["y"]))
    return [{"id": i, **e} for i, e in enumerate(out[:ELEMENTS_CAP], 1)]


class ElementSource:
    """Where the element list comes from. `collect(clip, deadline)` returns
    (raw elements in global input coordinates, partial); `unavailable()`
    is the honest reason there are none, or None."""
    src = "none"

    def __init__(self, note: str = "not supported on this backend"):
        self.note = note

    def unavailable(self) -> str | None:
        return self.note

    def collect(self, clip: tuple, deadline: float, walk: str = "front",
                windows: dict | None = None) -> tuple[list[dict], bool]:
        """`walk` "front" caps background windows (walk_tree's kinds), "all"
        walks every window in full; `windows` receives the background
        groups' {"shown", "total", "more"}."""
        return [], False

    def focused(self) -> dict | None:
        """The element with keyboard focus: {role (ours), label, value (str or
        None), selected, secure, truncated}; {} when nothing has focus; None
        when this source cannot tell (then typing is not read back)."""
        return None


class FakeElementSource(ElementSource):
    """Tests: a recorded tree of dicts ({role, label, box, children, ...},
    roles already ours) walked by the real walker; `focus` is what
    focused() answers (a dict, {} or None, or a callable returning one)."""

    def __init__(self, roots: list[dict], src: str = "ax", note: str | None = None,
                 focus=None):
        super().__init__(note or "")
        self.roots, self.src, self.focus = roots, src, focus

    def focused(self):
        return self.focus() if callable(self.focus) else self.focus

    def unavailable(self):
        return self.note or None

    def collect(self, clip, deadline, walk="front", windows=None):
        kinds = None if walk == "all" else [r.get("kind") for r in self.roots]
        return walk_tree(self.roots, lambda n: n, clip, deadline, kinds=kinds,
                         windows=windows)


TYPED_TAIL = 40           # read-back compares at most this many trailing characters


ZOOM_ENDED_NOTE = ("the zoom ended: this is the whole screen again (a zoom is a look "
                   "at the last screenshot, not a mode)")
SHOT_LOST_NOTE = ("the action was sent but the screen could not be captured afterwards — "
                  "take desk_screenshot before repeating it")
TYPED_DIFF_NOTE = ("typed; the field now reads differently from what was typed "
                   "(autocomplete or formatting?) — check the screenshot before retyping")


def _fold(s: str) -> str:
    """Comparable form of field text: NFKC, case-folded, whitespace collapsed."""
    return " ".join(unicodedata.normalize("NFKC", s).split()).casefold()


def _field_text(focus: dict) -> str:
    value, sel = focus.get("value"), focus.get("selected")
    return _fold(f"{value if isinstance(value, str) else ''} "
                 f"{sel if isinstance(sel, str) else ''}")


def typed_result(text: str, focus: dict | None, changed: bool | None = None,
                 before: dict | None = None) -> tuple[str | None, str | None]:
    """Did `text` land in the focused field? (error, note). (None, None) = yes,
    or cannot tell (no reader, a secure field, a newline/tab that may have
    submitted or moved focus, a value too long to read). The text was typed
    whatever this says, so the error is only for "it visibly went nowhere":
    the field's value did not change and the screen did not change. A field
    that changed but does not hold the text (autocomplete, reformatting,
    masking, auto-capitalise) is a note, not an error: an error invites a
    retype, and the text would land twice. `before` is the focused element
    before typing; without it a value lacking the text stays an error.
    Never quotes the field's value — only its role and label."""
    if focus is None or any(c in text for c in "\n\r\t"):
        return None, None
    want = _fold(text)
    if not want:
        return None, None
    if not focus:
        if changed is True:
            return None, None
        return ("typed text did not appear: nothing on this computer has keyboard "
                "focus — click the field first, then type"), None
    role = focus.get("role") or "element"
    label = " ".join(str(focus.get("label") or "").split())[:60]
    what = f"{role} {label}".strip().replace('"', "'")
    value = focus.get("value")
    if focus.get("secure") or focus.get("truncated"):
        return None, None
    if role not in ("textfield", "combobox") and not isinstance(value, str):
        if changed is True:
            return None, None
        return (f'typed text did not appear: the focused element is not a text field '
                f'("{what}") — click the field first, then type'), None
    hay = _field_text(focus)
    if want[-TYPED_TAIL:] in hay:
        return None, None
    if before is not None:
        if hay != _field_text(before):
            return None, TYPED_DIFF_NOTE
        if changed is True:
            return None, None
    return (f'typed text did not appear in the focused field ("{what}") — click the '
            f"field first, then type"), None


def typed_check(text: str, focus: dict | None, changed: bool | None = None,
                before: dict | None = None) -> str | None:
    """The error half of typed_result (None when it landed, cannot be told, or
    only differs from what was typed)."""
    return typed_result(text, focus, changed, before)[0]


def ax_info(v: dict) -> dict:
    """AX attribute values (already Python) -> walk_tree's node info. Split
    out of the ctypes reader so a recorded tree tests it without the API."""
    role = ax_role(v.get("AXRole"), v.get("AXSubrole"))
    val = v.get("AXValue")
    if isinstance(val, float) and val.is_integer():
        val = int(val)
    if role == "text":
        label = (val if isinstance(val, str) else "") or v.get("AXDescription") \
            or v.get("AXTitle") or ""
    else:
        label = (v.get("AXTitle") or v.get("AXDescription")
                 or (val if isinstance(val, str) and role != "textfield" else "")
                 or v.get("AXPlaceholderValue") or v.get("AXHelp") or "")
    pos, size = v.get("AXPosition"), v.get("AXSize")
    # a closed menu (every menu bar item has one) is 0x0 with all its items
    # below it: skipping it saves the menu bar most of its nodes
    hidden = v.get("AXRole") == "AXMenu" and bool(size) and not (size[0] and size[1])
    return {"role": role, "label": label, "hidden": hidden,
            "value": val if role in ("textfield", "checkbox", "radio", "slider",
                                     "combobox", "toggle") else None,
            "focused": v.get("AXFocused") is True, "enabled": v.get("AXEnabled"),
            "box": (pos[0], pos[1], size[0], size[1]) if pos and size else None,
            "children": v.get("AXChildren") or []}


def atspi_info(role_name: str, name: str, description: str, states: set[str],
               extents: tuple | None, children: list) -> dict:
    """AT-SPI node facts -> walk_tree's node info (testable without a bus).
    `states` are lowercase names: showing, focused, enabled, sensitive,
    editable, selectable, checked."""
    role = atspi_role(role_name, editable="editable" in states,
                      selectable="selectable" in states)
    value = None
    if role in ("checkbox", "radio", "toggle"):
        value = "checked" if "checked" in states else "unchecked"
    return {"role": role, "label": name or description or "", "value": value,
            "focused": "focused" in states,
            "enabled": "enabled" in states or "sensitive" in states,
            "hidden": "showing" not in states,
            "box": tuple(extents) if extents and extents[2] > 0 else None,
            "children": children}


class MacAXSource(ElementSource):
    """AXUIElement over ctypes (ApplicationServices + CoreFoundation, no
    PyObjC). The focused application's windows and menu bar first, then the
    other apps with on-screen windows, front to back (CGWindowList), while the
    budget lasts. AX positions are global points — the same space as the
    Quartz input events, so Frame maps them like any click."""
    src = "ax"
    ATTRS = ("AXRole", "AXSubrole", "AXTitle", "AXDescription", "AXValue", "AXHelp",
             "AXPlaceholderValue", "AXPosition", "AXSize", "AXFocused", "AXEnabled",
             "AXChildren")
    OTHER_APPS = 6
    AX_TIMEOUT_S = 0.25       # per AX message during a walk: a hung app costs this
    AX_CANNOT_COMPLETE = -25204

    def __init__(self):
        super().__init__("")
        self._hung: set[int] = set()
        self._woken: set[int] = set()
        import ctypes
        import ctypes.util
        c = self.ct = ctypes
        vp = c.c_void_p
        self.ax = c.cdll.LoadLibrary("/System/Library/Frameworks/ApplicationServices"
                                     ".framework/ApplicationServices")
        self.cf = c.cdll.LoadLibrary(ctypes.util.find_library("CoreFoundation"))
        self.cg = c.cdll.LoadLibrary(ctypes.util.find_library("CoreGraphics"))
        ax, cf = self.ax, self.cf
        ax.AXIsProcessTrusted.restype = c.c_bool
        ax.AXUIElementCreateSystemWide.restype = vp
        ax.AXUIElementCreateApplication.restype = vp
        ax.AXUIElementCreateApplication.argtypes = [c.c_int32]
        ax.AXUIElementCopyAttributeValue.argtypes = [vp, vp, c.POINTER(vp)]
        ax.AXUIElementCopyAttributeValue.restype = c.c_int32
        ax.AXUIElementCopyMultipleAttributeValues.argtypes = [vp, vp, c.c_uint32,
                                                              c.POINTER(vp)]
        ax.AXUIElementCopyMultipleAttributeValues.restype = c.c_int32
        ax.AXUIElementSetMessagingTimeout.argtypes = [vp, c.c_float]
        ax.AXUIElementSetAttributeValue.argtypes = [vp, vp, vp]
        ax.AXUIElementSetAttributeValue.restype = c.c_int32
        ax.AXUIElementGetPid.argtypes = [vp, c.POINTER(c.c_int32)]
        ax.AXValueGetTypeID.restype = c.c_ulong
        ax.AXValueGetType.argtypes = [vp]
        ax.AXValueGetType.restype = c.c_uint32
        ax.AXValueGetValue.argtypes = [vp, c.c_uint32, vp]
        ax.AXValueGetValue.restype = c.c_bool
        for fn, res, args in (("CFRelease", None, [vp]), ("CFGetTypeID", c.c_ulong, [vp]),
                              ("CFStringGetTypeID", c.c_ulong, []),
                              ("CFBooleanGetTypeID", c.c_ulong, []),
                              ("CFNumberGetTypeID", c.c_ulong, []),
                              ("CFArrayGetTypeID", c.c_ulong, []),
                              ("CFArrayGetCount", c.c_long, [vp]),
                              ("CFArrayGetValueAtIndex", vp, [vp, c.c_long]),
                              ("CFBooleanGetValue", c.c_bool, [vp]),
                              ("CFNumberGetValue", c.c_bool, [vp, c.c_int, vp]),
                              ("CFStringGetLength", c.c_long, [vp]),
                              ("CFStringGetCString", c.c_bool, [vp, c.c_char_p, c.c_long,
                                                                c.c_uint32]),
                              ("CFStringCreateWithCString", vp, [vp, c.c_char_p, c.c_uint32]),
                              ("CFArrayCreate", vp, [vp, vp, c.c_long, vp]),
                              ("CFDictionaryGetValue", vp, [vp, vp])):
            f = getattr(cf, fn)
            f.restype, f.argtypes = res, args
        self.cg.CGWindowListCopyWindowInfo.restype = vp
        self.cg.CGWindowListCopyWindowInfo.argtypes = [c.c_uint32, c.c_uint32]
        self.T = {n: getattr(cf, f"CF{n}GetTypeID")() for n in
                  ("String", "Boolean", "Number", "Array")}
        self.T["AXValue"] = ax.AXValueGetTypeID()
        self._keep: list = []
        self._s: dict = {}
        self._arrays: dict = {}
        self._lock = threading.Lock()
        names = [self.cfstr(a) for a in self.ATTRS]
        arr = (vp * len(names))(*names)
        cb = c.addressof(c.c_char.in_dll(cf, "kCFTypeArrayCallBacks"))
        self.attr_array = cf.CFArrayCreate(None, arr, len(names), cb)

    def cfstr(self, s: str):
        """Interned CFString (kept for the process lifetime; a handful)."""
        if s not in self._s:
            self._s[s] = self.cf.CFStringCreateWithCString(None, s.encode(), 0x08000100)
        return self._s[s]

    def unavailable(self):
        if not self.ax.AXIsProcessTrusted():
            return "no Accessibility permission"
        return None

    def py(self, obj, cap: int = 400):
        """A CF object -> Python (str, bool, float, list of borrowed refs,
        (a, b) for an AXValue point/size); None for anything else, including
        the AXError values CopyMultiple puts in place of missing attributes."""
        if not obj:
            return None
        c, cf = self.ct, self.cf
        t = cf.CFGetTypeID(obj)
        if t == self.T["String"]:
            n = cf.CFStringGetLength(obj)
            buf = c.create_string_buffer(n * 4 + 1)
            if cf.CFStringGetCString(obj, buf, len(buf), 0x08000100):
                return buf.value.decode(errors="replace")[:cap]
            return ""
        if t == self.T["Boolean"]:
            return bool(cf.CFBooleanGetValue(obj))
        if t == self.T["Number"]:
            d = c.c_double()
            cf.CFNumberGetValue(obj, 13, c.byref(d))        # kCFNumberDoubleType
            return d.value
        if t == self.T["Array"]:
            return [cf.CFArrayGetValueAtIndex(obj, i) for i in range(cf.CFArrayGetCount(obj))]
        if t == self.T["AXValue"]:
            kind = self.ax.AXValueGetType(obj)
            if kind in (1, 2):                              # CGPoint, CGSize
                pt = (c.c_double * 2)()
                self.ax.AXValueGetValue(obj, kind, c.cast(pt, c.c_void_p))
                return (pt[0], pt[1])
        return None

    def attr(self, el, name: str):
        out = self.ct.c_void_p()
        if self.ax.AXUIElementCopyAttributeValue(el, self.cfstr(name),
                                                 self.ct.byref(out)) != 0:
            return None
        self._keep.append(out.value)
        return out.value

    def read(self, el) -> dict:
        """One IPC per node (CopyMultipleAttributeValues), not one per attr.
        An app that timed out once in this walk is skipped for the rest of it
        (a hung app would otherwise cost AX_TIMEOUT_S per node)."""
        pid = self.ct.c_int32()
        if self._hung and self.ax.AXUIElementGetPid(el, self.ct.byref(pid)) == 0 \
                and pid.value in self._hung:
            return {}
        out = self.ct.c_void_p()
        err = self.ax.AXUIElementCopyMultipleAttributeValues(
            el, self.attr_array, 0, self.ct.byref(out))
        if err == self.AX_CANNOT_COMPLETE:
            if self.ax.AXUIElementGetPid(el, self.ct.byref(pid)) == 0:
                self._hung.add(pid.value)
            return {}
        if err != 0 or not out.value:
            return {}
        self._keep.append(out.value)
        return ax_info(dict(zip(self.ATTRS, (self.py(v) for v in self.py(out.value)))))

    def multi(self, el, names: tuple) -> dict:
        """Several attributes in one IPC: {name: python value}."""
        arr = self._arrays.get(names)
        if arr is None:
            c = self.ct
            vals = (c.c_void_p * len(names))(*[self.cfstr(n) for n in names])
            cb = c.addressof(c.c_char.in_dll(self.cf, "kCFTypeArrayCallBacks"))
            arr = self._arrays[names] = self.cf.CFArrayCreate(None, vals, len(names), cb)
        out = self.ct.c_void_p()
        if self.ax.AXUIElementCopyMultipleAttributeValues(el, arr, 0,
                                                          self.ct.byref(out)) != 0 \
                or not out.value:
            return {}
        self._keep.append(out.value)
        # element-valued attributes stay raw (borrowed, alive while `out` is)
        return {n: v if n in ("AXWindows", "AXMenuBar") else self.py(v)
                for n, v in zip(names, self.py(out.value) or [])}

    # the documented assistive-technology switches: Electron builds its web
    # tree after AXManualAccessibility, Chromium after AXEnhancedUserInterface
    WAKE_ATTRS = ("AXManualAccessibility", "AXEnhancedUserInterface")

    def wake(self, app, pid: int) -> None:
        """Switch on Chromium/Electron accessibility for this app, once per
        app per session; nothing is restored and every failure is ignored
        (the app's messaging timeout is already set, so a hung app costs at
        most that)."""
        if pid in self._woken:
            return
        self._woken.add(pid)
        try:
            true = self.ct.c_void_p.in_dll(self.cf, "kCFBooleanTrue")
            for name in self.WAKE_ATTRS:
                self.ax.AXUIElementSetAttributeValue(app, self.cfstr(name), true)
        except Exception:  # noqa: BLE001 — a nicety; the walk works without it
            pass

    def roots(self, deadline: float = float("inf")) -> tuple[list, list[str], list[str]]:
        """(root elements, their group names, their kinds): each window as
        "<App>: <title>" (or just the app), the front app's menu bar as
        "menu bar"; the focused app's windows are "front", its menu bar
        "menu", every other app's windows "background"."""
        c, ax, cf = self.ct, self.ax, self.cf
        out, pids, groups, kinds = [], [], [], []
        sysw = ax.AXUIElementCreateSystemWide()
        self._keep.append(sysw)
        app = self.attr(sysw, "AXFocusedApplication")
        if app:
            pid = c.c_int32()
            ax.AXUIElementGetPid(app, c.byref(pid))
            pids.append(pid.value)
        info = self.cg.CGWindowListCopyWindowInfo(1 | 16, 0)   # on screen, no desktop
        if info:
            self._keep.append(info)
            for d in self.py(info) or []:
                layer = self.py(cf.CFDictionaryGetValue(d, self.cfstr("kCGWindowLayer")))
                pid = self.py(cf.CFDictionaryGetValue(d, self.cfstr("kCGWindowOwnerPID")))
                if layer == 0 and pid and int(pid) not in pids:
                    pids.append(int(pid))
        for i, pid in enumerate(pids[:1 + self.OTHER_APPS]):
            if time.monotonic() > deadline:
                break
            a = ax.AXUIElementCreateApplication(pid)
            if not a:
                continue
            self._keep.append(a)
            ax.AXUIElementSetMessagingTimeout(a, self.AX_TIMEOUT_S)
            self.wake(a, pid)
            v = self.multi(a, ("AXTitle", "AXWindows", "AXMenuBar"))
            if not v:
                continue                                   # hung or gone: next app
            app_name = v.get("AXTitle") if isinstance(v.get("AXTitle"), str) else ""
            app_name = app_name or f"app {pid}"
            wins = self.py(v.get("AXWindows")) or []
            for w in wins if isinstance(wins, list) else []:
                title = self.py(self.attr(w, "AXTitle"))
                out.append(w)
                groups.append(f"{app_name}: {title}" if title else app_name)
                kinds.append("front" if i == 0 else "background")
            if i == 0:
                mb = v.get("AXMenuBar")
                if mb and self.cf.CFGetTypeID(mb) != self.T["AXValue"]:
                    out.append(mb)
                    groups.append(MENU_BAR)
                    kinds.append("menu")
        return out, groups, kinds

    FOCUS_CAP = 200_000
    AX_NO_VALUE = -25212

    def _attr_err(self, el, name: str):
        out = self.ct.c_void_p()
        err = self.ax.AXUIElementCopyAttributeValue(el, self.cfstr(name), self.ct.byref(out))
        if err == 0 and out.value:
            self._keep.append(out.value)
        return err, out.value if err == 0 else None

    def _front_app(self):
        """The app owning the front-most normal on-screen window."""
        info = self.cg.CGWindowListCopyWindowInfo(1 | 16, 0)
        if not info:
            return None
        self._keep.append(info)
        for d in self.py(info) or []:
            layer = self.py(self.cf.CFDictionaryGetValue(d, self.cfstr("kCGWindowLayer")))
            pid = self.py(self.cf.CFDictionaryGetValue(d, self.cfstr("kCGWindowOwnerPID")))
            if layer == 0 and pid:
                a = self.ax.AXUIElementCreateApplication(int(pid))
                if a:
                    self._keep.append(a)
                    self.ax.AXUIElementSetMessagingTimeout(a, 0.5)
                return a
        return None

    def focused(self):
        """AXFocusedUIElement of the system: role, label, AXValue (read in
        full up to FOCUS_CAP), AXSelectedText. None without permission or
        when a walk holds the lock too long."""
        if self.unavailable() or not self._lock.acquire(timeout=1.0):
            return None
        try:
            sysw = self.ax.AXUIElementCreateSystemWide()
            self._keep.append(sysw)
            self.ax.AXUIElementSetMessagingTimeout(sysw, 0.5)
            err, el = self._attr_err(sysw, "AXFocusedUIElement")
            if err:
                # the system-wide query can fail outright (CannotComplete);
                # ask the front app instead. Only "no value" means no focus.
                app = self.attr(sysw, "AXFocusedApplication") or self._front_app()
                if not app:
                    return None
                err, el = self._attr_err(app, "AXFocusedUIElement")
            if err == self.AX_NO_VALUE:
                return {}
            if err or not el:
                return None
            v = {n: self.py(self.attr(el, n), self.FOCUS_CAP) for n in
                 ("AXRole", "AXSubrole", "AXTitle", "AXDescription",
                  "AXPlaceholderValue", "AXValue", "AXSelectedText")}
            val = v["AXValue"] if isinstance(v["AXValue"], str) else None
            return {"role": ax_role(v["AXRole"], v["AXSubrole"]) or str(v["AXRole"] or ""),
                    "label": v["AXTitle"] or v["AXDescription"] or v["AXPlaceholderValue"]
                    or "",
                    "value": val, "selected": v["AXSelectedText"],
                    "secure": v["AXSubrole"] == "AXSecureTextField",
                    "truncated": val is not None and len(val) >= self.FOCUS_CAP}
        finally:
            for o in self._keep:
                if o:
                    self.cf.CFRelease(o)
            self._keep = []
            self._lock.release()

    def collect(self, clip, deadline, walk="front", windows=None):
        """One walk at a time: screenshots run concurrently in worker
        threads, and `_keep` (the CF objects released after a walk) must not
        be shared. A second caller waits inside the same budget, then gives up."""
        if not self._lock.acquire(timeout=max(0.0, deadline - time.monotonic())):
            return [], True
        try:
            # the global AX timeout: child elements do not inherit the app
            # element's, and the default is 6 s per message
            sysw = self.ax.AXUIElementCreateSystemWide()
            self._keep.append(sysw)
            self.ax.AXUIElementSetMessagingTimeout(sysw, self.AX_TIMEOUT_S)
            self._hung = set()
            roots, groups, kinds = self.roots(deadline)
            return walk_tree(roots, self.read, clip, deadline, groups=groups,
                             kinds=None if walk == "all" else kinds, windows=windows)
        finally:
            for o in self._keep:
                if o:
                    self.cf.CFRelease(o)
            self._keep = []
            self._lock.release()


def _walk_windows(wins, states, read, clip, deadline, walk, windows):
    """AT-SPI: the active window first and walked in full ("front"); the
    others are background windows unless walk == "all"."""
    active = [("active" in states(w)) for w in wins]
    order = sorted(range(len(wins)), key=lambda i: not active[i])
    kinds = None if walk == "all" else ["front" if active[i] else "background"
                                        for i in order]
    return walk_tree([wins[i] for i in order], read, clip, deadline, name_roots=True,
                     kinds=kinds, windows=windows)


class GiAtspiSource(ElementSource):
    """AT-SPI2 through gi.repository.Atspi (what pyatspi wraps, so a host
    with pyatspi has it). Active windows first. Screen coordinates, which on
    X11 are the xdotool input space."""
    src = "atspi"
    STATES = ("showing", "focused", "enabled", "sensitive", "editable",
              "selectable", "checked", "active")

    def __init__(self, Atspi):
        super().__init__("")
        self.A = Atspi

    def unavailable(self):
        return None

    def _states(self, acc) -> set[str]:
        ss = acc.get_state_set()
        return {n for n in self.STATES if ss.contains(getattr(self.A.StateType, n.upper()))}

    def read(self, acc) -> dict:
        kids = [acc.get_child_at_index(i) for i in range(min(acc.get_child_count(), 500))]
        try:
            r = acc.get_extents(self.A.CoordType.SCREEN)
            ext = (r.x, r.y, r.width, r.height)
        except Exception:  # noqa: BLE001 — no Component interface
            ext = None
        return atspi_info(acc.get_role_name(), acc.get_name(), acc.get_description(),
                          self._states(acc), ext, kids)

    def collect(self, clip, deadline, walk="front", windows=None):
        desk = self.A.get_desktop(0)
        wins = []
        for i in range(desk.get_child_count()):
            app = desk.get_child_at_index(i)
            for j in range(app.get_child_count() if app else 0):
                w = app.get_child_at_index(j)
                if w:
                    wins.append(w)
        return _walk_windows(wins, self._states, self.read, clip, deadline, walk, windows)


class DbusAtspiSource(ElementSource):
    """AT-SPI2 over raw D-Bus (python3-dbus), for hosts without gi. A node is
    (bus name, object path); every fact is a round trip, so this is the
    slowest source and the budget decides how much of the screen it covers."""
    src = "atspi"
    BITS = {"active": 1, "checked": 4, "editable": 7, "enabled": 8, "focused": 12,
            "selectable": 22, "sensitive": 24, "showing": 25}
    ACC = "org.a11y.atspi.Accessible"

    def __init__(self, dbus):
        super().__init__("")
        self.dbus = dbus
        addr = dbus.SessionBus().get_object("org.a11y.Bus", "/org/a11y/bus") \
            .GetAddress(dbus_interface="org.a11y.Bus")
        self.bus = dbus.bus.BusConnection(addr)

    def unavailable(self):
        return None

    def _call(self, node, iface, method, *args):
        obj = self.bus.get_object(node[0], node[1], introspect=False)
        return getattr(obj, method)(*args, dbus_interface=iface, timeout=0.3)

    def _states(self, node) -> set[str]:
        try:
            lo, hi = (list(self._call(node, self.ACC, "GetState")) + [0, 0])[:2]
        except Exception:  # noqa: BLE001 — an app that went away
            return set()
        bits = int(lo) | (int(hi) << 32)
        return {n for n, b in self.BITS.items() if bits >> b & 1}

    def _prop(self, node, name):
        return str(self._call(node, "org.freedesktop.DBus.Properties", "Get",
                              self.ACC, name))

    def _kids(self, node) -> list:
        return [(str(b), str(p)) for b, p in self._call(node, self.ACC, "GetChildren")][:500]

    def read(self, node) -> dict:
        try:
            ext = tuple(int(v) for v in self._call(node, "org.a11y.atspi.Component",
                                                   "GetExtents", self.dbus.UInt32(0)))
        except Exception:  # noqa: BLE001 — no Component interface
            ext = None
        return atspi_info(str(self._call(node, self.ACC, "GetRoleName")),
                          self._prop(node, "Name"), self._prop(node, "Description"),
                          self._states(node), ext, self._kids(node))

    def collect(self, clip, deadline, walk="front", windows=None):
        wins = []
        for app in self._kids(("org.a11y.atspi.Registry", "/org/a11y/atspi/accessible/root")):
            try:
                wins += self._kids(app)
            except Exception:  # noqa: BLE001 — an app that went away
                continue
        return _walk_windows(wins, self._states, self.read, clip, deadline, walk, windows)


def atspi_source() -> ElementSource:
    """The best AT-SPI binding on this host (gi, which pyatspi is built on;
    else raw python3-dbus), or an honest none."""
    try:
        import gi
        gi.require_version("Atspi", "2.0")
        from gi.repository import Atspi
        return GiAtspiSource(Atspi)
    except Exception:  # noqa: BLE001 — ImportError, or ValueError from require_version
        pass
    try:
        import dbus
        import dbus.bus  # noqa: F401
    except ImportError:
        return ElementSource("AT-SPI not installed (python3-gi + gir1.2-atspi-2.0, "
                             "or python3-dbus)")
    try:
        return DbusAtspiSource(dbus)
    except Exception as e:  # noqa: BLE001 — no accessibility bus running
        return ElementSource(f"AT-SPI bus not reachable ({type(e).__name__})")


# --- the closed action list -----------------------------------------------------------------

BUTTONS = ("left", "right", "middle")
MODIFIERS = {"ctrl": "ctrl", "control": "ctrl", "shift": "shift", "alt": "alt",
             "option": "alt", "opt": "alt", "super": "super", "logo": "super",
             "win": "super", "meta": "super", "cmd": "super", "command": "super",
             "altgr": "altgr"}
# keysym names allowed as the final key: letters, digits, F-keys and a named set
_NAMED_KEYS = {"Return", "Enter", "Tab", "Escape", "BackSpace", "Delete", "Insert",
               "Home", "End", "Page_Up", "Page_Down", "Prior", "Next", "Left",
               "Right", "Up", "Down", "space", "minus", "equal", "comma", "period",
               "slash", "backslash", "semicolon", "apostrophe", "grave",
               "bracketleft", "bracketright", "Print", "Menu"}
_NAMED_LC = {k.lower(): k for k in _NAMED_KEYS}
# spellings a model reaches for (browser and web names), folded onto the keysyms
_KEY_ALIASES = {"esc": "Escape", "backspace": "BackSpace", "del": "Delete",
                "ins": "Insert", "pageup": "Page_Up", "pagedown": "Page_Down",
                "pgup": "Page_Up", "pgdn": "Page_Down", "arrowleft": "Left",
                "arrowright": "Right", "arrowup": "Up", "arrowdown": "Down",
                "spacebar": "space"}
# combos that end the session or hand the machine elsewhere; the backend adds
# whatever its compositor binds to exit (hyprctl binds)
DENY_KEYS = {"ctrl+alt+Delete", "ctrl+alt+BackSpace", "super+shift+e", "super+m",
             "super+shift+q", "super+ctrl+q", "super+alt+Escape"} | {
             f"ctrl+alt+F{i}" for i in range(1, 13)}
# typed text that would reach this client's own controls
_SELF_WORDS = ("jav3-desk", ".config/jav3", "desk-shell", "desk.paused")
_URL_RE = re.compile(r"^https?://[^\s]{1,2000}$")


def normalize_combo(combo: str) -> str:
    """'Ctrl+Shift+t' -> 'ctrl+shift+t'; modifiers canonical and ordered
    (option = alt, command = super), the final key a letter or digit, F1-F24 or
    a named key in any case ('enter', 'esc', 'ArrowDown', 'pgdn' -> the keysym).
    A single letter after a modifier is lowercased: xdotool reads 'ctrl+L' as
    ctrl+shift+l. backend/desk.py normalize_combo is the server's copy: keep
    the two in step (tests/test_desk_client.py compares them). Raises
    DeskError on anything else."""
    if not isinstance(combo, str) or not re.fullmatch(
            r"[A-Za-z0-9_]{1,32}(\+[A-Za-z0-9_]{1,32}){0,4}", combo.strip()):
        raise DeskError('bad key combo (e.g. "Return", "ctrl+l", "shift+Tab")')
    parts = combo.strip().split("+")
    mods, key = parts[:-1], parts[-1]
    out = []
    for m in mods:
        c = MODIFIERS.get(m.lower())
        if c is None:
            raise DeskError(f"unknown modifier {m!r}")
        if c not in out:
            out.append(c)
    order = ["ctrl", "alt", "altgr", "shift", "super"]
    out.sort(key=order.index)
    if len(key) == 1 and key.isascii() and key.isalnum():
        if out and key.isalpha():
            key = key.lower()
    else:
        f = re.fullmatch(r"[Ff]([1-9]|1[0-9]|2[0-4])", key)
        named = f"F{f.group(1)}" if f else (_NAMED_LC.get(key.lower())
                                           or _KEY_ALIASES.get(key.lower()))
        if not named:
            raise DeskError(f"unknown key {key!r}")
        key = named
    return "+".join([*out, key])


def _deny_set(extra) -> set[str]:
    """DENY_KEYS + a backend's own, normalized; an entry that is not a combo
    this grammar can express (a mouse bind) is skipped, not fatal."""
    out = set()
    for d in set(extra) | DENY_KEYS:
        try:
            out.add(normalize_combo(d).lower())
        except DeskError:
            continue
    return out


def _num(p: dict, k: str, lo: int, hi: int, default=None) -> int:
    v = p.get(k, default)
    if isinstance(v, bool) or not isinstance(v, int):
        raise DeskError(f"{k} must be an integer")
    if not lo <= v <= hi:
        raise DeskError(f"{k} out of range")
    return v


def validate(verb: str, p: dict, frame: Frame | None, apps: dict,
             deny: set[str] = frozenset()) -> dict:
    """Re-check a request from the server. The server already validated it;
    this side does not assume the server is honest."""
    if not isinstance(p, dict):
        raise DeskError("params must be an object")
    out: dict = {}
    if verb == "screenshot":
        if p.get("monitor") is not None:
            out["monitor"] = str(p["monitor"])[:32]
        r = p.get("region")
        if r is not None:
            # shape only: the bounds are the last full-frame image of that
            # monitor, which the session checks (and clips to)
            if not isinstance(r, dict):
                raise DeskError("region must be {x, y, w, h}")
            out["region"] = {"x": _num(r, "x", 0, 100_000), "y": _num(r, "y", 0, 100_000),
                             "w": _num(r, "w", 4, 100_000), "h": _num(r, "h", 4, 100_000)}
        out["elements"] = p.get("elements", True) is not False
        out["walk"] = "all" if p.get("walk") == "all" else "front"
        return out
    if verb == "wait":
        if p.get("mode", "stable") not in ("stable", "change"):
            raise DeskError("mode must be stable or change")
        out["mode"] = p.get("mode", "stable")
        out["timeout_ms"] = _num(p, "timeout_ms", 0, WAIT_MAX_MS, 3000)
        return out
    if verb in ("move", "click", "drag") or (verb == "scroll" and "x" in p):
        if frame is None:
            raise DeskError("no screenshot yet; coordinates have nothing to refer to")
        out["x"] = _num(p, "x", 0, frame.iw - 1)
        out["y"] = _num(p, "y", 0, frame.ih - 1)
    if verb in ("move", "click", "scroll", "type", "key", "open", "drag"):
        out["screenshot_after"] = p.get("screenshot_after", True) is not False
    if verb == "move":
        return out
    if verb == "drag":
        out["to_x"] = _num(p, "to_x", 0, frame.iw - 1)
        out["to_y"] = _num(p, "to_y", 0, frame.ih - 1)
        if p.get("button", "left") not in BUTTONS:
            raise DeskError("bad button")
        out["button"] = p.get("button", "left")
        return out
    if verb == "click":
        if p.get("button", "left") not in BUTTONS:
            raise DeskError("bad button")
        out["button"] = p.get("button", "left")
        out["count"] = _num(p, "count", 1, 3, 1)
        return out
    if verb == "scroll":
        out["dx"] = _num(p, "dx", -20, 20, 0)
        out["dy"] = _num(p, "dy", -20, 20, 0)
        return out
    if verb == "type":
        t = p.get("text")
        if not isinstance(t, str) or not t or len(t) > TEXT_CAP or "\x00" in t:
            raise DeskError("bad text")
        if any(w in t for w in _SELF_WORDS):
            raise DeskError("refused: that text would reach jav3-desk's own controls")
        out["text"] = t
        return out
    if verb == "key":
        c = normalize_combo(p.get("combo"))
        if c.lower() in _deny_set(deny):
            raise DeskError(f"refused: {c} is on this computer's denylist")
        out["combo"] = c
        return out
    if verb == "open":
        url, app = p.get("url"), p.get("app")
        if isinstance(url, str) and url:
            if not _URL_RE.match(url):
                raise DeskError("only http(s) URLs")
            out["url"] = url
        elif app_named(apps, app):
            out["app"] = app_named(apps, app)
        else:
            raise DeskError("open needs an http(s) url or one of this computer's apps")
        return out
    if verb == "shell":
        cmd = p.get("cmd")
        if not isinstance(cmd, str) or not cmd.strip() or len(cmd) > 4000:
            raise DeskError("bad cmd")
        mode = p.get("mode")
        if mode not in ("argv", "shell"):
            raise DeskError("bad shell mode")
        out.update(cmd=cmd, mode=mode, timeout=_num(p, "timeout", 1, 120, 60))
        if mode == "argv":
            argv = p.get("argv")
            if not (isinstance(argv, list) and argv and len(argv) <= 256
                    and all(isinstance(a, str) and "\x00" not in a for a in argv)):
                raise DeskError("bad argv")
            out["argv"] = argv
        cwd = p.get("cwd")
        if cwd is not None:
            if not isinstance(cwd, str) or "\x00" in cwd or len(cwd) > 512:
                raise DeskError("bad cwd")
            out["cwd"] = cwd
        return out
    raise DeskError(f"unknown verb {verb!r}")


# --- running programs --------------------------------------------------------------------------

EXTRA_BIN_DIRS = ("/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin",
                  "/usr/sbin", "/sbin", "/snap/bin")


def find_bin(name: str) -> str | None:
    """Resolved ONCE per backend at startup, then frozen: nothing is looked up
    on PATH later, so PATH cannot be moved under a running client. A service
    inherits a thin PATH, hence the extra dirs."""
    path = os.environ.get("PATH", "") + os.pathsep + os.pathsep.join(EXTRA_BIN_DIRS)
    return shutil.which(name, path=path)


def run_argv(argv: list[str], *, data: bytes | None = None, timeout: float = 15,
             check: bool = True) -> bytes:
    r = subprocess.run(argv, input=data, capture_output=True, timeout=timeout,
                       shell=False)
    if check and r.returncode != 0:
        raise DeskError(f"{Path(argv[0]).name} failed: "
                        f"{r.stderr.decode(errors='replace').strip()[:300]}")
    return r.stdout


# --- backends --------------------------------------------------------------------------------------

class Backend:
    name = "?"
    session = "?"
    needs: tuple[str, ...] = ()
    cheap_thumb = False       # thumbnail() is in-process (tens of ms, no subprocess)

    def __init__(self):
        self.bin = {n: find_bin(n) for n in self.needs + self.optional()}
        missing = [n for n in self.needs if not self.bin.get(n)]
        if missing:
            raise DeskError(f"the {self.name} backend needs: {', '.join(missing)}")

    def optional(self) -> tuple[str, ...]:
        return ()

    def monitors(self) -> list[Monitor]:
        raise NotImplementedError

    def screenshot(self, mon: Monitor, rect: tuple | None = None) -> bytes:
        """The monitor fitted to LONG_EDGE; with `rect` (relative to the
        monitor, input units) that rect at native resolution fitted to
        LONG_EDGE, upscaled at most ZOOM_MAX (zoom_size)."""
        raise NotImplementedError

    def thumbnail(self, mon: Monitor, rect: tuple | None = None) -> bytes:
        """A cheap capture for settle, compared with thumbs_match. The
        default is the full screenshot, compared byte-for-byte: correct but
        slower, and a blinking caret reads as a change."""
        return self.screenshot(mon) if rect is None else self.screenshot(mon, rect)

    def cursor(self) -> tuple[int, int] | None:
        """The pointer in global input units, when cheap to read; else None."""
        return None

    def elements_source(self) -> ElementSource:
        return ElementSource("not supported on this backend")

    def drag(self, x0: int, y0: int, x1: int, y1: int, button: str) -> None:
        raise DeskError(f"drag is not supported on the {self.name} backend")

    def move(self, x: int, y: int) -> None:
        raise NotImplementedError

    def click(self, button: str, count: int) -> None:
        raise NotImplementedError

    def scroll(self, dx: int, dy: int) -> None:
        raise NotImplementedError

    def type_text(self, text: str) -> None:
        raise NotImplementedError

    def key(self, combo: str) -> None:
        raise NotImplementedError

    def open_url(self, url: str) -> None:
        opener = find_bin("open" if sys.platform == "darwin" else "xdg-open")
        if not opener:
            raise DeskError("no opener (xdg-open) installed")
        subprocess.Popen([opener, url], shell=False, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)

    def secure_input(self) -> bool:
        """Is another app holding secure keyboard entry (macOS)?"""
        return False

    def deny_keys(self) -> set[str]:
        return set()

    def screen_state(self) -> dict:
        """{"locked", "asleep"}: whether a capture would only show a lock
        screen or nothing. False when the backend cannot tell cheaply."""
        return {"locked": False, "asleep": False}

    def notify(self, text: str) -> None:
        n = find_bin("notify-send")
        if n:
            subprocess.Popen([n, "-a", "jav3-desk", "jav3-desk", text], shell=False,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def screen_refusal(state: dict) -> str | None:
    """The one sentence a locked / asleep screen gets instead of a capture."""
    if state.get("locked"):
        return LOCKED_ERR
    if state.get("asleep"):
        return ASLEEP_ERR
    return None


def _probe(argv: list[str], env: dict | None = None) -> str | None:
    """stdout of one short read-only command, None when it is missing,
    fails, or times out. The default runner of linux_locked (tests pass a fake)."""
    try:
        r = subprocess.run(argv, shell=False, capture_output=True, text=True, timeout=2,
                           env=env)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def _logind_hint(lc: str, run, uid: int, environ) -> bool | None:
    """LockedHint of this session, found by XDG_SESSION_ID or else by the
    user's active graphical session (a systemd --user service has no
    XDG_SESSION_ID). True / False when a session answered, None when none did."""
    sids = [environ["XDG_SESSION_ID"]] if environ.get("XDG_SESSION_ID") else []
    if not sids:
        listing = run([lc, "list-sessions", "--no-legend"]) or ""
        for line in listing.splitlines():
            f = line.split()
            if len(f) >= 2 and f[1] == str(uid):
                sids.append(f[0])
    seen = None
    for sid in sids:
        out = run([lc, "show-session", sid, "-p", "Type", "-p", "State",
                   "-p", "LockedHint"])
        if out is None:
            continue
        kv = dict(ln.split("=", 1) for ln in out.splitlines() if "=" in ln)
        if not environ.get("XDG_SESSION_ID") and (
                kv.get("Type") not in ("x11", "wayland", "mir")
                or kv.get("State") not in ("active", "online")):
            continue                                  # a tty / ssh session
        if kv.get("LockedHint") == "yes":
            return True
        if kv.get("LockedHint") == "no":
            seen = False
    return seen


def _screensaver_active(run, environ, uid: int) -> bool | None:
    """The freedesktop ScreenSaver's GetActive over the session bus (gdbus,
    else dbus-send); None when neither tool nor any answering service exists."""
    env = dict(environ)
    sock = f"/run/user/{uid}/bus"
    if not env.get("DBUS_SESSION_BUS_ADDRESS") and os.path.exists(sock):
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={sock}"
    services = (("org.freedesktop.ScreenSaver", "/org/freedesktop/ScreenSaver"),
                ("org.gnome.ScreenSaver", "/org/gnome/ScreenSaver"))
    gd, ds = find_bin("gdbus"), find_bin("dbus-send")
    for dest, path in services:
        if gd:
            out = run([gd, "call", "--session", "--dest", dest, "--object-path", path,
                       "--method", f"{dest}.GetActive"], env)
        elif ds:
            out = run([ds, "--session", f"--dest={dest}", "--print-reply", path,
                       f"{dest}.GetActive"], env)
        else:
            return None
        if out and "true" in out.lower().split("boolean")[-1]:
            return True
        if out and "false" in out.lower():
            return False
    return None


def linux_locked(run=None, environ=None, uid: int | None = None) -> bool | None:
    """Whether the Linux session is locked: True / False, or None = unknown.
    logind's LockedHint first (session by XDG_SESSION_ID, else the user's
    graphical session); "yes" is believed at once. Many lockers never set it,
    so "no" (or no session) goes on to the ScreenSaver D-Bus GetActive. With
    no D-Bus answer, a session that said "no" reads unlocked; no session and
    no answer at all is None, never a guess of False."""
    run = run or _probe
    environ = os.environ if environ is None else environ
    uid = os.getuid() if uid is None else uid
    lc = find_bin("loginctl")
    hint = _logind_hint(lc, run, uid, environ) if lc else None
    if hint is True:
        return True
    dbus = _screensaver_active(run, environ, uid)
    if dbus is not None:
        return dbus
    return hint


def logind_locked() -> bool | None:
    return linux_locked()


def drag_path(x0: int, y0: int, x1: int, y1: int, n: int = 12) -> list[tuple[int, int]]:
    """Intermediate pointer positions for a drag, end included: apps that
    track motion (sliders, drag-and-drop) ignore a jump straight to the end."""
    out: list[tuple[int, int]] = []
    for i in range(1, n + 1):
        p = (round(x0 + (x1 - x0) * i / n), round(y0 + (y1 - y0) * i / n))
        if not out or out[-1] != p:
            out.append(p)
    return out


def _grim_shot(b: Backend, mon: Monitor, rect: tuple | None = None,
               thumb: bool = False) -> bytes:
    """grim's -s is the output image scale relative to LOGICAL size (its
    default is the output's own scale, i.e. physical pixels), so this both
    downsizes and undoes HiDPI in one go. JPEG: ~65 ms vs ~800 ms for PNG.
    A zoom is -g in layout coordinates, scaled up to native (mon.scale) and
    at most ZOOM_MAX; a settle thumbnail is a tiny raw PPM (no decoder
    needed to compare it)."""
    if rect is None:
        where, (w, h) = ["-o", mon.name], (mon.w, mon.h)
        s = fit(w, h)
    else:
        rx, ry, w, h = rect
        where = ["-g", f"{mon.x + rx},{mon.y + ry} {w}x{h}"]
        s = zoom_size(w, h, mon.scale)[0] / w
    if thumb:
        return run_argv([b.bin["grim"], *where, "-t", "ppm",
                         "-s", f"{THUMB_EDGE / max(w, h):.4f}", "-"])
    return run_argv([b.bin["grim"], *where, "-t", "jpeg", "-q", "80",
                     "-s", f"{s:.4f}", "-"])


class WaylandPointer:
    """A minimal zwlr_virtual_pointer_v1 client, speaking the Wayland wire
    protocol directly (no pywayland). Pointer events without root, uinput or a
    portal — the compositor trusts local Wayland clients, which is also why
    only wlroots-family compositors (Hyprland, Sway) offer it."""

    BTN = {"left": 0x110, "right": 0x111, "middle": 0x112}

    def __init__(self, path: str | None = None):
        disp = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
        path = path or (disp if disp.startswith("/") else
                        os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d"
                                                    % os.getuid()), disp))
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)
        self.next_id = 2
        self.globals: dict[str, tuple[int, int]] = {}
        self.buf = b""
        reg = self._new()
        self._send(1, 1, self.u32(reg))                  # wl_display.get_registry
        self.registry = reg
        self.roundtrip()
        if "zwlr_virtual_pointer_manager_v1" not in self.globals:
            raise DeskError("this compositor has no zwlr_virtual_pointer_manager_v1")
        name, ver = self.globals["zwlr_virtual_pointer_manager_v1"]
        self.mgr = self._new()
        self._send(reg, 0, self.u32(name) + self.string("zwlr_virtual_pointer_manager_v1")
                   + self.u32(min(ver, 1)) + self.u32(self.mgr))      # wl_registry.bind
        self.ptr = self._new()
        self._send(self.mgr, 0, self.u32(0) + self.u32(self.ptr))   # create(seat=null)
        self.roundtrip()

    # wire encoding
    @staticmethod
    def u32(v: int) -> bytes:
        return struct.pack("=I", v & 0xFFFFFFFF)

    @staticmethod
    def i32(v: int) -> bytes:
        return struct.pack("=i", v)

    @staticmethod
    def fixed(v: float) -> bytes:
        return struct.pack("=i", int(round(v * 256)))

    @staticmethod
    def string(s: str) -> bytes:
        b = s.encode() + b"\0"
        return struct.pack("=I", len(b)) + b + b"\0" * (-len(b) % 4)

    def _new(self) -> int:
        i = self.next_id
        self.next_id += 1
        return i

    def _send(self, obj: int, opcode: int, payload: bytes = b"") -> None:
        self.sock.sendall(struct.pack("=II", obj, ((8 + len(payload)) << 16) | opcode)
                          + payload)

    def roundtrip(self) -> None:
        cb = self._new()
        self._send(1, 0, self.u32(cb))                       # wl_display.sync
        self.sock.settimeout(5)
        while True:
            while len(self.buf) < 8:
                chunk = self.sock.recv(4096)
                if not chunk:
                    raise DeskError("the compositor closed the connection")
                self.buf += chunk
            obj, word = struct.unpack("=II", self.buf[:8])
            size, op = word >> 16, word & 0xFFFF
            while len(self.buf) < size:
                chunk = self.sock.recv(4096)
                if not chunk:
                    raise DeskError("the compositor closed the connection")
                self.buf += chunk
            body, self.buf = self.buf[8:size], self.buf[size:]
            if obj == 1 and op == 0:                         # wl_display.error
                n = struct.unpack("=I", body[8:12])[0]
                raise DeskError("wayland error: " + body[12:12 + n - 1].decode(errors="replace"))
            if obj == self.registry and op == 0:             # wl_registry.global
                name, n = struct.unpack("=II", body[:8])
                iface = body[8:8 + n - 1].decode()
                ver = struct.unpack("=I", body[8 + n + (-n % 4):12 + n + (-n % 4)])[0]
                self.globals[iface] = (name, ver)
            if obj == cb and op == 0:                        # wl_callback.done
                return

    @staticmethod
    def _t() -> int:
        return int(time.monotonic() * 1000) & 0xFFFFFFFF

    def motion_absolute(self, x: int, y: int, ext_w: int, ext_h: int) -> None:
        self._send(self.ptr, 1, self.u32(self._t()) + self.u32(x) + self.u32(y)
                   + self.u32(ext_w) + self.u32(ext_h))
        self._send(self.ptr, 4)                              # frame
        self.roundtrip()

    def click(self, button: str, count: int) -> None:
        for _ in range(count):
            for state in (1, 0):
                self._send(self.ptr, 2, self.u32(self._t()) + self.u32(self.BTN[button])
                           + self.u32(state))
                self._send(self.ptr, 4)
            time.sleep(0.03)
        self.roundtrip()

    def button(self, button: str, pressed: bool) -> None:
        self._send(self.ptr, 2, self.u32(self._t()) + self.u32(self.BTN[button])
                   + self.u32(1 if pressed else 0))
        self._send(self.ptr, 4)
        self.roundtrip()

    def scroll(self, dx: int, dy: int) -> None:
        for axis, n in ((0, dy), (1, dx)):
            if n:
                self._send(self.ptr, 5, self.u32(0))         # axis_source: wheel
                self._send(self.ptr, 7, self.u32(self._t()) + self.u32(axis)
                           + self.fixed(15.0 * n) + self.i32(n))   # axis_discrete
                self._send(self.ptr, 4)
        self.roundtrip()


class WlrootsBackend(Backend):
    needs = ("grim", "wtype")
    _wtype_mod = {"ctrl": "ctrl", "alt": "alt", "shift": "shift", "super": "logo",
                  "altgr": "altgr"}

    def __init__(self):
        super().__init__()
        self._ptr = None

    def screen_state(self) -> dict:
        return {"locked": logind_locked(), "asleep": False}

    def pointer(self) -> WaylandPointer:
        if self._ptr is None:
            self._ptr = WaylandPointer()
        return self._ptr

    def layout(self) -> tuple[int, int, int, int]:
        ms = self.monitors()
        x0, y0 = min(m.x for m in ms), min(m.y for m in ms)
        return x0, y0, max(m.x + m.w for m in ms) - x0, max(m.y + m.h for m in ms) - y0

    def screenshot(self, mon: Monitor, rect: tuple | None = None) -> bytes:
        return _grim_shot(self, mon, rect)

    def thumbnail(self, mon: Monitor, rect: tuple | None = None) -> bytes:
        return _grim_shot(self, mon, rect, thumb=True)

    def elements_source(self) -> ElementSource:
        # AT-SPI extents on Wayland are window-relative or zero (no global
        # coordinates by design), so boxes would point at the wrong place
        return ElementSource("not supported on this backend (AT-SPI has no screen "
                             "coordinates on Wayland)")

    def move(self, x: int, y: int) -> None:
        x0, y0, w, h = self.layout()
        self.pointer().motion_absolute(x - x0, y - y0, w, h)

    def drag(self, x0, y0, x1, y1, button):
        """Virtual pointer throughout (not Hyprland's cursor dispatch): the
        press, the motion and the release must come from one device."""
        lx, ly, w, h = self.layout()
        p = self.pointer()
        p.motion_absolute(x0 - lx, y0 - ly, w, h)
        p.button(button, True)
        try:
            for x, y in drag_path(x0, y0, x1, y1):
                time.sleep(0.015)
                p.motion_absolute(x - lx, y - ly, w, h)
        finally:
            p.button(button, False)

    def click(self, button: str, count: int) -> None:
        self.pointer().click(button, count)

    def scroll(self, dx: int, dy: int) -> None:
        self.pointer().scroll(dx, dy)

    def type_text(self, text: str) -> None:
        run_argv([self.bin["wtype"], "-d", "8", "--", text], timeout=60)

    def key(self, combo: str) -> None:
        *mods, k = combo.split("+")
        argv = [self.bin["wtype"]]
        for m in mods:
            argv += ["-M", self._wtype_mod[m]]
        argv += ["-k", "Return" if k == "Enter" else k]
        for m in reversed(mods):
            argv += ["-m", self._wtype_mod[m]]
        run_argv(argv)


class HyprlandBackend(WlrootsBackend):
    name, session = "hyprland", "hyprland"
    needs = ("grim", "wtype", "hyprctl")

    def _j(self, *what: str):
        return json.loads(run_argv([self.bin["hyprctl"], *what, "-j"]))

    def monitors(self) -> list[Monitor]:
        """Logical rects (hyprctl reports the physical mode + scale), focused
        monitor first — that is the one a bare desk_screenshot shows."""
        raw = self._j("monitors")
        out = []
        for m in raw:
            s = float(m.get("scale") or 1) or 1.0
            w, h = int(m["width"]), int(m["height"])
            if int(m.get("transform", 0)) % 2:
                w, h = h, w
            out.append(Monitor(name=m["name"], x=int(m["x"]), y=int(m["y"]),
                               w=round(w / s), h=round(h / s), scale=s))
        return sorted(out, key=lambda m: not raw[out.index(m)].get("focused"))

    def _version(self) -> tuple[int, ...]:
        try:
            tag = self._j("version").get("tag", "")
            return tuple(int(p) for p in re.findall(r"\d+", tag)[:3])
        except (DeskError, ValueError, OSError):
            return (0,)

    def move(self, x: int, y: int) -> None:
        """Hyprland moves its own cursor (multi-monitor safe, per hypruse);
        0.56 replaced string dispatchers with Lua. Read back via cursorpos, and
        fall back to the virtual pointer if the dispatch did not land."""
        if self._version() >= (0, 56):
            argv = [self.bin["hyprctl"], "dispatch", f"hl.dsp.cursor.move({{x={x},y={y}}})"]
        else:
            argv = [self.bin["hyprctl"], "dispatch", "movecursor", f"{x} {y}"]
        run_argv(argv, check=False)
        try:
            got = run_argv([self.bin["hyprctl"], "cursorpos"]).decode()
            cx, cy = (int(float(v)) for v in got.split(","))
            if abs(cx - x) <= 2 and abs(cy - y) <= 2:
                return
        except (DeskError, ValueError, OSError):
            pass
        super().move(x, y)

    def cursor(self):
        try:
            got = run_argv([self.bin["hyprctl"], "cursorpos"], timeout=2).decode()
            return tuple(int(float(v)) for v in got.split(","))[:2]
        except (DeskError, ValueError, OSError, subprocess.TimeoutExpired):
            return None

    def deny_keys(self) -> set[str]:
        """Whatever this compositor binds to `exit` (default super+M)."""
        out = set()
        try:
            for b in self._j("binds"):
                if b.get("dispatcher") == "exit" and b.get("key"):
                    mask = int(b.get("modmask", 0))
                    mods = [n for bit, n in ((4, "ctrl"), (8, "alt"), (1, "shift"),
                                             (64, "super")) if mask & bit]
                    out.add("+".join([*mods, b["key"]]))
        except (DeskError, ValueError, OSError, TypeError, KeyError):
            pass
        return out


class SwayBackend(WlrootsBackend):
    name, session = "sway", "sway"
    needs = ("grim", "wtype", "swaymsg")

    def monitors(self) -> list[Monitor]:
        outs = json.loads(run_argv([self.bin["swaymsg"], "-t", "get_outputs", "-r"]))
        ms = [Monitor(name=o["name"], x=o["rect"]["x"], y=o["rect"]["y"],
                      w=o["rect"]["width"], h=o["rect"]["height"],
                      scale=float(o.get("scale") or 1)) for o in outs if o.get("active")]
        focused = [m for m, o in zip(ms, [o for o in outs if o.get("active")])
                   if o.get("focused")]
        return focused + [m for m in ms if m not in focused]


class X11Backend(Backend):
    """xdotool against $DISPLAY. The laptop's DISPLAY is only Xwayland (it
    cannot see native Wayland windows), so this is chosen only when there is
    no Wayland session — and it is the headless test backend under Xvfb."""
    name, session = "x11", "x11"
    needs = ("xdotool",)

    def optional(self):
        return ("import", "maim", "scrot")

    def screen_state(self) -> dict:
        return {"locked": logind_locked(), "asleep": False}

    def monitors(self) -> list[Monitor]:
        w, h = (int(v) for v in run_argv([self.bin["xdotool"], "getdisplaygeometry"])
                .split())
        return [Monitor(name="0", x=0, y=0, w=w, h=h)]

    def screenshot(self, mon: Monitor, rect: tuple | None = None) -> bytes:
        if rect is None:
            x, y, w, h = mon.x, mon.y, mon.w, mon.h
            s = fit(w, h)
            tw, th = max(1, round(w * s)), max(1, round(h * s))
        else:
            x, y, w, h = mon.x + rect[0], mon.y + rect[1], rect[2], rect[3]
            tw, th = zoom_size(w, h)
        if self.bin.get("import"):
            return run_argv([self.bin["import"], "-window", "root", "-crop",
                             f"{w}x{h}+{x}+{y}", "-resize",
                             f"{tw}x{th}!", "-quality", "80", "jpeg:-"])
        if self.bin.get("maim"):
            # no resize in maim: a zoom comes back at native size (the Frame
            # takes the image's real size, so clicks still map)
            return run_argv([self.bin["maim"], "-f", "jpg", "-g", f"{w}x{h}+{x}+{y}"])
        if rect is not None:
            raise DeskError("zooming with region needs ImageMagick (import) or maim")
        if self.bin.get("scrot"):
            with tempfile.TemporaryDirectory() as d:
                f = os.path.join(d, "s.jpg")
                run_argv([self.bin["scrot"], "-o", f])
                return Path(f).read_bytes()
        raise DeskError("install ImageMagick (import), maim or scrot for screenshots")

    def thumbnail(self, mon: Monitor, rect: tuple | None = None) -> bytes:
        """A raw PGM from ImageMagick (decodable, so a caret blink is not a
        change); without it, the full screenshot compared byte-for-byte."""
        if not self.bin.get("import"):
            return super().thumbnail(mon, rect)
        x, y, w, h = (mon.x, mon.y, mon.w, mon.h) if rect is None else (
            mon.x + rect[0], mon.y + rect[1], rect[2], rect[3])
        k = THUMB_EDGE / max(w, h)
        return run_argv([self.bin["import"], "-window", "root", "-crop", f"{w}x{h}+{x}+{y}",
                         "-resize", f"{max(1, round(w * k))}x{max(1, round(h * k))}!",
                         "-colorspace", "Gray", "-depth", "8", "pgm:-"])

    def elements_source(self) -> ElementSource:
        return atspi_source()

    def cursor(self):
        try:
            out = run_argv([self.bin["xdotool"], "getmouselocation", "--shell"],
                           timeout=2).decode()
        except (DeskError, OSError, subprocess.TimeoutExpired):
            return None
        kv = dict(ln.split("=", 1) for ln in out.splitlines() if "=" in ln)
        try:
            return int(kv["X"]), int(kv["Y"])
        except (KeyError, ValueError):
            return None

    def move(self, x, y):
        run_argv([self.bin["xdotool"], "mousemove", "--sync", str(x), str(y)])

    def drag(self, x0, y0, x1, y1, button):
        b = {"left": "1", "middle": "2", "right": "3"}[button]
        argv = [self.bin["xdotool"], "mousemove", "--sync", str(x0), str(y0), "mousedown", b]
        for x, y in drag_path(x0, y0, x1, y1):
            argv += ["sleep", "0.015", "mousemove", "--sync", str(x), str(y)]
        run_argv(argv + ["mouseup", b], timeout=20)

    def click(self, button, count):
        run_argv([self.bin["xdotool"], "click", "--repeat", str(count), "--delay", "80",
                  {"left": "1", "middle": "2", "right": "3"}[button]])

    def scroll(self, dx, dy):
        for n, neg, pos in ((dy, "4", "5"), (dx, "6", "7")):
            if n:
                run_argv([self.bin["xdotool"], "click", "--repeat", str(abs(n)),
                          neg if n < 0 else pos])

    def type_text(self, text):
        run_argv([self.bin["xdotool"], "type", "--delay", "12", "--", text], timeout=60)

    def key(self, combo):
        run_argv([self.bin["xdotool"], "key", "--clearmodifiers",
                  combo.replace("Enter", "Return")])


class MacBackend(Backend):
