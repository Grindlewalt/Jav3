    class AgentsScreen(Screen):
        """← from an empty prompt: every conversation that is working, across
        projects. ↑↓ walk the roots; the highlighted root's agents unfold under it
        and shift+↑↓ walk those; enter opens one in the main screen."""

        DEFAULT_CSS = """
        AgentsScreen { background: $background; }
        #ag-head { height: 1; padding: 0 2; margin: 1 0; }
        #ag-list { height: 1fr; padding: 0 1; scrollbar-size-vertical: 1; }
        #ag-foot { height: 1; padding: 0 2; color: $text-muted; }
        AgentRow { height: 1; padding: 0 1; }
        AgentRow.project { color: $text-muted; text-style: bold; margin-top: 1; }
        AgentRow.child { color: $text; }
        AgentRow.-sel { background: $primary 25%; }
        AgentRow.current { background: $success 18%; color: $success; }
        AgentRow.current.-sel { background: $success 38%; }
        """
        BINDINGS = [
            Binding("escape,left,right", "back", show=False),
            Binding("up", "move(-1)", show=False),
            Binding("down", "move(1)", show=False),
            Binding("shift+up", "child(-1)", show=False),
            Binding("shift+down", "child(1)", show=False),
            Binding("enter", "open", show=False),
            Binding("r", "reload", show=False),
            Binding("pageup", "page(-1)", show=False),
            Binding("pagedown", "page(1)", show=False),
        ]

        def __init__(self, origin=None) -> None:
            super().__init__()
            self.origin = origin              # the conversation the operator came from
            self.forest = AgentTree([])
            self.sel_root = None
            self.sel_child = None
            self.loaded = False
            self.error: str | None = None
            self._lock = asyncio.Lock()
            self.frame = 0

        def compose(self) -> ComposeResult:
            yield Static(id="ag-head")
            yield VerticalScroll(id="ag-list", can_focus=False)
            yield Static("[$primary]↑↓[/] agents   [$primary]shift+↑↓[/] the agents under "
                         "one   [$primary]enter[/] open   [$primary]← esc[/] back   "
                         "[$primary]r[/] refresh   [$success]■[/] where you were",
                         id="ag-foot")

        def on_mount(self) -> None:
            self.render_head()
            self.run_worker(self.reload(), group="ag-reload", exclusive=True)
            self.set_interval(2, lambda: self.run_worker(self.reload(), group="ag-reload",
                                                         exclusive=True))
            self.set_interval(0.15, self.spin)

        async def reload(self) -> None:
            try:
                data = await self.app.api("GET", "/api/chat/agents")
                nodes = data.get("nodes") if isinstance(data, dict) else None
                self.error = None
                self.set_tree(AgentTree(nodes if isinstance(nodes, list) else []))
            except CliError as e:
                self.error = str(e)
            await self.rebuild()

        def set_tree(self, tree: AgentTree) -> None:
            self.forest = tree
            if not self.loaded:
                self.loaded = True
                root = tree.root_of(self.origin) if self.origin in tree.by_id else None
                if root is not None:
                    self.sel_root = root
                    self.sel_child = self.origin if self.origin != root else None
            if self.sel_root not in {r["id"] for r in tree.roots}:
                self.sel_root = tree.roots[0]["id"] if tree.roots else None
                self.sel_child = None
            if self.sel_child is not None and self.sel_child not in {
                    n["id"] for n, _ in tree.descendants(self.sel_root)}:
                self.sel_child = None

        def row_markup(self, n: dict, depth: int, root: bool) -> str:
            icon = AGENT_ICONS.get(n.get("kind"), "·")
            nk = len(self.forest.descendants(n["id"])) if root else 0
            fold = ("▾" if n["id"] == self.sel_root else "▸") if nk else " "
            indent = "  " * depth + ("└ " if depth else "")
            title = n.get("title") or "#{}".format(n["id"])
            bits = [f"{fold} {indent}[$secondary]{icon}[/] [b]{_esc(_short(title, 50))}[/]"]
            if n.get("agent_slug"):
                bits.append(f"[$text-muted]@{_esc(n['agent_slug'])}[/]")
            if n.get("model"):
                bits.append(f"[$text-muted]{_esc(str(n['model']).split('/')[-1])}[/]")
            if nk:
                bits.append(f"[$text-muted]{nk} agent{'s' * (nk != 1)}[/]")
            bits.append(f"[$accent]{SPINNER[self.frame % len(SPINNER)]}[/]"
                        if n.get("running") else "[$success]✓[/]")
            age = _age(n.get("started_at"))
            if age:
                bits.append(f"[$text-muted]{age}[/]")
            return "  ".join(bits)

        def render_head(self) -> None:
            running, n, projects = self.forest.counts()
            head = (f"[b]Agents[/]   [$accent]{running} running[/] [$text-muted]·[/] "
                    f"{n} agent{'s' * (n != 1)} [$text-muted]·[/] "
                    f"{projects} project{'s' * (projects != 1)}")
            if self.error:
                head += f"   [$error]{_esc(self.error)}[/]"
            self.query_one("#ag-head", Static).update(head)

        async def rebuild(self) -> None:
            async with self._lock:
                rows: list = []
                for proj, roots in self.forest.groups:
                    rows.append(AgentRow(f"⌂ {_esc(proj or 'no project')}  "
                                         f"[$text-muted]{len(roots)}[/]", "project"))
                    for r in roots:
                        rows.append(AgentRow(self.row_markup(r, 0, True), "root", r["id"]))
                        if r["id"] == self.sel_root:
                            for k, d in self.forest.descendants(r["id"]):
                                rows.append(AgentRow(self.row_markup(k, d, False), "child",
                                                     k["id"], d))
                if not rows:
                    rows.append(AgentRow("[$text-muted]no agents or chats are running — "
                                         "/orchestration starts some[/]", "project"))
                sel = self.sel_child if self.sel_child is not None else self.sel_root
                want = "child" if self.sel_child is not None else "root"
                target = None
                for row in rows:
                    if row.nid is not None and row.nid == self.origin:
                        row.add_class("current")
                    if row.nid == sel and row.kind == want:
                        row.add_class("-sel")
                        target = row
                lst = self.query_one("#ag-list", VerticalScroll)
                with self.app.batch_update():
                    await lst.remove_children()
                    await lst.mount_all(rows)
                self.render_head()
                if target is not None:
                    target.scroll_visible(animate=False)

        def spin(self) -> None:
            self.frame += 1
            for row in self.query(AgentRow):
                n = self.forest.by_id.get(row.nid)
                if n is not None and n.get("running"):
                    row.update(self.row_markup(n, row.depth, row.kind == "root"))

        async def action_move(self, d: int) -> None:
            ids = [r["id"] for r in self.forest.roots]
            if not ids:
                return
            i = ids.index(self.sel_root) if self.sel_root in ids else -1
            self.sel_root = ids[max(0, min(len(ids) - 1, i + d))]
            self.sel_child = None
            await self.rebuild()

        async def action_child(self, d: int) -> None:
            kids = [n["id"] for n, _ in self.forest.descendants(self.sel_root)]
            if not kids:
                return
            if self.sel_child is None:
                if d < 0:
                    return
                self.sel_child = kids[0]
            else:
                i = kids.index(self.sel_child) + d
                self.sel_child = None if i < 0 else kids[min(i, len(kids) - 1)]
            await self.rebuild()

        def action_page(self, d: int) -> None:
            lst = self.query_one("#ag-list", VerticalScroll)
            lst.scroll_page_up() if d < 0 else lst.scroll_page_down()

        async def action_reload(self) -> None:
            await self.reload()

        def action_back(self) -> None:
            self.app.pop_screen()

        def action_open(self) -> None:
            nid = self.sel_child if self.sel_child is not None else self.sel_root
            node = self.forest.by_id.get(nid)
            if node is None:
                return
            self.app.pop_screen()
            self.app.run_worker(self.app.open_node(node), group="agents")

        def click_row(self, row) -> None:
            if row.kind == "root":
                self.sel_root, self.sel_child = row.nid, None
            else:
                self.sel_child = row.nid
            self.action_open()

    class Palette(Provider):
        """Every slash command in ctrl+p."""

        async def discover(self):
            for name, cmd in self.app.unique_commands():
                yield DiscoveryHit(f"/{name}", self._runner(name), help=cmd.help)

        async def search(self, query: str):
            matcher = self.matcher(query)
            for name, cmd in self.app.unique_commands():
                score = matcher.match(f"/{name} {cmd.help}")
                if score > 0:
                    yield Hit(score, matcher.highlight(f"/{name}"), self._runner(name),
                              help=cmd.help)

        def _runner(self, name: str):
            return lambda: self.app.dispatch(f"/{name}")

