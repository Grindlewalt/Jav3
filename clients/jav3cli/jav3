                "",
                f"{_esc(c.get('proto') or '?')} {_esc(c.get('dir') or '?')} "
                f"{_esc(str(c.get('laddr') or ''))}:{_esc(str(c.get('lport') or ''))} → "
                f"{_esc(str(c.get('raddr') or ''))}:{_esc(str(c.get('rport') or ''))} "
                f"[b]{_esc(c.get('host') or '')}[/] {_esc(c.get('state') or '')}",
