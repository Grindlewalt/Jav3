                f"↓{_bytes(c.get('host_bytes_in'))}B  guest-reported ↑"
                f"{_bytes(c.get('guest_bytes_out'))}B ↓{_bytes(c.get('guest_bytes_in'))}B"])

        def _detail_pbox(self, e) -> str:
            r = e["raw"]
            t = r.get("totals") or {}
            orph = _jlist(r.get("orphan_conns"))
            lines = [
                f"[b]{_esc(r.get('box_id') or '?')}[/] {_esc(r.get('kind') or '')} "
                f"{_esc(r.get('project') or '')}",
                ("not reported yet: a box takes a minute after it boots"
                 if not r.get("reported_at") else
                 f"reported {_esc(full_ts(r.get('reported_at')))}"
                 + (f"  {AMBER} stale: the guest stopped reporting [/]"
                    if r.get("stale") else ""))]
            if r.get("error"):
                lines.append(f"[$error b]report failed:[/] {_esc(str(r['error']))}")
            if orph:
                lines.append(f"{RED} {len(orph)} connection{'s' * (len(orph) != 1)} no "
                             "process owns: possibly a hidden process [/]")
            if t:
                lines.append(
                    f"{t.get('procs', '?')} processes · {t.get('unexpected', 0)} unexpected · "
                    f"{t.get('conns', 0)} connections · guest-reported ↑"
                    f"{_bytes(t.get('guest_bytes_out'))}B ↓{_bytes(t.get('guest_bytes_in'))}B"
                    f" · host-verified ↑{_bytes(t.get('host_bytes_out'))}B "
                    f"↓{_bytes(t.get('host_bytes_in'))}B")
            if r.get("truncated"):
                lines.append("[$warning]truncated: the report was too big; the tree shows "
                             "only part of it (totals count everything)[/]")
            lines.append(
                "[$text-muted]baseline: "
                + ("the image's own (from its build)" if r.get("baseline") == "image" else
                   "the built-in set: this image has no baseline of its own yet, so more "
                   "shows as unexpected" if r.get("baseline") == "builtin" else
                   _esc(str(r.get("baseline") or "?")))
