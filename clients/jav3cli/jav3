        def _detail_profile(self, e) -> str:
            p = e["raw"]
            keys = ("[$primary]p[/] assign to a project   [$primary]e[/] edit   "
                    "[$primary]a[/] new profile"
                    + ("   [$text-muted]the default: cannot be deleted[/]"
                       if p.get("is_default") else "   [$primary]d[/] delete"))
