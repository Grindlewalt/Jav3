        def _detail_proc(self, e) -> str:
            r = e["raw"]
            svc = r.get("service_id")
            keys = ("[$primary]enter[/] open/close   "
                    + ("[$primary]s[/] stop service   [$primary]d[/] revoke service"
                       if svc else "[$text-muted]not a service: stop it from the "
                                   "project's chat or destroy the box (/vms)[/]"))
            tag = r.get("tag") or ""
            lines = [keys, "",
                     (f"{RED} UNEXPECTED [/] not in the image baseline and in no approved "
                      "service" if tag == "unexpected" else f"tag: {_esc(tag or '-')}"),
                     f"pid [b]{_esc(str(r.get('pid')))}[/]  ppid {_esc(str(r.get('ppid')))}  "
                     f"user {_esc(r.get('user') or '?')}  unit {_esc(r.get('unit') or '-')}"
                     f"  service {_esc(str(svc or '-'))}",
                     f"exe: {_esc(r.get('exe') or '?')}",
                     f"cmd: {_esc(r.get('cmd') or '')}",
                     f"rss {_bytes(r.get('rss'))}B  cpu {_num(r.get('cpu_pct')) or 0:.1f}%  "
                     f"started {_esc(str(r.get('started') or '?'))}", ""]
            conns = r.get("conns") or []
            if not conns:
                lines.append("[$text-muted]no connections[/]")
            for d in ("out", "in"):
                cs = [c for c in conns if c.get("dir") == d]
                if not cs:
                    continue
                lines.append(f"[b]connections {d}[/]  [$text-muted]guest-reported ↑↓ vs "
                             "host-verified ↑↓[/]")
                for c in cs:
                    flag = _conn_flag(c)
                    mark = (f" {RED} MISMATCH [/]" if flag == "mismatch" else
                            " [$warning]unverified[/]" if flag else " [$success]verified[/]")
                    lines.append(
                        f"  {_esc(c.get('proto') or '?')} {_esc(str(c.get('laddr') or ''))}:"
                        f"{_esc(str(c.get('lport') or ''))} → "
                        f"{_esc(str(c.get('raddr') or ''))}:{_esc(str(c.get('rport') or ''))}"
                        f" {_esc(c.get('host') or '')} [$text-muted]{_esc(c.get('state') or '')}"
                        f"[/]  guest ↑{_bytes(c.get('guest_bytes_out'))} "
                        f"↓{_bytes(c.get('guest_bytes_in'))}  host "
                        f"↑{_bytes(c.get('host_bytes_out'))} "
                        f"↓{_bytes(c.get('host_bytes_in'))}{mark}")
            return "\n".join(lines)

