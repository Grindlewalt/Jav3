def parse_page_args(arg: str) -> tuple[list[str], bool]:
    """`[args] [panel]`: the words after a page's name, and whether the last one is the
    word `panel` (open in a new panel rather than replacing the view). Split on
    whitespace; a page that takes free text reads its own words."""
    toks = (arg or "").split()
    panel = bool(toks) and toks[-1].lower() == "panel"
    return (toks[:-1] if panel else toks), panel


