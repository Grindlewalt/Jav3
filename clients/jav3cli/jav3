    # -- pages ----------------------------------------------------------------------------
    #
    # A page is a WIDGET that a PageHost mounts, not a pushed Screen: it has its own key
    # bindings (live while it has focus), the `args` it was opened with, and hooks for
    # when it is shown or hidden (its polling stops while it is hidden). Nothing in a
    # page may assume it owns the terminal: it sizes itself from its container, has no
    # bindings of the app's, and leaves by asking its host (`leave()`, `go_home()`,
    # `open_page()` post a message the host handles) rather than calling the app. A
    # host keeps a back stack of its pages; the chat is the page at the bottom of it.
    # Modal dialogs stay ModalScreens: they sit over whatever page is showing.

    class Page(Vertical, can_focus=True):
        """Subclass it, name it (`NAME` is the slash name in PAGE_SPECS), and set `BINDINGS`
        and `DEFAULT_CSS` as for any widget. Override `build` (how the app makes one),
        `set_args` (it was opened again with other args), `focus_target`, `page_title`
        and the `page_shown` / `page_hidden` hooks; start timers with `poll`, which the
        host pauses while the page is hidden."""

        NAME = ""
        SLASH_TO_PROMPT = True    # `/` on the page jumps to the prompt (a page that wants the key sets False)
        DEFAULT_CSS = """
        Page { width: 1fr; height: 1fr; background: $background; }
        """
        BINDINGS = [Binding("escape", "leave", show=False)]

        class Leave(Message):
            """esc: show the page before this one."""
            def __init__(self, page) -> None:
                super().__init__()
                self.page = page

        class GoHome(Message):
            """Back to the chat, dropping the pages between."""
            def __init__(self, page) -> None:
                super().__init__()
                self.page = page

        class OpenPage(Message):
            """Ask the host's app to open another page (`/name args`)."""
            def __init__(self, page, name: str, args: tuple) -> None:
                super().__init__()
                self.page, self.name, self.args = page, name, args

        def __init__(self, args=(), **kw) -> None:
            super().__init__(**kw)
            self.args = [str(a) for a in args]
            self.page_visible = False        # set by the host
            self.shown_count = 0             # times it was shown (1 = the first)
            self._polls: list = []

        @classmethod
        def build(cls, app, args) -> "Page":
            """How the app makes one (a page that needs the chat it came from overrides)."""
            return cls(args)

        @property
        def page_title(self) -> str:
            return self.NAME.title()

        def set_args(self, args) -> None:
            """The page is already showing and was opened again with other args."""
            self.args = [str(a) for a in args]

        def focus_target(self):
            """What takes the keyboard when the page is shown: the page itself, so its
            bindings work; the chat page hands it to the prompt."""
            return self

        def page_shown(self) -> None:
            """Shown (the first time too, once it is mounted): load, or load again."""

        def page_hidden(self) -> None:
            """Hidden under another page, or about to be removed."""

        def poll(self, seconds: float, callback):
            """A repeating timer that runs only while the page is shown."""
            timer = self.set_interval(seconds, callback, pause=not self.page_visible)
            self._polls.append(timer)
            return timer

        def set_visible(self, on: bool) -> None:
            if on == self.page_visible:
                return
            self.page_visible = on
            self.display = on
            for timer in self._polls:
                timer.resume() if on else timer.pause()
            if on:
                self.shown_count += 1
                self.page_shown()
            else:
                self.page_hidden()

        @property
        def active(self) -> bool:
            """Shown, and no dialog over it: the time to refresh what is on screen."""
            return self.page_visible and not isinstance(self.app.screen, ModalScreen)

        def leave(self) -> None:
            self.post_message(self.Leave(self))

        def go_home(self) -> None:
            self.post_message(self.GoHome(self))

        def open_page(self, name: str, *args: str) -> None:
            self.post_message(self.OpenPage(self, name, args))

        def action_leave(self) -> None:
            self.leave()

        def on_key(self, event) -> None:
            """`/` on a page types a command: the prompt line takes the focus, slash
            first. (Here, not in the app: the page's queue is ordered, so the letters
            typed after the slash find the focus already moved.)"""
            if event.key == "slash" and self.SLASH_TO_PROMPT and self.page_visible:
                event.stop()
                event.prevent_default()
                self.app.command_line("/")

        @staticmethod
        def of(widget) -> "Page | None":
            """The page a widget inside it belongs to."""
            return next((a for a in widget.ancestors_with_self if isinstance(a, Page)), None)

    class ChatPage(Page, can_focus=False):
        """The chat itself: the page at the bottom of every host's stack. The prompt
        under the host types into it; focus belongs to the prompt, never to the page."""

        NAME = "work"
        FOCUS_ON_CLICK = False

        @property
        def page_title(self) -> str:
            return "Chat"

        def focus_target(self):
            return self.app.editor

        def leave(self) -> None:
            pass                # nothing is under the chat

    class PageHost(Vertical):
        """The area above the prompt: the page showing, and under it (hidden, their
        polling paused) the pages esc returns to. The first Page child is the base."""

        DEFAULT_CSS = "PageHost { width: 1fr; height: 1fr; }"
        MAX_DEPTH = 8             # pages kept under the one showing

        class Changed(Message):
            def __init__(self, page) -> None:
                super().__init__()
                self.page = page

        def __init__(self, *children, **kw) -> None:
            super().__init__(*children, **kw)
            self.stack: list[Page] = []

        @property
        def current(self) -> Page:
            if not self.stack:           # the app asks before this widget has mounted
                base = next(iter(self.query(Page)))
                self.stack = [base]
                base.set_visible(True)
            return self.stack[-1]

        async def push(self, page: Page) -> None:
            """Show `page` over the one showing. An older page of the same kind lower
            in the stack gives way (opening it again starts it fresh)."""
            cur = self.current
            stale = [p for p in self.stack[1:] if p.NAME == page.NAME]
            cur.set_visible(False)
            for old in stale:
                self.stack.remove(old)
                old.set_visible(False)
                await old.remove()
            self.stack.append(page)
            await self.mount(page)
            page.set_visible(True)
            while len(self.stack) > self.MAX_DEPTH + 1:
                gone = self.stack.pop(1)
                await gone.remove()
            self._shown(page)

        async def back(self) -> bool:
            """esc: the page before this one. False at the chat."""
            if len(self.stack) < 2:
                return False
            old = self.stack.pop()
            old.set_visible(False)
            await old.remove()
            self._shown(self.current)
            return True

        async def home(self) -> None:
            """Back to the chat, the pages between dropped."""
            if len(self.stack) < 2:
                return
            while len(self.stack) > 1:
                old = self.stack.pop()
                old.set_visible(False)
                await old.remove()
            self._shown(self.current)

        def _shown(self, page: Page) -> None:
            page.set_visible(True)
            self.call_after_refresh(self._focus, page)
            self.post_message(self.Changed(page))

        def _focus(self, page: Page) -> None:
            if page is self.current and page.is_attached:
                target = page.focus_target()
                if target is not None and target.is_attached:
                    target.focus()

        def on_page_leave(self, message) -> None:
            message.stop()
            if message.page is self.current:
                self.run_worker(self.back(), group="nav")

        def on_page_go_home(self, message) -> None:
            message.stop()
            self.run_worker(self.home(), group="nav")

        def on_page_open_page(self, message) -> None:
            message.stop()
            self.run_worker(self.app.open_page(message.name, " ".join(message.args)),
                            group="nav")

    class AgentRow(Static):
        """One row of the agents screen: a project header, a root, or a descendant."""

        def __init__(self, markup: str, kind: str, nid=None, depth: int = 0) -> None:
            super().__init__(markup, classes=kind)
            self.kind, self.nid, self.depth = kind, nid, depth
            self.markup, self.picked = markup, False

        def show(self, markup: str) -> None:
            self.markup = markup
            self.update(on_the_bar(markup) if self.picked else markup)

        def pick(self) -> None:
            """The selected row: the bar gets the row's plain form. Its muted grey,
            accent spinner and purple icon are 1-1.7:1 against the bar in 256 colours."""
            self.picked = True
            self.add_class("-sel")
            self.update(on_the_bar(self.markup))

        def on_click(self) -> None:
            if self.nid is not None:
                Page.of(self).click_row(self)

    class AgentsPage(Page):
        """/agents, and ← from an empty prompt. The active view: what is running and what needs
        the operator, then a Finished row; the finished view: everything else,
        grouped by project or by time (tab). ↑↓ move between entries, the
        highlighted one unfolds its agents, → steps into them and ← back out,
        enter opens. Plain arrows only: Terminal.app keeps shift+↑↓ for itself."""

        DEFAULT_CSS = """
        #ag-head { height: 1; padding: 0 2; margin: 1 0; }
        #ag-list { height: 1fr; padding: 0 1; scrollbar-size-vertical: 1; }
        #ag-foot { height: auto; padding: 0 2; color: $text-muted; }  /* wraps when narrow */
        AgentRow { height: 1; padding: 0 1; border-left: blank; }
        AgentRow.section { color: $text-muted; text-style: bold; margin-top: 1; }
        AgentRow.group { color: $text-muted; margin-top: 1; }
        AgentRow.link { margin-top: 1; color: $text-muted; }
        AgentRow.child { color: $text; }
        AgentRow.-sel { background: $primary; color: auto 95%; text-style: bold;
                        border-left: thick $accent; }
        /* solid colours only: a blended tint rounds to grey in 256 colours */
        AgentRow.current { background: $panel; color: $success; border-left: thick $success; }
        AgentRow.current.-sel { background: $success; color: auto 95%;
                                border-left: thick $accent; }
        """
        BINDINGS = [
            Binding("escape", "back", show=False),
            Binding("left", "left", show=False),
            Binding("right", "right", show=False),
            Binding("up,k", "move(-1)", show=False),
            Binding("down,j", "move(1)", show=False),
            # still honoured where the terminal sends them
            Binding("shift+up", "root(-1)", show=False),
            Binding("shift+down", "root(1)", show=False),
            Binding("tab", "group", show=False),
            Binding("enter", "open", show=False),
            Binding("r", "reload", show=False),
            Binding("pageup", "page(-1)", show=False),
            Binding("pagedown", "page(1)", show=False),
        ]

        RELOAD_S = 1.5          # a chat started in the web app shows within about 2 s

        NAME = "agents"

        def __init__(self, args=(), origin=None) -> None:
            super().__init__(args)
            self.origin = origin              # the conversation the operator came from
            # `/agents finished` opens the second view; otherwise the view the
            # conversation we came from is in (see _select_origin)
            self.mode = "finished" if self.args[:1] == ["finished"] else "active"
            self.explicit = self.mode == "finished"
            self.group_by = "project"         # finished view: or "time"
            # the data (what runs server-wide, merged and sorted) lives in the feed
            self.feed = AgentsFeed(self._api)
            self.trees = self.feed.trees
            self.sel = None                   # a root id, a child id, or "finished"
            self.in_kids = False              # ↑↓ walk the open root's agents
            self.open_root = None
            self.loaded = False
            self._lock = asyncio.Lock()
            self._reloading = False
            self.frame = 0

        @classmethod
        def build(cls, app, args) -> "AgentsPage":
            return cls(args, origin=app.cid)

        @property
        def page_title(self) -> str:
            return "Agents · finished" if self.mode == "finished" else "Agents"

        def set_args(self, args) -> None:
            super().set_args(args)
            want = "finished" if self.args[:1] == ["finished"] else "active"
            if want != self.mode:
                self.run_worker(self._enter_view(want), group="ag-open")

        async def _enter_view(self, want: str) -> None:
            if want == "finished":
                self.in_kids, self.sel = False, "finished"
                await self.action_open()
            else:
                await self.action_back()

        async def _api(self, method: str, path: str, **kw):
            return await self.app.api(method, path, **kw)

        @property
        def total_finished(self) -> int | None:
            return self.feed.total_finished

        @property
        def error(self) -> str | None:
            return self.feed.error

        def compose(self) -> ComposeResult:
            yield Static(id="ag-head")
            yield VerticalScroll(id="ag-list", can_focus=False)
            yield Static(id="ag-foot")

        def on_mount(self) -> None:
            self.feed.add_convs(self.app.convs)      # names for chats the app already listed
            self.render_chrome()
            self.run_worker(self._reload_safe(), group="ag-reload", exclusive=True)
            self.poll(self.RELOAD_S, self._auto_reload)
            self.poll(0.15, self.spin)

        def page_shown(self) -> None:
            if self.shown_count > 1:          # back from another page: what ran meanwhile
                self.run_worker(self._reload_safe(), group="ag-reload", exclusive=True)

        def _auto_reload(self) -> None:
            # a fetch still going is left alone: a slow server would otherwise be
            # asked again, and the answer cancelled, before it ever got through
            if self.mode == "active" and not self._reloading:
                self.run_worker(self._reload_safe(), group="ag-reload", exclusive=True)

        @property
        def tree(self) -> AgentTree:
            return self.trees[self.mode]

        async def _reload_safe(self) -> None:
            # the fetch is slow; the operator may close the screen meanwhile, and
            # then its widgets are gone ("No nodes match '#ag-head'" crashed the
            # whole app). A result for a closed screen is simply dropped.
            from textual.css.query import NoMatches
            try:
                await self.reload()
            except NoMatches:
                if self.is_attached:
                    raise

        async def reload(self) -> None:
            self._reloading = True
            try:
                await self.feed.refresh(full_finished=self.mode == "finished")
            finally:
                self._reloading = False
            if not self.loaded:
                self.loaded = True
                if not self.explicit:
                    self._select_origin()
            self._keep_selection()
            await self.rebuild()

        # -- what is shown, in order --------------------------------------------------

        def _sections(self) -> list[tuple[str, list[dict]]]:
            return agent_sections(self.tree, self.mode, self.group_by)

        def _root_ids(self) -> list:
            ids = [r["id"] for _, rs in self._sections() for r in rs]
            if self.mode == "active":
                ids.append("finished")
            return ids

        def _select_origin(self) -> None:
            for mode in ("active", "finished"):
                tr = self.trees[mode]
                if self.origin in tr.by_id:
                    self.mode = mode
                    root = tr.root_of(self.origin)
                    self.sel, self.open_root = root, root
                    if self.origin != root:
                        self.sel, self.in_kids = self.origin, True
                    return

        def _keep_selection(self) -> None:
            ids = self._root_ids()
            if self.in_kids:
                kids = [k["id"] for k, _ in self.tree.descendants(self.open_root)] \
                    if self.open_root in self.tree.by_id else []
                if self.sel in kids:
                    return
                self.in_kids = False
                self.sel = self.open_root
            if self.sel not in ids:
                self.sel = ids[0] if ids else None
            self.open_root = self.sel if self.sel != "finished" else None

        # -- drawing ------------------------------------------------------------------

        def row_markup(self, nd: dict, depth: int, root: bool) -> str:
            tr = self.tree
            icon = AGENT_ICONS.get(nd.get("kind"), "·")
            nk = len(tr.descendants(nd["id"])) if root else 0
            fold = ("▾" if nd["id"] == self.open_root else "▸") if nk else " "
            indent = "   " * depth
            st = tr.root_status(nd["id"]) if root else node_status(nd)
            glyph = (f"[$accent]{SPINNER[self.frame % len(SPINNER)]}[/]" if st == "running"
                     else STATUS_GLYPH.get(st, ""))
            why = tr.needs(nd["id"]) if root else (nd.get("needs") if st == "needs_you"
                                                    else None)
            if why and st == "running":            # running, and something under it waits on you
                glyph += " " + STATUS_GLYPH["needs_you"]
            title = clean_title(nd.get("title")) or f"#{nd['id']}"
            meta = [node_role(nd)]
            if root and nd.get("project") and not (self.mode == "finished"
                                                   and self.group_by == "project"):
                meta.append(f"⌂ {nd['project']}")
            if nd.get("model"):
                meta.append(str(nd["model"]).split("/")[-1])
            if nk:
                meta.append(f"{nk} agent{'s' * (nk != 1)}")
            # what it waits on comes before the age: a narrow terminal cuts the end
            ask = f" [$warning]{_esc(_short(why, 60))}[/]" if why else ""
            return (f"{fold} {indent}[$secondary]{icon}[/] [b]{_esc(title)}[/]  "
                    f"[$text-muted]{_esc(' · '.join(meta))}[/]  {glyph}{ask} "
                    f"[$text-muted]{_age(nd.get('ended_at') or nd.get('started_at'))}[/]")

        def render_chrome(self) -> None:
            act = self.trees["active"]
            run = sum(1 for r in act.roots if act.root_status(r["id"]) == "running")
            need = sum(1 for r in act.roots if act.needs(r["id"]))    # a blocked child counts
            if self.mode == "active":
                head = (f"[b]Agents[/]   [$accent]{run} running[/] [$text-muted]·[/] "
                        + (f"[$warning]{need} need you[/]" if need else
                           "[$text-muted]nothing needs you[/]"))
                foot = ("[$primary]↑↓[/] move   [$primary]→ ←[/] into / out of its agents   "
                        "[$primary]enter[/] open   [$primary]esc[/] back   "
                        "[$primary]r[/] refresh   [$success]■[/] where you were")
            else:
                total = self.total_finished or 0
                head = (f"[b]Finished[/]   {total} [$text-muted]· grouped by[/] "
                        f"[b]{self.group_by}[/]")
                foot = (f"[$primary]tab[/] group by {'time' if self.group_by == 'project' else 'project'}"
                        "   [$primary]↑↓[/] move   [$primary]→ ←[/] into / out of its agents   "
                        "[$primary]enter[/] open   [$primary]esc[/] back to active")
            if self.error:
                head += f"   [$error]{_esc(self.error)}[/]"
            self.query_one("#ag-head", Static).update(head)
            self.query_one("#ag-foot", Static).update(foot)

        async def rebuild(self) -> None:
            async with self._lock:
                rows: list = []
                tr = self.tree
                for name, roots in self._sections():
                    if self.mode == "active" and not roots:
                        continue
                    rows.append(AgentRow(f"{_esc(name)}  [$text-muted]{len(roots)}[/]",
                                         "section" if self.mode == "active" else "group"))
                    for r in roots:
                        rows.append(AgentRow(self.row_markup(r, 0, True), "root", r["id"]))
                        if r["id"] == self.open_root:
                            for k, d in tr.descendants(r["id"]):
                                rows.append(AgentRow(self.row_markup(k, d, False), "child",
                                                     k["id"], d))
                if self.mode == "active":
                    if not any(r.kind == "root" for r in rows):
                        rows.append(AgentRow("[$text-muted]nothing is running and nothing "
                                             "needs you — /orchestration starts a team[/]",
                                             "section"))
                    n = self.total_finished
                    rows.append(AgentRow(f"  Finished  [$text-muted]{'' if n is None else n}  "
                                         "enter →[/]", "link", "finished"))
                elif not rows:
                    rows.append(AgentRow("[$text-muted]nothing has finished yet[/]", "group"))
                target = None
                for row in rows:
                    if row.nid is not None and row.nid == self.origin:
                        row.add_class("current")
                    if row.nid == self.sel and (row.kind == "child") == self.in_kids \
                            and row.kind in ("root", "child", "link"):
                        row.pick()
                        target = row
                lst = self.query_one("#ag-list", VerticalScroll)
                with self.app.batch_update():
                    await lst.remove_children()
                    await lst.mount_all(rows)
                self.render_chrome()
                if target is not None:
                    target.scroll_visible(animate=False)

        def spin(self) -> None:
            self.frame += 1
            for row in self.query(AgentRow):
                nd = self.tree.by_id.get(row.nid)
                if nd is not None and (row.kind == "root" and self.tree.root_status(
                        row.nid) == "running" or node_status(nd) == "running"):
                    row.show(self.row_markup(nd, row.depth, row.kind == "root"))

        # -- keys -------------------------------------------------------------------------

        async def action_move(self, d: int) -> None:
            if self.in_kids:
                kids = [k["id"] for k, _ in self.tree.descendants(self.open_root)]
                i = kids.index(self.sel) + d if self.sel in kids else 0
                if i < 0:                         # above the first agent: back to its root
                    self.in_kids, self.sel = False, self.open_root
                elif i >= len(kids):              # below the last: on to the next entry
                    self.in_kids = False
                    self.sel = self.open_root
                    return await self.action_root(1)
                else:
                    self.sel = kids[i]
                return await self.rebuild()
            await self.action_root(d)

        async def action_root(self, d: int) -> None:
            ids = self._root_ids()
            if not ids:
                return
            if self.in_kids:
                self.in_kids, self.sel = False, self.open_root
            i = ids.index(self.sel) if self.sel in ids else -1
            self.sel = ids[max(0, min(len(ids) - 1, i + d))]
            self.open_root = self.sel if self.sel != "finished" else None
            await self.rebuild()

        async def action_right(self) -> None:
            if self.sel == "finished":
                return await self.action_open()
            if not self.in_kids and self.open_root is not None:
                kids = self.tree.descendants(self.open_root)
                if kids:
                    self.in_kids, self.sel = True, kids[0][0]["id"]
                    await self.rebuild()

        async def action_left(self) -> None:
            if self.in_kids:
                self.in_kids, self.sel = False, self.open_root
                await self.rebuild()
            else:
                await self.action_back()

        async def action_group(self) -> None:
            if self.mode == "finished":
                self.group_by = "time" if self.group_by == "project" else "project"
                self.in_kids = False
                ids = self._root_ids()
                self.sel = ids[0] if ids else None
                self.open_root = self.sel
                await self.rebuild()

        def action_page(self, d: int) -> None:
            lst = self.query_one("#ag-list", VerticalScroll)
            lst.scroll_page_up() if d < 0 else lst.scroll_page_down()

        async def action_reload(self) -> None:
            await self.reload()

        async def action_back(self) -> None:
            if self.mode == "finished":
                self.mode, self.in_kids = "active", False
                self.sel = "finished"
                self.open_root = None
                await self.rebuild()
            else:
                self.leave()

        async def action_open(self) -> None:
            if self.sel == "finished":
                self.mode, self.in_kids = "finished", False
                if not self.feed.finished_full:       # only the count is loaded
                    await self.reload()
                ids = self._root_ids()
                self.sel = ids[0] if ids else None
                self.open_root = self.sel
                await self.rebuild()
                return
            node = self.tree.by_id.get(self.sel)
            if node is None:
                return
            self.app.run_worker(self.app.open_node(node), group="agents")

        def click_row(self, row) -> None:
            if row.kind == "link":
                self.sel = "finished"
            elif row.kind == "root":
                self.sel, self.in_kids, self.open_root = row.nid, False, row.nid
            else:
                self.sel, self.in_kids = row.nid, True
            self.run_worker(self.action_open(), group="ag-open")

    # -- the security screen -------------------------------------------------------------
    #
    # /security (alias /review): the web app's Security area in eight tabs. The
    # queue is Review.jsx's (egress hosts waiting, git commit/remote requests
    # pending in every project, service and package requests, unacknowledged
    # alerts, which carry the diff-gate flags); Network is each project's allow
    # and deny lists over its profile's baseline with its egress feed; Logs is
    # the whole security-event log; Secrets is SecretsPanel.jsx's list, names
    # and bound hosts only; Persistent is every box's non-OS process tree with
    # guest-reported vs host-verified bytes, and the approved services;
    # Profiles lists, assigns, creates and edits security profiles. /vms reuses
    # the frame for boxes, images and the package catalogue. Every route is
    # operator-only, so a chat-only login gets a locked message and no requests.

    _KEEP_ON_BAR = {"b", "bold", "i", "italic", "u", "underline", "strike"}

    def on_the_bar(markup: str):
        """A row's markup as it reads on the selection bar: the row's own colours
        (muted grey, amber, purple) are 1-1.7:1 against the bar and vanish, so only
        bold, italic and underline stay, and a chip that carries its own background
        keeps everything. The bar's own contrast colour does the rest."""
        from textual.content import Content, Span
        c = Content.from_markup(markup)
        spans = []
        for sp in c.spans:
            st = sp.style if isinstance(sp.style, str) else None
            if st is None:
                continue
            if " on " in f" {st} ":
                keep = st
            else:
                keep = " ".join(t for t in st.split() if t in _KEEP_ON_BAR)
            if keep:
                spans.append(Span(sp.start, sp.end, keep))
        return Content(c.plain, spans=spans)

    class SecRow(Static):
        """One row of the security screen's list; `key` None is a note."""

        def __init__(self, markup: str, key: str | None) -> None:
            super().__init__(markup, classes="row" if key is not None else "note")
            self.key = key
            self.markup = markup
            self.picked = False

        def show(self, markup: str) -> None:
            self.markup = markup
            self.update(on_the_bar(markup) if self.picked else markup)

        def pick(self, on: bool) -> None:
            """Select or deselect: the bar gets the row's plain form, so it stays readable."""
            self.set_class(on, "-sel")
            if on != self.picked:
                self.picked = on
                self.update(on_the_bar(self.markup) if on else self.markup)

        def on_click(self) -> None:
            if self.key is not None:
                Page.of(self).select_key(self.key)

    class SecTab(Static):
        def __init__(self, tab: str) -> None:
            super().__init__("", id=f"sec-tab-{tab}", classes="tab")
            self.tab = tab

        def on_click(self) -> None:
            page = Page.of(self)
            page.run_worker(page.switch_to(page.TABS.index(self.tab)), group="sec-switch")

    _SEV_COL = {"critical": "$error", "warn": "$warning"}
    _SEV_RANK = {"critical": 0, "warn": 1}

    def _verdict_col(v: str) -> str:
        return ("$success" if v in ("allow", "auto_allow") else
                "$error" if v in ("deny", "auto_deny", "denied", "cut", "block", "blocked")
                else "$warning")

    def _bytes(n) -> str:
        try:
            n = float(n or 0)
        except (TypeError, ValueError):
            return "?"
        for unit in ("", "k", "M", "G"):
            if n < 1000:
                return f"{n:.0f}{unit}" if unit == "" else f"{n:.1f}{unit}"
            n /= 1000
        return f"{n:.1f}T"

    def _diff_markup(text: str) -> str:
        out = []
        for ln in str(text).splitlines():
            style = ("$success" if ln.startswith("+") and not ln.startswith("+++")
                     else "$error" if ln.startswith("-") and not ln.startswith("---")
                     else "$accent" if ln.startswith("@@") else "$text")
            out.append(f"[{style}]{_esc(ln)}[/]")
        return "\n".join(out)

    def _detail_markup(raw) -> str:
        """An event's `detail` (a JSON string, usually): a diff it carries in
        colour, everything else as pretty JSON."""
        d = raw
        if isinstance(raw, str):
            try:
                d = json.loads(raw)
            except ValueError:
                return _esc(raw)
        if d in (None, "", {}, []):
            return ""
        parts = []
        if isinstance(d, dict):
            d = dict(d)
            for k in ("diff", "patch"):
                if isinstance(d.get(k), str) and d[k].strip():
                    parts.append(_diff_markup(d.pop(k)))
        if d not in ({}, None):
            parts.insert(0, _esc(json.dumps(d, indent=2, sort_keys=True, default=str)))
        return "\n\n".join(parts)

    # -- boxes, services, processes, profiles, packages (docs/boxes-contract.md) --------

    def _docker_notes(runtimes: dict) -> list[str]:
        """What GET /api/vm/boxes `runtimes.docker` says about this host: why
        docker is unavailable, or the warnings when it would run weak."""
        d = (runtimes or {}).get("docker")
        if not isinstance(d, dict):
            return []
        if d.get("available") is False:
            return [f"[$error b]docker is unavailable here:[/] {_esc(str(d.get('reason') or '?'))}"]
        if d.get("weak"):
            ws = _jlist(d.get("warnings")) or ["no user namespace"]
            return [f"{RED} WEAK ISOLATION [/] " + _esc(w) for w in ws]
        return []

    def _runtime_tag(rt) -> str:
        if rt == "docker":
            return f"docker {AMBER} less isolated [/]"
        return _esc(str(rt or "kvm"))

    def _tree_count(nodes) -> int:
        return sum(1 + _tree_count(n.get("children")) for n in nodes or [])

    def _num(v):
        try:
            return None if v is None else float(v)
        except (TypeError, ValueError):
            return None

    def _conn_flag(c: dict) -> str:
        """'mismatch' when the guest's byte count and the proxy's disagree (a
        root implant can lie to /proc, not to the proxy), 'unverified' when the
        host could not join it, '' when they agree."""
        for d in ("out", "in"):
            g, h = _num(c.get(f"guest_bytes_{d}")), _num(c.get(f"host_bytes_{d}"))
            if g is not None and h is not None and abs(g - h) > max(4096.0, 0.1 * max(g, h)):
                return "mismatch"
        if c.get("verified") is False and (c.get("host_bytes_out") is not None
                                           or c.get("host_bytes_in") is not None):
            return "mismatch"
        return "" if c.get("verified") else "unverified"

    def _node_bad(nd: dict) -> bool:
        return (nd.get("tag") == "unexpected"
                or any(_conn_flag(c) == "mismatch" for c in nd.get("conns") or []))

    def _tree_bad(nodes) -> bool:
        return any(_node_bad(n) or _tree_bad(n.get("children")) for n in nodes or [])

    def _tree_bad_count(nodes) -> int:
        return sum(_node_bad(n) + _tree_bad_count(n.get("children")) for n in nodes or [])

    def _ports_text(ports) -> str:
        return ", ".join(f"{p.get('port')}/{p.get('protocol') or 'tcp'}"
                         f"({p.get('expose') or 'none'})" for p in ports or []) or "none"

    def _argv(cmd) -> str:
        if isinstance(cmd, (list, tuple)):
            return " ".join(shlex.quote(str(a)) for a in cmd)
        return str(cmd or "")

    def _jlist(v) -> list:
        if isinstance(v, str):
            try:
                v = json.loads(v)
            except ValueError:
                return [v] if v else []
        return list(v or [])

