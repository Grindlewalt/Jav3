def parse_todos(result: str) -> list[tuple[bool, str]]:
    import re
    out = []
    for ln in (result or "").splitlines():
        m = re.match(r"\s*\d+\.\s*\[([ xX])\]\s*(.*)", ln)
        if m:
            out.append((m.group(1).lower() == "x", m.group(2)))
    return out


