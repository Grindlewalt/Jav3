def _argstr(args, n: int = 70) -> str:
    """Tool args the way a person reads them: the one value when there is one,
    else key=value pairs."""
    if not isinstance(args, dict) or not args:
        return "" if args in ({}, None, "") else _short(args, n)
    if len(args) == 1:
        return _short(next(iter(args.values())), n)
    return _short(", ".join(f"{k}={v if isinstance(v, str) else json.dumps(v)}"
                            for k, v in args.items()), n)


def _summary(result: str, n: int = 110) -> str:
    lines = [ln for ln in (result or "").splitlines() if ln.strip()]
    if not lines:
        return "(no output)"
    head = _short(lines[0], n)
    return head + (f"  (+{len(lines) - 1} lines)" if len(lines) > 1 else "")


def _elapsed(secs: float, precise: bool = False) -> str:
    """2m 13s. precise: tenths under ten seconds (a finished tool call)."""
    secs = max(0.0, secs)
    if precise and secs < 10:
        return f"{secs:.1f}s"
    s = int(secs)
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m {s % 60:02d}s"
    return f"{s // 3600}h {s % 3600 // 60:02d}m"


def _fmt_cost(usd) -> str:
    if not isinstance(usd, (int, float)) or usd <= 0:
        return "$0.00"
    return f"${usd:.2f}" if usd >= 0.01 else f"${max(usd, 0.001):.3f}"


def _plural(n: int, one: str, many: str | None = None) -> str:
    return f"{n} {one if n == 1 else many or one + 's'}"


def fit_parts(parts: list[tuple[str, str, int]], width: int, sep: str = " · ",
              markup_sep: str | None = None) -> str:
    """Join (plain, markup, rank) parts in their order, leaving out the
    highest-numbered ranks (last-added first among equals) until the plain
    text fits `width`. The first part always stays."""
    keep = list(range(len(parts)))
    for i in sorted(range(1, len(parts)), key=lambda i: (-parts[i][2], -i)):
        if len(sep.join(parts[j][0] for j in keep)) <= width:
            break
        keep.remove(i)
    return (sep if markup_sep is None else markup_sep).join(parts[j][1] for j in keep)


def verdict_label(v: str) -> str:
    """A network verdict as its row label, whole words in eight columns: `pending`
    was cut to PENDI, `auto_allow` to A·ALL and `reviewed` to REVIEWE."""
    return str(v or "?").replace("auto_", "a·").upper()[:8]


def fit_row(left: list[tuple[str, str, int]], right: list[tuple[str, str, int]],
            total: int, sep: str = " · ", markup_sep: str | None = None) -> tuple[str, str]:
    """A status row's two sides, (plain, markup, rank) parts each, joined so the
    row fits `total` columns with a gap between them: the highest ranks go first,
    a right-hand part before a left-hand one of the same rank, so whole hints go
    and none is cut mid-word. Each side keeps its first part."""
    ls, rs = list(range(len(left))), list(range(len(right)))

    def plain() -> int:
        return (len(sep.join(left[i][0] for i in ls)) + len(sep.join(right[i][0] for i in rs)))

    order = sorted([(left[i][2], 0, i) for i in range(1, len(left))]
                   + [(right[i][2], 1, i) for i in range(1, len(right))],
                   key=lambda k: (-k[0], -k[1], -k[2]))
    for _, side, i in order:
        if plain() + 2 <= total:
            break
        (rs if side else ls).remove(i)
    msep = sep if markup_sep is None else markup_sep
    return (msep.join(left[i][1] for i in ls), msep.join(right[i][1] for i in rs))


_CD = re.compile(r"""^cd\s+(?:"[^"]*"|'[^']*'|[^\s;&|]+)(?:\s+2>\s*/dev/null)?"""
                 r"""\s*(?:;|&&|\|\||$)\s*""")


def _cmd_line(cmd) -> str:
    """A shell command the way its row reads: the first line that does
    something, without the agent's habitual `cd "$(pwd)";` or `cd <project>`
    in front, and " …" when more lines follow."""
    lines = [ln.strip() for ln in str(cmd or "").splitlines() if ln.strip()]
    for i, ln in enumerate(lines):
        rest = ln
        while True:
            m = _CD.match(rest)
            if not m or not m.group(0):
                break
            rest = rest[m.end():]
        if rest:
            return rest + (" …" if i < len(lines) - 1 else "")
    return lines[0] if lines else ""


def result_hint(name: str, args, ok, result) -> str:
    """The few words after a finished call's title: what came back ("lines
    1-230 of 656", "20 matches in 3 files", "exit 0 · 40 lines", "+3 −1"),
    not the first line of it. A failure: its first line, without "error:"."""
    import difflib
    a = args if isinstance(args, dict) else {}
    r = result or ""
    lines = [ln for ln in r.splitlines() if ln.strip()]
    if ok is False:
        return _short(re.sub(r"^error:\s*", "", lines[0]) if lines else "failed", 100)
    if name in ("read_file", "local_read_file"):
        m = re.match(r"\((lines \d+-\d+ of \d+)", r)
        return m.group(1) if m else _plural(len(r.splitlines()), "line")
    if name in ("search_codebase", "local_search"):
        if r.startswith("no matches"):
            return "no matches"
        hits = [int(m.group(1)) for m in
                re.finditer(r"^\S.*? \((\d+) match(?:es)?\)\s*$", r, re.M)]
        if hits:
            return f"{_plural(sum(hits), 'match', 'matches')} in {_plural(len(hits), 'file')}"
    if name in ("list_files", "crawl_codebase", "local_list_files"):
        n = len(lines) - (1 if lines and lines[0].startswith("project:") else 0)
        return _plural(n, "entry", "entries")
    if name == "web_search":
        n = len(re.findall(r"^\d+\. ", r, re.M))
        if n:
            return _plural(n, "result")
    if name == "read_and_summarize":
        n = r.count("Source: ")
        if n:
            return f"summary of {_plural(n, 'source')}"
    if name in ("edit_file", "local_edit_file") and ("find" in a or "replace" in a):
        old = str(a.get("find", "")).splitlines()
        new = str(a.get("replace", "")).splitlines()
        add = rem = 0
        for ln in difflib.unified_diff(old, new, lineterm="", n=0):
            if ln.startswith("+") and not ln.startswith("+++"):
                add += 1
            elif ln.startswith("-") and not ln.startswith("---"):
                rem += 1
        return f"+{add} −{rem}"
    if name in ("write_file", "local_write_file"):
        return ""                      # the title already says how many lines
    if name in ("run_code", "local_shell"):
        m = re.match(r"exit (-?\d+)(?: · [\d.]+s)?([^\n]*)", r)
        out = [ln for ln in r.splitlines()[1 if m else 0:]
               if ln.strip() and not re.match(r"^--- (stdout|stderr) ---$", ln)]
        bits = [f"exit {m.group(1)}"] if m else []
        if m and m.group(2).strip(" ·"):
            bits.append(m.group(2).strip(" ·"))
        bits.append(_plural(len(out), "line") if out else "no output")
        return " · ".join(bits)
    if name == "todo_update":
        todos = parse_todos(r)
        if todos:
            return f"{sum(d for d, _ in todos)}/{len(todos)} done"
    return _summary(r, 70) if lines else ""


def expand_attachments(text: str, cwd: Path | None = None) -> tuple[str, list[str], list[str]]:
    """`@path` words that name a readable local text file are appended to the
    message as fenced blocks, since the agent runs on the server and cannot see
    this machine. Returns (message, attached, skipped-with-reason)."""
    import re
    cwd = cwd or Path.cwd()
    blocks, attached, skipped, seen = [], [], [], set()
    for m in re.finditer(r"(?:^|\s)@(\S+)", text):
        raw = m.group(1).rstrip(".,;:!?)\"'")
        p = Path(os.path.expanduser(raw))
        p = p if p.is_absolute() else cwd / p
        if raw in seen or not p.is_file():
            continue
        seen.add(raw)
        try:
            if p.stat().st_size > ATTACH_LIMIT:
                skipped.append(f"{raw} (over {ATTACH_LIMIT // 1024} KB)")
                continue
            body = p.read_bytes().decode("utf-8")
        except UnicodeDecodeError:
            skipped.append(f"{raw} (not text)")
            continue
        except OSError as e:
            skipped.append(f"{raw} ({e.strerror})")
            continue
        fence = "````" if "```" in body else "```"
        blocks.append(f"File `{raw}`:\n{fence}\n{body.rstrip()}\n{fence}")
        attached.append(raw)
    if blocks:
        text = text + "\n\n" + "\n\n".join(blocks)
    return text, attached, skipped


async def aiter_sse(lines):
    """iter_sse over an async line iterator."""
    buf: list[str] = []
    async for line in lines:
        if line == "":
            if buf:
                yield json.loads("\n".join(buf))
                buf = []
        elif line.startswith("data:"):
            buf.append(line[5:].lstrip(" "))
    if buf:
        yield json.loads("\n".join(buf))


