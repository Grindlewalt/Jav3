def time_bucket(ts, now: float | None = None) -> str:
    from datetime import datetime, timedelta, timezone
    try:
        d = datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
    except (TypeError, ValueError):
        return "Older"
    if d.tzinfo is None:                      # the server's naive timestamps are UTC
        d = d.replace(tzinfo=timezone.utc)
    d = d.astimezone().replace(tzinfo=None)
    today = datetime.fromtimestamp(now if now is not None else time.time()).date()
    day = d.date()
    if day >= today:
        return "Today"
    if day == today - timedelta(days=1):
        return "Yesterday"
    if day > today - timedelta(days=7):
        return "This week"
    if day > today - timedelta(days=31):
        return "This month"
    return "Older"


TIME_BUCKETS = ("Today", "Yesterday", "This week", "This month", "Older")


class AgentTree:
    """/api/chat/agents nodes as a forest: roots (parent_id null, or a parent not
    in the list) grouped by project, each with its descendants in depth order."""

    def __init__(self, nodes: list[dict]) -> None:
        self.by_id = {n["id"]: n for n in nodes if isinstance(n, dict) and "id" in n}
        self.kids: dict = {}
        roots = []
        for n in self.by_id.values():
            p = n.get("parent_id")
            if p is not None and p in self.by_id and p != n["id"]:
                self.kids.setdefault(p, []).append(n)
            else:
                roots.append(n)
        for ks in self.kids.values():
            ks.sort(key=lambda n: str(n.get("started_at") or ""))
        roots.sort(key=lambda n: str(n.get("started_at") or ""), reverse=True)
        roots.sort(key=lambda n: not n.get("running"))
        groups: dict = {}
        for r in roots:
            groups.setdefault(r.get("project") or None, []).append(r)
        self.groups = sorted(groups.items(), key=lambda kv: (kv[0] is None, kv[0] or ""))
        self.roots = [r for _, rs in self.groups for r in rs]

    def descendants(self, root_id) -> list[tuple[dict, int]]:
        out, seen = [], {root_id}

        def walk(pid, depth):
            for k in self.kids.get(pid, []):
                if k["id"] in seen:
                    continue
                seen.add(k["id"])
                out.append((k, depth))
                walk(k["id"], depth + 1)
        walk(root_id, 1)
        return out

    def root_of(self, nid):
        seen = set()
        while nid in self.by_id and nid not in seen:
            seen.add(nid)
            p = self.by_id[nid].get("parent_id")
            if p is None or p not in self.by_id:
                return nid
            nid = p
        return None

    def root_status(self, root_id) -> str:
        """A root's status counts its whole subtree: running if anything under it
        runs, needs_you if anything under it waits on the operator."""
        nodes = [self.by_id[root_id]] + [k for k, _ in self.descendants(root_id)]
        sts = [node_status(k) for k in nodes]
        for s in ("running", "needs_you"):
            if s in sts:
                return s
        return sts[0]

    def needs(self, root_id) -> str | None:
        nodes = [self.by_id[root_id]] + [k for k, _ in self.descendants(root_id)]
        for k in nodes:
            if node_status(k) == "needs_you":
                return k.get("needs") or "waiting on you"
        return None

    def counts(self) -> tuple[int, int, int]:
        nodes = self.by_id.values()
        return (sum(1 for n in nodes if n.get("running")), len(self.by_id),
                len({n.get("project") for n in nodes if n.get("project")}))


def _conv_title(cv: dict) -> str:
    return " ".join(str(cv.get("title") or cv.get("summary") or "").split())


def running_chat_nodes(nodes: list[dict], running, convs: dict) -> tuple[list[dict], list]:
    """Roots for the chats whose own turn runs but that GET /api/chat/agents
    leaves out (a plain chat with no agent work under it: the server only
    counts agent work as a tree), as agents-tree nodes. `running` is
    /api/chat/running, `convs` is id -> a /api/conversations row. Returns the
    extra nodes and the running ids nobody can name (incognito chats are not
    listed; a chat that started a moment ago may not be yet)."""
    have = {n.get("id") for n in nodes if isinstance(n, dict)}
    extra, unknown = [], []
    for cid in running or []:
        if not isinstance(cid, int) or cid in have:
            continue
        cv = convs.get(cid)
        if cv is None:
            unknown.append(cid)
            continue
        extra.append({"id": cid, "parent_id": None, "kind": "chat", "role": "chat",
                      "title": _conv_title(cv), "summary": cv.get("summary") or "",
                      "status": "running", "needs": None, "running": True,
                      "agent_slug": None, "project": cv.get("project_slug"),
                      "model": cv.get("model"), "started_at": cv.get("started_at"),
                      "ended_at": None})
    return extra, unknown


def agent_sections(tr: AgentTree, mode: str = "active",
                   group_by: str = "project") -> list[tuple[str, list[dict]]]:
    """An agents tree as the ← list shows it. Active mode: what runs, then what
    waits on the operator (newest first inside each); finished mode: grouped by
    project or by time."""
    if mode == "active":
        run = [r for r in tr.roots if tr.root_status(r["id"]) == "running"]
        need = [r for r in tr.roots if tr.root_status(r["id"]) == "needs_you"]
        return [("Active", run), ("Needs you", need)]
    if group_by == "time":
        buckets: dict = {}
        # newest first inside each bucket: tr.roots is in project order,
        # which read as shuffled once the rows were grouped by time
        when = lambda r: str(r.get("ended_at") or r.get("started_at") or "")  # noqa: E731
        for r in sorted(tr.roots, key=when, reverse=True):
            buckets.setdefault(time_bucket(when(r)), []).append(r)
        return [(b, buckets[b]) for b in TIME_BUCKETS if b in buckets]
    return [(f"⌂ {p or 'no project'}", rs) for p, rs in tr.groups]


class AgentsFeed:
    """Everything running on the server, whoever started it: the data behind the
    ← screen (and whatever else lists agents, e.g. a drawer), with no widgets.

    GET /api/chat/agents?scope=active is every agent tree with something running
    or waiting: orchestrator plans and their items, schedule runs, agent runs,
    sub-agents. It leaves out a plain chat whose own turn streams, so
    GET /api/chat/running is merged in (named from /api/conversations, fetched
    only when a running id is new), the way the web sidebar's Active group does.
    `api` is the app's async api(method, path) that raises CliError.
    refresh() never raises: a failure lands in `error` and the last data stays."""

    RETRY_S = 10        # how soon a chat the server could not name is looked up again
    FINISHED_PAGE = 500

    def __init__(self, api, convs=None) -> None:
        self.api = api
        self.convs: dict = {}
        self.add_convs(convs)
        self._tried: dict = {}                  # chat id -> when its name was last looked up
        self.trees = {"active": AgentTree([]), "finished": AgentTree([])}
        self.total_finished: int | None = None
        self.finished_full = False              # `finished` holds the whole page, not a count
        self.error: str | None = None

    def add_convs(self, convs) -> None:
        for cv in convs or ():
            if isinstance(cv, dict) and isinstance(cv.get("id"), int):
                self.convs[cv["id"]] = cv

    async def _nodes(self, scope: str, limit: int | None = None):
        q = f"?scope=finished&limit={limit or self.FINISHED_PAGE}" if scope == "finished" \
            else "?scope=active"
        data = await self.api("GET", f"/api/chat/agents{q}")
        nodes = data.get("nodes") if isinstance(data, dict) else None
        return ([n for n in nodes if isinstance(n, dict)] if isinstance(nodes, list) else [],
                data.get("total") if isinstance(data, dict) else None)

    async def _running(self) -> list:
        try:
            data = await self.api("GET", "/api/chat/running")
        except NotLoggedIn:
            raise
        except CliError:
            return []                           # a server without the route: the tree only
        ids = data.get("running") if isinstance(data, dict) else None
        return ids if isinstance(ids, list) else []

    async def _name_chats(self, nodes: list[dict], running: list) -> list[dict]:
        extra, unknown = running_chat_nodes(nodes, running, self.convs)
        # a chat with no name yet is looked up again, but not on every reload
        now = time.monotonic()
        bare = [n["id"] for n in extra if not n["title"]]
        stale = [i for i in unknown + bare if now - self._tried.get(i, -1e9) > self.RETRY_S]
        if stale:
            try:
                self.add_convs((await self.api("GET", "/api/conversations")).get("conversations"))
            except (CliError, AttributeError):
                pass
            for i in stale:
                self._tried[i] = now
            extra, _ = running_chat_nodes(nodes, running, self.convs)
        return extra

    async def refresh(self, full_finished: bool = False) -> None:
        """Reload the active view. The finished side is fetched in full when
        `full_finished` (the Finished view is open) or on the first load; a root
        leaving the active set only re-counts it, so the Finished row stays right."""
        try:
            (nodes, _), running = await asyncio.gather(self._nodes("active"), self._running())
            if nodes and not any("status" in n for n in nodes):
                # an older server ignores `scope` and sends everything: split
                # it here, by whether anything in a root's tree is running
                whole = AgentTree(nodes)
                act, fin = [], []
                for r in whole.roots:
                    grp = act if whole.root_status(r["id"]) in ("running", "needs_you") else fin
                    grp += [r] + [k for k, _ in whole.descendants(r["id"])]
                self.trees.update(active=AgentTree(act), finished=AgentTree(fin))
                self.total_finished, self.finished_full = len(AgentTree(fin).roots), True
            else:
                before = {r["id"] for r in self.trees["active"].roots}
                nodes = nodes + await self._name_chats(nodes, running)
                self.trees["active"] = AgentTree(nodes)
                left = before - {r["id"] for r in self.trees["active"].roots}
                if full_finished or self.total_finished is None:
                    fnodes, total = await self._nodes("finished")
                    self.trees["finished"] = AgentTree(fnodes)
                    self.total_finished = (total if isinstance(total, int)
                                           else len(self.trees["finished"].roots))
                    self.finished_full = True
                elif left:
                    _, total = await self._nodes("finished", limit=1)
                    if isinstance(total, int):
                        self.total_finished, self.finished_full = total, False
            self.error = None
        except CliError as e:
            self.error = str(e)

    def sections(self, mode: str = "active", group_by: str = "project"):
        return agent_sections(self.trees[mode], mode, group_by)


def _age(ts, now: float | None = None) -> str:
    """'12s' / '5m' / '3h' / '2d' since an ISO (naive = UTC) or epoch timestamp."""
    from datetime import datetime, timezone
    if ts in (None, ""):
        return ""
    try:
        if isinstance(ts, (int, float)):
            t = float(ts)
        else:
            d = datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
            if d.tzinfo is None:
                d = d.replace(tzinfo=timezone.utc)
            t = d.timestamp()
    except (ValueError, OverflowError):
        return ""
    s = max(0, int((now if now is not None else time.time()) - t))
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"{s // n}{unit}"
    return f"{s}s"


def session_when(ts, now: float | None = None) -> str:
    """When a chat started, in local time: 'today 04:19', 'yesterday 21:03', else
    '09-27 14:02'. The server's started_at is UTC; '' when it is unreadable."""
    import calendar
    try:
        t = calendar.timegm(time.strptime(str(ts).replace("T", " ")[:16], "%Y-%m-%d %H:%M"))
    except (TypeError, ValueError, OverflowError):
        return ""
    now = time.time() if now is None else now
    day = lambda x: time.strftime("%Y-%m-%d", time.localtime(x))  # noqa: E731
    clock = time.strftime("%H:%M", time.localtime(t))
    if day(t) == day(now):
        return f"today {clock}"
    if day(t) == day(now - 86400):
        return f"yesterday {clock}"
    return time.strftime("%m-%d ", time.localtime(t)) + clock


def _esc(s: str) -> str:
    """Text made safe to splice into Textual markup. textual.markup.escape only
    escapes a `[` that already looks like a whole tag, so an unbalanced one
    ("[startup — …" as a chat title, `test [ -f x` as a command) swallowed the
    markup after it and a later [/] raised MarkupError — a crash. Every `[` is
    escaped here; a single backslash before `[` is the only escape Textual
    knows, so a trailing backslash gets a zero-width space to keep it off the
    tag that follows."""
    s = str(s).replace("[", "\\[")
    return s + "​" if s.endswith("\\") else s


# Diff lines carry a 12% tint of green / red behind them. That is a blend: on a 256-colour
# terminal it rounds to whatever the palette has (olive, black) and in an ANSI theme
# it cannot be blended at all (red text on a red block). The app clears this then.
DIFF_TINT = True


def tool_body(name: str, args, ok: bool | None, result: str | None,
              expanded: bool, cap: int | None = None) -> tuple[str | None, int]:
    """The block under a tool's title, as Textual markup, and how many lines were
    left out. None = the call stays a single line. `cap` overrides the line
    limit (an open row in the transcript shows EXPANDED_LINES)."""
    import difflib
    a = args if isinstance(args, dict) else {}
    cap = cap or (400 if expanded else COLLAPSED_LINES)

    def clip(lines: list[str]) -> tuple[list[str], int]:
        return (lines, 0) if len(lines) <= cap else (lines[:cap], len(lines) - cap)

    if ok is False:
        lines, more = clip((result or "failed").splitlines())
        return "\n".join(f"[$error]{_esc(ln)}[/]" for ln in lines), more
    if name == "edit_file" and ("find" in a or "replace" in a):
        out = []
        for ln in difflib.unified_diff(str(a.get("find", "")).splitlines(),
                                       str(a.get("replace", "")).splitlines(),
                                       lineterm="", n=2):
            if ln.startswith(("---", "+++")):
                continue
            if ln.startswith("@@"):
                out.append("[$text-muted]⋯[/]")
            elif ln.startswith("+"):
                out.append(f"[$success{' on $success 12%' if DIFF_TINT else ''}]{_esc(ln)}[/]")
            elif ln.startswith("-"):
                out.append(f"[$error{' on $error 12%' if DIFF_TINT else ''}]{_esc(ln)}[/]")
            else:
                out.append(f"[$text-muted]{_esc(ln)}[/]")
        lines, more = clip(out)
        return "\n".join(lines) or None, more
    if name == "write_file" and a.get("content"):
        lines, more = clip(str(a["content"]).splitlines())
        return "\n".join(f"[$text-muted]{i:>4}[/]  {_esc(ln)}"
                         for i, ln in enumerate(lines, 1)), more
    if name == "todo_update":
        todos = parse_todos(result or "")
        if todos:
            return "\n".join(f"[$success]✓[/] [$text-muted strike]{_esc(t)}[/]" if done
                             else f"[$warning]☐[/] {_esc(t)}" for done, t in todos), 0
        return None, 0
    if name in ("run_code", "local_shell"):
        # open: the whole command first when its row could not show it
        cmd = str(a.get("command") or a.get("code") or "").strip()
        head = ([f"[$text-muted]$ {_esc(ln)}[/]" for ln in cmd.splitlines()[:COLLAPSED_LINES]]
                if expanded and ("\n" in cmd or len(cmd) > 100) else [])
        if result is None:
            return "\n".join(head) or None, 0
        lines, more = clip((result or "(no output)").rstrip().splitlines() or ["(no output)"])
        return "\n".join(head + [_esc(ln) for ln in lines]), more
    if expanded:
        # an open row: what the title cut short (a sub-agent's task, a message),
        # then what came back
        out = []
        for k, v in a.items():
            if isinstance(v, str) and (len(v) > 60 or "\n" in v.strip()):
                vl = v.strip().splitlines()
                out.append(f"[$text-muted]{_esc(k)}:[/] {_esc(vl[0])}")
                out += [f"  {_esc(ln)}" for ln in vl[1:6]]
                if len(vl) > 6:
                    out.append(f"  [$text-muted]… {len(vl) - 6} more lines[/]")
        lines, more = clip((result or "").rstrip().splitlines())
        out += [f"[$text-muted]{_esc(ln)}[/]" for ln in lines]
        return "\n".join(out) or None, more
    return None, 0


LOGO_GLYPHS = {
    "J": ["  ███", "   █ ", "   █ ", "█  █ ", " ██  "],
    "A": [" ███ ", "█   █", "█████", "█   █", "█   █"],
