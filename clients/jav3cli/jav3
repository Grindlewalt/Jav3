class AgentTree:
    """/api/chat/agents nodes as a forest: roots (parent_id null, or a parent not
    in the list) grouped by project, each with its descendants in depth order."""

    def __init__(self, nodes: list[dict]) -> None:
        self.by_id = {n["id"]: n for n in nodes if isinstance(n, dict) and "id" in n}
        self.kids: dict = {}
        roots = []
        for n in self.by_id.values():
            p = n.get("parent_id")
            if p is not None and p in self.by_id and p != n["id"]:
                self.kids.setdefault(p, []).append(n)
            else:
                roots.append(n)
        for ks in self.kids.values():
            ks.sort(key=lambda n: str(n.get("started_at") or ""))
        roots.sort(key=lambda n: str(n.get("started_at") or ""), reverse=True)
        roots.sort(key=lambda n: not n.get("running"))
        groups: dict = {}
        for r in roots:
            groups.setdefault(r.get("project") or None, []).append(r)
        self.groups = sorted(groups.items(), key=lambda kv: (kv[0] is None, kv[0] or ""))
        self.roots = [r for _, rs in self.groups for r in rs]

    def descendants(self, root_id) -> list[tuple[dict, int]]:
        out, seen = [], {root_id}

        def walk(pid, depth):
            for k in self.kids.get(pid, []):
                if k["id"] in seen:
                    continue
                seen.add(k["id"])
                out.append((k, depth))
                walk(k["id"], depth + 1)
        walk(root_id, 1)
        return out

    def root_of(self, nid):
        seen = set()
        while nid in self.by_id and nid not in seen:
            seen.add(nid)
            p = self.by_id[nid].get("parent_id")
            if p is None or p not in self.by_id:
                return nid
            nid = p
        return None

    def counts(self) -> tuple[int, int, int]:
        nodes = self.by_id.values()
        return (sum(1 for n in nodes if n.get("running")), len(self.by_id),
                len({n.get("project") for n in nodes if n.get("project")}))


def _age(ts, now: float | None = None) -> str:
    """'12s' / '5m' / '3h' / '2d' since an ISO (naive = UTC) or epoch timestamp."""
    from datetime import datetime, timezone
    if ts in (None, ""):
        return ""
    try:
        if isinstance(ts, (int, float)):
            t = float(ts)
        else:
            d = datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
            if d.tzinfo is None:
                d = d.replace(tzinfo=timezone.utc)
            t = d.timestamp()
    except (ValueError, OverflowError):
        return ""
    s = max(0, int((now if now is not None else time.time()) - t))
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"{s // n}{unit}"
    return f"{s}s"


def _esc(s: str) -> str:
    from textual.markup import escape
    return escape(s)


def tool_body(name: str, args, ok: bool | None, result: str | None,
              expanded: bool) -> tuple[str | None, int]:
    """The block under a tool's title, as Textual markup, and how many lines were
    left out. None = the call stays a single line."""
    import difflib
    a = args if isinstance(args, dict) else {}
    cap = 400 if expanded else COLLAPSED_LINES

    def clip(lines: list[str]) -> tuple[list[str], int]:
        return (lines, 0) if len(lines) <= cap else (lines[:cap], len(lines) - cap)

    if ok is False:
        lines, more = clip((result or "failed").splitlines())
        return "\n".join(f"[$error]{_esc(ln)}[/]" for ln in lines), more
    if name == "edit_file" and ("find" in a or "replace" in a):
        out = []
        for ln in difflib.unified_diff(str(a.get("find", "")).splitlines(),
                                       str(a.get("replace", "")).splitlines(),
                                       lineterm="", n=2):
            if ln.startswith(("---", "+++")):
                continue
            if ln.startswith("@@"):
                out.append("[$text-muted]⋯[/]")
            elif ln.startswith("+"):
                out.append(f"[$success on $success 12%]{_esc(ln)}[/]")
            elif ln.startswith("-"):
                out.append(f"[$error on $error 12%]{_esc(ln)}[/]")
            else:
                out.append(f"[$text-muted]{_esc(ln)}[/]")
        lines, more = clip(out)
        return "\n".join(lines) or None, more
    if name == "write_file" and a.get("content"):
        lines, more = clip(str(a["content"]).splitlines())
        return "\n".join(f"[$text-muted]{i:>4}[/]  {_esc(ln)}"
                         for i, ln in enumerate(lines, 1)), more
    if name == "todo_update":
        todos = parse_todos(result or "")
        if todos:
            return "\n".join(f"[$success]✓[/] [$text-muted strike]{_esc(t)}[/]" if done
                             else f"[$warning]☐[/] {_esc(t)}" for done, t in todos), 0
        return None, 0
    if name in ("run_code", "local_shell") and result is not None:
        lines, more = clip((result or "(no output)").rstrip().splitlines() or ["(no output)"])
        return "\n".join(_esc(ln) for ln in lines), more
    if expanded and result:
        lines, more = clip(result.rstrip().splitlines())
        return "\n".join(f"[$text-muted]{_esc(ln)}[/]" for ln in lines), more
    return None, 0


