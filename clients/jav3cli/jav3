    if name == "read_and_summarize":
        urls = a.get("urls") if isinstance(a.get("urls"), list) else []
        first = s("url") or (_short(urls[0], 70) if urls else "")
        return "%", f"Read {first}" + (f" (+{len(urls) - 1} more)" if len(urls) > 1 else "")
    if name == "ask_user":
        qs = a.get("questions") if isinstance(a.get("questions"), list) else []
        q = qs[0].get("question", "") if qs and isinstance(qs[0], dict) else ""
        return "?", f"Ask you {_short(q, 80)}".rstrip()
    if name == "send_message":
        return "✉", f"Message {s('to', 30)}  {s('message', 70)}".rstrip()
    if name == "research":
        return "◈", f"Research {s('topic')}"
    if name == "search_codebase":
        return "✱", f'Grep "{s("query")}"' + (f" in {s('subdir')}" if a.get("subdir") else "")
    if name in ("list_files", "crawl_codebase"):
        return "✱", f"List {s('path') or '.'}"
    if name == "todo_update":
        return "⚙", f"Todo {s('action')} {s('text', 60)}".rstrip()
    if name == "orchestrate":
        first = next((ln for ln in str(a.get("dump", "")).splitlines()
                      if ln.strip() and not ln.strip().endswith(":")), "")
        return "◆", f"Plan {s('title') or _short(first, 70)}".rstrip()
    if name == "plan_status":
        return "◷", "Waiting on the plan" + (f" (up to {a['wait_seconds']}s)"
                                            if a.get("wait_seconds") else "")
    if name in ("spawn_agent", "spawn_temp_agent", "deploy_agents", "orchestrate"):
        who = s("agent") or s("label") or s("title")
