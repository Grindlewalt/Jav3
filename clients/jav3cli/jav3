    def _uptime(s) -> str:
        s = int(_num(s) or 0)
        return (f"{s // 86400}d{s % 86400 // 3600}h" if s >= 86400 else
                f"{s // 3600}h{s % 3600 // 60}m" if s >= 3600 else f"{s // 60}m{s % 60}s")

    def _mins(s) -> str:
        """45s, 4m, 1h05m: the idle-timer words (backend boxes._mins)."""
        s = max(0, int(_num(s) or 0))
        return (f"{s}s" if s < 60 else f"{s // 60}m" if s < 3600
                else f"{s // 3600}h{s % 3600 // 60:02d}m")

    _local_ts = local_ts


    def _box_timer(r) -> str:
        """BACKLOG "Idle timers on /vms box rows": a project box says
        `· idle 4m (stops at 10m)`, the shared box `· scrub after Nm` (N = the
        minutes left) while vm_idle_scrub_seconds > 0. Nothing while a turn
        runs in it or it is stopped."""
        if r.get("state") != "running" or r.get("idle_s") is None or not r.get("stop_after_s"):
            return ""
        if r.get("stop_action") == "stop":
            return (f" [$text-muted]· idle {_mins(r['idle_s'])} "
                    f"(stops at {_mins(r['stop_after_s'])})[/]")
        if r.get("stop_action") == "scrub":
            left = r.get("stops_in_s")
            if left is None:
                left = max(0, int(_num(r["stop_after_s"]) or 0) - int(_num(r["idle_s"]) or 0))
            return f" [$text-muted]· scrub after {_mins(left)}[/]"
        return ""

    def _box_turns(r) -> list[dict]:
        return [t for t in _jlist(r.get("now")) if isinstance(t, dict)]

    def _turn_text(t: dict, width: int = 40, home: str | None = None) -> str:
        """`#42 fix the build shell npm test`: the turn, its title, its tool
        (and its project, when it is not the box's own `home`)."""
        cid = t.get("conversation_id")
        out = f"[b]{'#' + str(cid) if cid else 'a turn'}[/]"
        if t.get("title"):
            out += f" {_esc(_short(t['title'], width))}"
        if t.get("project") and t.get("project") != home:
            out += f" [$text-muted]⌂ {_esc(t['project'])}[/]"
        tool = t.get("tool") if isinstance(t.get("tool"), dict) else {}
        if tool.get("name"):
            out += f" [$secondary]{_esc(tool['name'])}[/]"
            if tool.get("detail"):
                out += f" [$text-muted]{_esc(_short(tool['detail'], width))}[/]"
        return out

    def _box_now(r) -> str:
        """What the box is doing now, for the one-line row."""
        now = _box_turns(r)
        if not now:
            return ""
        more = f" [$text-muted]+{len(now) - 1} more[/]" if len(now) > 1 else ""
        return f" [$text-muted]·[/] {_turn_text(now[0], 32, r.get('project'))}{more}"

    _BOX_EV_COL = {"started": "$success", "restarted": "$success", "stopped": "$text-muted",
                   "idle_stopped": "$text-muted", "wiped": "$warning", "nuked": "$warning",
                   "destroyed": "$warning", "crashed": "$error", "error": "$error"}

    def _box_event_line(ev: dict) -> str:
        """One history line: `● 09-28 14:03 IDLE-STOPPED idle 11m … by reaper`."""
        name = str(ev.get("event") or "?")
        col = _BOX_EV_COL.get(name, "$text-muted")
        word = name.replace("_", "-").upper()
        why = f" {_esc(_short(ev['reason'], 90))}" if ev.get("reason") else ""
        who = f" [$text-muted]by {_esc(str(ev['actor']))}[/]" if ev.get("actor") else ""
        return (f"[{col}]●[/] [$text-muted]{_local_ts(ev.get('created_at'))}[/] "
                f"[{col} b]{word:<12}[/]{why}{who}")

    def _box_state_word(r) -> tuple[str, str]:
        """(colour, word): running | starting | failed | stopped."""
        st, act = r.get("state") or "?", r.get("activity")
        if act == "failed":
            return "$error", "failed"
        if act == "starting":
            return "$warning", "starting"
        return ("$success" if st == "running" else "$text-muted"), st

    def _row_box(e) -> str:
        r = e["raw"]
        st = r.get("state") or "?"
        col, word = _box_state_word(r)
        img = r.get("image") or {}
        projs = [str(p) for p in _jlist(r.get("projects"))] or (
            [str(r["project"])] if r.get("project") else [])
        where = (f" ⌂ {_esc(projs[0])}" + (f" +{_esc(','.join(projs[1:]))}" if projs[1:] else "")
                 if projs else "")
        up = (f" · up {_uptime(r.get('uptime_s'))} · rss {_bytes(r.get('rss_bytes'))}B · cpu "
              f"{_num(r.get('cpu_pct')) or 0:.0f}%" if st == "running" else "")
        busy = (f" [$accent]{r.get('inflight')} turn{'s' * (r.get('inflight') != 1)}[/]"
                if r.get("inflight") and not _box_turns(r) else "")
        err = (f" [$error]✗ {_esc(_short(r['last_error'], 50))}[/]"
               if r.get("last_error") else "")
        last = r.get("last_event") if isinstance(r.get("last_event"), dict) else None
        was = (f" [$text-muted]· {_esc(str(last.get('event') or '').replace('_', '-'))} "
               f"{_local_ts(last.get('created_at'))}[/]"
               if st != "running" and last and not err else "")
        kind = "" if r.get("kind") == r.get("id") else _esc(str(r.get("kind") or ""))
        meta = f"[$text-muted]{kind}{where}[/] " if kind or where else ""
        return (f"[{col}]●[/] [b]{_esc(r.get('id') or '?')}[/] {_runtime_tag(r.get('runtime'))} "
                f"{meta}[{col}]{_esc(word)}[/]"
                f"{_box_timer(r)}{_box_now(r)}{busy}{err}{was} [$text-muted]· "
                f"{r.get('mem_mb') or '?'}MB · {_esc(img.get('variant') or 'main')}"
                f"{' v' + str(img['version']).lstrip('v') if img.get('version') else ''}{up}[/]")

    def _row_leftover(e) -> str:
        r = e["raw"]
        mark = "[$warning]▲[/]" if r.get("cleanable") else "[$text-muted]△[/]"
        size = f" · {_bytes(r['bytes'])}B" if r.get("bytes") else ""
        return (f"{mark} [b]{_esc(r.get('name') or '?')}[/] [$text-muted]"
                f"{_esc(r.get('type') or '')}{size} · {_esc(_short(r.get('why') or '', 90))}[/]")

    def _row_variant(e) -> str:
        r = e["raw"]
        users = _jlist(r.get("used_by"))
        return (f"[$accent b]{_esc(r.get('name') or '?')}[/] [$text-muted]from "
                f"{_esc(r.get('from') or 'base')}{' · builtin' if r.get('builtin') else ''}"
                f" · min {r.get('min_mem_mb') or '?'}MB · used by "
                f"{_esc(', '.join(users)) if users else 'no project'}[/]"
                + (" [$text-muted]·[/] [$warning b]needs a build[/]" if r.get("needs_build")
                   else ""))

    def _row_version(e) -> str:
        r = e["raw"]
        st = r.get("status") or "?"
        col = ("$success" if st in ("built", "ready") else
               "$error" if st == "failed" else "$warning")
        active = " [$primary b]active[/]" if r.get("active") else ""
        inuse = _jlist(r.get("in_use_by"))
        return (f"  [$text-muted]v[/]{_esc(str(r.get('version') or '?'))}{active} "
                f"[{col}]{_esc(st)}[/] [$text-muted]{_bytes(r.get('size_bytes'))}B · built "
                f"{_esc(full_ts(r.get('built_at')) or '-')} · in use by "
                f"{_esc(', '.join(map(str, inuse))) if inuse else 'no box'}"
                f"{' · older recipe' if r.get('stale_recipe') else ''}[/]")

