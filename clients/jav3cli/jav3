        def _count(self, tab: str, n: int | None = None):
            """A tab's count for the tab bar: None before it loads, and a '?' when a
            load failed, so an unreachable server never reads as 'nothing waits'."""
            if not self.loaded[tab]:
                return None
            n = len(self.entries[tab]) if n is None else n
            return (f"{n}?" if n else "?") if self.errors[tab] else n

