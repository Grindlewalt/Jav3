        @staticmethod
        def _paths(r: dict) -> list[str]:
            p = r.get("paths")
            if isinstance(p, str):
                try:
                    p = json.loads(p)
                except ValueError:
                    p = [p]
            return [str(x) for x in p or []]

        # -- drawing ----------------------------------------------------------------------

        # short tab names for a window under 80 columns: eight tabs must fit, and the
        # active one must be on screen
        SHORT = {"network": "Net", "secrets": "Sec", "persistent": "Proc", "profiles": "Prof"}

        def render_chrome(self) -> None:
            n = self.counts()
            narrow = self.size.width < 80
            for t in self.TABS:
                lab = (self.SHORT.get(t) if narrow else None) or self.LABELS[t]
                if not self.locked and n.get(t) is not None:
                    lab += f" {n[t]}"
                w = self.query_one(f"#sec-tab-{t}", SecTab)
                w.update(lab)
                w.set_class(t == self.tab, "-on")
            self.query_one("#sec-tabs").scroll_to_widget(
                self.query_one(f"#sec-tab-{self.tab}", SecTab), animate=False)
            self.query_one("#sec-sub", Static).update(self.sub_markup())
            self.render_foot()

        def foot_keys(self) -> str:
            """This tab's keys. On the Queue they follow the selected row: an approval
            takes y / n, an alert only a (there is nothing to approve in an alert)."""
            if self.tab == "queue" and not self.locked:
                e = self.selected()
                if e is not None and e["type"] == "alert":
                    return "[$primary]a[/] acknowledge"
                if e is not None:
                    return "[$primary]y[/] approve  [$primary]n[/] deny"
            return self.FOOT[self.tab]

        def _live(self) -> bool:
            return False

        def render_foot(self) -> None:
            from textual.content import Content
            common = self.common_foot(live=self._live())
            line = common if self.locked else f"{self.foot_keys()}   {common}"
            extras = self.foot_extras()
            if extras:
                # an extra never splits across two lines: it goes on its own line
                # when it does not fit after the keys
                room = max(20, self.size.width - 4)
                fits = (len(Content.from_markup(line).plain) + 2
                        + len(Content.from_markup(extras).plain) <= room)
                line += ("  " if fits else "\n") + extras
            self.query_one("#sec-foot", Static).update(line)

        TIMED = ("queue", "network", "logs", "persistent", "rules", "calls")

        def _tight(self) -> bool:
            """A small terminal (under 100 columns or 30 rows): heads use their short
            form, so the list keeps some rows."""
            return self.size.width < 100 or self.size.height < 30

        def foot_extras(self) -> str:
            """What the footer adds when it applies: [ ] scrolls a pane that overflows,
            and the times on the rows are this machine's (the server keeps UTC)."""
            self._more = False if self.locked else self._detail_more()
            bits = []
            if self._more:
                bits.append(f"[$primary]{_esc('[ ]')}[/] scroll the details")
            if self.tab in self.TIMED and not self.locked:
                bits.append(f"[$text-muted]times {_esc(tz_label())}[/]")
            return "  ".join(bits)

        def common_foot(self, live: bool = False) -> str:
            """The keys every tab has."""
            return (f"[$primary]tab → ←[/] tabs  [$primary]1-{len(self.TABS)}[/] jump  "
                    "[$primary]↑↓[/] select  "
                    + ("" if live else "[$primary]r[/] refresh  ")
                    + "[$primary]esc[/] back"
                    + ("  [$text-muted](live)[/]" if live else ""))

        def sub_markup(self) -> str:
            if self.locked:
                return f"[$warning b]{_esc(self.locked_text())}[/]"
            if self.errors[self.tab] and not self.entries[self.tab]:
                # nothing came back: no '0 hosts waiting' over a queue that never loaded
                return "\n".join(
                    [f"[$error b]could not load the {self.LABELS[self.tab].lower()} tab — "
                     "r retries[/]"]
                    + [f"[$error]{_esc(x)}[/]" for x in collapse_errors(self.errors[self.tab])]
                    + ([self.status] if self.status else []))
            bits = []
            if self.tab == "queue":
                es = self.entries["queue"]
                eg = sum(e["type"] == "egress" for e in es)
                gt = sum(e["type"] == "git" for e in es)
                al = sum(e["type"] == "alert" for e in es)
                sv = sum(e["type"] == "service" for e in es)
                pk = sum(e["type"] == "package" for e in es)
                extra = ""
                if sv or pk:
                    extra = (f"{sv} service{'s' * (sv != 1)} · {pk} package"
                             f"{'s' * (pk != 1)} · ")
                bits.append(f"[$text-muted]{eg} host{'s' * (eg != 1)} waiting · {gt} git "
                            f"request{'s' * (gt != 1)} · {extra}{al} alert{'s' * (al != 1)} "
                            "to acknowledge · every project[/]")
            elif self.tab == "network":
                bits.append(self.net_markup())
            elif self.tab == "logs":
                kinds = self.log_kinds()
                bits.append("  ".join(f"[$primary b] {_esc(k)} [/]" if k == self.log_filter
                                      else f"[$text-muted]{_esc(k)}[/]" for k in kinds)
                            + "  [$text-muted]· newest first[/]")
            elif self.tab == "persistent":
                es = self.entries["persistent"]
                boxes = [e for e in es if e["type"] == "pbox"]
                nb = sum(1 for e in boxes if e["raw"].get("reported_at"))
                waiting = len(boxes) - nb
                bad = _tree_bad_count([n for b in self._last_boxes for n in b.get("tree") or []])
                orph = sum(e["type"] == "orphan" for e in es)
                if self.procs_enabled is False:
                    bits.append("[$warning b]boxes are off[/] [$text-muted](vm_boxes_enabled): "
                                "there is no process view; approved services are listed "
                                "below[/]")
                else:
                    bits.append(f"[$text-muted]{nb} box{'es' * (nb != 1)} reporting"
                                + (f" · {waiting} waiting for a first report" if waiting else "")
                                + " · non-OS processes only · guest-reported vs "
                                  "host-verified bytes[/]"
                                + (f"  {RED} {bad} need a look [/]" if bad else "")
                                + (f"  {RED} {orph} possibly hidden process"
                                   f"{'es' * (orph != 1)} [/]" if orph else ""))
            elif self.tab == "profiles":
                bits.append("[$text-muted]a profile is a project's security baseline: "
                            "network, secrets by name, box runtime, service placement[/]")
            elif self.tab == "rules":
                bits.append("[$text-muted]\"always allow\" answers to permission asks: one "
                            "tool and one command or path prefix per project[/]")
            elif self.tab == "calls":
                bits.append(calls_sub(self.calls_meta,
                                      self.conversation if self.calls_only else None))
            elif self.tab != "secrets":
                bits.append(self.vms_sub())
            else:
                bits.append("[$text-muted]names and bound hosts only — a value is written, "
                            "never read back[/]")
            if self.status:
                bits.append(self.status)
            bits += [f"[$error]{_esc(x)}[/]" for x in collapse_errors(self.errors[self.tab])]
            return "\n".join(bits)

        def net_markup(self) -> str:
            pol = self.net.get("policy") or {}
            summ = self.net.get("summary") or {}
            where = (f"[b]⌂ {_esc(self.project)}[/]" if self.project
                     else "[b]all projects[/]")
            line = where
            if not self.project and pol and "profile" in pol and self._tight():
                line += "  [$text-muted]grouped by project; the rest follows the profile[/] " \
                        f"[b]{_esc((pol.get('profile') or {}).get('name') or '?')}[/]"
            elif not self.project and pol and "profile" in pol:
                prof = pol.get("profile") or {}
                line += ("  [$text-muted]grouped by project: each project's own allow and "
                         "deny lists over its profile's baseline[/]\n[$text-muted]traffic "
                         "with no project (the shared box outside a turn) follows[/] "
                         f"[b]{_esc(prof.get('name') or '?')}[/] [$text-muted]("
                         f"{_esc(prof.get('default') or '?')} by default); allowing it "
                         "names a project[/]")
            elif pol and ("project_allow" in pol or "profile" in pol):
                prof = pol.get("profile") or {}
                line += (f"  [$text-muted]profile[/] [b]{_esc(prof.get('name') or '?')}[/] "
                         f"[$text-muted]({_esc(prof.get('default') or '?')} by default) · "
                         f"{len(_jlist(pol.get('effective_allow')))} allowed, "
                         f"{len(_jlist(pol.get('effective_deny')))} denied in effect[/]")
            elif not self.project:
                line += ("  [$text-muted]grouped by project: each project's own allow and "
                         "deny lists over its profile's baseline[/]")
                if pol:
                    eff = pol.get("effective") or []
                    line += (f"\n[$text-muted]general baseline[/] [b]"
                             f"{_esc(pol.get('mode') or '?')}[/] [$text-muted]· {len(eff)} "
                             f"host{'s' * (len(eff) != 1)}"
                             + (": " + _esc(_short(", ".join(eff), 70)) if eff else "") + "[/]")
            elif pol:
                mode = pol.get("mode") or "?"
                src = pol.get("source")
                if not self.project:
                    how = "general baseline"
                elif src == "general":
                    how = "no own policy: uses the general list"
                else:
                    how = "own policy" + (" + general" if pol.get("inherit_general")
                                          and mode == "allowlist" else "")
                eff = pol.get("effective") or []
                line += (f"  [$text-muted]policy[/] [b]{_esc(mode)}[/] [$text-muted]"
                         f"({_esc(how)}) · {len(eff)} host{'s' * (len(eff) != 1)}"
                         + (": " + _esc(_short(", ".join(eff), 70)) if eff else "") + "[/]")
            if summ:
                line += (f"\n[$text-muted]last 24h:[/] [$success]{summ.get('allowed', 0)} "
                         f"allowed[/] [$text-muted]·[/] [$error]{summ.get('denied', 0)} "
                         f"denied[/] [$text-muted]·[/] [$warning]{summ.get('waiting', 0)} "
                         "waiting[/] [$text-muted](distinct hosts; verdicts in Queue)[/]")
            return line

        def on_resize(self, event) -> None:
            """Calls rows have a compact form under 100 columns: draw them again
            when a resize crosses that width."""
            narrow = self.size.width < 100
            if narrow != getattr(self, "_narrow", narrow) and self.tab == "calls" \
                    and type(self) is SecurityPage:
                self.run_worker(self.rebuild(), group="rebuild", exclusive=True)
            self._narrow = narrow
            tight = self._tight()
            if (tight, self.size.width < 80) != getattr(self, "_was_tight", (tight, self.size.width < 80)):
                self.render_chrome()                       # the head and tab names have short forms
            self._was_tight = (tight, self.size.width < 80)
            self.call_after_refresh(self._foot_again)

        async def rebuild(self) -> None:
            async with self._lock:
                shown = [] if self.locked else self.shown()
                keys = [e["key"] for e in shown]
                if self.sel[self.tab] not in keys:
                    self.sel[self.tab] = keys[0] if keys else None
                allp = self.project is None
                marks = [self.row_markup(e, allp, self.size.width < 100) for e in shown]
                sig = (self.tab, self.locked, self.loaded[self.tab], tuple(keys), tuple(marks),
                       bool(self.errors[self.tab]))
                if sig != self._sig:
                    self._sig = sig
                    if self.locked:
                        rows = [SecRow("[$text-muted]nothing to show until you are logged in "
                                       "with a password[/]", None)]
                    elif not shown and self.loaded[self.tab] and self.errors[self.tab]:
                        rows = [SecRow("[$error]could not load — r retries[/]", None)]
                    elif not shown:
                        msg = self.empty_text() if self.loaded[self.tab] else "loading…"
                        rows = [SecRow(f"[$text-muted]{msg}[/]", None)]
                    else:
                        rows = [SecRow(m, k) for m, k in zip(marks, keys)]
                    lst = self.query_one("#sec-list", VerticalScroll)
                    with self.app.batch_update():
                        await lst.remove_children()
                        await lst.mount_all(rows)
                self.refresh_sel()
                self.render_chrome()

        def empty_text(self) -> str:
            if self.tab == "persistent" and self.procs_enabled is False:
                return "boxes are off: no processes are watched and no service is approved"
            return self.EMPTY[self.tab]

        def refresh_sel(self) -> None:
            target = None
            for row in self.query(SecRow):
                on = row.key is not None and row.key == self.sel[self.tab]
                row.pick(on)
                if on:
                    target = row
            if target is not None:
                target.scroll_visible(animate=False)
            self.query_one("#sec-detail", Static).update(
                "" if self.locked else self.detail_markup(self.selected()))
            self.render_foot()
            here = (self.tab, self.sel[self.tab])
            if here != getattr(self, "_detail_for", None):
                self._detail_for = here
                self.query_one("#sec-detail-wrap", VerticalScroll).scroll_home(animate=False)
            self.call_after_refresh(self._foot_again)

        # -- keys -------------------------------------------------------------------------

        async def switch_to(self, i: int) -> None:
            tab = self.TABS[i % len(self.TABS)]
            if tab == self.tab:
                return
            self.tab, self.status = tab, ""
            await self.rebuild()
            if not self.locked:
                self.run_worker(self.load(tab), group="sec-load", exclusive=True)

        async def action_cycle(self, d: int) -> None:
            await self.switch_to(self.TABS.index(self.tab) + d)

        async def action_jump(self, i: int) -> None:
            if i < len(self.TABS):
                await self.switch_to(i)

        def action_move(self, d: int) -> None:
            keys = [e["key"] for e in self.shown()]
            if not keys or self.locked:
                return
            cur = self.sel[self.tab]
            i = keys.index(cur) + d if cur in keys else 0
            self.sel[self.tab] = keys[max(0, min(len(keys) - 1, i))]
            self.refresh_sel()

        def select_key(self, key: str) -> None:
            self.sel[self.tab] = key
            self.refresh_sel()

        def action_page(self, d: int) -> None:
            lst = self.query_one("#sec-list", VerticalScroll)
            if lst.max_scroll_y <= 0:            # the list fits: the pane under it is what pages
                self.action_detail(d)
                return
            lst.scroll_page_up() if d < 0 else lst.scroll_page_down()

        def action_detail(self, d: int) -> None:
            """[ and ] (PgUp / PgDn when the list is short) scroll the pane under the list:
            a diff or an evidence block runs past it, and Terminal.app has no shift+arrows."""
            wrap = self.query_one("#sec-detail-wrap", VerticalScroll)
            wrap.scroll_page_up(animate=False) if d < 0 else wrap.scroll_page_down(animate=False)
            self.call_after_refresh(self._foot_again)

        def _detail_more(self) -> bool:
            wrap = self.query_one("#sec-detail-wrap", VerticalScroll)
            return wrap.max_scroll_y > 0

        def _foot_again(self) -> None:
            """The footer names [ ] when the pane overflows; layout settles after the
            text changes, so this runs once it has."""
            if self._detail_more() != getattr(self, "_more", False):
                self.render_chrome()

        async def action_reload(self) -> None:
            if not self.locked:
                await self.load(self.tab)

        def action_back(self) -> None:
            self.leave()

        def _act(self, coro) -> None:
            if self.locked:
                coro.close()
                return
            self.run_worker(coro, group="sec-act", exclusive=True)

        def action_approve(self) -> None:
            if self.tab == "queue":
                self._act(self._verdict(True))
            elif self.tab == "network":
                self._act(self._net_host(True))

        def action_deny(self) -> None:
            if self.tab == "queue":
                self._act(self._verdict(False))
            elif self.tab == "network":
                self._act(self._net_host(False))

        def action_promote(self) -> None:
            if self.tab == "network":
                self._act(self._promote())

        def action_a(self) -> None:
            if self.tab in ("queue", "logs"):
                self._act(self._ack())
            elif self.tab == "secrets":
                self._act(self._add_secret())
            elif self.tab == "profiles":
                self._act(self._profile_form(None))

        def action_project(self) -> None:
            if self.tab == "network":
                self._act(self._pick_project())
            elif self.tab == "profiles":
                self._act(self._assign_profile())

        def action_stop(self) -> None:
            if self.tab == "persistent":
                self._act(self._stop_service())

        def action_logs(self) -> None:
            if self.tab == "persistent":
                self._act(self._service_logs())

        def action_edit(self) -> None:
            if self.tab == "network":
                self._act(self._edit_policy())
            elif self.tab == "profiles":
                e = self.selected()
                if e is not None and e["type"] == "profile":
                    self._act(self._profile_form(e["raw"]))

        def action_build(self) -> None:
            pass

        async def action_enter(self) -> None:
            if self.locked:
                self.run_worker(self._login_from_here(), group="sec-act", exclusive=True)
                return
            e = self.selected()
            if e is None:
                return
            if e["type"] == "proc" and e["raw"].get("children"):
                self.open_nodes ^= {e["key"]}
                self.entries["persistent"] = self.persistent_entries_again()
                await self.rebuild()
            elif e["type"] == "profile":
                self._act(self._show_profile(e))            # a dialog needs a worker
            elif e["type"] == "call":
                self._act(self._view_call_context(e))       # a dialog needs a worker

        async def _show_profile(self, e: dict) -> None:
            await self.app.push_screen_wait(View(
                f"Profile {e['raw'].get('name') or ''}", "\n".join(_profile_lines(e["raw"]))))

        def persistent_entries_again(self) -> list[dict]:
            """Re-flatten the last report with the new open set (no request)."""
            return self.persistent_entries(self._last_boxes, self._last_services,
                                           self.open_nodes)

        def action_filter(self) -> None:
            if self.tab == "logs" and not self.locked:
                self._act(self._pick_kind())

        async def _pick_kind(self) -> None:
            """f opens the kinds as a list (there are a dozen and more): type to find
            one, enter keeps it. The chips above the log show which is on."""
            n: dict[str, int] = {}
            for e in self.entries["logs"]:
                k = str(e["raw"].get("kind") or "")
                if k:
                    n[k] = n.get(k, 0) + 1
            rows = [("all", "all kinds", f"{len(self.entries['logs'])}")]
            rows += [(k, k, str(n[k])) for k in sorted(n)]
            v = await self.app.pick("Show one kind of event", rows, self.log_filter)
            if v and v != self.log_filter:
                self.log_filter = v
                await self.rebuild()

        def action_hosts(self) -> None:
            if self.tab == "secrets":
                self._act(self._edit_hosts())

        def action_rotate(self) -> None:
            if self.tab == "secrets":
                self._act(self._rotate())

        def action_delete(self) -> None:
            if self.tab == "secrets":
                self._act(self._delete_secret())
            elif self.tab == "persistent":
                self._act(self._revoke_service())
            elif self.tab == "profiles":
                self._act(self._delete_profile())
            elif self.tab == "rules":
                self._act(self._delete_rule())

        # -- actions ------------------------------------------------------------------

        async def _send(self, method: str, path: str, done: str, **kw) -> bool:
            self.last = {}
            try:
                r = await self.app.api(method, path, **kw) or {}
            except CliError as e:
                self.status = f"[$error]{_esc(str(e))}[/]"
                ok = False
            else:
                if isinstance(r, dict) and r.get("ok") is False:
                    self.status = f"[$error]{_esc(str(r.get('error') or 'refused'))}[/]"
                    ok = False
                else:
                    self.last = r if isinstance(r, dict) else {}
                    into = (f" (added to {r['added_to']})"
                            if isinstance(r, dict) and r.get("added_to") else "")
                    self.status = f"[$success]{_esc(done + into)}[/]"
                    ok = True
            await self.load(self.tab, draw=False)
            for t in self.COUNTED:                     # the header's counts
                if t != self.tab:
                    await self.load(t, draw=False)
            await self.rebuild()
            return ok

        async def _confirm(self, q: str, detail: str) -> bool:
            return bool(await self.app.push_screen_wait(Confirm(q, detail, strict=True)))

        async def _verdict(self, yes: bool) -> None:
            e = self.selected()
            if e is not None and e["type"] == "service":
                await (self._approve_service(e["raw"]) if yes
                       else self._reject("service", e["raw"]))
                return
            if e is not None and e["type"] == "package":
                await (self._approve_package(e["raw"]) if yes
                       else self._reject("package", e["raw"]))
                return
            if e is not None and e["type"] == "alert":
                self.status = ("[$warning]an alert is not an approval: a acknowledges it, "
                               "the detail below says what happened[/]")
                self.render_chrome()
                return
            if e is None or e["type"] not in ("egress", "git"):
                return
            r = e["raw"]
            if e["type"] == "egress":
                host, proj = r.get("host") or "?", r.get("project_slug") or "general"
                body = None
                if yes and (r.get("project_slug") or self.GENERAL) == self.GENERAL:
                    # unattributed (the shared box, no turn): an approval writes a
                    # project's own list, so the operator names the project
                    slug = await self._pick_slug(
                        f"{host} came from the shared box with no project: allow it for")
                    if slug is None:
                        return
                    body, proj = {"project": slug}, slug
                seen = (f"Asked {r.get('hit_count') or 0}× (first {full_ts(r.get('first_seen')) or '?'},"
                        f" last {full_ts(r.get('last_seen')) or '?'}).")
                review = (f" Reviewer: {r.get('triage_verdict')}"
                          f"{' — ' + r['triage_reason'] if r.get('triage_reason') else ''}."
                          if r.get("triage_verdict") else "")
                if yes:
                    q = f"Allow {host} for {proj}?"
                    detail = (f"Adds exactly '{host}' to {proj}'s own allow list (its "
                              "profile's baseline is unchanged; a deny on either still "
                              f"wins). {proj}'s boxes may then reach {host} through the "
                              f"proxy, any method and path. {seen}{review}")
                else:
                    q = f"Reject {host} for {proj}?"
                    detail = (f"Nothing is added to any allowlist; {host} stays blocked. If "
                              f"the guest asks for it again it re-queues. {seen}{review}")
                verb = "approve" if yes else "reject"
                if await self._confirm(q, detail):
                    await self._send("POST", f"/api/egress/pending/{r.get('id')}/{verb}",
                                     f"{'allowed' if yes else 'rejected'} {host}"
                                     + (f" for {proj}" if body else ""),
                                     **({"json": body} if body else {}))
                return
            slug, rid = r.get("project_slug") or "?", r.get("id")
            remote = r.get("kind") == "remote"
            if yes and remote:
                q = f"Connect {slug} to {r.get('message')}?"
                detail = ("Verifies the remote is reachable with the stored git token, sets "
                          f"it as {slug}'s remote and pushes the existing commits to it. If "
                          "the check fails nothing changes and the request stays pending.")
            elif yes:
                paths = self._paths(r)
                q = f"Commit in {slug}: “{_short(r.get('message') or '', 60)}”?"
                detail = (f"Runs git add on {', '.join(paths) if paths else 'ALL changes'} "
                          f"and commits them to {slug}'s repository with that message, as "
                          "Jav3. Nothing is pushed. If the commit fails the request stays "
                          "pending with the error.")
            else:
                q = f"Reject {'remote' if remote else 'commit'} request #{rid} in {slug}?"
                detail = ("Marks the request rejected. Nothing is committed, pushed or "
                          "connected; the files stay as they are in the workspace.")
            verb = "approve" if yes else "reject"
            if await self._confirm(q, detail):
                await self._send("POST", f"/api/projects/{slug}/git/requests/{rid}/{verb}",
                                 f"{'approved' if yes else 'rejected'} request #{rid}")

        async def _ack(self) -> None:
            e = self.selected()
            if e is None or e["type"] not in ("alert", "log") or e["raw"].get("acknowledged"):
                return
            r = e["raw"]
            q = f"Acknowledge alert #{r.get('id')}?"
            detail = (f"{r.get('kind') or '?'} ({r.get('severity') or 'info'}): "
                      f"{_short(r.get('summary') or '', 120)}. Marks it seen: it leaves the "
                      "queue and stays in the log. Nothing else changes; a cut host stays "
                      "cut and a flagged write stays where the gate put it.")
            if await self._confirm(q, detail):
                await self._send("POST", f"/api/security/events/{r.get('id')}/ack",
                                 f"acknowledged #{r.get('id')}")

        async def _pick_project(self) -> None:
            try:
                ps = (await self.app.api("GET", "/api/projects") or {}).get("projects") or []
            except CliError as e:
                self.status = f"[$error]{_esc(str(e))}[/]"
                self.render_chrome()
                return
            rows = [("*", "all projects", "the general baseline policy")] + [
                (p["slug"], p.get("name") or p["slug"], p["slug"]) for p in ps if p.get("slug")]
            v = await self.app.push_screen_wait(Picker("Network: which project", rows,
                                                       self.project or "*"))
            if v is None:
                return
            self.project = None if v == "*" else v
            self.entries["network"], self.net = [], {}
            self.loaded["network"] = False
            await self.rebuild()
            await self.load("network")

        def _secret(self) -> dict | None:
            e = self.selected()
            return e["raw"] if e is not None and e["type"] == "secret" else None

        @staticmethod
        def _hosts(raw: str) -> list[str]:
            return [h.strip() for h in raw.split(",") if h.strip()]

        async def _add_secret(self) -> None:
            name = await self.app.push_screen_wait(Ask(
                "New secret: name (letters, digits, underscores; stored upper-case)"))
            name = (name or "").strip().upper()
            if not name:
                return
            if any(e["raw"].get("name") == name for e in self.entries["secrets"]):
                if not await self._confirm(
                        f"{name} already exists. Replace its value?",
                        "The stored value is overwritten; its bound hosts stay unless you "
                        "change them next. The old value cannot be recovered."):
                    return
            value = await self.app.push_screen_wait(Ask(
                f"Value for {name} (hidden; stored host-side, never shown again)",
                secret=True))
            if not value:
                return
            hosts = await self.app.push_screen_wait(Ask(
                f"Web hosts {name} may be sent to, comma-separated (empty = unusable)"))
            if hosts is None:
                return
            await self._send("PUT", f"/api/secrets/{name}", f"saved {name}",
                             json={"value": value, "hosts": self._hosts(hosts)})

        async def _edit_hosts(self) -> None:
            s = self._secret()
            if s is None:
                return
            hosts = await self.app.push_screen_wait(Ask(
                f"Web hosts for {s['name']}, comma-separated (empty = unusable)",
                value=", ".join(s.get("hosts") or [])))
            if hosts is None:
                return
            # value '' keeps the stored value: a hosts-only edit
            await self._send("PUT", f"/api/secrets/{s['name']}", f"hosts saved for {s['name']}",
                             json={"value": "", "hosts": self._hosts(hosts)})

        async def _rotate(self) -> None:
            s = self._secret()
            if s is None:
                return
            value = await self.app.push_screen_wait(Ask(
                f"New value for {s['name']} (hidden; replaces the stored one)", secret=True))
            if not value:
                return
            # hosts omitted: the server keeps the bound hosts
            await self._send("PUT", f"/api/secrets/{s['name']}", f"new value for {s['name']}",
                             json={"value": value})

        async def _delete_secret(self) -> None:
            s = self._secret()
            if s is None:
                return
            if await self._confirm(
                    f"Delete secret {s['name']}?",
                    f"Removes {s['name']} and its value from the host for good. Prompts and "
                    f"projects that use {{{{secret:{s['name']}}}}} stop getting it; there "
                    "is no undo."):
                await self._send("DELETE", f"/api/secrets/{s['name']}",
                                 f"deleted {s['name']}")

        # -- services, packages, policy, profiles ----------------------------------------

        def _fail(self, msg: str) -> None:
            self.status = f"[$error]{_esc(msg)}[/]"
            self.render_chrome()

        async def _approve_service(self, r: dict) -> None:
            sid, name = r.get("id"), r.get("name") or "?"
            diff = None
            if r.get("supersedes_id"):
                try:
                    diff = (await self.app.api("GET", f"/api/services/{sid}") or {}).get("diff")
                except CliError as e:
                    self._fail(f"could not read the diff: {e}")
                    return
            pick = await self.app.push_screen_wait(ServiceApprove(r, diff, self.lan_ip))
            if not pick:
                return
            pl = pick["placement"]
            expose = [{"port": port, "bind": "lan" if how == "lan" else "loopback"}
                      for port, how in pick["expose"]]
            ports = "; ".join(
                f"port {x['port']} on "
                + (f"the services LAN address {self.lan_ip}" if x["bind"] == "lan"
                   else "host loopback only")
                + " through the metered relay" for x in expose) or "no port exposed"
            hosts = ", ".join(map(str, _jlist(r.get("egress_hosts")))) or "no host"
            detail = (f"Approves the content-hashed artifact sha256 "
                      f"{r.get('artifact_sha256') or '?'} for {r.get('project_slug') or '?'} "
                      f"and runs `{_argv(r.get('command'))}` (restart "
                      f"{r.get('restart') or 'no'}) in {PLACEMENT_SAYS[pl]} "
                      f"[placement {pl}"
                      + ("" if pl == r.get("placement") else
                         f", changed from the profile's {r.get('placement') or 'none'}")
                      + f"]. Egress: deny by default; allowed only {hosts} minus the "
                      f"profile and project deny lists. Inbound: {ports}. It starts now and "
                      "on every boot until stopped or revoked; a code change is a new "
                      "request.")
            if await self._confirm(f"Approve service {name} as {pl}?", detail):
                await self._send("POST", f"/api/services/{sid}/approve",
                                 f"approved service {name} ({pl})",
                                 json={"acknowledge": True, "placement": pl,
                                       "expose_ports": expose})

        async def _approve_package(self, r: dict) -> None:
            pid, variant = r.get("id"), r.get("target_variant") or "?"
            what = (f"{r.get('manager') or '?'} {r.get('package') or '?'}"
                    f"{' ' + r['resolved_version'] if r.get('resolved_version') else ''}")
            via, card = _pkg_users(r), _pkg_card(r)
            detail = (f"{card[:1].upper() + card[1:]}{' (' + via + ')' if via else ''}. Every project on "
                      f"`{variant}` gets it: a new version of the image is built with "
                      f"`{r.get('canonical_command') or '?'}` (the host's canonical command; "
                      f"the agent's `{r.get('requested_command') or '?'}` never runs) and "
                      "boxes pick it up at their next boot. The image in use now is not "
                      "changed.")
            if await self._confirm(f"Approve {what} into {variant}?", detail):
                ok = await self._send("POST", f"/api/packages/{pid}/approve",
                                      f"approved {what} into {variant}",
                                      json={"acknowledge": True, "target_variant": variant,
                                            "build": True})
                if ok and "build_started" in self.last:
                    self.status += (
                        f" [$text-muted]· build of {_esc(variant)} started[/]"
                        if self.last.get("build_started") else
                        " [$warning]· no build started (one is running; b on /vms "
                        "Images builds it)[/]")
                    self.render_chrome()

        async def _reject(self, kind: str, r: dict) -> None:
            rid = r.get("id")
            what = (f"service {r.get('name') or '?'}" if kind == "service"
                    else f"package {r.get('package') or '?'}")
            reason = await self.app.push_screen_wait(Ask(
                f"Reject {what}: the reason (the agent sees it)"))
            if reason is None:
                return
            reason = reason.strip() or "rejected by the operator"
            if await self._confirm(f"Reject {what} (#{rid})?",
                                   f"Marks the request rejected with: {reason}. Nothing "
                                   "is installed or started."):
                base = "services" if kind == "service" else "packages"
                await self._send("POST", f"/api/{base}/{rid}/reject", f"rejected {what}",
                                 json={"reason": reason})

        def _service_of(self) -> dict | None:
            """The service behind the selected Persistent row: a service row, or a
            process whose cgroup names one."""
            e = self.selected()
            if e is None:
                return None
            if e["type"] == "svc":
                return e["raw"]
            sid = e["raw"].get("service_id") if e["type"] == "proc" else None
            if sid is None:
                return None
            known = next((s for s in self._last_services if s.get("id") == sid), None)
            return known or {"id": sid, "name": f"service {sid}"}

        async def _service_logs(self) -> None:
            s = self._service_of()
            if s is None:
                return
            try:
                r = await self.app.api("GET", f"/api/services/{s.get('id')}/logs",
                                       params={"lines": 200}) or {}
            except CliError as e:
                self._fail(f"logs: {e}")
                return
            # guest output: text only, never markup
            text = str(r.get("text") or "")
            await self.app.push_screen_wait(View(
                f"Logs: {s.get('name')} (#{s.get('id')}), last 200 lines",
                "[$warning]untrusted: written by the service in its box[/]\n\n"
                + (_esc(text) if text.strip() else "[$text-muted]no output[/]")))

        async def _stop_service(self) -> None:
            s = self._service_of()
            if s is None:
                return
            if s.get("desired_state") == "stopped":
                if await self._confirm(
                        f"Start service {s.get('name')} (#{s.get('id')})?",
                        "Starts the approved definition in its box (booting the box if "
                        "it is down) and reopens its egress hosts; it comes back on every "
                        "boot until stopped or revoked."):
                    await self._send("POST", f"/api/services/{s.get('id')}/start",
                                     f"started {s.get('name')}")
                return
            if await self._confirm(
                    f"Stop service {s.get('name')} (#{s.get('id')})?",
                    "Stops its unit now and closes its egress hosts. The approved "
                    "definition stays; s here starts it again."):
                await self._send("POST", f"/api/services/{s.get('id')}/stop",
                                 f"stopped {s.get('name')}")

        async def _revoke_service(self) -> None:
            s = self._service_of()
            if s is None:
                return
            if not await self._confirm(
                    f"Revoke service {s.get('name')} (#{s.get('id')})?",
                    "Deletes the approved definition and destroys the box it runs in "
                    "(killing the VM is the authoritative stop). A new request is needed "
                    "to run it again. Its /srv data is kept unless you say so next."):
                return
            wipe = bool(await self.app.push_screen_wait(Confirm(
                f"Also delete {s.get('name')}'s /srv data?",
                "y deletes the data disk for good; n (or esc or enter) keeps it.",
                strict=True)))
            ok = await self._send("POST", f"/api/services/{s.get('id')}/revoke",
                                  f"revoked {s.get('name')}",
                                  json={"confirm": True, "delete_data": wipe})
            if ok and "data_deleted" in self.last:
                self.status += (" [$text-muted]· its data was deleted[/]"
                                if self.last.get("data_deleted") else
                                " [$text-muted]· its data was kept[/]"
                                if not wipe else
                                " [$warning]· its data could not be deleted[/]")
                self.render_chrome()

        async def _edit_policy(self) -> None:
            e = self.selected()
            if e is None or e["type"] != "policy":
                e = next((x for x in self.shown() if x["type"] == "policy"
                          and x["raw"]["slug"] == self.project), None)
            if e is None:
                return
            slug, p = e["raw"]["slug"], e["raw"].get("policy") or {}
            if not ("project_allow" in p or "profile" in p):
                self._fail("this server has no per-project allow/deny lists yet")
                return
            allow = await self.app.push_screen_wait(Ask(
                f"{slug}: hosts to ALLOW, comma-separated",
                value=", ".join(_jlist(p.get("project_allow")))))
            if allow is None:
                return
            deny = await self.app.push_screen_wait(Ask(
                f"{slug}: hosts to DENY, comma-separated (deny beats allow)",
                value=", ".join(_jlist(p.get("project_deny")))))
            if deny is None:
                return
            al, dn = self._hosts(allow), self._hosts(deny)
            prof = (p.get("profile") or {}).get("name") or "its profile"
            if await self._confirm(
                    f"Save {slug}'s egress lists?",
                    f"{slug} only: allow {', '.join(al) or 'nothing extra'}; deny "
                    f"{', '.join(dn) or 'nothing extra'}. {prof}'s baseline is unchanged; "
                    "deny beats allow."):
                await self._send("PUT", f"/api/egress/policy/{slug}", f"saved {slug}'s lists",
                                 json={"allow": al, "deny": dn})

        async def _pick_slug(self, title: str) -> str | None:
            """A project, picked from /api/projects (never the image-build
            pseudo-project)."""
            try:
                ps = (await self.app.api("GET", "/api/projects") or {}).get("projects") or []
            except CliError as e:
                self._fail(str(e))
                return None
            rows = [(x["slug"], x.get("name") or x["slug"], "") for x in ps
                    if x.get("slug") and x["slug"] != IMAGE_BUILD]
            if not rows:
                self._fail("no project to put it in")
                return None
            return await self.app.push_screen_wait(Picker(title, rows))

        def _policy_of(self, slug: str) -> dict:
            e = next((x for x in self.entries["network"] if x["type"] == "policy"
                      and x["raw"]["slug"] == slug), None)
            return (e["raw"].get("policy") or {}) if e else {}

        async def _net_host(self, allow: bool) -> None:
            """y / n on a traffic row: put its host on the project's OWN allow
            (POST /api/egress/allow) or deny list (PUT the policy's deny)."""
            e = self.selected()
            if e is None or e["type"] != "net":
                return
            r = e["raw"]
            host, slug = r.get("host") or "", r.get("project_slug") or self.GENERAL
            if not host:
                return
            if slug == IMAGE_BUILD:
                self._fail("image builds have a fixed policy: the registries only")
                return
            if slug == self.GENERAL:
                slug = await self._pick_slug(
                    f"{host} came with no project: {'allow' if allow else 'deny'} it for")
                if slug is None:
                    return
            if allow:
                if await self._confirm(
                        f"Allow {host} for {slug}?",
                        f"Adds exactly '{host}' to {slug}'s own allow list. Its profile's "
                        "baseline is unchanged, and a deny on either list still wins."):
                    await self._send("POST", "/api/egress/allow", f"allowed {host}",
                                     json={"project": slug, "host": host})
                return
            pol = self._policy_of(slug)
            if not pol:
                try:
                    pol = await self.app.api("GET", f"/api/egress/policy/{slug}") or {}
                except CliError as err:
                    self._fail(str(err))
                    return
            deny = _jlist(pol.get("project_deny"))
            if host in deny:
                self._fail(f"{host} is already on {slug}'s deny list")
                return
            if await self._confirm(
                    f"Deny {host} for {slug}?",
                    f"Adds '{host}' to {slug}'s own deny list (deny beats allow, the "
                    "profile's lists included). Its other lists are unchanged."):
                await self._send("PUT", f"/api/egress/policy/{slug}", f"denied {host}",
                                 json={"deny": deny + [host]})

        async def _promote(self) -> None:
            """u on a project's policy row: move one host from its own list onto a
            profile's list of the same kind (POST .../promote)."""
            e = self.selected()
            if e is None or e["type"] != "policy":
                return
            slug, p = e["raw"]["slug"], e["raw"].get("policy") or {}
            rows = ([(f"allow\t{h}", h, "on its allow list")
                     for h in _jlist(p.get("project_allow"))]
                    + [(f"deny\t{h}", h, "on its deny list")
                       for h in _jlist(p.get("project_deny"))])
            if not rows:
                self._fail(f"{slug} has no host of its own to promote")
                return
            pick = await self.app.push_screen_wait(Picker(
                f"{slug}: which host goes up to a profile", rows))
            if pick is None:
                return
            which, host = pick.split("\t", 1)
            own = p.get("profile") or {}
            prows = [("own", f"{own.get('name') or '?'} (its own profile)",
                      "every project on it gets the host")]
            prows += [(str(x.get("id")), x.get("name") or "?",
                       f"{len(_jlist(x.get('projects')))} project(s)")
                      for x in self.profiles if x.get("id") != own.get("id")]
            pid = await self.app.push_screen_wait(Picker(f"Promote {host} into", prows))
            if pid is None:
                return
            target = next((x for x in self.profiles if str(x.get("id")) == pid), None)
            name = own.get("name") if pid == "own" else (target or {}).get("name") or pid
            users = ", ".join(_jlist((target or next(
                (x for x in self.profiles if x.get("id") == own.get("id")), {})
            ).get("projects"))) or "no other project"
            if await self._confirm(
                    f"Promote {host} to {name}'s {which} list?",
                    f"Moves '{host}' off {slug}'s own {which} list onto profile {name}'s: "
                    f"every project on {name} ({users}) is then under it. A profile "
                    "change; it is logged as profile_changed."):
                await self._send("POST", f"/api/egress/policy/{slug}/promote",
                                 f"promoted {host} to {name}",
                                 json={"host": host, "list": which,
                                       "profile_id": None if pid == "own" else int(pid)})

        def _profile(self) -> dict | None:
            e = self.selected()
            return e["raw"] if e is not None and e["type"] == "profile" else None

        async def _assign_profile(self) -> None:
            p = self._profile()
