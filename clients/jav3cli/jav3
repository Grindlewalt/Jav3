                               "of it", "[page]", takes_arg=True, busy_ok=True,
                               leader="w"),
                "status": Command(self.c_status, "server, chat, model, usage", busy_ok=True,
                                  leader="s"),
                "editor": Command(self.c_editor, "write the prompt in $EDITOR (ctrl+g)",
                                  busy_ok=True, leader="e"),
                "orchestration": Command(self.c_orchestrate, "brain-dump a problem; an "
                                         "orchestrator sends agents at it", "[project]",
                                         takes_arg=True, leader="o"),
                "dnd": Command(self.c_dnd, "do not disturb: silence pings (full access)",
                               "[1h|4h|90m|tomorrow|off]", takes_arg=True, busy_ok=True),
                "login": Command(self.c_login, "log in: the line from Settings (chat only) "
                                 "or your password (full access)", "[line|password]"),
                "logout": Command(self.c_logout, "log out: /logout says who, /logout yes does it "
                                 "(a device token is revoked)", "[yes]", takes_arg=True),
                "exit": Command(self.c_exit, "quit (a running turn keeps going)",
                                busy_ok=True, leader="q"),
            }
            # the pages: /work /agents /security /vms /sessions and the web-only ones
            for spec in PAGE_SPECS:
                if spec.name not in c:
                    c[spec.name] = Command(
                        self._page_fn(spec.name), spec.help, spec.hint,
                        takes_arg=bool(spec.hint), busy_ok=True, leader=spec.leader,
                        page=spec.name)
                c[spec.name].page = spec.name
            for alias, name in (("quit", "exit"),
                                ("model", "models"),
                                ("agent", "persona"),
                                ("theme", "themes"),
                                ("clear", "new"), ("providers", "provider"),
                                ("orchestrate", "orchestration"),
                                ("stop-project", "stop-a"), ("perms", "permissions"),
                                ("mode", "permissions")):
                c[alias] = c[name]
            for spec in PAGE_SPECS:
                for alias in spec.aliases:
                    c[alias] = c[spec.name]
            return c

        def unique_commands(self):
            seen = set()
            for name, cmd in self.commands.items():
                if id(cmd) not in seen:
                    seen.add(id(cmd))
                    yield name, cmd

        def arg_options(self, name: str) -> list[tuple[str, str]]:
            cmd = self.commands.get(name)
            fn = cmd.fn if cmd else None
            o = self.options or {}
            if fn == self.c_model:
                return [(m["id"], m.get("label", "") + ("  (default)" if m["id"] == o.get("default")
                                                        else ""))
                        for m in o.get("models", [])]
            if fn == self.c_logout:
                return [("yes", "sign out (a device token is revoked)")]
            if fn == self.c_agent:
                return [("none", "plain Jav3")] + [(a["slug"], a.get("name", ""))
                                                  for a in o.get("agents", [])]
            if fn == self.c_project:
                return ([("none", "no project: files go to the chat's artifacts"),
                         ("follow", "whatever project is loaded")]
                        + [(p["slug"], p.get("name", "")) for p in o.get("projects", [])])
            if fn in (self.c_orchestrate, self.c_stop_project):
                return [(p["slug"], p.get("name", "")) for p in o.get("projects", [])]
            if fn == self.c_sessions:
                return [(str(cv["id"]), _short(cv.get("summary") or "(untitled)", 60))
                        for cv in self.convs[:60]]
            if fn == self.c_theme:
                return [("create", "new theme, with live preview"),
                        ("export", "export [path] — the current theme as JSON"),
                        ("import", "import <path> — a .json theme")] + [
                    (t, "") for t in self.theme_names()]
            if fn == self.c_export:
                return [("default", "default <location> — where /export saves")]
            if fn == self.c_screenshot:
                return [("help", "current default format and location"),
                        ("default", "default <format> [location]"),
                        ("svg", "colours, opens in a browser"), ("txt", "plain text"),
                        ("png", "needs cairosvg")]
            if fn == self.c_permissions:
                return [(m, self.PERM_HINT[m]) for m in self.PERM_MODES]
            if fn == self.c_login:
                return [("password", "full access"), ("line", "chat only")]
            if fn == self.c_web:
                return [(n, "the web app's page") for n in WEB_PAGES]
            if cmd and cmd.page:
                return list(PAGES[cmd.page].options.items())
            return []

        async def pick(self, title: str, rows, current=None, custom=False, hint="",
                       actions=None, hidden=(), wide=False):
