        async def c_rename(self, arg: str) -> None:
            if self.cid is None:
                raise CliError("no chat yet — send a message first")
            if not arg:
                arg = (await self.push_screen_wait(Ask("Rename chat",
                                                       value=self.title_text or "")) or "").strip()
                if not arg:
                    return
            r = await self.api("PATCH", f"/api/conversations/{self.cid}", json={"title": arg})
            self.title_text = r.get("title", arg)
            self.refresh_chrome()

        async def c_star(self, arg: str) -> None:
            if self.cid is None:
                raise CliError("no chat yet — send a message first")
            await self.refresh_convs()
            cur = next((cv.get("starred") for cv in self.convs if cv.get("id") == self.cid),
                       False)
            await self.api("PATCH", f"/api/conversations/{self.cid}", json={"starred": not cur})
            self.notify("starred" if not cur else "unstarred")

        async def c_delete(self, arg: str) -> None:
            cid = int(arg) if arg.isdigit() else self.cid
            if cid is None:
                raise CliError("no chat to delete")
            if not await self.push_screen_wait(Confirm(f"Delete chat #{cid}?",
                                                       "This cannot be undone.",
                                                       strict=True)):
                return
            await self.api("DELETE", f"/api/conversations/{cid}")
            self.notify(f"deleted #{cid}")
            if cid == self.cid:
                await self.c_new()

        async def c_retry(self, arg: str) -> None:
            if not self.last_user:
                raise CliError("nothing to retry")
            self.send(self.last_user)

        async def c_resume(self, arg: str) -> None:
            """Continue the turn that died (a dropped guest, a lost connection, a
            provider error), but only when this chat's last message IS that
            failure: the server then hands the model the dead turn's tool calls,
            so it picks up from the last step. The same words as the web's Resume
            button (backend/chat.py RESUME_MESSAGE). /resume was already the
            sessions picker (Claude Code's habit) and stays that when there is
            nothing to continue, or when it is given a chat."""
            if arg or self.cid is None:
                await self.c_sessions(arg)
                return
            r = await self.api("GET", f"/api/conversations/{self.cid}/messages")
            rows = [m for m in r.get("messages", []) if m.get("role") in ("user", "assistant")]
            last = rows[-1] if rows else {}
            if r.get("running") or last.get("role") != "assistant" or not (
                    last.get("content") or "").lstrip().startswith(
                        ("(turn failed:", "(guest loop error:")):
                await self.c_sessions("")
                return
            self.send("Continue from where the previous turn stopped.")

        async def c_stop(self, arg: str) -> None:
            if not self.busy:
                self.notify("nothing is running")
                return
            self.interrupt()

        async def _bulk_stop(self, path: str, body: dict, what: str) -> None:
            d = await self.api("POST", path, json={**body, "dry_run": True})
            n = int(d.get("count") or 0)
            if not n:
                self.notify(f"nothing is running {what}")
                return
            plans = d.get("plans") or []
            detail = (f"{len(d.get('conversations') or [])} turn(s)"
                      + (f" and {len(plans)} plan run(s)" if plans else "")
                      + ". Each stops where it is; its transcript keeps what it did.")
            if not await self.push_screen_wait(Confirm(
                    f"Stop {n} running turn{'s' * (n != 1)} {what}?", detail)):
                return
            d = await self.api("POST", path, json=body)
            mine = self.turn.cid if self.turn and self.turn.cid else self.cid
            if self.busy and mine in (d.get("conversations") or []):
                self.interrupt()
            self.notify(f"stopped {d.get('count', 0)}")

        async def c_stop_all(self, arg: str) -> None:
            await self._bulk_stop("/api/chat/stop-all", {}, "anywhere")

        async def c_stop_project(self, arg: str) -> None:
            slug = arg or self._project_label()
            if not slug or slug == "no project":
                raise CliError("this chat has no project — /stop-a <project>")
            await self._bulk_stop("/api/chat/stop-project", {"project": slug},
                                  f"in {slug}")

        async def c_copy(self, arg: str) -> None:
            if not self.last_reply:
                raise CliError("no reply to copy yet")
            how = copy_to_clipboard(self.last_reply, osc52=self.copy_to_clipboard)
            self.notify(f"copied the last reply ({how})")

        def _export_default(self) -> str:
            loc = self._load_settings().get("export_dir")
            return loc if isinstance(loc, str) and loc else os.getcwd()

        async def c_export(self, arg: str) -> None:
            """/export [location]: a directory, or a file path ending in .md;
            /export default <location> sets where a bare /export saves."""
            word, _, rest = arg.partition(" ")
            if word == "default":
                rest = rest.strip()
                if not rest:
                    await self.note(f"/export saves to {self._export_default()} — "
                                    "/export default <location> changes it")
                    return
                loc = str(safe_output_dir(rest))
                self._save_settings(export_dir=loc)
                self.notify(f"exports: {loc}")
                return
            if self.cid is None:
                raise CliError("no chat to export")
            loc, stem = arg.strip() or self._export_default(), f"jav3-{self.cid}"
            if loc.lower().endswith(".md"):
                stem = safe_stem(Path(loc).name[:-3], stem)
                loc = str(Path(loc).parent)
            directory = safe_output_dir(loc)
            r = await self.api("GET", f"/api/conversations/{self.cid}/messages")
            text = transcript_markdown(self.title_text or f"Jav3 chat #{self.cid}",
                                       r.get("messages", []))
            path = write_new(directory, stem, "md", text.encode("utf-8"))
            await self.note(f"saved {path}")         # in the log: a toast wraps and goes

        def _shot_defaults(self) -> tuple[str, str]:
            st = self._load_settings()
            fmt = st.get("screenshot_format")
            loc = st.get("screenshot_dir")
            return (fmt if fmt in SHOT_FORMATS else "svg",
                    loc if isinstance(loc, str) and loc else str(default_shot_dir()))

        def screen_text(self) -> str:
            from rich.console import Console
            w, h = self.size
            console = Console(width=w, height=h, file=io.StringIO(), force_terminal=True,
                              color_system="truecolor", record=True, legacy_windows=False)
            console.print(self.screen._compositor.render_update(
                full=True, screen_stack=self._background_screens))
            return console.export_text()

        async def c_screenshot(self, arg: str) -> None:
            try:
                toks = shlex.split(arg)
            except ValueError:
                toks = arg.split()
            fmt0, loc0 = self._shot_defaults()
            if toks[:1] == ["help"]:
                await self.note(f"/screenshot [name] [format] [location] — default format "
                                f"{fmt0}, location {loc0}. Formats: svg, txt, png (png "
                                "needs cairosvg). /screenshot default <format> [location] "
                                "changes them.")
                return
            if toks[:1] == ["default"]:
                if len(toks) < 2 or toks[1].lower() not in SHOT_FORMATS or len(toks) > 3:
                    raise CliError("usage: /screenshot default <svg|txt|png> [location]")
                fmt = toks[1].lower()
                loc = str(safe_output_dir(toks[2])) if len(toks) == 3 else loc0
                self._save_settings(screenshot_format=fmt, screenshot_dir=loc)
                self.notify(f"screenshots: {fmt} in {loc}")
                return
            name, fmt, loc = parse_shot_args(toks)
            fmt = fmt or fmt0
            directory = safe_output_dir(loc or loc0)
            # the picture is of the chat, not of the command being run: the completion
            # list and any toast go first (and the screen gets a frame to redraw)
            self.hide_popup()
            self.clear_notifications()
            await asyncio.sleep(0.15)
            if fmt == "txt":
                data = self.screen_text().encode("utf-8")
            else:
                svg = self.export_screenshot(title="Jav3")
                data = svg_to_png(svg) if fmt == "png" else svg.encode("utf-8")
            path = write_new(directory, safe_stem(name, time.strftime("jav3-%Y%m%d-%H%M%S")),
                             fmt, data)
            await self.note(f"saved {path}")

        async def c_details(self, arg: str) -> None:
            self.action_toggle_tools()

        async def c_detach(self, arg: str) -> None:
            n, self.attachments = len(self.attachments), []
            self.refresh_chrome()
            self.notify(f"dropped {n} pending output{'s' * (n != 1)}")

        async def c_web(self, arg: str) -> None:
            import webbrowser
            # /c/<id> opens that chat in the web app's Work page; / is Work; /web memory is
            # the Memory page (the names the terminal does not have yet, /memory ...)
            page = arg.strip().strip("/").lower()
            if page and not re.fullmatch(r"[a-z][a-z0-9/_-]*", page):
                raise CliError(f"no web page called {arg.strip()!r}")
            url = self.base + (f"/{page}" if page else f"/c/{self.cid}" if self.cid else "/")
            webbrowser.open(url)
            self.notify(f"opened {url}")

        async def c_status(self, arg: str) -> None:
            info = self.info or {}
            rows = [("server", self.base or "(none)"), ("signed in as", self.whoami),
                    ("access", self._access_label()),
                    ("chat", f"#{self.cid} {self.title_text or ''}" if self.cid else "(new)"),
                    ("model", self._model_label()),
                    ("project", self._project_label() or "none"),
                    ("agent", self.agent or "none"),
                    ("temporary", "on" if self.ephemeral else "off"),
                    ("theme", self.theme), ("cwd", str(Path.cwd()))]
            if info:
                rows.append(("usage", f"{info.get('input_tokens', 0):,} in · "
                                      f"{info.get('output_tokens', 0):,} out · "
                                      f"${info.get('cost_usd', 0):.4f}"))
            if self.attachments:
                rows.append(("pending", f"{len(self.attachments)} !command output(s)"))
            md = "# Status\n\n| | |\n|---|---|\n" + "\n".join(
                f"| {k} | {str(v).replace('|', '/')} |" for k, v in rows)
            await self.push_screen_wait(Help(md))

        async def c_editor(self, arg: str) -> None:
            self.action_external_editor()

        async def c_login(self, arg: str) -> None:
            how = arg if arg in ("line", "password") else None
            if how is None:
                how = await self.pick("Log in", [
                    ("password", "Server address, username and password",
                     "full access, like the web app"),
                    ("line", "Paste the line from Settings → Add computer", "chat only")],
                    hint="a password session can manage providers, models and projects")
                if not how:
                    return
            err = io.StringIO()
            if how == "line":
                line = await self.push_screen_wait(Ask(PROMPT.rstrip(": "), secret=True))
                if not line:
                    return

                def go():
                    with contextlib.redirect_stderr(err):
                        return login_with_line(line, self.server_override)
            else:
                saved = load_credentials() or {}
                addr = await self.push_screen_wait(Ask(
                    "Server address (host:port or URL)",
                    value=self.server_override or saved.get("address") or self.base,
                    placeholder="like 10.0.0.82:8000"))
                if not (addr or "").strip():
                    return
                # the plain-http warning comes before the password is typed, not after
                # it was sent: find out where this address really goes first
                self.notify(f"checking {addr.strip()}…")
                target = await asyncio.to_thread(
                    lambda: upgrade_to_https(base_url(addr.strip())))
                if target.startswith("http://") and not _loopback_base(target):
                    if not await self.push_screen_wait(Confirm(
                            f"{target.split('://', 1)[1]} is plain http. Send your password anyway?",
                            "It and the session it is traded for cross the network "
                            "unencrypted. Only say yes on a network you trust.", strict=True)):
                        return
                user = await self.push_screen_wait(Ask(
                    "Username", value=saved.get("username") or ""))
                if not (user or "").strip():
                    return
                password = await self.push_screen_wait(Ask("Password", secret=True))
                if not password:
                    return

                def go():
                    with contextlib.redirect_stderr(err):
                        return login_with_password(addr.strip(), user.strip(), password,
                                                   warn=False)
            self.notify(f"logging in to {how == 'line' and 'the server' or addr.strip()}…")
            try:
                base, cred, who = await asyncio.to_thread(go)
            finally:
                if err.getvalue().strip():
                    await self.note(err.getvalue().strip(), "warn")
            await self._logged_in_as(base, cred, who)

        async def _logged_in_as(self, base: str, cred: str, who: str) -> None:
            self.base, self.token, self.whoami = base, cred, who
            self.logged_in = True
            if self.client is not None:
                await self.client.aclose()
            self.client = self._new_client()
            await self._after_login()
            msg = f"logged in to {base.split('://')[-1]} as {who} — {self._access_label()}"
            self.push_notice(msg, "done", toast=False)
            self.notify(msg)

        async def c_logout(self, arg: str) -> None:
            """/logout says who is signed in and what signing out does; /logout yes
            does it (the web app's two steps: one slip of a finger costs a login)."""
            if not self.token:
                self.notify("not logged in")
                return
            what = ("forgets this password session" if is_session(self.token)
                    else "revokes this computer's token and forgets it")
            if arg.strip().lower() != "yes":
                await self.note(f"signed in as {self.whoami} on {self.base} "
                                f"({self._access_label()}) — /logout yes {what}")
                return
            ns = argparse.Namespace(server=self.server_override)
            await asyncio.to_thread(cmd_logout, ns, io.StringIO())
            self.workers.cancel_group(self, "notices")
            self.token, self.logged_in, self.whoami = None, False, "?"
            self.options, self.convs = {}, []
            if self.client is not None:
                await self.client.aclose()
            self.client = self._new_client()
            self.push_notice("logged out", "info", toast=False)
            self.notify("logged out — /login to log in again")
            self.refresh_chrome()

        # -- providers, models, projects (full access) ------------------------------------

        async def _providers(self) -> list[dict]:
            return (await self.api("GET", "/api/providers", params={"models": 0})) \
                .get("providers") or []

        async def _pick_model_full(self) -> None:
            """Every model of every provider that has a key, grouped by provider;
            space switches one on/off on the server, d makes it the default."""
            usable = [p for p in await self._providers()
                      if (p.get("key_set") or not p.get("needs_key"))
                      and not p.get("needs_base_url")]
            views = await asyncio.gather(*(self.api("GET", f"/api/providers/{p['id']}")
                                           for p in usable), return_exceptions=True)
            provs = [v for v in views if isinstance(v, dict) and v.get("models")]
            if not provs:
                raise CliError("no provider has a key yet — /provider adds one")
            state: dict[str, tuple[dict, dict]] = {}

            def rows():
                out = [("default", "Server default", "clears this chat's model pin")]
                for pv in provs:
                    out.append((None, (pv.get("label") or pv["id"])
                                + ("" if pv.get("enabled") else "  (provider off)"), ""))
                    for m in pv["models"]:
                        v = f"{pv['id']}/{m['id']}"
                        state[v] = (pv, m)
                        out.append((v, m.get("label") or m["id"],
                                    "default" if m.get("default") else
                                    "" if m.get("enabled") else "off"))
                return out

            async def toggle(v):
                if v not in state:
                    return None
                pv, m = state[v]
                r = await self.api("PUT", f"/api/providers/{pv['id']}/models/{m['id']}",
                                   json={"enabled": not m.get("enabled")})
                m.update(r.get("model") or {"enabled": not m.get("enabled")})
                self.notify(f"{v}: {'on' if m.get('enabled') else 'off'}")
                await self.refresh_options()
                return rows()

            async def make_default(v):
                if v not in state:
                    return None
                pv, m = state[v]
                r = await self.api("PUT", f"/api/providers/{pv['id']}/models/{m['id']}",
                                   json={"default": True})
                for _, other in state.values():
                    other["default"] = False
                m.update(r.get("model") or {})
                m["default"], m["enabled"] = True, True
                self.notify(f"default model: {v}")
                await self.refresh_options()
                self.refresh_chrome()
                return rows()

            cur = self.model or self.shown_model or (self.options or {}).get("default")
            first = rows()
            # off providers and deprecated models stay off the list until a filter is
            # typed: a switched-off provider used to add a heading and all its models
            hidden = {v for v, (pv, m) in state.items()
                      if not pv.get("enabled") or m.get("deprecated")
                      or "deprecated" in f"{m.get('label')} {m['id']}".lower()} - {cur}
            v = await self.pick("Models", first, cur,
                                actions={"space": ("on/off", toggle),
                                         "d": ("make default", make_default)},
                                hint="enter pins the model to this chat", hidden=hidden)
            if not v:
                return
            if v == "default":
                self.model = None
                self.notify("model: server default for new chats")
            else:
                pv, m = state[v]
                if not m.get("enabled"):
                    raise CliError(f"{v} is switched off — press space on it in /model "
                                   "to switch it on")
                if not pv.get("enabled"):
                    raise CliError(f"provider {pv['id']} is off — /provider {pv['id']} "
                                   "switches it on")
                self.model = v
                self.notify(f"model: {v}" + (" — pinned to this chat from the next message"
                                             if self.cid else ""))
            self.refresh_chrome()

        async def c_provider(self, arg: str) -> None:
            self._need_full("/provider")
            provs = await self._providers()
            if not arg:
                rows = []
                for p in provs:
                    bits = ["key set" if p.get("key_set") else
                            "no key needed" if not p.get("needs_key") else "no key"]
                    if p.get("needs_base_url"):
                        bits.append("needs base URL")
                    bits.append("on" if p.get("enabled") else "off")
                    rows.append((p["id"], p.get("label") or p["id"], " · ".join(bits)))
                arg = await self.pick("Providers", rows,
                                      hint="enter: set its key / base URL, then test it") or ""
                if not arg:
                    return
            p = next((x for x in provs if x["id"] == arg), None)
            if p is None:
                raise CliError(f"no provider {arg!r} in the catalogue")
            label = p.get("label") or p["id"]
            body: dict = {"enabled": True}
            if p.get("needs_base_url"):
                url = await self.push_screen_wait(Ask(
                    f"{label}: base URL (replace the {{PLACEHOLDER}})",
                    value=p.get("base_url") or ""))
                if not (url or "").strip():
                    return
                body["base_url"] = url.strip()
            if p.get("needs_key"):
                key = await self.push_screen_wait(Ask(
                    f"{label}: API key" + (" — empty keeps the saved one"
                                           if p.get("key_set") else ""), secret=True))
                if key is None:
                    return
                if key.strip():
                    body["api_key"] = key.strip()
                elif not p.get("key_set"):
                    await self.note(f"{label} needs an API key — nothing changed", "warn")
                    return
            if not p.get("needs_base_url"):
                url = await self.push_screen_wait(Ask(
                    f"{label}: base URL — enter keeps it", value=p.get("base_url") or ""))
                if url is None:
                    return
                if url.strip() and url.strip().rstrip("/") != (p.get("base_url") or "").rstrip("/"):
                    body["base_url"] = url.strip()
            await self.api("PUT", f"/api/providers/{p['id']}", json=body)
            self.notify(f"{label}: saved — testing…")
            res = await self.api("POST", f"/api/providers/{p['id']}/test", json={})
            found = res.get("models_found") or []
            if res.get("ok"):
                msg = f"{label}: connected" + (f" — {len(found)} models" if found else "")
                self.push_notice(msg, "done", toast=False)
                await self.note(msg + " · /model to pick one")
            else:
                await self.note(f"{label}: test failed — {res.get('detail') or 'no detail'}",
                                "error")
            await self.refresh_options()
            self.refresh_chrome()

        async def _project_rows(self) -> list[tuple]:
            if self.full_access:
                r = await self.api("GET", "/api/projects")
                projects = [(p["slug"], p.get("name") or "") for p in r.get("projects") or []]
                active = r.get("active")
            else:
                o = self.options or {}
                projects = [(p["slug"], p.get("name") or "") for p in o.get("projects", [])]
                active = o.get("active_project")
            return ([(NEW_PROJECT, "+ New project", "" if self.full_access
                      else "needs /login with a password"),
                     ("none", "none", "no project: files go to the chat's artifacts"),
                     ("follow", "follow", "whatever project is loaded")]
                    + [(slug, slug, " · ".join(x for x in (name, "loaded" if slug == active
                                                            else "") if x))
                       for slug, name in projects])

        async def _load_project(self, slug: str):
            if slug in (NEW_PROJECT, "none", "follow"):
                return None
            await self.api("POST", f"/api/projects/{slug}/load")
            self.notify(f"loaded {slug} as the active project")
            await self.refresh_options()
            return await self._project_rows()

        async def _new_project(self) -> str | None:
            self._need_full("a new project")
            name = (await self.push_screen_wait(Ask("New project name")) or "").strip()
            if not name:
                return None
            return await self._create_project(name)

        async def _create_project(self, name: str) -> str:
            r = await self.api("POST", "/api/projects", json={"name": name})
            await self.refresh_options()
            self.push_notice(f"created project {r.get('slug', name)}", "done", toast=False)
            return r.get("slug") or name

        async def _known_project(self, name: str) -> str | None:
            """The slug of the project `name` means: as typed, or by its display
            name, or (nothing matching) after asking whether to create it. None when
            the operator says no. A name that matches nothing used to pin the chat to
            a project that did not exist, and the first message then failed with a 404."""
            if self.full_access:
                rows = (await self.api("GET", "/api/projects")).get("projects") or []
            else:
                await self.refresh_options()        # one may have been made elsewhere
                rows = (self.options or {}).get("projects", [])
            known = {p["slug"]: p.get("name") or "" for p in rows if p.get("slug")}
            if name in known:
                return name
            low = name.lower()
            hit = next((sl for sl, nm in known.items() if sl.lower() == low
                        or (nm and nm.lower() == low)), None)
            if hit:
                return hit
            if not self.full_access:
                have = ", ".join(sorted(known)[:8]) + (" …" if len(known) > 8 else "")
                raise CliError(f"no project named {name!r}" + (f" — you have: {have}" if known
                                                                else "")
                               + " (making one needs /login with your password)")
            if not await self.push_screen_wait(Confirm(
                    f"No project named {name!r}. Create it?",
                    "It becomes this chat's project.")):
                return None
            return await self._create_project(name)

        async def c_orchestrate(self, arg: str) -> None:
            if not arg:
                rows = [(v, name or v, v if name else "")
                        for v, name in self.arg_options("orchestration")]
                arg = await self.pick("Orchestrate which project?", rows, self.project,
                                      custom=True, hint="its agents all work in this "
                                      "project") or ""
                if not arg:
                    return
            dump = await self.push_screen_wait(BrainDump(arg))
            if not dump:
                return
            await self.c_new()
            self.project, self.project_mode = arg, "pin"
            self.agent, self.orchestrator = None, True
            self.refresh_chrome()
            self.send(dump)

        # -- pages: the router -----------------------------------------------------------------

        def _page_fn(self, name: str):
            async def go(arg: str = "") -> None:
                await self.open_page(name, arg)
            return go

        async def open_page(self, name: str, arg: str = "") -> None:
            """/name args: show a page in the host. The page showing already is told its new
            args; one lower in the stack gives way to a fresh one on top. `work` is the
            chat; a page the terminal does not have yet says where it lives."""
            spec = PAGES[name]
            args = (arg or "").split()
            if spec.kind == "web":
                await self.say(not_in_terminal(name), "warn")
                return
            self.hide_popup()
            if name == "sessions":
                await self.c_sessions(arg)
                return
            if spec.kind == "chat":
                await self.host.home()
                return
            if (name == "agents" and args and args[0] not in AGENTS_VIEW_BLURB
                    and args[0] != "active"):
                # the old spelling: /agents <slug> starts a chat as that agent preset
                await self.c_agent(arg)
                return
            cls = self.page_classes[name]
            if type(self.page) is cls:
                self.page.set_args(args)
                self.page.focus_target().focus()
                return
            await self.host.push(cls.build(self, args))

        async def c_exit(self, arg: str = "") -> None:
            self.exit()

    # for the next steps (panels host pages of their own) and for tests
    Jav3App.Page, Jav3App.PageHost, Jav3App.ChatPage = Page, PageHost, ChatPage
    return Jav3App(base, token, **kw)


def transcript_markdown(title: str, messages: list[dict]) -> str:
    parts = [f"# {title}\n"]
    for m in messages:
        if m.get("role") not in ("user", "assistant"):
            continue
        parts.append(f"## {'You' if m['role'] == 'user' else 'Jav3'}\n")
        for a in m.get("activity") or []:
            icon, title_ = tool_title(a["name"], a.get("args"))
            parts.append(f"- {icon} {title_}" + ("" if a.get("ok") else " (failed)"))
        parts.append((m.get("content") or "") + "\n")
    return "\n".join(parts)


# --- saving files the operator asked for (/screenshot, /export) --------------------------
#
# Every file these write lands in a directory checked here, under a name made
# here: path components in a typed name are dropped, an existing file is never
# overwritten (-2, -3 … instead), and the file is created O_EXCL | O_NOFOLLOW so
# a planted symlink cannot redirect the write.

SHOT_FORMATS = ("svg", "txt", "png")
_UNSAFE_NAME = re.compile(r"[^A-Za-z0-9._-]+")


def default_shot_dir() -> Path:
    home = Path.home()
    return home / "Pictures" / "jav3" if (home / "Pictures").is_dir() else home / "Downloads"


def safe_output_dir(loc: str, cwd: Path | None = None) -> Path:
    """The directory `loc` names, ready to write into. Inside the home directory
    it is created when missing; outside it, only an absolute path to an existing,
    writable directory is accepted."""
    raw = os.path.expanduser((loc or "").strip())
    if not raw or "\x00" in raw:
        raise CliError("no location given")
    p = Path(raw)
    given_absolute = p.is_absolute()
    if not given_absolute:
        p = (cwd or Path.cwd()) / p
    p = p.resolve()
    home = Path.home().resolve()
    if p != home and home not in p.parents:
        if not given_absolute:
            raise CliError(f"{loc} is outside your home directory — give an absolute "
                           "path to a directory you can write to")
        if not p.is_dir() or not os.access(p, os.W_OK):
            raise CliError(f"{p} is not a directory you can write to")
        return p
    try:
        p.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        raise CliError(f"could not create {p}: {e.strerror or e}")
    if not p.is_dir() or not os.access(p, os.W_OK):
        raise CliError(f"{p} is not a directory you can write to")
    return p


def safe_stem(name: str | None, default: str) -> str:
    """A file name stem from what was typed: its last path component only,
    anything but letters, digits, . _ - folded to -, no leading dot."""
    stem = _UNSAFE_NAME.sub("-", Path(name or "").name).strip(".-")[:80]
    return stem or default


def write_new(directory: Path, stem: str, ext: str, data: bytes) -> Path:
    """Create directory/stem.ext, or stem-2.ext, stem-3.ext … if it exists."""
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    for i in range(1, 1000):
        path = directory / f"{stem}{'' if i == 1 else f'-{i}'}.{ext}"
        try:
            fd = os.open(path, flags, 0o644)
        except FileExistsError:
            continue
        except OSError as e:
            raise CliError(f"could not save {path}: {e.strerror or e}")
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        return path
    raise CliError(f"too many files named {stem} in {directory}")


def svg_to_png(svg: str) -> bytes:
    try:
        import cairosvg
    except ImportError:
        raise CliError("png needs cairosvg (pip install cairosvg into jav3's Python) — "
                       "svg and txt work without it")
    return cairosvg.svg2png(bytestring=svg.encode("utf-8"))


def parse_shot_args(toks: list[str]) -> tuple[str | None, str | None, str | None]:
    """/screenshot [name] [format] [location], any order: a format word is the
    format, a token that looks like a path (/ ~ .) the location, the rest the
    name; a name ending in .svg/.txt/.png sets the format when none is given."""
    name = fmt = loc = None
    for t in toks:
        if t.lower() in SHOT_FORMATS and fmt is None:
            fmt = t.lower()
        elif loc is None and (t.startswith(("~", ".", "/")) or os.sep in t):
            loc = t
        elif name is None:
            name = t
        else:
            raise CliError(f"unexpected {t!r} — /screenshot [name] [format] [location]")
    if name and fmt is None:
        ext = name.rsplit(".", 1)[-1].lower() if "." in name else ""
        if ext in SHOT_FORMATS:
            fmt = ext
    if name and fmt and name.lower().endswith("." + fmt):
        name = name[:-len(fmt) - 1]
    return name, fmt, loc


