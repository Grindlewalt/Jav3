AGENT_ICONS = {"orchestrator": "◆", "chat": "●", "agent": "◇", "head": "▣",
               "leader": "◈", "subagent": "◦"}


def clean_title(raw, n: int = 60) -> str:
    """A node's title the way a person would write it: no "[item i1]" / "[head]"
    tag, no "Plan:" prefix, no "Project: /path" lead-in, no trailing colon, cut
    at a word boundary. The server sends a clean `title` now; this keeps older
    servers (and whatever slips through) readable."""
    import re
    s = " ".join(str(raw or "").split())
    s = re.sub(r"^(\[[^\]]*\]\s*)+", "", s)
    s = re.sub(r"^(Plan|Task|Job)\s*:\s*", "", s, flags=re.I)
    s = re.sub(r"^Project:\s*\S+\s*[-—:.,]?\s*", "", s, flags=re.I)
    s = s.strip().rstrip(":").strip()
    if len(s) <= n:
        return s
    cut = s[:n].rsplit(" ", 1)[0].rstrip(",.;:-—")
    return (cut if len(cut) > n // 2 else s[:n]) + "…"


def node_role(nd: dict) -> str:
    import re
    if nd.get("role"):
        return str(nd["role"])
    kind = nd.get("kind") or "agent"
    m = re.match(r"\s*\[([^\]]+)\]", str(nd.get("title") or ""))
    tag = m.group(1).strip() if m else ""
    if tag.startswith("item "):
        return tag
    if kind == "head" or tag == "head":
        return "plan"
    if nd.get("agent_slug"):
        return f"@{nd['agent_slug']}"
    # older rows carry the agent in the title's tag: "[morning-stocks] Fetch…"
    if tag:
        return f"@{tag}" if " " not in tag else tag
    return kind


def node_status(nd: dict) -> str:
    """running | needs_you | done | failed | stopped; an older server only says
    whether a node is running."""
    st = nd.get("status")
    if st in ("running", "needs_you", "done", "failed", "stopped"):
        return st
    return "running" if nd.get("running") else "done"


