        def _detail_policy(self, e) -> str:
            slug, p = e["raw"]["slug"], e["raw"].get("policy") or {}
            if not ("project_allow" in p or "profile" in p):
                return _esc(json.dumps(p, indent=2, sort_keys=True, default=str))
            prof = p.get("profile") or {}
            base = next((x for x in self.profiles if x.get("id") == prof.get("id")), {})

            def ls(v):
                v = _jlist(v)
                return _esc(", ".join(v)) if v else "[$text-muted]none[/]"
            return "\n".join([
                "[$primary]e[/] edit this project's allow and deny lists   [$primary]u[/] "
                "promote one of its hosts into a profile", "",
                f"[b]⌂ {_esc(slug)}[/]  profile [b]{_esc(prof.get('name') or '?')}[/] "
                f"[$text-muted](default: {_esc(prof.get('default') or '?')}; deny beats "
                "allow)[/]"
                + (f"  {RED} network off: nothing leaves [/]" if prof.get("network_off")
                   else ""),
                f"[$success]project allow:[/] {ls(p.get('project_allow'))}",
                f"[$error]project deny:[/]  {ls(p.get('project_deny'))}",
                f"[$text-muted]profile baseline allow:[/] {ls(base.get('allow_hosts'))}",
                f"[$text-muted]profile baseline deny:[/]  {ls(base.get('deny_hosts'))}",
                f"effective allow: {ls(p.get('effective_allow'))}",
                f"effective deny:  {ls(p.get('effective_deny'))}"])

