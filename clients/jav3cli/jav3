        async def _get(self, tab: str, what: str, path: str, key: str, quiet404=False,
                       **kw):
            """GET one route; a failure is noted on the tab (a 404 from a route an
            older server lacks stays quiet when `quiet404`) and reads as None."""
            try:
                r = await self.app.api("GET", path, **kw)
            except CliError as e:
                if not (quiet404 and "said 404" in str(e)):
                    self.errors[tab].append(f"{what}: {e}")
                return None
            return (r or {}).get(key) if key else (r or {})

        async def load(self, tab: str, draw: bool = True) -> None:
            if self.locked:
                return
            self.errors[tab] = []
            entries = await getattr(self, f"_load_{tab}")()
            if entries is not None:
                self.entries[tab] = entries
            self.loaded[tab] = True
            if draw and tab == self.tab:
                await self.rebuild()
            elif draw:
                self.render_chrome()

        async def _load_queue(self):
            projects, pending, alerts, svcs, pkgs = await asyncio.gather(
                self._get("queue", "projects", "/api/projects", "projects"),
                self._get("queue", "egress", "/api/egress/pending", "pending"),
                self._get("queue", "alerts", "/api/security/events", "events",
                          params={"unacknowledged": "true", "limit": self.LIMIT}),
                self._get("queue", "services", "/api/services", "", quiet404=True),
                self._get("queue", "packages", "/api/packages", "packages", quiet404=True,
                          params={"status": "pending"}))
            if projects is not None:
                self.projects = projects
            self._lan(svcs)
            slugs = [p.get("slug") for p in projects or [] if p.get("slug")]
            reqs = await asyncio.gather(*[
                self._get("queue", f"git {s}", f"/api/projects/{s}/git/requests", "requests")
                for s in slugs])
            if projects is None and pending is None and alerts is None:
                return None
            return self.queue_entries(pending or [], dict(zip(slugs, reqs)), alerts or [],
                                      (svcs or {}).get("services") or [], pkgs or [])

        def _lan(self, svcs) -> None:
            """GET /api/services' LAN fields: services_lan_ip is "" unless a
            valid dedicated address is set; lan_error says why a configured one
            is refused."""
            if svcs is not None:
                self.lan_ip = str(svcs.get("services_lan_ip") or "")
                self.lan_conf = str(svcs.get("services_lan_ip_configured") or "")
                self.lan_error = str(svcs.get("lan_error") or "")

        def lan_markup(self) -> str:
            if self.lan_ip:
                return f"LAN exposure available on {_esc(self.lan_ip)}"
            if self.lan_conf or self.lan_error:
                return (f"[$warning]LAN exposure unavailable: "
                        f"{_esc(self.lan_conf or 'the configured address')} is refused"
                        f"{' — ' + _esc(self.lan_error) if self.lan_error else ''}[/]")
            return "LAN exposure unavailable (no services LAN IP on the server)"

        @staticmethod
        def queue_entries(pending, git: dict, alerts, services=(), packages=()) -> list[dict]:
            asks = [{"type": "egress", "key": f"p{e.get('id')}", "raw": e,
                     "ts": e.get("last_seen") or ""} for e in pending]
            asks += [{"type": "service", "key": f"v{q.get('id')}", "raw": q,
                      "ts": q.get("created_at") or ""}
                     for q in services if q.get("status") == "pending"]
            asks += [{"type": "package", "key": f"pk{q.get('id')}", "raw": q,
                      "ts": q.get("created_at") or ""}
                     for q in packages if q.get("status", "pending") == "pending"]
            for slug, reqs in git.items():
                for q in reqs or []:
                    if q.get("status", "pending") == "pending":
                        asks.append({"type": "git", "key": f"g{slug}:{q.get('id')}",
                                     "raw": {**q, "project_slug": slug},
                                     "ts": q.get("created_at") or ""})
            asks.sort(key=lambda x: x["ts"], reverse=True)
            # a coalesced row (count > 1) sorts and reads by its latest repeat
            al = [{"type": "alert", "key": f"s{e.get('id')}", "raw": e,
                   "ts": ((e.get("count") or 1) > 1 and e.get("last_seen")
                          or e.get("created_at") or "")}
                  for e in alerts if not e.get("acknowledged")]
            al.sort(key=lambda x: x["ts"], reverse=True)
            al.sort(key=lambda x: SecurityPage._rank(x["raw"]))
            return asks + al                  # what waits on a verdict comes first

        @staticmethod
        def _rank(e: dict) -> int:
            return _SEV_RANK.get(e.get("severity"), 2)

        async def _load_network(self):
            pq = {"project": self.project} if self.project else {}
            # the general row is the pre-profiles baseline; a server with
            # profiles may no longer have it, so its absence stays quiet
            pol, summ, evs, projects, profiles = await asyncio.gather(
                self._get("network", "policy",
                          f"/api/egress/policy/{self.project or self.GENERAL}", "",
                          quiet404=not self.project),
                self._get("network", "summary", "/api/egress/summary", "", params=pq),
                self._get("network", "events", "/api/egress/events", "events",
                          params={"limit": self.LIMIT, **pq}),
                self._get("network", "projects", "/api/projects", "projects"),
                self._get("network", "profiles", "/api/profiles", "profiles", quiet404=True))
            self.net = {"policy": pol, "summary": summ}
            if projects is not None:
                self.projects = projects
            if profiles is not None:
                self.profiles = profiles
            slugs = ([self.project] if self.project else
                     [p.get("slug") for p in self.projects if p.get("slug")])
            if self.project:
                pols = [pol]
            else:
                pols = await asyncio.gather(*[
                    self._get("network", f"policy {s}", f"/api/egress/policy/{s}", "")
                    for s in slugs])
            if evs is None:
                return None
            return self.network_entries(dict(zip(slugs, pols)), evs,
                                        None if self.project else self.GENERAL)

        @staticmethod
        def network_entries(policies: dict, events, general: str | None) -> list[dict]:
            """Grouped by project: each project's policy row (its own allow and
            deny lists over the profile baseline), then its traffic, newest
            first; unattributed traffic last, under `general`."""
            by: dict[str, list[dict]] = {}
            for e in events:
                by.setdefault(e.get("project_slug") or general or "", []).append(e)
            out = []
            groups = list(policies) + [g for g in by if g not in policies]
            for slug in groups:
                if slug in policies:
                    out.append({"type": "policy", "key": f"P{slug}",
                                "raw": {"slug": slug, "policy": policies[slug] or {}}})
                elif slug == general or slug == IMAGE_BUILD:
                    out.append({"type": "group", "key": f"P{slug}",
                                "raw": {"slug": _slug_says(slug)}})
                evs = sorted(by.get(slug, []), key=lambda e: e.get("created_at") or "",
                             reverse=True)
                out += [{"type": "net", "key": f"e{e.get('id')}", "raw": e,
                         "ts": e.get("created_at") or ""} for e in evs]
            return out

