        async def c_new(self, arg: str = "") -> None:
            await self.host.home()
            self.cid, self.title_text, self.last_reply = None, None, ""
            self.child_of = None
            self.shown_model, self.info, self.todos = None, None, []
            self.orchestrator = False
            await self.show_home()

        async def c_sessions(self, arg: str) -> None:
            convs = await self.refresh_convs()
            if not arg:
                rows = []
                # the dialog is 90% of the terminal, 110 at most, less its padding (4),
                # the list's (2 and a scrollbar's 1) and the mark (2); a row is the
                # title, two spaces and the meta, and the title gives way so the
                # meta stays on the same line
                width = min(self.size.width * 9 // 10, 110) - 4 - 3 - 2
                for cv in convs[:100]:
                    meta = session_when(cv.get("started_at"))
                    if cv.get("project_slug"):
                        meta += f"  ⌂ {_short(cv['project_slug'], 18)}"
                    if cv.get("running"):
                        meta += "  ● running"
                    if cv.get("starred"):
                        meta = "★ " + meta
                    # one row per chat: a summary that is still the first
                    # message can carry newlines
                    title = " ".join(str(cv.get("summary") or "").split()) or "(untitled)"
                    rows.append((str(cv["id"]), _short(title, max(16, width - len(meta) - 2)),
                                 meta))
                arg = await self.pick("Sessions", rows, str(self.cid) if self.cid else None,
                                      wide=True) or ""
                if not arg:
                    return
            if not arg.isdigit():
                hits = [cv for cv in convs if arg.lower() in (cv.get("summary") or "").lower()]
                if not hits:
                    raise CliError(f"no chat matches {arg!r}")
                arg = str(hits[0]["id"])
            await self.open_conversation(int(arg))

        async def open_conversation(self, cid: int, running: bool = False,
                                    parent: int | None = None) -> None:
            await self.host.home()
            r = await self.api("GET", f"/api/conversations/{cid}/messages")
            self.cid, self.ephemeral = cid, False
            self.child_of = parent          # an agent's chat: esc goes back to its parent
            self.orchestrator = r.get("kind") == "orchestrator" or r.get("mode") == "orchestrate"
            meta = next((cv for cv in self.convs if cv.get("id") == cid), {})
            self.title_text = meta.get("summary")
            self.agent = r.get("agent_slug") or None
            self.project = meta.get("project_slug") or None
            self.project_mode = "pin" if self.project else None
            self.todos, self.last_reply = [], ""
            self.run_worker(self._load_perm_mode(cid), group="perm")
            await self.clear_log()
            msgs = [m for m in r.get("messages", []) if m.get("role") in ("user", "assistant")]
            if len(msgs) > 60:
                await self.note(f"… {len(msgs) - 60} earlier messages (/export has them all)")
            for m in msgs[-60:]:
                if m["role"] == "user":
                    body = m.get("content") or ""
                    # an agent's brief is server-wrapped text: let the terminal wrap it
                    await self.log_view.mount(UserMsg(_esc(reflow(body) if self.child_of
                                                           else body)))
                    continue
                for a in m.get("activity") or []:
                    tv = ToolView(a["name"], a.get("args"), ok=a.get("ok"),
                                  result=a.get("result"), done=True)
                    await self.log_view.mount(tv)
                    if a["name"] == "todo_update" and parse_todos(a.get("result") or ""):
                        self.todos = parse_todos(a["result"])
                if (m.get("content") or "").strip():
                    await self.log_view.mount(Reply(m["content"]))
                if m.get("model"):
                    self.shown_model = m["model"]
                who = self.agent or "Jav3"
                mname = (m.get("model") or "").split("/")[-1]
                await self.log_view.mount(Footer(
                    f"[$primary]▣[/] {_esc(who)}" + (f" · {_esc(mname)}" if mname else "")))
                self.last_reply = m.get("content") or ""
            self.log_view.scroll_end(animate=False)
            await self.refresh_info()
            if r.get("running") or running:
                for a in r.get("pending_activity") or []:
                    await self.log_view.mount(ToolView(a["name"], a.get("args"), ok=a.get("ok"),
                                                       result=a.get("result"), done=True))
                await self.note("a turn is running — attached" + (
                    f" · esc goes back to #{self.child_of}, ctrl+c stops it"
                    if self.child_of else ""), "warn")
                self.run_worker(self.attach(cid, r.get("pending_activity") or []),
                                group="turn")

        async def c_model(self, arg: str) -> None:
            if not arg and self.full_access:
                await self._pick_model_full()
                return
            if not arg:
                rows = [(v, v.split("/")[-1], meta) for v, meta in self.arg_options("models")]
                cur = self.model or self.shown_model or (self.options or {}).get("default")
                arg = await self.pick("Models", rows, cur, custom=True,
                                      hint="provider/model · 'default' clears the pin") or ""
                if not arg:
                    return
            if arg in ("default", "none"):
                self.model = None
                self.notify("model: server default for new chats")
                self.refresh_chrome()
                return
            known = [m["id"] for m in (self.options or {}).get("models", [])]
            if known and arg not in known:
                near = [k for k in known if arg in k]
                if len(near) != 1:
                    raise CliError(f"not an enabled model: {arg}")
                arg = near[0]
            self.model = arg
            self.notify(f"model: {arg}" + (" — pinned to this chat from the next message"
                                           if self.cid else ""))
            self.refresh_chrome()

        async def c_agent(self, arg: str) -> None:
            if not arg:
                rows = [(v, meta or v, "") for v, meta in self.arg_options("persona")]
                arg = await self.pick("Agent presets", rows, self.agent or "none", custom=True,
                                      hint="a new chat starts as the agent you pick") or ""
                if not arg:
                    return
            self.agent = None if arg == "none" else arg
            await self.c_new()
            self.notify(f"new chat as {self.agent or 'Jav3'}")

        async def c_project(self, arg: str) -> None:
            if not arg:
                actions = {"l": ("load as active", self._load_project)} \
                    if self.full_access else None
                arg = await self.pick("Projects", await self._project_rows(),
                                      self.project or self.project_mode, custom=True,
                                      actions=actions,
                                      hint="enter pins this chat to it") or ""
                if not arg:
                    return
            made = arg == NEW_PROJECT
            if made:
                arg = await self._new_project() or ""
                if not arg:
                    return
            mode = arg if arg in ("none", "follow") else "pin"
            slug = arg if mode == "pin" else None
            if slug is not None and not made:
                slug = await self._known_project(slug)
                if not slug:
                    return
            if self.cid is not None:
                body = {"mode": mode}
                if slug:
                    body["project"] = slug
                await self.api("PATCH", f"/api/conversations/{self.cid}", json=body)
            self.project, self.project_mode = slug, mode
            self.notify({"pin": f"project: {slug}",
                         "none": "project: none — file work goes to the chat's artifacts",
                         "follow": "project: follows whatever is loaded"}[mode])
            self.refresh_chrome()

        def add_theme(self, theme) -> None:
            """Register a Theme, or the dict of a validated theme file, with a solid
            muted-text colour; on a 256-colour terminal it is the snapped variant
            (terminal_theme_spec). The theme as given is kept for /theme export."""
            if isinstance(theme, dict):
                theme = Theme(**theme)
            self.theme_src[theme.name] = theme
            if not theme.ansi:
                spec = terminal_theme_spec(resolved_theme_spec(theme), self.truecolor)
                spec["variables"] = {"text-muted": muted_colour(spec, not self.truecolor),
                                     **spec["variables"]}
                theme = Theme(**spec)
            self.register_theme(theme)
            if theme.name == self.theme and self.is_mounted:
                self.refresh_css(animate=False)     # the active theme changed under it

        def drop_theme(self, name: str) -> None:
            self.unregister_theme(name)
            self.theme_src.pop(name, None)

        def theme_names(self) -> list[str]:
            return sorted(t for t in self.available_themes if t != THEME_PREVIEW)

        def theme_rows(self) -> list[tuple[str, str, str]]:
            """The picker's rows: Jav3's own themes, then Textual's, then yours."""
            def order(t):
                return (0 if t == "jav3" or t in JAV3_THEMES else
                        2 if t not in self.builtin_themes else 1, t)
            return [(t, t, ("light" if not self.available_themes[t].dark else "dark")
                     + (" · yours" if t not in self.builtin_themes else ""))
                    for t in sorted(self.theme_names(), key=order)]

        def current_theme_dict(self) -> dict:
            from textual.color import Color
            t = self.theme_src.get(self.theme) or self.current_theme
            d = {"name": t.name, "dark": bool(t.dark)}
            for k in THEME_COLOURS:
                v = getattr(t, k, None)
                if v:
                    try:
                        d[k] = Color.parse(v).hex[:7].lower()
                    except Exception:
                        pass
            return d

        async def c_theme(self, arg: str) -> None:
            word, _, rest = arg.partition(" ")
            rest = rest.strip()
            if word == "create":
                base = self.current_theme_dict()
                base["name"] = ""
                name = await self.push_screen_wait(ThemeEditor(base, self.builtin_themes))
                if name:
                    self.theme = name
                    self._save_settings(theme=name)
                    self.notify(f"theme {name} saved in {themes_dir()}")
                return
            if word == "export":
                src = self.theme_src.get(self.theme) or self.current_theme
                if src.ansi:
                    raise CliError(f"{src.name} uses the terminal's own colours, so there is "
                                   "no #rrggbb to export — /theme create starts one")
                d = self.current_theme_dict()
                if d["name"].lower() in self.builtin_themes:
                    d["name"] = (d["name"][:35] + "-copy")
                d = validate_theme(d)
                loc = rest or str(Path.home() / "Downloads")
                stem = safe_stem(d["name"], "theme")
                if loc.lower().endswith(".json"):
                    stem = safe_stem(Path(loc).name[:-5], stem)
                    loc = str(Path(loc).parent)
                path = write_new(safe_output_dir(loc), stem, "json",
                                 (json.dumps(d, indent=2) + "\n").encode())
                self.notify(f"theme {d['name']} exported to {path}")
                return
            if word == "import":
                if not rest:
                    raise CliError("usage: /theme import <path to a .json theme>")
                clean, path = import_theme(rest, self.builtin_themes)
                self.add_theme(clean)
                self.theme = clean["name"]
                self._save_settings(theme=clean["name"])
                self.notify(f"theme {clean['name']} imported to {path} — the source file "
                            "can be deleted")
                return
            if not arg:
                before = self.theme
                arg = await self.push_screen_wait(ThemePicker(
                    "Themes", self.theme_rows(), before,
                    hint="↑↓ preview it on this screen · enter keeps it · esc puts "
                         "the old one back")) or ""
                if not arg:
                    self.theme = before
                    return
            if arg not in self.available_themes or arg == THEME_PREVIEW:
                raise CliError(f"no theme {arg!r} — /theme lists them")
            self.theme = arg
            self._save_settings(theme=arg)

        async def c_temp(self, arg: str) -> None:
