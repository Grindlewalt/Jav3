        UserMsg.failed { border-left: thick $error; }
        BrainDump { align: center middle; background: $background 60%; }
        #dump { height: 1fr; min-height: 8; border: none; background: $panel; }
        #dump:focus { border: none; }
        #dump-foot { height: 1; margin-top: 1; }
        #dump-hint { width: 1fr; }
        """
        BINDINGS = [
            Binding("ctrl+x", "leader", "leader", show=False, priority=True),
            Binding("ctrl+c", "ctrl_c", show=False, priority=True),
            Binding("escape", "escape", show=False),
            Binding("ctrl+n", "new", show=False, priority=True),
            Binding("ctrl+b", "toggle_sidebar", show=False, priority=True),
            Binding("ctrl+o", "toggle_tools", show=False, priority=True),
            Binding("ctrl+g", "external_editor", show=False, priority=True),
            Binding("pageup", "scroll_log(-1)", show=False, priority=True),
            Binding("pagedown", "scroll_log(1)", show=False, priority=True),
            Binding("ctrl+d", "ctrl_d", show=False, priority=True),
        ]
        # keys the dialogs need for themselves
        _MAIN_ONLY = {"leader", "new", "toggle_sidebar", "toggle_tools", "external_editor",
                      "scroll_log", "ctrl_d"}
        # ...and of those, the ones that mean the chat: a page keeps pgup/pgdn, ctrl+o,
        # ctrl+g and ctrl+d for itself
        _CHAT_ONLY = {"toggle_tools", "external_editor", "scroll_log", "ctrl_d"}

        def __init__(self, base: str, token: str | None, *,
                     server_override: str | None = None,
                     project: str | None = None, agent: str | None = None,
                     model: str | None = None, resume: int | None = None,
                     cont: bool = False, prompt: str | None = None, transport=None):
            super().__init__()
            self.base, self.token, self.server_override = base, token, server_override
            self.transport = transport       # tests hand in an httpx mock transport
            self.cid: int | None = None
            self.title_text: str | None = None
            self.project, self.project_mode = project, ("pin" if project else None)
            self.agent, self.model = agent, model
            self.shown_model: str | None = None
            self.ephemeral = False
            self.local = False                         # /local: the next new chat runs here
            self.local_execs: dict[int, LocalExecutor] = {}
            self.local_cids: set[int] = set()         # chats this client opened as /local
            self.whoami = "?"
            self.logged_in: bool | None = None    # None = not checked yet
            self.notices: list[tuple[float, str, str]] = []   # (time, kind, text), newest first
            self.unread = 0
            self.crit_unread = 0                  # of those, critical security alerts
            self.dnd: dict | None = None          # the server's do-not-disturb, while on
            self.options: dict = {}
            self.convs: list[dict] = []
            self.info: dict | None = None
            self.todos: list[tuple[bool, str]] = []
            self.busy = False
            self.turn: TurnState | None = None
            self.last_turn: TurnState | None = None
            self.stop_requested = False
            self.queue: list[str] = []
            self.pending: list = []          # QueuedMsg posted mid-turn, not yet delivered
            self.orchestrator = False        # this chat is an orchestrator (/orchestration)
            self.child_of: int | None = None   # this view is an agent under that conversation
            self.attachments: list[str] = []
            self.last_user: str | None = None
            self.last_reply = ""
            self.leader = False
            self._leader_timer = None
            self._status_tall = False        # the status row grown for the leader keys
            self._status_text: dict[str, str] = {}   # what the status row shows now
            self.esc_armed = 0.0
            self.ctrl_c_at = 0.0
            self.sidebar_pref: bool | None = None     # None = follow the width
            self._yolo_armed = -100.0                 # when shift+tab last stopped short of yolo
            self.tools_expanded = False
            self.history: list[str] = []
            self.hist_pos: int | None = None
            self.hist_draft = ""
            self.popup_items: list[tuple[str, str]] = []   # (kind, value)
            self.arg_deliberate = False     # the argument menu was opened by Tab or ↑ ↓
            self.initial = (resume, cont, prompt)
            self.client = None
            self.page_classes = {"agents": AgentsPage, "security": SecurityPage,
                                 "vms": VmsPage}
            self.commands = self._commands()
            self.frame = 0
            self.example = EXAMPLES[int(time.time()) % len(EXAMPLES)]

        # -- composition ---------------------------------------------------------------

        def compose(self) -> ComposeResult:
            with Horizontal(id="main"):
                with Vertical(id="left"):
                    with PageHost(id="host"):
                        with ChatPage(id="chat-page"):
                            yield Static(id="header")
                            yield ChatLog(Home(), id="log")
                            yield NewHint(id="new-hint")
                    with Vertical(id="bottom"):
                        yield OptionList(id="popup")
                        with Vertical(id="prompt"):
                            yield Editor(id="editor", compact=True, show_line_numbers=False,
                                         highlight_cursor_line=False,
                                         placeholder=f'Ask anything… "{self.example}"')
                            yield Static(id="meta")
                        with Horizontal(id="status"):
                            yield Static(id="status-left")
                            yield Static(id="status-right")
                with VerticalScroll(id="sidebar", can_focus=False):
                    yield Static(id="sb-title")
                    yield Static(id="sb-context")
                    yield Static(id="sb-model")
                    yield Static(id="sb-files")
                    yield Static(id="sb-todo")
                    yield Static(id="sb-notes")
                    yield Static(id="sb-foot")

        @property
        def host(self):
            return self.query_one("#host", PageHost)

        @property
        def page(self):
            """The page showing in the host (the chat, unless another page is over it)."""
            return self.host.current

        @property
        def top(self):
            """What the operator is looking at: the dialog over everything, else the page."""
            return self.screen if isinstance(self.screen, ModalScreen) else self.page

        @property
        def paged(self) -> bool:
            """A page other than the chat is showing."""
            return not isinstance(self.page, ChatPage)

        @property
        def log_view(self):
            return self.query_one("#log", VerticalScroll)

        @property
        def editor(self):
            return self.query_one("#editor", Editor)

        async def on_mount(self) -> None:
            # With 256 colours (Terminal.app) the three near-black greys all round
            # to the same black: dialogs, the prompt box and the input fields
            # vanished into the background. There they are greys from the
            # 256-colour ramp itself (233/235/237), which survive the rounding.
            truecolor = self.truecolor = self.console.color_system == "truecolor"
            self.theme_src = {}
            kept = {n: t for n, t in self.available_themes.items() if n in THEME_KEEP}
            for name in list(self.available_themes):
                if name not in kept:
                    self.unregister_theme(name)
            self.add_theme(dict(
                name="jav3", primary="#5fd7af", secondary="#af87ff", accent="#ffaf5f",
                foreground="#e4e4e4",
                background="#0e1014" if truecolor else "#121212",
                surface="#161a20" if truecolor else "#262626",
                panel="#1e232b" if truecolor else "#3a3a3a",
                warning="#ffaf00", error="#ff6b6b", success="#5fd787", dark=True))
            for spec in jav3_theme_specs(truecolor):
                self.add_theme(spec)
            from dataclasses import replace
            for theme in kept.values():
                self.add_theme(replace(theme, **THEME_TUNE.get(theme.name, {})))
            self.builtin_themes = {n.lower() for n in self.available_themes} | {
                THEME_PREVIEW}
            customs, errors = load_custom_themes(self.builtin_themes)
            for clean in customs:
                self.add_theme(clean)
            for e in errors:
                self.push_notice(e, "warn")
            settings = self._load_settings()
            self.theme = settings.get("theme") if settings.get("theme") in \
                self.available_themes else "jav3"
            self.watch_theme(self.theme)         # set even when the theme did not change
            self.sidebar_pref = settings.get("sidebar")
            self._load_history()
            self.log_view.anchor()
            self.editor.focus()
            self.set_interval(0.1, self._tick)
            self.refresh_chrome()
            self.run_worker(self._startup(), group="startup")

        async def _startup(self) -> None:
            self.client = self._new_client()
            resume, cont, prompt = self.initial
            if not await self._check_login():
                if prompt:                 # keep it for after /login
                    self.editor.text = prompt
                    self.editor.move_cursor(self.editor.document.end)
                return
            await self._after_login()
            if not self.options:
                await self.note("this server predates the TUI's pickers (/api/chat/options): "
                                "/model, /agent and /project take typed names", "warn")
            self.refresh_chrome()
            try:
                if cont and self.convs:
                    await self.open_conversation(self.convs[0]["id"])
                elif resume is not None:
                    await self.open_conversation(resume)
            except CliError as e:
                await self.note(str(e), "error")
            if prompt:
                self.send(prompt)

        async def _check_login(self) -> bool:
            """Who the saved credential is. No credential, or a 401: the
            not-logged-in state (the TUI runs; /login fixes it)."""
            if not self.token or not self.base:
                self.logged_in = False
                await self.note(NOT_LOGGED_IN, "warn")
                self.refresh_chrome()
                return False
            try:
                who = await self.api("GET", "/api/devices/whoami")
            except NotLoggedIn:
                self.logged_in = False
                await self.note("the saved login was refused (revoked or expired) — /login",
                                "warn")
                self.refresh_chrome()
                return False
            except CliError as e:
                await self.note(str(e), "error")
                return False
            self.whoami = who.get("username") or "?"
            self.logged_in = True
            return True

        async def _after_login(self) -> None:
            await asyncio.gather(self.refresh_options(), self.refresh_convs())
            if is_session(self.token):
                self.run_worker(self._notice_loop(), group="notices", exclusive=True)
            self.refresh_chrome()

        @property
        def full_access(self) -> bool:
            return is_session(self.token) and self.logged_in is not False

        def _access_label(self) -> str:
            if not self.token or self.logged_in is False:
                return "not logged in"
            return "full access" if is_session(self.token) else "chat only"

        def _need_full(self, what: str) -> None:
            if not self.full_access:
                raise CliError(f"{what} needs full access — /login with your password "
                               "(a device token from Settings → Add computer is chat only)")

        async def _notice_loop(self) -> None:
            """The server's one multiplexed stream, topics `notices` (agent runs
            the operator started finishing elsewhere) and `security` (alerts,
            of which only those the server marks `ping` notify) ->
            notifications. Operator session only. A server without /api/events
            answers 404 and the loop falls back to the notices stream alone."""
            backoff = 2.0
            path = "/api/events?topics=notices,security"
            while is_session(self.token) and self.client is not None:
                try:
                    async with self.client.stream("GET", path) as r:
                        if r.status_code in (401, 403):
                            return
                        if r.status_code == 404 and path.startswith("/api/events"):
                            path = "/api/agents/notices/stream"
                            continue
                        if r.status_code < 400:
                            backoff = 2.0
                            await self._load_dnd()        # it may have changed while we were away
                            async for ev in aiter_sse(r.aiter_lines()):
                                if "topic" in ev:          # /api/events wraps each one
                                    ev = ev.get("event") or {}
                                if ev.get("type") == "agent_run_done":
                                    self._agent_notice(ev)
                                elif ev.get("type") == "storage_warning":
                                    self.push_notice("◆ " + _short(ev.get("summary") or "storage is filling up", 300), "warn")
                                elif ev.get("type") == "security_event":
                                    await self._security_notice(ev)
                                elif ev.get("type") == "dnd_changed":
                                    self._set_dnd(ev)
                                elif ev.get("type") == "dnd_summary":
                                    self.push_notice("◆ " + _short(ev.get("summary") or "", 200),
                                                     "warn", dnd_break=True)
                except (httpx.HTTPError, ValueError):
                    pass
                await asyncio.sleep(backoff)
                backoff = min(backoff * 2, 60.0)

        async def _security_notice(self, ev: dict) -> None:
            """A live security event. The server decides whether it pings
            (backend/security.py, against Settings -> Notifications: critical
            only / needs my approval / everything); an event without `ping`
            (an older server) pings only when critical. A ping is a sidebar
            notice and, with the sidebar hidden, a toast and the status-row
            badge. A critical one also counts in its own red badge and, while
            a turn of this chat or project runs, prints a red line in the chat.
            Every string is the server's: plain text, never markup."""
            crit = ev.get("severity") == "critical" or ev.get("tier") == "critical"
            if not (ev["ping"] if "ping" in ev else crit):
                return
            proj = ev.get("project") or ev.get("project_slug")
            n = ev.get("count") or 1
            text = (f"{ev.get('kind') or 'alert'}{' ⌂ ' + str(proj) if proj else ''} "
                    f"{_short(str(ev.get('summary') or ''), 140)}"
                    + (f" (×{n})" if isinstance(n, int) and n > 1 else ""))
            if crit and not self.sidebar_shown():
                self.crit_unread += 1
            self.push_notice(text, "error" if crit else "warn",
                             timeout=20 if crit else 5, dnd_break=True)
            if crit and self.busy and self.turn is not None and self._in_this_turn(ev, proj):
                from textual.css.query import NoMatches
                try:
                    await self.mount_log(Note(_esc(f"security: {text} — /security to review"),
                                              classes="error"))
                except NoMatches:
                    pass

        def _in_this_turn(self, ev: dict, proj) -> bool:
            """Does a live event belong to the turn on screen? Its conversation
            is this chat, or its project is this chat's, or it has none (a
            shared-box or host-wide alert)."""
            d = ev.get("detail") if isinstance(ev.get("detail"), dict) else {}
            cid = d.get("conversation_id")
            if cid is not None and cid in (self.cid, getattr(self.turn, "cid", None)):
                return True
            return not proj or proj == self._project_label()

        def _agent_notice(self, ev: dict) -> None:
            who = ev.get("agent") or ev.get("slug") or "an agent"
            where = f" #{ev['conversation_id']}" if ev.get("conversation_id") else ""
            if ev.get("ok") is False:
                self.push_notice(f"◆ {who}{where} failed after {ev.get('took', '?')}: "
                                 f"{_short(ev.get('error') or 'error', 120)}", "error")
            else:
                tail = f" — {_short(ev['summary'], 120)}" if ev.get("summary") else ""
                self.push_notice(f"◆ {who}{where} finished in {ev.get('took', '?')}{tail}",
                                 "done")

        # -- do not disturb ---------------------------------------------------------------------

        def _set_dnd(self, d: dict | None) -> None:
            """The server's do-not-disturb state (`on`, `until`, `break_critical`): a
            mark in the status row, and pings (sidebar count, toasts) held back in
            push_notice. The server already stamps what pings, so a security event
            needs nothing from this beyond the mark."""
            self.dnd = dict(d) if isinstance(d, dict) and d.get("on") else None
            self.refresh_chrome()

        async def _load_dnd(self) -> None:
            try:
                r = await self.api("GET", "/api/notifications/dnd")
            except CliError:
                return                  # an older server has no do-not-disturb
            self._set_dnd(r)

        def _dnd_end(self):
            from datetime import datetime, timezone
            u = (self.dnd or {}).get("until")
            try:
                d = datetime.fromisoformat(str(u).replace("Z", "+00:00")) if u else None
            except ValueError:
                return None
            return d if d is None or d.tzinfo else d.replace(tzinfo=timezone.utc)

        def _dnd_left(self) -> str:
            """'47m' or '1h 12m' left, '' when it runs until turned off."""
            from datetime import datetime, timezone
            end = self._dnd_end()
            if end is None:
                return ""
            mins = max(0, -(-int((end - datetime.now(timezone.utc)).total_seconds()) // 60))
            h, m = divmod(mins, 60)
            return f"{mins}m" if not h else f"{h}h {m}m" if m else f"{h}h"

        def _dnd_until_text(self) -> str:
            end = self._dnd_end()
            if end is None:
                return "until you turn it off (/dnd off)"
            local, now = end.astimezone(), time.localtime()
            same_day = (local.year, local.month, local.day) == (now.tm_year, now.tm_mon,
                                                                 now.tm_mday)
            return f"until {'' if same_day else local.strftime('%a ')}{local:%H:%M}"

        @staticmethod
        def _dnd_request(arg: str) -> dict:
            """The PUT body for `/dnd <arg>`: '' and 'on' (until turned off), '1h',
            '90m', '2d', 'tomorrow' (the next 08:00 local), 'off'."""
            from datetime import datetime, timedelta, timezone
            a = (arg or "").strip().lower()
            if a in ("", "on"):
                return {"on": True}
            if a in ("off", "stop", "end"):
                return {"on": False}
            if a in ("tomorrow", "morning"):
                now = datetime.now().astimezone()
                t = now.replace(hour=8, minute=0, second=0, microsecond=0)
                if t <= now:
                    t += timedelta(days=1)
                return {"on": True,
                        "until": t.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
            m = re.fullmatch(r"(\d+)\s*(m|min|mins|h|hr|hrs|hour|hours|d|day|days)?", a)
            if m is None or int(m.group(1)) <= 0:
                raise CliError(f"dnd: {arg!r} is not a time: try 1h, 90m, tomorrow or off")
            unit = (m.group(2) or "m")[0]
            return {"on": True, "minutes": int(m.group(1)) * {"m": 1, "h": 60, "d": 1440}[unit]}

        async def c_dnd(self, arg: str) -> None:
            """/dnd [1h|4h|90m|tomorrow|off]: do not disturb. Nothing pings (no toast,
            no sidebar count) until it ends; alerts still count in /security and are
            still recorded. A critical alert breaks through unless Settings says not.
            /dnd alone turns it on until you turn it off."""
            self._need_full("do not disturb")
            body = self._dnd_request(arg)
            if body["on"] and not arg.strip() and self.dnd:
                await self.note("do not disturb is on " + self._dnd_until_text()
                                + " — /dnd off turns it off")
                return
            r = await self.api("PUT", "/api/notifications/dnd", json=body)
            self._set_dnd(r)
            if not body["on"]:
                await self.note("do not disturb is off")
            else:
                await self.note("do not disturb is on " + self._dnd_until_text()
                                + ": nothing pings; alerts still count in /security")

        # -- notifications ---------------------------------------------------------------------

        def sidebar_shown(self) -> bool:
            return bool(self.sidebar_pref) and self.size.width >= SIDEBAR_MIN_COLS

        def push_notice(self, text: str, kind: str = "info", toast: bool = True,
                        timeout: float = 5, dnd_break: bool = False) -> None:
            """Newest first, capped. With the sidebar hidden it also counts as
            unread (the badge in the status row) and shows as a toast. While do not
            disturb is on a notice that would ping (`toast`) is only listed, unless
            `dnd_break`: the server let it through (a critical alert) or it is the
            end-of-DND summary."""
            from textual.css.query import NoMatches
            self.notices.insert(0, (time.time(), kind, text))
            del self.notices[NOTICE_CAP:]
            if not self.sidebar_shown() and not (toast and self.dnd and not dnd_break):
                self.unread += 1
                if toast:
                    self.notify(text, timeout=timeout,
                                severity={"error": "error", "warn": "warning"}
                                .get(kind, "information"))
            try:
                self._refresh_sidebar()
                self._refresh_status()
            except NoMatches:
                pass          # a dialog is on top; the next refresh catches up

        def notify(self, message, *, markup: bool = False, **kw):
            # every toast here is plain text, often the server's (a chat title,
            # an agent's summary, an error): never parse it as markup
            return super().notify(message, markup=markup, **kw)

        async def on_unmount(self) -> None:
            if self.client is not None:
                await self.client.aclose()

        # -- settings and history ------------------------------------------------------------

        def _settings_path(self) -> Path:
            return config_dir() / "tui.json"

        def _load_settings(self) -> dict:
            try:
                d = json.loads(self._settings_path().read_text())
                return d if isinstance(d, dict) else {}
            except (OSError, ValueError):
                return {}

        def _save_settings(self, **kw) -> None:
            d = self._load_settings()
            d.update(kw)
            try:
                config_dir().mkdir(parents=True, exist_ok=True)
                self._settings_path().write_text(json.dumps(d))
            except OSError:
                pass

        def _history_path(self) -> Path:
            return config_dir() / "history.jsonl"

        def _load_history(self) -> None:
            try:
                for ln in self._history_path().read_text().splitlines()[-500:]:
                    try:
                        self.history.append(json.loads(ln))
                    except ValueError:
                        pass
            except OSError:
                pass

        def _remember(self, text: str) -> None:
            if not text.strip() or (self.history and self.history[-1] == text):
                return
            self.history.append(text)
            try:
                config_dir().mkdir(parents=True, exist_ok=True)
                fd = os.open(self._history_path(), os.O_WRONLY | os.O_CREAT | os.O_APPEND,
                             0o600)
                with os.fdopen(fd, "a") as f:
                    f.write(json.dumps(text) + "\n")
            except OSError:
                pass

        def history_step(self, d: int) -> bool:
            if not self.history:
                return False
            ed = self.editor
            if self.hist_pos is None:
                if d > 0:
                    return False
                self.hist_draft, self.hist_pos = ed.text, len(self.history)
            pos = self.hist_pos + d
            if pos < 0:
                return True
            if pos >= len(self.history):
                self.hist_pos = None
                ed.text = self.hist_draft
            else:
                self.hist_pos = pos
                ed.text = self.history[pos]
            # text recalled from history must not open the slash menu, or the
            # next arrow key drives the menu instead of walking history; it
            # opens again as soon as the operator types (the text then differs)
            self._hist_text = ed.text
            self.hide_popup()
            ed.move_cursor(ed.document.end)
            return True

        # -- HTTP --------------------------------------------------------------------------

        def _new_client(self):
            return httpx.AsyncClient(
                base_url=self.base, follow_redirects=False, transport=self.transport,
                headers={"User-Agent": "jav3-cli", **auth_headers(self.token)},
                timeout=httpx.Timeout(30.0, read=None))

        async def api(self, method: str, path: str, **kw):
            if not self.base or self.client is None or not self.token:
                raise NotLoggedIn(NOT_LOGGED_IN)
            try:
                r = await self.client.request(method, path, **kw)
            except httpx.HTTPError as e:
                raise CliError(f"could not reach {self.base}: {net_error_text(e)}")
            if r.is_redirect:
                raise CliError(redirect_hint(self.base, r.headers.get("location", "")))
            if r.status_code == 401:
                self._login_lost()
                raise NotLoggedIn(SESSION_LOST)
            if r.status_code >= 400:
                raise CliError(f"server said {r.status_code}: {_detail(r)}")
            try:
                return r.json()
            except ValueError:
                return {}

        def _login_lost(self) -> None:
            if self.logged_in:
                self.logged_in = False
                self.push_notice("the server refused the login (expired or revoked) — /login",
                                 "warn")

        async def refresh_options(self) -> None:
            try:
                self.options = await self.api("GET", "/api/chat/options")
            except CliError:
                self.options = {}

        async def refresh_convs(self) -> list[dict]:
            try:
                self.convs = (await self.api("GET", "/api/conversations"))["conversations"]
            except (CliError, KeyError, TypeError):
                pass
            return self.convs

        async def refresh_info(self) -> None:
            if self.cid is None:
                self.info = None
            else:
                try:
                    self.info = await self.api("GET", f"/api/conversations/{self.cid}/info")
                    if self.info.get("title"):
                        self.title_text = self.info["title"]
                except CliError:
                    self.info = None
            self.refresh_chrome()

        # -- transcript -------------------------------------------------------------------------

        unseen = 0                     # transcript items mounted while scrolled up

        async def mount_log(self, widget) -> None:
            home = self.query(Home)
            if home:
                await home.remove()
            lv = self.log_view
            if not self._following():
                self.unseen += 1               # "↓ n new" until they scroll back down
            await lv.mount(widget)

        def _following(self) -> bool:
            """The transcript keeps to the bottom (Textual's anchor), i.e. the
            operator has not scrolled up to read something."""
            lv = self.log_view
            return lv.max_scroll_y <= 0 or (lv.is_anchored
                                            and not getattr(lv, "_anchor_released", False))

        def _refresh_new_hint(self) -> None:
            hint = self.query_one(NewHint)
            if self.unseen and self._following():
                self.unseen = 0
            show = bool(self.unseen)
            if hint.display != show:
                hint.display = show
            if show:
                text = f"↓ {self.unseen} new below · pgdn, or click here"
                if str(hint.render()) != text:
                    hint.update(text)

        async def note(self, text: str, kind: str = "info") -> None:
            await self.mount_log(Note(_esc(text), classes=kind))
            if kind == "error":
                self.push_notice(text, "error")

        async def say(self, text: str, kind: str = "info") -> None:
            """A note in the chat, and a toast too while a page hides the chat (the
            answer to a command typed over a page must be seen where it was typed)."""
            await self.note(text, kind)
            if self.paged and kind != "error":
                self.notify(text, severity="warning" if kind == "warn" else "information")

        async def clear_log(self) -> None:
            await self.log_view.remove_children()
            # a new transcript starts at the bottom, following it, whatever the
            # last one was scrolled to
            self.log_view.anchor()
            self.log_view.picked = None
            self.unseen = 0

        async def show_home(self) -> None:
            await self.clear_log()
            await self.log_view.mount(Home())
            self.refresh_chrome()

        # -- chrome: prompt meta, status row, sidebar ----------------------------------------------

        def _model_label(self) -> str:
            return self.model or self.shown_model or (self.options or {}).get("default") or "default"

        def _here(self) -> dict | None:
            """Where this chat works when it is a /local one: the conversation's
            own record, or — during its first turn, before /info has been read —
            this directory, since this client opened it as local."""
            if self.cid is None:
                return {"cwd": os.getcwd()} if self.local else None
            here = (self.info or {}).get("local")
            if here:
                return here
            return {"cwd": os.getcwd()} if self.cid in self.local_cids else None

        def _project_label(self) -> str | None:
            # a local chat works on this machine, not in any project
            if self._here():
                return None
            if self.project:
                return self.project
            if self.project_mode == "none":
                return "no project"
            return (self.info or {}).get("project") or (self.options or {}).get("active_project")

        def refresh_chrome(self) -> None:
            if not self.is_mounted:
                return
            try:
                prompt = self.query_one("#prompt")
            except Exception:  # noqa: BLE001 — a dialog is on top
                return
            prompt.set_class(bool(self.agent), "agent")
            prompt.set_class(self.ephemeral, "temp")
            prompt.set_class(self.busy, "busy")
            paged = self.paged
            self.query_one("#bottom").set_class(paged, "paged")
            self.editor.placeholder = ("/ for a command · /work back to the chat" if paged
                                       else f'Ask anything… "{self.example}"')
            who = f"[$secondary b]{_esc(self.agent)}[/]" if self.agent else "[$primary b]Jav3[/]"
            model = self._model_label()
            bits = [who, f"[$text]{_esc(model.split('/')[-1])}[/]"]
            if self.orchestrator:
                bits.insert(1, "[$accent b]orchestrator[/]")
            if "/" in model:
                bits.append(f"[$text-muted]{_esc(model.split('/')[0])}[/]")
            proj = self._project_label()
            if proj:
                bits.append(f"[$text-muted]⌂ {_esc(proj)}[/]")
            if self.ephemeral:
                bits.append("[$warning]temporary[/]")
            bits.append(self._perm_label())
            here = self._here()
            if here:
                bits.append(f"[$success]local {_esc(here.get('cwd') or os.getcwd())}[/]")
            if self.attachments:
                bits.append(f"[$accent]+{len(self.attachments)} attached[/]")
            self.query_one("#meta", Static).update("  ".join(bits))
            self._refresh_status()
            self._refresh_sidebar()
            try:
                home_hints = self.query_one("#home-hints", Static)
            except Exception:  # noqa: BLE001
                home_hints = None
            if home_hints is not None:
                who = (f"[$text-muted]{_esc(self.whoami)} @ {_esc(self.base)} · "
                       f"{self._access_label()}[/]" if self.logged_in else
                       "[$warning]not logged in[/] [$text-muted]— /login[/]"
                       if self.logged_in is False else f"[$text-muted]{_esc(self.base)}[/]")
                proj = self._project_label()
                where = (f"\n[$text-muted]files and chats go to ⌂ {_esc(proj)}[/]"
                         if proj and not self._here() else "")
                home_hints.update(
                    f"{who}{where}\n\n"
                    "[$text]/help[/]       [$text-muted]commands and keys[/]\n"
                    "[$text]←[/]           [$text-muted]agents: what is running, on an empty "
                    "prompt[/]\n"
                    "[$text]ctrl+j[/]      [$text-muted]new line (enter sends)[/]\n"
                    "[$text]shift+tab[/]   [$text-muted]permissions: yolo → auto → ask · "
                    "ctrl+x u picks[/]\n"
                    "[$text]ctrl+x l[/]    [$text-muted]sessions · [/][$text]ctrl+x m[/] "
                    "[$text-muted]models[/]\n"
                    "[$text]ctrl+p[/]      [$text-muted]command palette[/]")
            show = self.sidebar_shown()        # hidden unless the operator opened it
            self.query_one("#sidebar").display = show
            header = self.query_one("#header", Static)
            header.display = not show
            header.update(f"[b]{_esc(self.title_text or 'New chat')}[/]"
                          + (f"  [$text-muted]#{self.cid}[/]" if self.cid else "")
                          + ("  [$text-muted]ctrl+b notifications[/]"
                             if self.size.width >= SIDEBAR_MIN_COLS else ""))

        def _status_parts(self) -> list[tuple[str, str, int]]:
            """The left side while a page is showing: its name, then its way out (a turn
            running in the chat behind it keeps its own line, without the esc that
            would interrupt it); the chat's own row otherwise."""
            if not self.paged:
                return self._chat_status_parts()
            title = self.page.page_title
            head = [(title, f"[$primary b]{_esc(title)}[/]", 0)]
            if not (self.busy and self.turn is not None):
                return head + [("esc back", "[$text-muted]esc back[/]", 1),
                               ("/ command", "[$text-muted]/ command[/]", 2)]
            return (head + [("esc back", "[$text-muted]esc back[/]", 1)]
                    + [p for p in self._chat_status_parts() if not p[0].startswith("esc")])

        def _chat_status_parts(self) -> list[tuple[str, str, int]]:
            """The status row's left side as (plain, markup, rank) parts — while a
            turn runs one steady line, `working 2m 13s · 14 tools · 2 agents · $0.02`,
            that the ▣ footer repeats when it ends; while tool rows are being
            picked, their keys; otherwise the prompt's keys. A narrow terminal drops
            the higher ranks first, so the row never wraps or gets cut mid-word."""
            t = self.turn if self.busy else None
            spin = f"[$accent]{SPINNER[self.frame % len(SPINNER)]}[/] " if t else ""
            if self.log_view.picking:
                parts = [("↑↓ pick", "[$primary]↑↓[/] pick", 0),
                         ("enter open/close", "[$primary]enter[/] open/close", 1),
                         ("→ all of it", "[$primary]→[/] all of it", 2),
                         ("esc back", "[$primary]esc[/] back", 1)]
                if t:
                    parts.append((f"x {t.stats()[0]}", f"{spin}[$text-muted]{t.stats()[0]}[/]", 3))
                return parts
            if not (self.busy and self.turn is not None):
                if self.logged_in is False:
                    return [("not logged in — /login · / commands",
                             "[$warning]not logged in[/] [$text-muted]— /login · / commands[/]", 0)]
                return [("enter send", "[$text-muted]enter send[/]", 0),
                        ("ctrl+j newline", "[$text-muted]ctrl+j newline[/]", 1),
                        ("/ commands", "[$text-muted]/ commands[/]", 2),
                        ("@ file", "[$text-muted]@ file[/]", 3),
                        ("! shell", "[$text-muted]! shell[/]", 4)]
            verb = ("interrupting" if self.stop_requested
                    else "reconnecting…" if self.reconnecting else "working")
            vm = f"[$warning]{verb}[/]" if self.reconnecting and not self.stop_requested else verb
            stats = t.stats()
            armed = time.monotonic() - self.esc_armed < 2
            nq = len(self.queue) + len(self.pending)
            parts = [(f"x {verb} {stats[0]}", f"{spin}{vm} [$text-muted]{stats[0]}[/]", 0)]
            for s in stats[1:]:
                rank = 2 if s.startswith("$") else 1 if s.endswith(("tool", "tools")) else 3
                parts.append((s, f"[$text-muted]{s}[/]", rank))
            if nq:
                parts.append((f"{nq} queued", f"[$accent]{nq} queued[/]", 1))
            parts.append(("esc again to interrupt", "[$warning]esc again to interrupt[/]", 0)
                         if armed else ("esc interrupt", "[$text-muted]esc interrupt[/]", 4))
            return parts

        def _status_right(self) -> list[tuple[str, str, int]]:
            """The right side: unread counts (critical security alerts not yet seen get
            their own red one), then the leader and palette keys."""
            parts = []
            if self.dnd:
                left = self._dnd_left()
                parts.append((f"DND {left}".strip(),
                              "[$warning b]DND[/]" + (f" [$text-muted]{left}[/]" if left else ""),
                              0))
            if self.crit_unread:
                parts.append((f"✗ {self.crit_unread}", f"[$error b]✗ {self.crit_unread}[/]", 0))
            if self.unread:
                parts.append((f"● {self.unread} ctrl+b",
                              f"[$warning b]● {self.unread}[/] [$text-muted]ctrl+b[/]", 0))
            parts.append(("ctrl+x leader", "[$text-muted]ctrl+x leader[/]", 2))
            parts.append(("ctrl+p commands", "[$text-muted]ctrl+p commands[/]", 3))
            return parts

        def _set_status(self, widget, text: str, **kw) -> None:
            """Update a status Static only when its text changed: the row is rebuilt
            ten times a second, and a repaint each time keeps an idle terminal busy
            (TUI-20)."""
            if self._status_text.get(widget.id) != text:
                self._status_text[widget.id] = text
                widget.update(text, **kw)

        def _refresh_status(self) -> None:
            left = self.query_one("#status-left", Static)
            right = self.query_one("#status-right", Static)
            # the leader's key list is longer than one row even at 140 columns:
            # the row grows while it shows, so q, b and the rest are not cut off
            if self._status_tall != self.leader:
                self._status_tall = self.leader
                self.query_one("#status").styles.height = "auto" if self.leader else 1
            if self.leader:
                keys = "  ".join(f"[$primary]{c.leader}[/] {name}"
                                 for name, c in self.unique_commands() if c.leader)
                self._set_status(left, f"[$warning b]ctrl+x[/]  {keys}  "
                                       "[$primary]b[/] notifications")
                self._set_status(right, "")
                return
            # both sides share one row: the width is the row's, not the left
            # side's (which changes when the right one does)
            total = self.query_one("#status").size.width or max(20, self.size.width - 6)
            lm, rm = fit_row(self._status_parts(), self._status_right(), total,
                             markup_sep=" [$text-muted]·[/] ")
            self._set_status(left, lm, layout=False)
            self._set_status(right, rm)

        def _refresh_sidebar(self) -> None:
            info = self.info or {}
            title = self.title_text or ("New chat" if self.cid is None else f"Chat #{self.cid}")
            sub = [f"#{self.cid}"] if self.cid else []
            if self.agent:
                sub.append(f"@{self.agent}")
            proj = self._project_label()
            if proj:
                sub.append(f"⌂ {proj}")
            self.query_one("#sb-title", Static).update(
                f"[b]{_esc(title)}[/]\n[$text-muted]{_esc(' · '.join(sub))}[/]")
            # the chat, compactly: usage on one line, the model on the next
            ctx = []
            if info:
                line = (f"{_fmt_tokens(info.get('input_tokens', 0) + info.get('output_tokens', 0))}"
                        f" tok · ${info.get('cost_usd', 0):.4f}")
                c = info.get("context") or {}
                if c.get("used") and c.get("window"):
                    pct = min(100, round(100 * c["used"] / c["window"]))
                    colour = "$error" if pct > 85 else "$warning" if pct > 60 else "$primary"
                    line += f" · [{colour}]{pct}%[/] ctx"
                ctx.append(line)
            else:
                ctx.append("[$text-muted]no usage yet[/]")
            self.query_one("#sb-context", Static).update("\n".join(ctx))
            model = self._model_label()
            self.query_one("#sb-model", Static).update(
                f"{_esc(model.split('/')[-1])}"
                + (f" [$text-muted]· {_esc(model.split('/')[0])}[/]" if "/" in model else ""))
            files = info.get("files") or []
            fw = self.query_one("#sb-files", Static)
            fw.display = bool(files)
            if files:
                lines = ["[b]Modified Files[/]"]
                for f in files[-12:]:
                    n = f.get("writes", 1)
                    lines.append(f"{_esc(_short(f['path'], 30))}"
                                 + (f" [$text-muted]×{n}[/]" if n > 1 else ""))
                fw.update("\n".join(lines))
            tw = self.query_one("#sb-todo", Static)
            tw.display = bool(self.todos)
            if self.todos:
                tw.update("[b]Todo[/]\n" + "\n".join(
                    f"[$success]✓[/] [$text-muted strike]{_esc(_short(t, 32))}[/]" if done
                    else f"[$warning]☐[/] {_esc(_short(t, 32))}" for done, t in self.todos))
            icons = {"error": "[$error]✗[/]", "warn": "[$warning]![/]",
                     "done": "[$success]✓[/]"}
            notes = ["[b]Notifications[/]"]
            for ts, kind, text in self.notices:
                notes.append(f"[$text-muted]{time.strftime('%H:%M', time.localtime(ts))}[/] "
                             f"{icons.get(kind, '[$primary]·[/]')} {_esc(_short(text, 160))}")
            if not self.notices:
                notes.append("[$text-muted]nothing yet[/]")
            self.query_one("#sb-notes", Static).update("\n".join(notes))
            access = self._access_label()
            colour = {"full access": "$success", "chat only": "$primary"}.get(access, "$warning")
            self.query_one("#sb-foot", Static).update(
                f"[{colour}]●[/] [b]Jav3[/] [$text-muted]{_esc(self.whoami)} · {access}[/]\n"
                f"[$text-muted]{_esc(self.base.split('://')[-1] or '(no server)')}[/]")

        def _tick(self) -> None:
            from textual.css.query import NoMatches
            self.frame += 1
            try:
                # every unfinished row, the turn's and a local `!command`'s alike
                for tv in list(self.__dict__.get("live_tools", ())):
                    tv.spin(SPINNER[self.frame % len(SPINNER)])
                t = self.turn
                if self.busy and t is not None and t.cid is not None \
                        and time.monotonic() - t.polled > 10:
                    t.polled = time.monotonic()
                    self.run_worker(self._poll_cost(t), group="cost", exclusive=True)
                self._refresh_status()
                self._refresh_new_hint()
            except NoMatches:
                pass          # shutting down, or a screen without the status row

        async def _poll_cost(self, t: TurnState) -> None:
            """What the running turn has spent so far, for the status line: the
            chat's cost now, less what it was when this view began watching."""
            try:
                info = await self.api("GET", f"/api/conversations/{t.cid}/info")
            except CliError:
                return
            cost = info.get("cost_usd")
            if isinstance(cost, (int, float)):
                if t.cost0 is None:
                    t.cost0 = cost
                t.cost = max(0.0, cost - t.cost0)
            if t.cid == self.cid:
                self.info = info

        def on_resize(self, event) -> None:
            self.refresh_chrome()
            self.call_after_refresh(self.refresh_chrome)     # once the new size has settled

        def watch_theme(self, theme: str) -> None:
            global DIFF_TINT
            DIFF_TINT = getattr(self, "truecolor", True) and not self.current_theme.ansi
            if self.is_mounted:
                for tv in self.query(ToolView):
                    tv._shown = ()              # same markup, new colours: redraw anyway
                    tv.redraw()

        # -- turns ------------------------------------------------------------------------------

        def _body(self, message: str) -> dict:
            body: dict = {"message": message, "conversation_id": self.cid}
            if self.cid is None:
                if self.project_mode:
                    body["project_mode"] = self.project_mode
                if self.project and self.project_mode == "pin":
                    body["project"] = self.project
                if self.agent:
                    body["agent"] = self.agent
                if self.ephemeral:
                    body["ephemeral"] = True
                if self.orchestrator:
                    body["mode"] = "orchestrate"
                if self.local:
                    body["local"] = local_spec()
            if self.cid is None and self.perm_mode != "yolo":
                body["permission_mode"] = self.perm_mode
            if self.model:
                body["model"] = self.model
            return body

        def send(self, text: str) -> None:
            if self.busy:
                # the turn has an id: the server hands it to the agent at its next
                # step; before `start` it waits here and is posted when the id comes
                if self.turn is not None and self.turn.cid is not None \
                        and not self.stop_requested and not self.reconnecting:
                    self.run_worker(self._midturn([text]), group="midturn")
                else:
                    self.queue.append(text)
                self._refresh_status()
                return
            self.busy = True           # claimed now, so a fast second Enter queues
            self.run_worker(self._turn(text), group="turn")

        async def _turn(self, text: str) -> None:
            self.busy, self.stop_requested = True, False
            self.turn = TurnState()
            # the turn's cost is the chat's from here on (a new chat starts at 0)
            self.turn.cost0 = ((self.info or {}).get("cost_usd") or 0.0) \
                if self.cid is not None else 0.0
            self.refresh_chrome()
            # sending means following the reply, wherever the transcript was scrolled
            self.log_view.scroll_end(animate=False)
            self.unseen = 0
            um = UserMsg(_esc(text))
            try:
                await self.mount_log(um)
                message, attached, skipped = expand_attachments(text)
                for a in attached:
                    await self.note(f"attached {a}")
                for s in skipped:
                    await self.note(f"not attached: {s}", "warn")
                if self.attachments:
                    message += "\n\n" + "\n\n".join(self.attachments)
                    self.attachments = []
                self.last_user = text
                await self._explain_permissions()
                body = self._body(message)
                self.turn.local = bool(body.get("local"))
                self.turn.sent = message
                await self._post(body)
                t = self.turn
                if t is not None and not (t.done or t.failed or t.idle or t.interrupted
                                          or self.stop_requested):
                    # the stream closed cleanly with no final: a server going down
                    raise httpx.RemoteProtocolError("the stream ended without a final")
            except CliError as e:
                await self.note(str(e), "error")
                if self.turn is not None and self.turn.cid is None:
                    # refused before the turn began (a 404, a 409, a login): nothing
                    # was sent, so the words go back where they were typed
                    self._not_sent(um, [text])
            except httpx.HTTPError as e:
                await self._lost_connection(e, text, um)
            finally:
                await self._end_turn()
            if self.queue and not self.busy:
                self.send(self.queue.pop(0))

        def _not_sent(self, um, texts: list[str]) -> None:
            """Put messages back in the prompt, ahead of what is typed there now."""
            if um is not None and um.is_mounted:
                um.add_class("failed")
            ed = self.editor
            ed.text = "\n".join(texts + ([ed.text] if ed.text else []))
            ed.move_cursor(ed.document.end)

        async def _lost_connection(self, e: Exception, text: str, um) -> None:
            """The stream broke, or the server never answered. Once the server has
            taken the turn (`start` arrived) the message is its, not ours: the client
            keeps trying and picks the turn up again (_reattach). A message that
            never got there goes back in the prompt, with a line saying so."""
            started = self.turn is not None and self.turn.cid is not None
            if started and isinstance(e, httpx.TransportError):
                if await self._reattach():
                    return
                await self.note(f"lost {self.base} mid-turn and it has not answered since. "
                                "The turn may still be running there: /sessions shows it.",
                                "error")
                if self.queue:              # typed while it ran: these never left here
                    ed = self.editor
                    ed.text = "\n".join(self.queue + ([ed.text] if ed.text else []))
                    ed.move_cursor(ed.document.end)
                    self.queue = []
                return
            if not started or isinstance(e, (httpx.ConnectError, httpx.ConnectTimeout)):
                line = (f"can't reach {self.base}: {net_error_text(e)}. Your message was "
                        "not sent; it is back in the prompt.")
            else:
                line = f"connection to {self.base} failed: {e}"
            await self.note(line, "error")
            back, self.queue = [text, *self.queue], []
            self._not_sent(um if not started else None, back)

        # -- re-attaching after a lost connection ---------------------------------------------
        # The web app does the same in useChatStream.openThread: read the saved
        # transcript (GET /api/conversations/<id>/messages: `running`, the calls so
        # far as `pending_activity`, the reply once it is saved) and, when the turn
        # still runs, tail GET /api/chat/<id>/stream, whose final event carries the
        # whole reply. Here the stream is opened FIRST, then the transcript read, so a
        # call that ends in between is in both (TurnState.claim drops the repeat)
        # rather than in neither.

        async def _reattach(self) -> bool:
            """Keep trying until the server answers, then follow the turn to its end:
            still running, re-attach; finished meanwhile, draw what was missed. False
            when the server never came back (or esc gave up on it)."""
            turn = self.turn
            self.reconnecting = True
            self._refresh_status()
            try:
                return await self._reattach_loop(turn)
            finally:
                self.reconnecting = False
                self._refresh_status()

        async def _reattach_loop(self, turn: TurnState) -> bool:
            cid, t0, tries = turn.cid, time.monotonic(), 0
            while self.turn is turn:
                if tries:
                    if self.stop_requested or time.monotonic() - t0 > RECONNECT_GIVE_UP:
                        return False
                    await asyncio.sleep(RECONNECT_STEPS[min(tries - 1, len(RECONNECT_STEPS) - 1)])
                tries += 1
                try:
                    async with self.client.stream("GET", f"/api/chat/{cid}/stream") as r:
                        if r.status_code == 401:
                            self._login_lost()
                            await self.note(SESSION_LOST, "error")
                            return True
                        if r.status_code >= 500:
                            continue            # a proxy that is up before the server behind it
                        if r.status_code >= 400:
                            return False        # the chat is gone (a temporary one, wiped)
                        saved = await self.client.get(f"/api/conversations/{cid}/messages")
                        if saved.status_code >= 500:
                            continue
                        if saved.status_code != 200:
                            return False
                        data = saved.json()
                        if not data.get("running"):
                            await self._settle(turn, data)
                            return True
                        self.reconnecting = False       # attached: the status line says working
                        self._refresh_status()
                        await self._resync(turn, data)
                        t0, tries = time.monotonic(), 1
                        if self.stop_requested:
                            await self._stop_remote(cid)    # esc came while it was down
                        await self._consume(r.aiter_lines())
                    if turn.done or turn.failed or turn.interrupted:
                        return True
                    # `idle`, or a clean close with no final: look again
                except httpx.TransportError:
                    self.reconnecting = True            # dropped again: back to trying
                    self._refresh_status()
                    continue
            return True                          # this view moved on to another turn

        async def _sync_calls(self, turn: TurnState, acts: list[dict], watch: bool) -> int:
            """Draw the saved calls of this turn the view has not drawn (a finished
            row with the same name, arguments and result counts as drawn): a row still
            spinning here is finished in place, the rest are new rows. `watch`: the
            turn goes on, so remember them for TurnState.claim. Returns how many
            rows this added or finished."""
            pool = list(turn.seeded) + list(turn.tools)
            todo = []
            for a in acts:
                for i, d in enumerate(pool):
                    if d["name"] == a["name"] and (d.get("args") or {}) == (a.get("args") or {}) \
                            and d.get("result") == a.get("result"):
                        del pool[i]
                        break
                else:
                    todo.append(a)
            if todo:
                await self._gap_mark(turn, close=True)
            for a in todo:
                args = a.get("args") or {}
                key = next((k for k, v in turn.running.items()
                            if v.tname == a["name"] and (not v.args or v.args == args)), None)
                tv = turn.running.pop(key, None) if key is not None else None
                if tv is None:
                    tv = ToolView(a["name"], args)
                    turn.count(a["name"])
                    await self.mount_log(tv)
                ok = a.get("ok") is not False
                tv.finish(ok, a.get("result", ""))
                turn.tools.append({"name": a["name"], "args": args, "ok": ok,
                                   "result": a.get("result", "")})
                if watch:
                    turn.synced.append({"name": a["name"], "args": args})
                if a["name"] == "todo_update" and ok and parse_todos(a.get("result") or ""):
                    self.todos = parse_todos(a["result"])
                    self._refresh_sidebar()
            return len(todo)

        async def _gap_mark(self, turn: TurnState, close: bool) -> None:
            """Text streaming into the log when the connection dropped is missing what
            came while it was down: end it with an ellipsis (a final reply replaces
            the whole text anyway); `close` when more rows go below it."""
            if turn.stream is not None and turn.seg.strip() and not turn.seg.endswith("…"):
                turn.seg += " …"
                await turn.stream.write(" …")
            if close:
                await self._close_seg()

        async def _resync(self, turn: TurnState, data: dict) -> None:
            """The turn still runs: draw the calls it made while this view was away,
            then let the live stream carry on."""
            n = await self._sync_calls(turn, data.get("pending_activity") or [], watch=True)
            if not n:
                await self._gap_mark(turn, close=False)
            turn.claim_until = time.monotonic() + CLAIM_WINDOW
            if self.queue:                      # typed while it was down
                texts, self.queue = self.queue, []
                self.run_worker(self._midturn(texts), group="midturn")

        async def _settle(self, turn: TurnState, data: dict) -> None:
            """The turn ended while this view was away: draw its missed calls and its
            reply from the saved transcript, or say it left none."""
            msgs = [m for m in data.get("messages", []) if m.get("role") in ("user", "assistant")]
            sent = (turn.sent or "").strip()
            users = [i for i, m in enumerate(msgs) if m["role"] == "user"]
            start = next((i for i in reversed(users)
                          if sent and (msgs[i].get("content") or "").strip() == sent),
                         users[-1] if users else -1)
            tail = [m for m in msgs[start + 1:] if m["role"] == "assistant"]
            if not tail and turn.sent is None:
                return              # only watching (an agent's node keeps no reply of its own)
            if not tail:
                turn.failed = True
                await self._close_seg()
                self._stop_rows(turn, "no result: the turn did not finish")
                await self.note("the server is back, but this turn has no saved reply: it "
                                "ended when the server went away, or it failed. Your message "
                                "is in the chat; send it again to try again.", "warn")
                return
            await self._sync_calls(turn, [a for m in tail for a in m.get("activity") or []],
                                   watch=False)
            turn.done = True
            await self._finish(next((m["content"] for m in reversed(tail)
                                     if (m.get("content") or "").strip()), ""))

        async def _post(self, body: dict) -> None:
            async with self.client.stream("POST", "/api/chat", json=body) as r:
                if r.status_code == 409:
                    await r.aread()
                    why = _detail(r)
                    if why == "turn_in_progress":
                        raise CliError("a turn is still running in this chat — wait, "
                                       "or /stop it")
                    raise CliError(f"server said 409: {why}")
                if r.is_redirect:
                    raise CliError(redirect_hint(self.base, r.headers.get("location", "")))
                if r.status_code == 401:
                    self._login_lost()
                    raise NotLoggedIn(SESSION_LOST)
                if r.status_code >= 400:
                    await r.aread()
                    raise CliError(f"server said {r.status_code}: {_detail(r)}")
                await self._consume(r.aiter_lines())

        async def _consume(self, lines) -> bool:
            """Render a stream; True if it carried anything but `idle`."""
            seen = False
            turn = self.turn
            async for ev in aiter_sse(lines):
                if self.turn is not turn:
                    break          # this view moved on: the rest belongs to a turn no longer here
                seen = seen or ev.get("type") != "idle"
                if await self.handle_event(ev):
                    break
            return seen

        async def _midturn(self, texts: list[str]) -> None:
            """Post messages to the running turn (in order). Shown dimmed until the
            stream's operator_message; a 409 means the turn just ended, so they go
            as the next turn instead."""
            for text in texts:
                cid = self.turn.cid if self.turn is not None else None
                if cid is None:
                    self._later(text)
                    continue
                message, attached, skipped = expand_attachments(text)
                for s in skipped:
                    await self.note(f"not attached: {s}", "warn")
                w = QueuedMsg(text, message)
                self.pending.append(w)
                await self.mount_log(w)
                try:
                    r = await self.client.post(f"/api/chat/{cid}/message",
                                               json={"text": message})
                except httpx.HTTPError as e:
                    self._unpend(w)
                    w.fail(f"not sent: {net_error_text(e)}")
                    continue
                if r.status_code in (404, 405, 409):
                    # 409 no_turn_running: it just ended. 404/405: a server without
                    # mid-turn messages. Either way it becomes the next turn.
                    self._unpend(w)
                    await w.remove()
                    self._later(text)
                elif r.status_code >= 400:
                    self._unpend(w)
                    w.fail(f"not sent — server said {r.status_code}: {_detail(r)}")
            self._refresh_status()

        def _unpend(self, w) -> None:
            if w in self.pending:
                self.pending.remove(w)

        def _later(self, text: str) -> None:
            """Send after the running turn, or now if none is running."""
            if self.busy:
                self.queue.append(text)
            else:
                self.send(text)

        def _match_pending(self, sent: str):
            return (next((w for w in self.pending if w.sent == sent), None)
                    or next((w for w in self.pending if w.sent.strip() == sent.strip()), None))

        async def _undelivered(self, texts: list[str], to_prompt: bool = False) -> None:
            """The turn ended before these reached the agent: they become the next
            turn — or, after an interrupt or a failure, go back to the prompt."""
            back = []
            for u in texts:
                w = self._match_pending(u)
                if w is not None:
                    self._unpend(w)
                    await w.remove()
                    back.append(w.text)
                else:
                    back.append(u)
            if not back:
                return
            if self.stop_requested or to_prompt:
                ed = self.editor
                ed.text = "\n".join(back + ([ed.text] if ed.text else []))
                ed.move_cursor(ed.document.end)
            else:
                self.queue.insert(0, "\n\n".join(back))

        async def _drain_queue(self) -> None:
            if self.queue and not self.busy:
                self.send(self.queue.pop(0))

        async def handle_event(self, ev: dict) -> bool:
            """Render one event; True when the turn is over."""
            t, turn = ev.get("type"), self.turn
            if turn is None:
                return True
            if t == "start":
                if ev.get("conversation_id") is not None:
                    turn.cid = ev["conversation_id"]
                    if not self.ephemeral:
                        self.cid = turn.cid
                    if turn.local:
                        self.local_cids.add(turn.cid)
                turn.model = ev.get("model") or turn.model
                self.shown_model = turn.model or self.shown_model
                self.refresh_chrome()
                if self.stop_requested:
                    await self._stop_remote()
                elif self.queue and turn.cid is not None:
                    texts, self.queue = self.queue, []
                    self.run_worker(self._midturn(texts), group="midturn")
            elif t == "token":
                chunk = ev.get("text", "")
                if turn.md is None:
                    if not chunk.strip():
                        return False
                    turn.md = Reply("")
                    await self.mount_log(turn.md)
                    turn.stream = Markdown.get_stream(turn.md)
                turn.seg += chunk
                await turn.stream.write(chunk)
            elif t == "retry":
                # the model stream dropped mid-round and is re-asked: the text it
                # had streamed is void, so the segment goes instead of showing twice
                if turn.stream is not None:
                    await turn.stream.stop()
                    turn.stream = None
                if turn.md is not None:
                    await turn.md.remove()
                turn.md, turn.seg = None, ""
            elif t == "tool":
                if turn.claim(ev):
                    return False
                await self._close_seg()
                name = ev.get("name") or "?"
                tv = ToolView(name, ev.get("args") or {})
                tv.expanded = self.tools_expanded
                # a call without an id (an older guest) must not take the place
                # of another one's: its result is matched by name, oldest first
                key = ev.get("id") or f"{name}\0{turn.ntools}"
                turn.running[key] = tv
                turn.count(name)
                await self.mount_log(tv)
            elif t == "tool_result":
                if turn.claim(ev):
                    return False
                name = ev.get("name") or "?"
                key = ev.get("id")
                if key is None or key not in turn.running:
                    key = next((k for k, v in turn.running.items()
                                if isinstance(k, str) and "\0" in k and v.tname == name), key)
                tv = turn.running.pop(key, None)
                if tv is None:
                    # its call began before this view attached: the row has no args
                    tv = ToolView(name, {})
                    await self.mount_log(tv)
                ok = ev.get("ok") is not False
                res = ev.get("result", "")
                tv.finish(ok, res)
                turn.tools.append({"name": tv.tname, "args": tv.args, "ok": ok, "result": res})
                if tv.tname == "todo_update" and ok and parse_todos(res):
                    self.todos = parse_todos(res)
                    self._refresh_sidebar()
            elif t == "job":
                turn.plans += 1
                await self.note(f"◆ plan running: {ev.get('title', '')}")
            elif t == "inbox":
                # an operator message arrives as operator_message too; the
                # inbox copy is the model-facing framing of the same words
                if not (ev.get("text") or "").lstrip().startswith("[the operator"):
                    await self.note(f"✉ {_short(ev.get('text', ''), 200)}")
            elif t == "operator_message":
                await self._close_seg()
                text = ev.get("text") or ""
                w = self._match_pending(text)
                if w is not None:
                    self._unpend(w)
                    w.deliver()
                elif text.strip():
                    # sent from elsewhere (the web UI, another terminal)
                    await self.mount_log(UserMsg(QueuedMsg._markup(text, "↳ delivered mid-turn")))
            elif t == "local_tool":
                self.run_worker(self._local_tool(ev, turn.cid or self.cid), group="local")
            elif t == "ask_user":
                self.run_worker(self._ask_user(ev, turn.cid or self.cid), group="ask")
            elif t == "ask_done":
                self._ask_gone(ev.get("id"))
            elif t == "final":
                turn.done = True
                await self._finish(ev.get("content") or "")
                if ev.get("undelivered"):
                    await self._undelivered([str(u) for u in ev["undelivered"]])
                return True
            elif t == "error":
                await self._close_seg()
                turn.failed = True
                self._stop_rows(turn, "no result: the turn failed")
                await self.note(ev.get("message") or "error", "error")
                if turn.sent is not None and not self.ephemeral and not ev.get("node_id"):
                    # the server saved the failure with the steps it got through
                    await self.note("/resume picks it up from its last step")
                await self._turn_footer(turn)
                if ev.get("undelivered"):
                    # back to the prompt: the operator decides whether they still
                    # apply after the failure
                    await self._undelivered([str(u) for u in ev["undelivered"]],
                                            to_prompt=True)
                return True
            elif t == "idle":
                turn.idle = True
                return True
            return False

        async def _local_tool(self, ev: dict, cid: int | None) -> None:
            """Run one /local tool call here and send the answer back. The
            executor is this chat's: made from the conversation's own record of
            where it works, and only when that is this machine."""
            if cid is None:
                return
            ex = self.local_execs.get(cid)
            if ex is None:
                try:
                    here = (await self.api("GET", f"/api/conversations/{cid}/info")).get("local")
                except CliError:
                    here = None
                me = socket.gethostname() or "localhost"
                if here and here.get("hostname") == me and Path(here.get("cwd", "")).is_dir():
                    async def approve(kind, summary):
                        ans = await self.local_approve(kind, summary)
                        # a dialog answered after the turn was stopped must not
                        # run anything: nobody is waiting for the result
                        live = self.turn is not None and self.turn.cid == cid
                        return ans if live else "no"
                    ex = self.local_execs[cid] = LocalExecutor(here["cwd"], approve)
            if ex is None:
                ok, result = False, ("this chat's local session is not on this computer "
                                     f"({socket.gethostname()}), or its directory is gone")
            else:
                ok, result = await ex.run(ev.get("name", ""), ev.get("args") or {})
            try:
                await self.api("POST", f"/api/chat/{cid}/local_result",
                               json={"id": str(ev.get("id", "")), "ok": ok, "result": result})
            except CliError as e:
                await self.note(f"local result not delivered: {e}", "warn")

        # permission modes (backend/permissions.py): shift+tab cycles, stored per
        # conversation; a chat not created yet sends it with its first message
        PERM_MODES = ("yolo", "auto", "ask")
        PERM_HINT = {"yolo": "everything runs in the VM without asking (the default)",
                     "auto": "a cheap judge reviews each write/run; risky ones ask you",
                     "ask": "every write/run asks you first"}
        perm_mode = "yolo"
        reconnecting = False       # the stream broke and the client is trying to get it back

        async def _explain_permissions(self) -> None:
            """Once, the first time a turn starts with the default: what the chip in
            the prompt's corner means and how to change it."""
            if self.perm_mode != "yolo" or self._load_settings().get("perm_explained"):
                return
            self._save_settings(perm_explained=True)
            await self.note("permissions: yolo — agents run in the VM without asking. "
                            "shift+tab or /permissions makes them ask first.")

        def _perm_label(self) -> str:
            col = {"yolo": "$text-muted", "auto": "$accent", "ask": "$warning"}[self.perm_mode]
            return f"[{col}]⏵ {self.perm_mode}[/]"

        def cycle_permission(self) -> None:
            """yolo → auto → ask, and back to yolo only on a second press within four
            seconds: one press too many from ask must not drop every guardrail."""
            modes = self.PERM_MODES
            nxt = modes[(modes.index(self.perm_mode) + 1) % len(modes)]
            if nxt == "yolo" and self.perm_mode != "yolo":
                now = time.monotonic()
                if now - self._yolo_armed > 4.0:
                    self._yolo_armed = now
                    self.notify("shift+tab again for yolo: everything runs in the VM without "
                                "asking (/permissions picks a mode too)", severity="warning")
                    return
            self._yolo_armed = -100.0
            self.set_permission(nxt)

        def set_permission(self, mode: str) -> None:
            self.perm_mode = mode
            self._save_settings(perm_explained=True)
            self.refresh_chrome()
            self.run_worker(self._save_perm_mode(self.cid, self.perm_mode), group="perm")

        async def c_permissions(self, arg: str) -> None:
            """/permissions [yolo|auto|ask]: whether agents ask before they write or
            run something. shift+tab cycles the same three from the prompt."""
            if not arg:
                rows = [(m, f"{m}  (the default)" if m == "yolo" else m, self.PERM_HINT[m]
                         .replace(" (the default)", "")) for m in self.PERM_MODES]
                arg = await self.pick("Permissions", rows, self.perm_mode,
                                      hint="shift+tab cycles these · set per chat") or ""
                if not arg:
                    return
            mode = arg.strip().lower()
            if mode not in self.PERM_MODES:
                raise CliError(f"permissions: {arg!r} is not one of "
                               f"{', '.join(self.PERM_MODES)}")
            self.set_permission(mode)

        async def _save_perm_mode(self, cid, mode: str) -> None:
            if cid is not None and not self.ephemeral:
                try:
                    await self.api("PUT", f"/api/chat/{cid}/permission_mode",
                                   json={"mode": mode})
                except CliError as e:
                    await self.note(f"permission mode not saved: {e}", "error")
                    return
            await self.note(f"permissions: {mode} — {self.PERM_HINT[mode]}")

        async def _load_perm_mode(self, cid: int) -> None:
            try:
                r = await self.api("GET", f"/api/chat/{cid}/permission_mode")
            except CliError:
                return                  # an older server: the default holds
            if self.cid == cid and r.get("mode") in self.PERM_MODES:
                self.perm_mode = r["mode"]
                self.refresh_chrome()

        def _ask_who(self, ev: dict, cid: int | None) -> str:
            """Who is asking, for the dialog: this chat, or the agent by its title
            (the server names it) and id."""
            n = ev.get("conversation_id")
            if n in (None, cid):
                return "this chat"
            title = " ".join(str(ev.get("agent") or "").split())
            return f"{_short(title, 50)} #{n}" if title else f"agent #{n}"

        def _asks_done(self) -> dict:
            """Ask ids this client has settled lately: a copy of the same event that
            arrives late (two channels carry it) is not a new question."""
            done = self.__dict__.setdefault("_asks_seen", {})
            now = time.monotonic()
            for k in [k for k, t in done.items() if now - t > 120]:
                del done[k]
            return done

        def _ask_recount(self) -> None:
            """Tell the dialog on screen how many asks wait behind it."""
            asks = self.__dict__.get("_asks", {})
            waiting = sum(1 for e in asks.values() if e["scr"] is None and not e["gone"])
            for e in asks.values():
                if e["scr"] is not None:
                    e["scr"].set_waiting(waiting)

        async def _ask_user(self, ev: dict, cid: int | None) -> None:
            """ask_user / a permission ask: one dialog at a time, in the order the
            asks came, each naming the agent that asks; the answer is POSTed to the
            conversation this view is on (the asker or an ancestor that showed it).
            An ask the server has settled (ask_done) before its turn never gets a
            dialog."""
            aid = ev.get("id")
            asks = self.__dict__.setdefault("_asks", {})
            if cid is None or not aid or aid in asks or aid in self._asks_done():
                return
            ent = asks[aid] = {"ev": ev, "scr": None, "gone": False}
            self._ask_recount()
            lock = self.__dict__.setdefault("_ask_lock", asyncio.Lock())
            settled = False
            try:
                async with lock:
                    if ent["gone"]:
                        settled = True
                        return
                    who = self._ask_who(ev, cid)
                    if ev.get("conversation_id") not in (None, cid):
                        await self.note(f"? {who} is asking you")
                    scr = AskUser(ev, who)
                    ent["scr"] = scr
                    self._ask_recount()
                    self.bell()
                    res = await self.push_screen_wait(scr)
                    ent["scr"] = None
                    if res == "gone":
                        settled = True
                        return
                    body = ({"id": aid, "skipped": True} if res is None
                            else {"id": aid, "answers": res})
                    try:
                        await self.api("POST", f"/api/chat/{cid}/answer", json=body)
                        settled = True
                    except CliError as e:
                        # the server still holds the ask: a re-attached view gets it again
                        await self.note(f"answer not delivered: {e}", "error")
            finally:
                asks.pop(aid, None)
                if settled:
                    self._asks_done()[aid] = time.monotonic()
                self._ask_recount()

        def _ask_gone(self, aid) -> None:
            """ask_done: answered elsewhere (the web, another view), timed out
            or stopped: drop it from the queue, or close its dialog."""
            ent = self.__dict__.get("_asks", {}).get(aid)
            if ent is None:
                return
            ent["gone"] = True
            if ent["scr"] is not None:
                ent["scr"].close_gone()
            self._ask_recount()

        def type_ahead(self, text: str) -> None:
            """Keys a dialog turned away because it had just opened go back to the
            prompt they were typed at (when that prompt is what is behind it)."""
            base = [s for s in self.screen_stack if not isinstance(s, ModalScreen)]
            if base and base[-1] is self.screen_stack[0] and not self.paged:
                with contextlib.suppress(Exception):
                    base[-1].query_one("#editor", Editor).insert(text)

        async def local_approve(self, kind: str, summary: str):
            """yes / always / no (None: closed with ctrl+c) from the operator."""
            return await self.push_screen_wait(LocalApprove(kind, summary))

        async def _close_seg(self) -> None:
            turn = self.turn
            if turn is None:
                return
            if turn.stream is not None:
                await turn.stream.stop()
                turn.stream = None
            if turn.md is not None:
                if turn.seg.strip():
                    turn.printed.append(turn.seg)
                else:
                    await turn.md.remove()
            turn.md, turn.seg = None, ""

        def _stop_rows(self, turn: TurnState, why: str) -> None:
            """Calls that will get no result now (a stop, a failure, a lost
            stream): their rows say so and their timers stop."""
            for tv in turn.running.values():
                tv.interrupt(why)
            turn.running.clear()

        def _footer_markup(self, turn: TurnState) -> str:
            who = self.agent or "Jav3"
            model = (turn.model or self._model_label()).split("/")[-1]
            bits = [_esc(who), _esc(model)] + turn.stats()
            if turn.failed:
                return f"[$error]▣[/] {' · '.join(bits)} · [$error]failed[/]"
            if turn.interrupted:
                return f"[$warning]▣[/] {' · '.join(bits)} · [$warning]interrupted[/]"
            if not turn.done:
                return f"[$warning]▣[/] {' · '.join(bits)} · [$warning]stream lost[/]"
            return f"[$primary]▣[/] {' · '.join(bits)}"

        async def _turn_footer(self, turn: TurnState) -> None:
            """The ▣ line that closes a turn: what the status line said while it
            ran (time, tools, agents, cost), frozen."""
            if turn.footer is None:
                turn.ended = time.monotonic()
                turn.footer = Footer(self._footer_markup(turn))
                await self.mount_log(turn.footer)

        async def _finish(self, final: str) -> None:
            turn = self.turn
            if final.startswith(INTERRUPTED):
                turn.interrupted = True
                self._stop_rows(turn, "interrupted")
                await self._close_seg()
                await self._turn_footer(turn)
                return
            self._stop_rows(turn, "no result")
            if turn.stream is not None:
                await turn.stream.stop()
                turn.stream = None
            # the final reply is authoritative (the rules pass can rewrite it): it
            # replaces the text that streamed, or is added if none did
            if turn.md is not None:
                if final.strip() and final.strip() != turn.seg.strip():
                    await turn.md.update(final)
                turn.printed.append(final or turn.seg)
                turn.md, turn.seg = None, ""
            elif final.strip() and final.strip() not in "".join(turn.printed):
                await self.mount_log(Reply(final))
            self.last_reply = final or "".join(turn.printed)
            await self._turn_footer(turn)

        def _watching(self, cid: int) -> bool:
            """This chat is the one on screen and the terminal has the focus (a
            reply that lands in front of you needs no toast and no unread count).
            A terminal that reports no focus changes always has it."""
            return cid == self.cid and self.app_focus and not self.paged

        async def _end_turn(self) -> None:
            t = self.turn
            if t is not None and t.done and not t.interrupted and t.cid is not None \
                    and not self.ephemeral and not self._watching(t.cid):
                name = (self.title_text if t.cid == self.cid and self.title_text
                        else f"#{t.cid}")
                self.push_notice(f"reply ready in {_short(name, 60)} · "
                                 f"{int(time.monotonic() - t.started)}s", "done")
            if t is not None:
                self.last_turn = t
                # the stream ended without a final or an error (connection lost,
                # this view left the turn): nothing may keep spinning
                self._stop_rows(t, "no result: the stream ended")
                if t.cid is not None and not t.idle:
                    with contextlib.suppress(Exception):
                        await self._turn_footer(t)
            self.turn, self.busy = None, False
            for w in self.pending:        # the server never said either way
                w.fail("not confirmed — the turn ended without delivering it")
            self.pending.clear()
            cid = t.cid if t is not None else None
            if self.ephemeral:
                self.cid = None          # a temporary chat is wiped when its turn ends
            self.refresh_chrome()
            if t is not None and t.footer is not None and cid is not None:
                # the footer's cost: the chat's total now, less where it began
                with contextlib.suppress(Exception):
                    await self._poll_cost(t)
                    if t.cost is not None:
                        t.footer.update(self._footer_markup(t))
            await self.refresh_info()

        async def _stop_remote(self, cid: int | None = None) -> None:
            cid = cid or (self.turn.cid if self.turn and self.turn.cid else self.cid)
            if cid is None:
                return
            try:
                await self.api("POST", f"/api/chat/{cid}/stop")
            except CliError:
                pass

        def interrupt(self) -> None:
            """Stop the turn server-side (every tail then gets its final) and hand
            queued messages back to the prompt."""
            if not self.busy:
                return
            self.stop_requested = True
            if self.queue:
                ed = self.editor
                ed.text = "\n".join(self.queue + ([ed.text] if ed.text else []))
                ed.move_cursor(ed.document.end)
                self.queue.clear()
            if self.turn and self.turn.cid is not None:
                # the id is taken now: a stop that runs late must not hit the next turn
                self.run_worker(self._stop_remote(self.turn.cid), group="stop")
            # no start event yet: on_event("start") sends the stop when the id arrives

        async def attach(self, cid: int, seen: list[dict] | None = None) -> None:
            """Watch a turn that is still running server-side. `seen`: the calls the
            view drew from the saved transcript before attaching (a lost connection
            is picked up again without drawing them twice)."""
            self.busy, self.stop_requested = True, False
            self.turn = TurnState()
            self.turn.cid = cid
            self.turn.seeded = list(seen or [])
            self.refresh_chrome()
            turn = self.turn
            try:
                # a job's agents stream from their own endpoint: try it when the
                # chat stream 404s or only says idle
                for path in (f"/api/chat/{cid}/stream", f"/api/chat/agents/{cid}/stream"):
                    async with self.client.stream("GET", path) as r:
                        if r.status_code >= 400:
                            await r.aread()
                            continue
                        if await self._consume(r.aiter_lines()):
                            break
                if self.turn is turn and not (turn.done or turn.failed or turn.interrupted
                                              or turn.idle or self.stop_requested):
                    # closed with no final: the server going down
                    raise httpx.RemoteProtocolError("the stream ended without a final")
            except httpx.HTTPError as e:
                if not (isinstance(e, httpx.TransportError) and await self._reattach()):
                    await self.note(f"lost the stream: {net_error_text(e)}", "error")
            finally:
                await self._end_turn()
            await self._drain_queue()

        # -- input ---------------------------------------------------------------------------

        @on(Editor.Submitted)
        def _submitted(self, ev) -> None:
            text = ev.text
            if not text.strip():
                return
            self._remember(text)
            self.hist_pos = None
            self.editor.text = ""
            self.hide_popup()
            self.dispatch(text)

        def dispatch(self, text: str) -> None:
            s = text.strip()
            if is_exit(s):
                self.exit()
                return
            if s == "?":
                s = "/help"
            if s.startswith("/") and not s.startswith("//"):
                self.run_worker(self.run_command(s), group="cmd")
            elif s.startswith("!"):
                self.run_worker(self.local_shell(s[1:].strip()), group="shell")
            elif not self.token or self.logged_in is False:
                self.run_worker(self.note(NOT_LOGGED_IN, "warn"), group="cmd")
            else:
                if self.paged:
                    self.run_worker(self.host.home(), group="nav")    # the chat takes it
                self.send(text[text.index("/") + 1:] if s.startswith("//") else text)

        async def run_command(self, line: str) -> None:
            name, _, arg = line[1:].partition(" ")
            cmd = self.commands.get(name.lower())
            if cmd is None:
                await self.note(f"unknown command /{name} — /help lists them", "error")
                return
            if self.busy and not cmd.busy_ok:
                self.notify(f"/{name} waits for the turn to finish — esc interrupts it",
                            severity="warning")
                return
            arg = arg.strip()
            if cmd.page:
                # `/page [args] [panel]`: the page gets its args; a trailing `panel`
                # asks for a new panel (the next step), so for now it opens in place
                words, panel = parse_page_args(arg)
                arg = " ".join(words)
                if panel:
                    await self.say(f"/{name}: panels arrive in the next step — opening "
                                   "it in place")
            try:
                await cmd.fn(arg)
            except CliError as e:
                await self.note(str(e), "error")
            except Exception as e:      # noqa: BLE001 - one bad command must not take the app down
                await self.note(f"/{name} failed: {type(e).__name__}: {e}", "error")

        async def local_shell(self, command: str) -> None:
            """`!cmd` runs on THIS machine; its output rides along with the next message."""
            if not command:
                await self.note("usage: !<command> — runs here; the output is attached to "
                                "your next message")
                return
            tv = ToolView("local_shell", {"command": command})
            await self.mount_log(tv)
            try:
                proc = await asyncio.create_subprocess_shell(
                    command, stdout=asyncio.subprocess.PIPE,
                    stderr=asyncio.subprocess.STDOUT, stdin=asyncio.subprocess.DEVNULL)
                out, _ = await asyncio.wait_for(proc.communicate(), 300)
                code = proc.returncode
            except asyncio.TimeoutError:
                proc.kill()
                tv.finish(False, "timed out after 5 minutes")
                return
            text = out.decode("utf-8", "replace").rstrip()
            tv.finish(code == 0, text + (f"\nexit {code}" if code else ""))
            self.attachments.append(f"I ran `{command}` on my machine (exit {code}):\n"
                                    f"```\n{text[-SHELL_KEEP:]}\n```")
            self.refresh_chrome()
            self.notify("output attached to your next message (/detach drops it)")

        # -- completion popup ---------------------------------------------------------------------

        def popup_open(self) -> bool:
            return self.query_one("#popup", OptionList).display

        def hide_popup(self) -> None:
            self.query_one("#popup", OptionList).display = False

        @on(TextArea.Changed, "#editor")
        def _editor_changed(self, ev) -> None:
            self.update_popup()

        def _word_before_cursor(self) -> str:
            ed = self.editor
            row, col = ed.cursor_location
            before = ed.document.get_line(row)[:col]
            return "" if not before or before[-1].isspace() else before.split()[-1]

        def update_popup(self) -> None:
            ed = self.editor
            text = ed.text
            pop = self.query_one("#popup", OptionList)
            if self.hist_pos is not None and text == getattr(self, "_hist_text", None):
                pop.display = False
                return
            items: list[tuple[str, str, str]] = []     # (kind, value, label markup)
            if text.startswith("/") and "\n" not in text:
                if " " not in text:
                    self.arg_deliberate = False
                    q = text[1:].lower()
                    for name, cmd in self.unique_commands():
                        if name.startswith(q):
                            items.append(("cmd", name, f"[b]/{name}[/] "
                                          f"[$text-muted]{_esc(cmd.usage)}  {_esc(cmd.help)}[/]"))
                    # an exact name first: /stop-a must not complete to /stop-all
                    items.sort(key=lambda it: it[1] != q)
                else:
                    head, _, arg = text.partition(" ")
                    for value, meta in self.arg_options(head[1:].lower()):
                        if value.startswith(arg) or (arg and arg.lower() in meta.lower()):
                            items.append(("arg", value, f"{_esc(value)}  "
                                          f"[$text-muted]{_esc(meta)}[/]"))
                    # what was typed, when it is an option, before the ones that only
                    # begin with it: /sessions 5 must not become /sessions 50
                    items.sort(key=lambda it: it[1] != arg)
            else:
                word = self._word_before_cursor()
                if word.startswith("@"):
                    paths = self._paths(word[1:])
                    # a word that already names a file needs no menu (Enter sends)
                    if paths != [word[1:]]:
                        for path in paths:
                            items.append(("path", path, _esc(path)))
            self.popup_items = [(k, v) for k, v, _ in items[:40]]
            if not items or (len(items) == 1 and items[0][0] == "cmd"
                             and items[0][1] == text[1:]
                             and not self.commands[items[0][1]].takes_arg):
                pop.display = False
                return
            pop.clear_options()
            for _, _, label in items[:40]:
                pop.add_option(Option(label))
            pop.highlighted = 0
            pop.display = True

        def _paths(self, frag: str) -> list[str]:
            d, _, prefix = frag.rpartition("/")
            base = Path(os.path.expanduser(d or ".")) if d or not frag.startswith("/") \
                else Path("/")
            if frag.startswith("/") and not d:
                base = Path("/")
            try:
                entries = sorted(base.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower()))
            except OSError:
                return []
            out = []
            for p in entries:
                if not p.name.startswith(prefix) or (p.name.startswith(".")
                                                     and not prefix.startswith(".")):
                    continue
                out.append((f"{d}/" if d else "") + p.name + ("/" if p.is_dir() else ""))
                if len(out) >= 40:
                    break
            return out

        def popup_key(self, key: str) -> None:
            pop = self.query_one("#popup", OptionList)
            if key == "escape":
                self.hide_popup()
                if self.paged:
                    self._back_to_page()
            elif key == "up":
                # at the top of the menu, ↑ keeps going: back into history
                if not pop.option_count or (pop.highlighted or 0) == 0:
                    self.hide_popup()
                    self.history_step(-1)
                else:
                    self.arg_deliberate = True
                    pop.action_cursor_up()
            elif key == "down":
                self.arg_deliberate = True
                pop.action_cursor_down()
            elif key in ("tab", "enter"):
                i = pop.highlighted or 0
                if not self.popup_items:
                    self.hide_popup()
                    return
                kind, value = self.popup_items[min(i, len(self.popup_items) - 1)]
                self.accept_popup(kind, value, submit=(key == "enter"))

        def accept_popup(self, kind: str, value: str, submit: bool) -> None:
            ed = self.editor
            if kind == "cmd":
                cmd = self.commands[value]
                if cmd.takes_arg and not submit:
                    # Tab opens the argument menu; Enter runs the command as typed
                    # (its bare form opens its own picker), never option 0 of a menu
                    # nobody asked for
                    ed.text = f"/{value} "
                    ed.move_cursor(ed.document.end)
                    self.arg_deliberate = True
                    self.update_popup()
                    return
                ed.text = f"/{value}"
                ed.move_cursor(ed.document.end)
                self.hide_popup()
                if submit:
                    ed.post_message(Editor.Submitted(ed.text))
                return
            if kind == "arg":
                head, _, typed = ed.text.partition(" ")
                if submit and not typed.strip() and not self.arg_deliberate:
                    # Enter on a menu that opened because of a typed space: the
                    # command as typed, not its first option
                    ed.text = head
                    ed.move_cursor(ed.document.end)
                    self.hide_popup()
                    ed.post_message(Editor.Submitted(ed.text))
                    return
                ed.text = f"{head} {value}"
                ed.move_cursor(ed.document.end)
                self.hide_popup()
                if submit:
                    ed.post_message(Editor.Submitted(ed.text))
                return
            # an @path: swap the word before the cursor
            row, col = ed.cursor_location
            word = self._word_before_cursor()
            start = col - len(word)
            ed.replace(f"@{value}" + ("" if value.endswith("/") else " "),
                       (row, start), (row, col))
            if value.endswith("/"):
                self.update_popup()
            else:
                self.hide_popup()

        # -- keys ---------------------------------------------------------------------------------

        def check_action(self, action: str, parameters) -> bool | None:
            if action in self._MAIN_ONLY and (
                    isinstance(self.screen, ModalScreen)
                    or (action in self._CHAT_ONLY and self.paged)):
                return False
            return True

        async def _on_key(self, event) -> None:
            """The key after ctrl+x belongs to the leader table whichever page has the
            focus (a page's own letters must not catch it)."""
            if self.leader and not isinstance(self.screen, ModalScreen):
                event.stop()
                event.prevent_default()
                self.run_leader(event.key)

        def command_line(self, text: str = "/") -> None:
            """Over a page the prompt is a command line: focus it with `text` typed."""
            self.editor.focus()
            self.editor.text = text
            self.editor.move_cursor(self.editor.document.end)

        def _back_to_page(self) -> None:
            """The prompt was a command line over a page: esc drops what was typed and
            gives the keys back to the page."""
            self.editor.text = ""
            self.hide_popup()
            self.page.focus_target().focus()

        def on_page_host_changed(self, message) -> None:
            """A page was shown or dropped: the prompt, status row and sidebar follow."""
            self.refresh_chrome()

        def action_leader(self) -> None:
            self.leader = True
            if self._leader_timer is not None:
                self._leader_timer.stop()
            self._leader_timer = self.set_timer(2, self._leader_off)
            self._refresh_status()

        def _leader_off(self) -> None:
            self.leader = False
            self._refresh_status()

        def run_leader(self, key: str) -> None:
            self._leader_off()
            if key == "b":
                self.action_toggle_sidebar()
                return
            for name, cmd in self.unique_commands():
                if cmd.leader == key:
                    self.dispatch(f"/{name}")
                    return

        def action_ctrl_c(self) -> None:
            if isinstance(self.screen, ModalScreen):
                if getattr(self.screen, "inert", lambda: False)():
                    return          # opened a moment ago while they typed: not an answer
                self.screen.dismiss(None)
                return
            if self.paged:
                self.run_worker(self.host.home(), group="nav")     # out of the page, to the chat
                return
            if self.editor.text:
                self.editor.text = ""
                self.hide_popup()
            elif self.busy:
                self.interrupt()
            elif time.monotonic() - self.ctrl_c_at < 2:
                self.exit()
            else:
                self.ctrl_c_at = time.monotonic()
                self.notify("ctrl+c again to quit", timeout=2)

        def action_ctrl_d(self) -> None:
            if self.editor.text:
                self.editor.action_delete_right()
            else:
                self.exit()

        def action_escape(self) -> None:
            if self.leader:
                self._leader_off()
            elif self.popup_open():
                self.hide_popup()
            elif self.paged:
                self._back_to_page()
            elif self.child_of is not None and not self.editor.text:
                # someone else's agent: the habit from the other screens (esc back)
                # must not stop it. ctrl+c or /stop does that.
                self.run_worker(self._back_to_parent(), group="nav")
            elif self.busy:
                if time.monotonic() - self.esc_armed < 2:
                    self.esc_armed = 0.0
                    self.interrupt()
                else:
                    self.esc_armed = time.monotonic()
                self._refresh_status()
            elif self.editor.text:
                if time.monotonic() - self.esc_armed < 1:
                    self.editor.text = ""
                    self.esc_armed = 0.0
                else:
                    self.esc_armed = time.monotonic()
                    self.notify("esc again to clear the prompt", timeout=1)

        def action_new(self) -> None:
            self.dispatch("/new")

        def action_agents_view(self) -> None:
            """← on an empty prompt (a drawer in the next step): /agents."""
            self.run_worker(self.open_page("agents"), group="nav")

        async def open_node(self, node: dict) -> None:
            """Open an agents-page node here: its transcript, and if it is
            running, its live stream (typing then messages it mid-turn)."""
            await self.host.home()
            await self._leave_turn()
            try:
                await self.open_conversation(node["id"], running=bool(node.get("running")),
                                             parent=node.get("parent_id"))
            except CliError as e:
                await self.note(str(e), "error")
                return
            if node.get("kind") == "orchestrator":
                self.orchestrator = True
            if node.get("title"):
                self.title_text = self.title_text or node["title"]
            self.refresh_chrome()

        async def _back_to_parent(self) -> None:
            parent = self.child_of
            if parent is None:
                return
            await self._leave_turn()
            try:
                await self.open_conversation(parent)
            except CliError as e:
                await self.note(str(e), "error")
            self.refresh_chrome()

        async def _leave_turn(self) -> None:
            """Stop watching the turn on screen (it keeps running server-side)."""
            if not self.busy:
                return
            workers = [w for w in self.workers if w.group == "turn" and w.is_running]
            for w in workers:
                w.cancel()
            for w in workers:
                with contextlib.suppress(Exception):
                    await w.wait()
            if self.queue:
                ed = self.editor
                ed.text = "\n".join(self.queue + ([ed.text] if ed.text else []))
                ed.move_cursor(ed.document.end)
                self.queue.clear()
            self.pending.clear()
            self.turn, self.busy, self.stop_requested = None, False, False

        def action_toggle_sidebar(self) -> None:
            if self.size.width < SIDEBAR_MIN_COLS:
                self.notify(f"the sidebar needs {SIDEBAR_MIN_COLS} columns; this window has "
                            f"{self.size.width}", severity="warning")
                return
            shown = self.query_one("#sidebar").display
            self.sidebar_pref = not shown
            if self.sidebar_pref:
                self.unread = self.crit_unread = 0
            self._save_settings(sidebar=self.sidebar_pref)
            self.refresh_chrome()

        def action_toggle_tools(self) -> None:
            self.tools_expanded = not self.tools_expanded
            for tv in self.query(ToolView):
                tv.expanded = self.tools_expanded
                tv.redraw()

        def action_scroll_log(self, direction: int) -> None:
            lv = self.log_view
            if direction < 0:
                lv.scroll_page_up()
            else:
                lv.scroll_page_down()

        def action_external_editor(self) -> None:
            import subprocess
            import tempfile
            editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
            with tempfile.NamedTemporaryFile("w+", suffix=".md", delete=False) as f:
                f.write(self.editor.text)
                path = f.name
            try:
                with self.suspend():
                    subprocess.call([*editor.split(), path])
                self.editor.text = Path(path).read_text().rstrip("\n")
                self.editor.move_cursor(self.editor.document.end)
            except OSError as e:
                # a $EDITOR that is not installed: say so, keep the prompt as it was
                self.notify(f"could not run {editor}: {e.strerror or e} — set $EDITOR",
                            severity="error")
            finally:
                os.unlink(path)

