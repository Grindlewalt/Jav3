# --- 256 colours -------------------------------------------------------------------------
#
# Terminal.app has 256 colours. Rich turns a truecolor value into one of them by
# rounding each channel, and anything under 15% saturation into the grey ramp:
# nord's slate #2e3440 comes out teal, dracula's dark panel navy, two near-whites
# the same white. So on such a terminal every theme is snapped once, here, to
# palette entries Rich really selects, and the roles that have to read against
# each other are checked: the three surfaces stay clearly apart (greys from the
# ramp), text and the three verdict colours keep their contrast on those, the
# selection block keeps its label readable, and error / warning / success stay
# distinguishable. Truecolor terminals get the theme as written.

THEME_ROLES = ("primary", "secondary", "accent", "foreground", "background", "surface",
               "panel", "warning", "error", "success")
MIN_SURFACE_STEP = 6.0       # L* between background, surface and panel
_XTERM: list | None = None   # (shown rgb, feed rgb, Lab) per usable palette entry
_CUBE = {0: (0, 47), 95: (48, 114), 135: (115, 154), 175: (155, 194), 215: (195, 234),
         255: (235, 255)}      # a cube level -> the channel values Rich rounds to it


def _hex_rgb(h: str) -> tuple[int, int, int]:
    return int(h[1:3], 16), int(h[3:5], 16), int(h[5:7], 16)


def _rgb_hex(c) -> str:
    return "#%02x%02x%02x" % tuple(c)


def _lin(v: float) -> float:
    v /= 255
    return v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4


def _luminance(c) -> float:
    r, g, b = (_lin(v) for v in c)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _contrast(a, b) -> float:
    la, lb = sorted((_luminance(a), _luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def _lab(c) -> tuple[float, float, float]:
    r, g, b = (_lin(v) for v in c)
    x, y, z = (0.4124 * r + 0.3576 * g + 0.1805 * b) / 0.95047, \
              0.2126 * r + 0.7152 * g + 0.0722 * b, \
              (0.0193 * r + 0.1192 * g + 0.9505 * b) / 1.08883

    def f(t):
        return t ** (1 / 3) if t > 0.008856 else 7.787 * t + 16 / 116
    fx, fy, fz = f(x), f(y), f(z)
    return 116 * fy - 16, 500 * (fx - fy), 200 * (fy - fz)


def _delta_e(a, b) -> float:
    return sum((p - q) ** 2 for p, q in zip(_lab(a), _lab(b))) ** 0.5


def _xterm_colours() -> list:
    """The palette entries a truecolor value can be made to select: the grey ramp,
    black, white and the cube's coloured entries (the 16 ANSI ones are the
    terminal's to draw; the cube's greys duplicate the ramp). Each comes with a
    `feed` colour that Rich's rounding maps to exactly that entry."""
    global _XTERM
    if _XTERM is None:
        from itertools import product
        from rich.color import EIGHT_BIT_PALETTE, Color, ColorSystem

        def index(c):
            return Color.from_rgb(*c).downgrade(ColorSystem.EIGHT_BIT).number
        out = []
        for i in range(16, 256):
            shown = tuple(EIGHT_BIT_PALETTE[i])
            if 16 < i < 232 and shown[0] == shown[1] == shown[2]:
                continue
            if 16 < i < 232:
                feeds = [c for c in product(*[(shown[k], *_CUBE[shown[k]]) for k in range(3)])
                         if index(c) == i]
            else:                # the ramp, black and white: some grey Rich sends there
                feeds = [(v,) * 3 for v in range(256) if index((v,) * 3) == i]
            if feeds:
                feed = min(feeds, key=lambda c: sum(abs(p - q) for p, q in zip(c, shown)))
                out.append((shown, feed, _lab(shown)))
        _XTERM = out
    return _XTERM


def _grey(shown) -> bool:
    return shown[0] == shown[1] == shown[2]


def snap_colour(h: str) -> str:
    """`h` as the #rrggbb to hand Textual on a 256-colour terminal: the nearest
    palette entry, chosen so that Rich's own rounding lands on it."""
    lab = _lab(_hex_rgb(h))
    best = min(_xterm_colours(), key=lambda c: sum((p - q) ** 2 for p, q in zip(lab, c[2])))
    return _rgb_hex(best[1])


def resolved_theme_spec(theme) -> dict:
    """A Textual Theme as plain values with every colour spelled out (a built-in
    leaves surface, panel and the rest to be derived)."""
    from textual.color import Color
    d = {"name": theme.name, "dark": bool(theme.dark), "variables": dict(theme.variables),
         "luminosity_spread": theme.luminosity_spread, "text_alpha": theme.text_alpha,
         "ansi": theme.ansi}
    if theme.ansi:
        d.update({k: getattr(theme, k) for k in (*THEME_ROLES, "boost")})
        return d
    made = theme.to_color_system().generate()
    for k in THEME_ROLES:
        d[k] = Color.parse(made[k]).hex[:7].lower()
    if theme.boost:
        d["boost"] = theme.boost
    return d


def muted_colour(spec: dict, snap: bool) -> str:
    """The theme's muted-text colour as one solid value. Textual leaves `$text-muted`
    as "auto 60%", a blend: in markup it comes out pure white (brighter than the
    body text), and on 256 colours it rounds to whatever grey is near."""
    fg, bg, sf, pn = (_hex_rgb(spec[k]) for k in ("foreground", "background", "surface", "panel"))
    for f in (0.62, 0.68, 0.74, 0.8, 0.86, 0.92):
        c = tuple(round(fg[i] * f + bg[i] * (1 - f)) for i in range(3))
        if _contrast(c, bg) >= 4 and _contrast(c, sf) >= 4 and _contrast(c, pn) >= 3.5:
            break
    h = _rgb_hex(c)
    return snap_colour(h) if snap else h


def _block_text_contrast(fed, shown) -> float:
    """Contrast of the label Textual writes on a block of colour `fed` (white when
    the colour is dark by its own measure, else black) against what is shown."""
    dark = (0.299 * fed[0] + 0.587 * fed[1] + 0.114 * fed[2]) / 255 < 0.5
    return _contrast((238,) * 3 if dark else (8,) * 3, shown)


def theme_problems(spec: dict, tint: bool = True) -> list[str]:
    """Why a theme will read badly, worded for the editor's hint line; empty when
    it is fine. `spec` has every colour spelled out (resolved_theme_spec). `tint`:
    diff lines sit on a 12% tint of their colour (not on 256 colours: DIFF_TINT)."""
    if spec.get("ansi"):
        return []
    c = {k: _hex_rgb(spec[k]) for k in THEME_ROLES}
    out = []
    for role, need in (("foreground", 4.5), ("primary", 3), ("secondary", 3), ("accent", 3),
                       ("warning", 3), ("error", 3), ("success", 3)):
        r = _contrast(c[role], c["background"])
        if r < need:
            out.append(f"{role} is hard to read on the background ({r:.1f}:1, want {need})")
    r = _block_text_contrast(c["primary"], c["primary"])
    if r < 4:
        out.append(f"selected rows are hard to read: the label on primary is {r:.1f}:1")
    for role in ("error", "success") if tint else ():
        row = tuple(round(c["background"][i] + (c[role][i] - c["background"][i]) * 0.12)
                    for i in range(3))
        r = _contrast(c[role], row)
        if r < 3:
            out.append(f"{role} is hard to read on a changed line of a diff ({r:.1f}:1)")
    for a, b in (("background", "surface"), ("surface", "panel")):
        if abs(_lab(c[a])[0] - _lab(c[b])[0]) < 4:
            out.append(f"{a} and {b} are almost the same, so dialogs blend in")
    for a, b in (("error", "warning"), ("error", "success"), ("warning", "success")):
        if _delta_e(c[a], c[b]) < 18:
            out.append(f"{a} and {b} look alike")
    return out


def terminal_theme_spec(spec: dict, truecolor: bool) -> dict:
    """`spec` (resolved_theme_spec, or a validated theme file) ready for this
    terminal; as is on truecolor, snapped and checked on 256 colours."""
    if truecolor or spec.get("ansi"):
        return spec
    full = dict(spec)
    if "background" not in full:                 # a theme file that leaves roles out
        from textual.theme import Theme
        full = {**spec, **resolved_theme_spec(Theme(**spec))}
    dark = bool(full.get("dark", True))
    cands = _xterm_colours()
    greys = sorted((c for c in cands if _grey(c[0])), key=lambda c: c[2][0])
    out = dict(full)
    # 1. the surfaces: neutral greys, each a clear step from the one before,
    # going the way the theme goes (dark: lighter; light: darker)
    step, surf = (1 if dark else -1), {}
    for k, before in (("background", None), ("surface", "background"), ("panel", "surface")):
        want = _lab(_hex_rgb(full[k]))[0]
        if before is None:
            pick = min(greys, key=lambda c: abs(c[2][0] - want))
        else:
            pl = surf[before][2][0]
            if abs(want - _lab(_hex_rgb(full[before]))[0]) > 1:
                step = 1 if want > _lab(_hex_rgb(full[before]))[0] else -1
            room = [c for c in greys if (c[2][0] - pl) * step >= MIN_SURFACE_STEP]
            if not room:
                step = -step
                room = [c for c in greys if (c[2][0] - pl) * step >= MIN_SURFACE_STEP]
            pick = min(room, key=lambda c: abs(c[2][0] - want))
        surf[k] = pick
        out[k] = _rgb_hex(pick[1])
    bg, sf, pn = (surf[k][0] for k in ("background", "surface", "panel"))
    # 2. the colours that are read on those surfaces; the verdict trio must also
    # stay apart (as far apart as the theme made them, up to a clear margin)
    chosen: dict[str, tuple] = {}

    def apart(role, c) -> bool:
        for other in ("error", "warning", "success"):
            if other == role or other not in chosen or role not in ("error", "warning", "success"):
                continue
            was = _delta_e(_hex_rgb(full[role]), _hex_rgb(full[other]))
            if _delta_e(c[0], chosen[other]) < min(22.0, 0.8 * was):
                return False
        return True

    def reads(role, c) -> bool:
        if role == "foreground":
            return (_contrast(c[0], bg) >= 7 and _contrast(c[0], sf) >= 4.5
                    and _contrast(c[0], pn) >= 4.5)
        if _contrast(c[0], bg) < 3 or _contrast(c[0], sf) < 3:
            return False
        if role in ("primary", "secondary", "accent") and _contrast(c[0], pn) < 3:
            return False      # headings and hints sit on the panel too
        if role == "primary":     # the selection block: Textual writes white or black on it
            return _block_text_contrast(c[1], c[0]) >= 4.5
        return True

    for role in ("primary", "error", "success", "warning", "accent", "secondary", "foreground"):
        lab = _lab(_hex_rgb(full[role]))
        ranked = sorted(cands, key=lambda c: sum((p - q) ** 2 for p, q in zip(lab, c[2])))
        pick = next((c for c in ranked if reads(role, c) and apart(role, c)), None) \
            or next((c for c in ranked if reads(role, c)), ranked[0])
        out[role] = _rgb_hex(pick[1])
        chosen[role] = pick[0]
    # colours a built-in spelled out in its variables follow the roles they name
    was = {full[k].lower(): out[k] for k in THEME_ROLES if k in full}
    out["variables"] = {k: was.get(str(v).lower(), v) for k, v in full.get("variables", {}).items()}
    return out


def _plain(s: str, n: int = 30) -> str:
    """Something from a file, safe to put in a message: no markup, no escapes."""
    return re.sub(r"[^A-Za-z0-9._-]", "?", str(s))[:n]


def validate_theme(obj, reserved=()) -> dict:
    """A theme file's content, checked: exactly the known keys, a plain name,
    #rrggbb (or a few named) colours, a boolean `dark`. Returns a clean copy."""
    if not isinstance(obj, dict):
        raise ThemeError("a theme file must be one JSON object")
    allowed = {"name", "dark", *THEME_COLOURS}
    extra = sorted(str(k) for k in obj if k not in allowed)
    if extra:
        raise ThemeError(f"unknown key {_plain(extra[0])!r} — allowed: name, dark, "
                         + ", ".join(THEME_COLOURS))
    name = obj.get("name")
    if not isinstance(name, str) or not _THEME_NAME.fullmatch(name) \
            or name.strip() != name:
        raise ThemeError("'name' must be 1-40 letters, digits, spaces, _ or - "
                         "(no leading or trailing space)")
    if name.lower() in reserved or name.lower() in THEME_WORDS:
        raise ThemeError(f"{name!r} is taken by a built-in theme or command — pick "
                         "another name")
    out: dict = {"name": name, "dark": True}
    if "dark" in obj:
        if type(obj["dark"]) is not bool:
            raise ThemeError("'dark' must be true or false")
        out["dark"] = obj["dark"]
    for k in THEME_COLOURS:
        if k not in obj:
            continue
        v = obj[k]
        if isinstance(v, str) and _HEX.fullmatch(v):
            out[k] = v.lower()
        elif isinstance(v, str) and v.lower() in NAMED_COLOURS:
            out[k] = NAMED_COLOURS[v.lower()]
        else:
            raise ThemeError(f"{k!r} must be #rrggbb or one of: "
                             + ", ".join(sorted(NAMED_COLOURS)))
    if "primary" not in out:
        raise ThemeError("'primary' is required")
    return out


def _no_duplicate_keys(pairs):
    d = {}
    for k, v in pairs:
        if k in d:
            raise ValueError(f"duplicate key {_plain(k)!r}")
        d[k] = v
    return d


def read_theme_file(path) -> object:
    """Parse a theme file: not a symlink, a regular file, at most 16 KB,
    UTF-8, JSON (json.loads, duplicate keys refused). Returns the parsed value."""
    import errno
    label = _plain(Path(path).name, 60)
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
    try:
        fd = os.open(path, flags)
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise ThemeError(f"{label} is a symlink — give the file itself")
        raise ThemeError(f"could not open {label}: {e.strerror or e}")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise ThemeError(f"{label} is not a regular file")
        if st.st_size > THEME_MAX_BYTES:
            raise ThemeError(f"{label} is bigger than {THEME_MAX_BYTES // 1024} KB")
        chunks, got = [], 0
        while got <= THEME_MAX_BYTES:
            b = os.read(fd, THEME_MAX_BYTES + 1 - got)
            if not b:
                break
            chunks.append(b)
            got += len(b)
    finally:
        os.close(fd)
    data = b"".join(chunks)
    if len(data) > THEME_MAX_BYTES:
        raise ThemeError(f"{label} is bigger than {THEME_MAX_BYTES // 1024} KB")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise ThemeError(f"{label} is not UTF-8 text")
    try:
        return json.loads(text, object_pairs_hook=_no_duplicate_keys)
    except RecursionError:
        raise ThemeError(f"{label} is nested too deeply")
    except ValueError as e:
        raise ThemeError(f"{label} is not valid JSON ({_plain(e, 60).replace('?', ' ')})")


def themes_dir() -> Path:
    return config_dir() / "themes"


def theme_filename(name: str) -> str:
    return re.sub(r"[^a-z0-9_-]", "-", name.lower()) + ".json"


def save_theme(clean: dict) -> Path:
    """Store a validated theme; never replaces one that is there."""
    d = themes_dir()
    if d.is_symlink():
        raise ThemeError(f"{d} is a symlink — refusing to write through it")
    try:
        d.mkdir(parents=True, exist_ok=True, mode=0o700)
    except OSError as e:
        raise ThemeError(f"could not create {d}: {e.strerror or e}")
    path = d / theme_filename(clean["name"])
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags, 0o600)
    except FileExistsError:
        raise ThemeError(f"a theme named {clean['name']!r} exists ({path}) — delete it "
                         "or pick another name")
    except OSError as e:
        raise ThemeError(f"could not save {path}: {e.strerror or e}")
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps(clean, indent=2) + "\n")
    return path


def import_theme(src: str, reserved=()) -> tuple[dict, Path]:
    clean = validate_theme(read_theme_file(Path(os.path.expanduser(src))), reserved)
    return clean, save_theme(clean)


def load_custom_themes(reserved=()) -> tuple[list[dict], list[str]]:
    """Every stored custom theme that still validates, and why the rest do not."""
    d = themes_dir()
    if not d.is_dir() or d.is_symlink():
        return [], []
    themes, errors, seen = [], [], set(reserved)
    for f in sorted(d.glob("*.json"))[:THEME_MAX_FILES]:
        try:
            clean = validate_theme(read_theme_file(f), reserved)
        except ThemeError as e:
            errors.append(f"theme {_plain(f.name, 60)} skipped: {e}")
            continue
        if clean["name"].lower() in seen:
            errors.append(f"theme {_plain(f.name, 60)} skipped: duplicate name")
            continue
        seen.add(clean["name"].lower())
        themes.append(clean)
    return themes, errors


def copy_to_clipboard(text: str, osc52=None) -> str:
    import shutil
    import subprocess
    for cmd in (["pbcopy"], ["wl-copy"], ["xclip", "-selection", "clipboard"],
                ["xsel", "--clipboard", "--input"]):
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, input=text.encode(), check=True, timeout=5)
                return cmd[0]
            except (OSError, subprocess.SubprocessError):
                continue
    # OSC 52: most terminals (and tmux with set-clipboard on) put this on the
    # clipboard even over SSH. Inside the TUI the app writes it, not us.
    if osc52 is not None:
        osc52(text)
        return "OSC 52"
    import base64
    sys.stdout.write(f"\033]52;c;{base64.b64encode(text.encode()).decode()}\a")
    sys.stdout.flush()
    return "OSC 52"


def login_with_line(line: str, server: str | None) -> tuple[str, str, str]:
    """Run `jav3 login` with an already-read line; (base, token, username)."""
    ns = argparse.Namespace(server=server)
    out = io.StringIO()
    cmd_login(ns, out, read=lambda: line)
    creds = load_credentials()
    if not creds:
        raise CliError("login did not save credentials")
    base = base_url(server or creds["address"])
    who = out.getvalue().rsplit("you are ", 1)[-1].strip() or "?"
    return base, creds["token"], who


def cmd_tui(args) -> int:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise CliError("the interactive TUI needs a terminal — use jav3 -p <message> "
                       "for one-shot output")
    if not tui_available():
        print(f"jav3: {TUI_HINT}; using the plain REPL", file=sys.stderr)
        args.message = []
        return cmd_chat(args)
    # no login prompt before the TUI: with no (or a dead) credential it starts
    # in its not-logged-in state and /login inside it fixes that
    creds = load_credentials()
    if creds:
        base, token = base_url(args.server or creds["address"]), cred_of(creds)
    else:
        base, token = (base_url(args.server) if args.server else ""), None
    prompt = " ".join(getattr(args, "prompt", None) or []) or None
    app = build_tui(base, token, server_override=args.server,
                    project=getattr(args, "project", None), agent=getattr(args, "agent", None),
                    model=getattr(args, "model", None), resume=getattr(args, "resume", None),
                    cont=getattr(args, "cont", False), prompt=prompt)
    app.run()
    if app.busy and app.cid:
        print(f"the turn keeps running on the server — `jav3 -r {app.cid}` re-attaches")
    if getattr(app, "return_code", 0):
        return app.return_code
    return 0


def cmd_print(args, out=sys.stdout) -> int:
    """`jav3 -p message` (or a pipe): one turn, plain text, for scripts."""
    msg = " ".join(args.prompt or [])
    if not sys.stdin.isatty():
        piped = sys.stdin.read()
        msg = f"{msg}\n\n{piped}".strip() if msg else piped.strip()
    if not msg:
        raise CliError("nothing to send")
    base, token = _session(args)
    with _client(base, token, timeout=httpx.Timeout(30.0, read=None)) as c:
        try:
            run_turn(c, msg, getattr(args, "resume", None), args.project, out)
        except httpx.HTTPError as e:
            raise CliError(f"connection to {base} failed: {e}")
    return 0


# --- arguments ---------------------------------------------------------------------------

SUBCOMMANDS = ("login", "chat", "whoami", "logout")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="jav3", description="Terminal client for a Jav3 server. With no command, "
        "starts the interactive TUI (optionally with a first message).",
        usage="jav3 [options] [message ...]\n       jav3 {login,chat,whoami,logout} ...")
    p.add_argument("--server", help="server address (host:port or URL), overriding the saved one")
    p.add_argument("-p", "--print", dest="print_mode", action="store_true",
                   help="send the message (or stdin), print the reply, exit")
    p.add_argument("-c", "--continue", dest="cont", action="store_true",
                   help="resume the most recent chat")
    p.add_argument("-r", "--resume", type=int, metavar="ID", help="resume chat ID")
    p.add_argument("--model", help="provider/model for this session's chats")
    p.add_argument("--agent", help="start the new chat as this agent")
    p.add_argument("--project", help="pin a new conversation to this project slug")
    sub = p.add_subparsers(dest="cmd")
    # the line is read from the terminal (or a pipe), never argv: argv lands in
    # shell history and is visible to every user via ps
    lg = sub.add_parser("login", help="log in with the line from Settings → Add computer "
                                      "(chat only), or --password for full access")
    lg.add_argument("--password", action="store_true",
                    help="ask for the server address, username and password instead "
                         "(full access: /security, /vms, providers)")
    ch = sub.add_parser("chat", help="send a message, or start the TUI with none")
    ch.add_argument("message", nargs="*")
    ch.add_argument("--project", help="pin a new conversation to this project slug")
    sub.add_parser("whoami", help="show who the saved token authenticates as")
    sub.add_parser("logout", help="revoke this computer's token and forget it")
    return p


def parse_args(argv: list[str]) -> argparse.Namespace:
    """Subcommands as before; anything else is the TUI, and free words are its
    first message (`jav3 fix the tests`)."""
    parser = build_parser()
    takes_value = {"--server", "-r", "--resume", "--model", "--agent", "--project"}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            i += 1
            break
        if a.startswith("-"):
            i += 1 if ("=" in a or a not in takes_value) else 2
            continue
        break
    if i < len(argv) and argv[i] in SUBCOMMANDS:
        args = parser.parse_args(argv)
        args.prompt = []
        return args
    words = [w for w in argv[i:] if w != "--"] if i < len(argv) else []
    head = [w for w in argv[:i] if w != "--"]
    args = parser.parse_args(head)
    args.prompt = words
    return args


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    try:
        args = parse_args(argv)
        cmds = {"login": cmd_login, "chat": cmd_chat, "whoami": cmd_whoami,
                "logout": cmd_logout}
        if args.cmd:
            return cmds[args.cmd](args)
        if args.print_mode or not sys.stdin.isatty():
            return cmd_print(args)
        return cmd_tui(args)
    except CliError as e:
        print(f"jav3: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
