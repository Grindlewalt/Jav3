    class VmsPage(SecurityPage):
        """/vms: Boxes · Images · Catalogue. The Security page's frame (tabs,
        list, detail, plain keys) over /api/vm/boxes, /api/vm/leftovers,
        /api/vm/images and /api/packages. Boxes refresh live (the rows update in
        place, the cursor stays on its box). Every action asks first; chat-only
        logins are locked."""

        NAME = "vms"
        TITLE = "VMs"
        TABS = VMS_TABS
        LABELS = {"boxes": "Boxes", "images": "Images", "catalogue": "Catalogue"}
        EMPTY = {"boxes": "no boxes", "images": "no image variants",
                 "catalogue": "no package requests"}
        COUNTED = ("catalogue",)
        TIMED = ("boxes", "images", "catalogue")
        FOOT = {"boxes": "[$primary]enter[/] history [$primary]s[/] start / stop  "
                         "[$primary]r[/] restart  [$primary]x[/] nuke shared  "
                         "[$primary]d[/] destroy  [$primary]c[/] clean leftovers",
                "images": "[$primary]b[/] build a new version  [$primary]l[/] build log",
                "catalogue": "[$primary]y[/] approve  [$primary]n[/] reject"}
        BINDINGS = [Binding("x", "nuke", show=False), Binding("c", "clean", show=False)]
        # one line per row, however long (the frame's `SecRow { height: 1 }`
        # does not reach this subclass's rows); the head gets two more lines
        DEFAULT_CSS = """
        VmsPage SecRow { height: 1; }
        VmsPage #sec-sub { max-height: 6; }
        """

        def __init__(self, args=()) -> None:
            super().__init__(args)
            self.vm: dict = {}
            self.leftovers: dict = {}            # GET /api/vm/leftovers
            self.hist_box: str | None = None     # enter: the box whose history shows
            self.hist: list[dict] = []

        @classmethod
        def build(cls, app, args) -> "VmsPage":
            return cls(args)

        def counts(self) -> dict:
            pend = sum((e["raw"].get("status") or "pending") == "pending"
                       for e in self.entries["catalogue"])
            return {"catalogue": self._count("catalogue", pend)}

        async def _load_boxes(self):
            hist = self.hist_box
            r, lo, ev = await asyncio.gather(
                self._get("boxes", "boxes", "/api/vm/boxes", ""),
                self._get("boxes", "leftovers", "/api/vm/leftovers", "", quiet404=True),
                self._get("boxes", "history", f"/api/vm/boxes/{hist}/events", "events",
                          quiet404=True, params={"limit": 30})
                if hist else asyncio.sleep(0))
            if hist and ev is not None and hist == self.hist_box:
                self.hist = [x for x in ev if isinstance(x, dict)]
            if lo is not None:
                self.leftovers = lo
            if r is None:
                return None
            self.vm.update(enabled=r.get("enabled"), budget=r.get("budget") or {},
                           idle=r.get("idle") or {})
            self.runtimes = r.get("runtimes") or {}
            return self.box_entries(r.get("boxes") or [], self.leftovers)

        @staticmethod
        def box_entries(rows, leftovers) -> list[dict]:
            """The boxes, then (when there are any) what they left behind."""
            out = [{"type": "box", "key": f"X{b.get('id')}", "raw": b} for b in rows]
            items = [i for i in _jlist((leftovers or {}).get("items")) if isinstance(i, dict)]
            if items:
                out.append({"type": "group", "key": "Gleft",
                            "raw": {"slug": "leftovers (no box owns them)"}})
                out += [{"type": "leftover", "key": f"L{i.get('id')}", "raw": i}
                        for i in items]
            return out

        async def _load_images(self):
            r = await self._get("images", "images", "/api/vm/images", "")
            if r is None:
                return None
            self.vm["build"] = r.get("build") or {}
            out = []
            for v in r.get("variants") or []:
                out.append({"type": "variant", "key": f"I{v.get('name')}",
                            "raw": {k: x for k, x in v.items() if k != "versions"}})
                for ver in v.get("versions") or []:
                    stale = bool(ver.get("recipe_sha256") and v.get("recipe_sha256")
                                 and ver["recipe_sha256"] != v["recipe_sha256"])
                    out.append({"type": "version", "key": f"I{v.get('name')}:"
                                                          f"{ver.get('version')}",
                                "raw": {**ver, "variant": v.get("name"),
                                        "stale_recipe": stale}})
            return out

        async def _load_catalogue(self):
            ps = await self._get("catalogue", "packages", "/api/packages", "packages")
            if ps is None:
                return None
            out = [{"type": "package", "key": f"pk{p.get('id')}", "raw": p,
                    "ts": p.get("created_at") or ""} for p in ps]
            out.sort(key=lambda x: ((x["raw"].get("status") or "pending") != "pending",
                                    x["ts"]), reverse=False)
            return out

        # -- drawing -------------------------------------------------------------------

        async def rebuild(self) -> None:
            """In place when the same rows are shown (a live refresh changes
            timers and states, not which boxes exist): no remount, no flicker,
            the cursor stays on its box. Otherwise the frame's full rebuild."""
            shown = [] if self.locked else self.shown()
            keys = [e["key"] for e in shown]
            rows = list(self.query(SecRow))
            if (not shown or not self.loaded[self.tab] or self.locked
                    or [w.key for w in rows] != keys):
                await super().rebuild()
                return
            async with self._lock:
                marks = [self.row_markup(e, True) for e in shown]
                prev = self._sig[4] if self._sig and len(self._sig) > 4 else ()
                for i, (w, m) in enumerate(zip(rows, marks)):
                    if i >= len(prev) or prev[i] != m:
                        w.show(m)
                self._sig = (self.tab, self.locked, self.loaded[self.tab], tuple(keys),
                             tuple(marks), bool(self.errors[self.tab]))
                self.refresh_sel()
                self.render_chrome()

        def _live(self) -> bool:
            return self.tab == "boxes" and not self.locked    # r restarts here; rows refresh

        def vms_sub(self) -> str:
            if self.tab == "boxes":
                b = self.vm.get("budget") or {}
                if not self.vm:
                    return "[$text-muted]…[/]"
                off = ("" if self.vm.get("enabled") else
                       "[$warning]boxes are off: the one shared box only[/] · ")
                tight = self._tight()
                return (f"{off}[$text-muted]RAM {b.get('ram_mb_used', '?')}/"
                        f"{b.get('ram_mb_cap', '?')} MB · boxes {b.get('boxes', '?')}/"
                        f"{b.get('boxes_cap', '?')} · project boxes "
                        f"{b.get('project_boxes', '?')}/{b.get('project_boxes_cap', '?')}"
                        + ("" if tight else " (reservations count, running or not)")
                        + "[/]\n"
                        + self.idle_markup(tight) + self.runtimes_markup(tight))
            if self.tab == "images":
                bd = self.vm.get("build") or {}
                tail = [str(x) for x in _jlist(bd.get("log_tail"))]
                if bd.get("running"):
                    return ("[$warning]building " + _esc(str(bd.get("variant") or "?"))
                            + f" ({_esc(str(bd.get('mode') or '?'))}): "
                            + _esc(str(bd.get("phase") or "…")) + "[/]"
                            + (f"\n[$text-muted]› {_esc(_short(tail[-1], 120))}[/]"
                               if tail else ""))
                return ("[$text-muted]variants are frozen layers over the base; a build "
                        "makes a new version, never changes one in use[/]")
            return ("[$text-muted]packages the agents asked for and the operator added; "
                    "an approved one goes into its variant's next version[/]")

        def idle_markup(self, tight: bool = False) -> str:
            """When the reaper acts, and what was left behind (one line; shorter when
            the terminal is small, so the head leaves the list its rows)."""
            idle = self.vm.get("idle") or {}
            bits = []
            if idle.get("project_stop_s") and self.vm.get("enabled"):
                bits.append(f"project boxes stop after {_mins(idle['project_stop_s'])} idle")
            if idle.get("shared_scrub_s"):
                bits.append((f"shared box scrubbed after {_mins(idle['shared_scrub_s'])}" if tight
                             else f"the shared box is scrubbed after "
                                  f"{_mins(idle['shared_scrub_s'])} idle"))
            elif idle:
                bits.append("shared box never scrubbed" if tight else
                            "the shared box is never scrubbed (vm_idle_scrub_seconds 0)")
            line = f"[$text-muted]{' · '.join(bits)}[/]" if bits else ""
            lo = _jlist(self.leftovers.get("items"))
            n = sum(1 for i in lo if isinstance(i, dict) and i.get("cleanable"))
            if lo:
                line += (("\n" if tight else "   ") if line else "") + (
                         f"[$warning]{len(lo)} leftover"
                         f"{'s' * (len(lo) != 1)} no box owns[/]"
                         + (" [$text-muted]— c cleans[/]" if n else ""))
            return line + "\n" if line else ""

        def runtimes_markup(self, tight: bool = False) -> str:
            rt = self.runtimes or {}
            if not rt:
                return ""
            if tight:
                # one line that always fits: the full warnings are in the detail of a
                # docker box and of a docker profile
                docker = rt.get("docker") if isinstance(rt.get("docker"), dict) else {}
                bits = []
                for name in ("kvm", "docker"):
                    info = rt.get(name)
                    if not isinstance(info, dict):
                        continue
                    if info.get("available") is False:
                        bits.append(f"[$text-muted]{name} unavailable[/]")
                    elif name == "docker":
                        bits.append("docker " + (f"{RED} WEAK ISOLATION [/]" if docker.get("weak")
                                                 else f"{AMBER} less isolated [/]"))
                    else:
                        bits.append(f"[$success]{name}[/]")
                return "[$text-muted]runtimes:[/] " + "  ".join(bits)
            bits = []
            for name in ("kvm", "docker"):
                info = rt.get(name)
                if not isinstance(info, dict):
                    continue
                if info.get("available") is False:
                    bits.append(f"[$text-muted]{name}: unavailable — "
                                f"{_esc(str(info.get('reason') or '?'))}[/]")
                elif name == "docker":
                    hard = [k for k in ("rootless", "userns", "gvisor", "seccomp")
                            if info.get(k)]
                    bits.append(f"docker {AMBER} less isolated [/]"
                                + (f" [$text-muted]({', '.join(hard)})[/]" if hard else ""))
                else:
                    bits.append(f"[$success]{name}[/]")
            line = "[$text-muted]runtimes:[/] " + "  ".join(bits)
            notes = _docker_notes(rt)
            if notes and (rt.get("docker") or {}).get("available") is not False:
                line += "\n" + "\n".join(notes)
            return line

        def _detail_box(self, e) -> str:
            r = e["raw"]
            st = r.get("state")
            shared = r.get("id") == "shared"
            net, disk, img = r.get("net") or {}, r.get("disk") or {}, r.get("image") or {}
            keys = ("[$primary]enter[/] " + ("hide history" if self.hist_box == r.get("id")
                                              else "history")
                    + "   [$primary]s[/] " + ("stop" if st == "running" else "start")
                    + ("   [$primary]r[/] restart" if st == "running" else "")
                    + ("   [$primary]x[/] nuke" if shared else "   [$primary]d[/] destroy"))
            col, word = _box_state_word(r)
            projs = [str(p) for p in _jlist(r.get("projects"))]
            now = _box_turns(r)
            if now:
                doing = [f"doing now: {_turn_text(t, 60)}"
                         + (f" [$text-muted](tool for {_mins(time.time() - t['tool']['since'])})[/]"
                            if isinstance(t.get("tool"), dict) and _num(t["tool"].get("since"))
                            else "") for t in now]
            elif st == "running":
                timer = _box_timer(r).replace(" [$text-muted]· ", "[$text-muted]", 1)
                doing = ["doing now: nothing (idle)" + (f"  {timer}" if timer else "")]
            else:
                doing = []
            last = r.get("last_event") if isinstance(r.get("last_event"), dict) else None
            hist = []
            if self.hist_box == r.get("id"):
                hist = (["[b]history[/] [$text-muted](newest first)[/]"]
                        + ([_box_event_line(x) for x in self.hist]
                           or ["[$text-muted]no history yet[/]"]) + [""])
            lines = [
                keys, "",
                f"[b]{_esc(r.get('id') or '?')}[/] {_esc(r.get('kind') or '')}"
                + (f" ⌂ {_esc(', '.join(projs))}" if projs else "")
                + f"  cid {r.get('cid')}  [{col} b]{_esc(word or '?')}[/]"
                + (f" [$text-muted]since {_local_ts(r['started_at'])}[/]"
                   if r.get("started_at") else ""),
                *doing,
                (f"[$error b]last error:[/] {_esc(str(r['last_error']))}"
                 if r.get("last_error") else None),
                ("last: " + _box_event_line(last) if last and not hist else None),
                *([""] + hist if hist else []),
                f"runtime: {_runtime_tag(r.get('runtime'))}"
                + ("  [$text-muted]a container shares the host kernel[/]"
                   if r.get("runtime") == "docker" else "")
                + ("".join("\n" + x for x in _docker_notes(self.runtimes))
                   if r.get("runtime") == "docker" else ""),
                f"image {_esc(img.get('variant') or 'main')} "
                + (f"v{_esc(str(img['version']).lstrip('v'))}" if img.get("version")
                   else "(active version)")
                + f"  RAM {r.get('mem_mb') or '?'} MB"
                + (f" (costs {r['ram_cost_mb']} MB of the budget)"
                   if r.get("ram_cost_mb") and r.get("ram_cost_mb") != r.get("mem_mb") else "")
                + f"  rss {_bytes(r.get('rss_bytes'))}B  cpu "
                f"{_num(r.get('cpu_pct')) or 0:.1f}%  up {_uptime(r.get('uptime_s'))}",
                f"disk: overlay {_bytes(disk.get('overlay_bytes'))}B, data "
                f"{_bytes(disk.get('data_bytes'))}B",
                f"net: {_esc(net.get('tap') or '?')} host {_esc(net.get('host_ip') or '?')} "
                f"guest {_esc(net.get('guest_ip') or '?')}",
                (f"service #{r.get('service_id')} · placement {_esc(r.get('placement') or '?')}"
                 if r.get("service_id") or r.get("placement") else None)]
            return "\n".join(x for x in lines if x is not None).rstrip()

        def _detail_leftover(self, e) -> str:
            r = e["raw"]
            head = ("[$primary]c[/] clean every cleanable leftover" if r.get("cleanable")
                    else "[$text-muted]listed only: never removed automatically[/]")
            d = r.get("detail") if isinstance(r.get("detail"), dict) else {}
            return "\n".join([
                head, "",
                f"[b]{_esc(r.get('name') or '?')}[/] {_esc(r.get('type') or '')}"
                + (f"  {_bytes(r['bytes'])}B" if r.get("bytes") else ""),
                _esc(r.get("why") or ""),
                "[$text-muted]" + _esc("  ".join(f"{k} {v}" for k, v in d.items())) + "[/]"])

        def _build_log(self, variant) -> list[str]:
            """The build's log tail, when the last (or running) build is this
            variant's: guest output, text only."""
            bd = self.vm.get("build") or {}
            tail = [str(x) for x in _jlist(bd.get("log_tail"))]
            if not tail or bd.get("variant") != variant:
                return []
            head = ("build running, " + str(bd.get("phase") or "…") if bd.get("running")
                    else "last build")
            return (["", f"[b]{_esc(head)}[/] [$text-muted](log tail, untrusted builder "
                     "output; l shows the whole log)[/]"] + [_esc(x) for x in tail[-15:]])

        def _detail_variant(self, e) -> str:
            r = e["raw"]
            pk = _jlist(r.get("layer_packages"))
            lb = r.get("last_build") if isinstance(r.get("last_build"), dict) else None
            return "\n".join([
                "[$primary]b[/] build a new version   [$primary]l[/] build log", "",
                f"[b]{_esc(r.get('name') or '?')}[/] from {_esc(r.get('from') or 'base')}"
                f"{'  builtin' if r.get('builtin') else ''}  min RAM "
                f"{r.get('min_mem_mb') or '?'} MB"
                + ("  [$warning b]needs a build[/]" if r.get("needs_build") else ""),
                "used by: " + (_esc(", ".join(_jlist(r.get("used_by")))) or "no project"),
                "layer packages: " + (_esc(", ".join(
                    " ".join(str(p.get(k) or "") for k in ("manager", "package", "version")
                             ).strip() if isinstance(p, dict) else str(p) for p in pk))
                    or "none"),
                (f"last build: v{_esc(str(lb.get('version')))} "
                 + ("[$success]built[/]" if lb.get("ok") else
                    f"[$error]failed[/] {_esc(str(lb.get('error') or ''))}")
                 + f" [$text-muted]{_esc(full_ts(lb.get('finished_at')))}[/]"
                 if lb else "last build: none"),
                f"recipe sha256: {_esc(r.get('recipe_sha256') or '?')}",
                "", _esc(str(r.get("recipe") or ""))] + self._build_log(r.get("name")))

        def _detail_version(self, e) -> str:
            r = e["raw"]
            return "\n".join([
                "[$primary]b[/] build a new version of "
                f"{_esc(r.get('variant') or '?')}   [$primary]l[/] this version's build log", "",
                f"[b]{_esc(r.get('variant') or '?')} v{_esc(str(r.get('version')))}[/] on base "
                f"{_esc(str(r.get('base_version') or '?'))}"
                + ("  [$primary b]active[/]" if r.get("active") else ""),
                f"status {_esc(r.get('status') or '?')} · {_bytes(r.get('size_bytes'))}B · "
                f"built {_esc(full_ts(r.get('built_at')) or '-')}",
                "in use by: " + (_esc(", ".join(map(str, _jlist(r.get("in_use_by")))))
                                 or "no box"),
                (f"recipe sha256: {_esc(r.get('recipe_sha256') or '?')}"
                 + ("  [$warning]an older recipe than the variant's[/]"
                    if r.get("stale_recipe") else ""))]
                + self._build_log(r.get("variant")))

        # -- keys ------------------------------------------------------------------------

        def action_approve(self) -> None:
            if self.tab == "catalogue":
                self._act(self._pkg_verdict(True))

        def action_deny(self) -> None:
            if self.tab == "catalogue":
                self._act(self._pkg_verdict(False))

        def action_stop(self) -> None:
            if self.tab == "boxes":
                self._act(self._box_startstop())

        def action_delete(self) -> None:
            if self.tab == "boxes":
                self._act(self._box_destroy())

        def action_build(self) -> None:
            if self.tab == "images":
                self._act(self._build())

        async def action_reload(self) -> None:
            if self.tab == "boxes":
                self._act(self._box_restart())      # r restarts; the list is live
            elif not self.locked:
                await self.load(self.tab)

        def action_nuke(self) -> None:
            if self.tab == "boxes":
                self._act(self._nuke())

        def action_clean(self) -> None:
            if self.tab == "boxes":
                self._act(self._clean())

        def action_logs(self) -> None:
            if self.tab == "images":
                self._act(self._image_log())

        async def action_enter(self) -> None:
            if self.locked:
                self.run_worker(self._login_from_here(), group="sec-act", exclusive=True)
                return
            if self.tab != "boxes":
                return
            b = self._box()
            if b is None:
                return
            if self.hist_box == b.get("id"):
                self.hist_box, self.hist = None, []
                self.refresh_sel()
                return
            self.hist_box, self.hist = b.get("id"), []
            self.refresh_sel()
            await self.load("boxes")               # fetches the history with the rows

        def _note(self, markup: str) -> None:
            self.status = markup
            self.render_chrome()

        async def _pkg_verdict(self, yes: bool) -> None:
            e = self.selected()
            if e is None or e["type"] != "package" or \
                    (e["raw"].get("status") or "pending") != "pending":
                return
            await (self._approve_package(e["raw"]) if yes else self._reject("package", e["raw"]))

        def _box(self) -> dict | None:
            e = self.selected()
            return e["raw"] if e is not None and e["type"] == "box" else None

        async def _box_startstop(self) -> None:
            b = self._box()
            if b is None:
                return
            bid = b.get("id")
            if b.get("state") == "running":
                busy = (f" {b.get('inflight')} turn(s) are running in it and are cut off."
                        if b.get("inflight") else "")
                ok = await self._confirm(
                    f"Stop box {bid}?",
                    f"Powers the {b.get('kind')} box off; its overlay and data stay and it "
                    f"boots again on next use.{busy}")
                verb = "stop"
            else:
                ok = await self._confirm(
                    f"Start box {bid}?",
                    f"Boots it ({b.get('mem_mb') or '?'} MB, runtime "
                    f"{b.get('runtime') or 'kvm'}"
                    + (", less isolated than a VM" if b.get("runtime") == "docker" else "")
                    + "). Refused if it would pass the RAM or box budget.")
                verb = "start"
            if ok:
                await self._send("POST", f"/api/vm/boxes/{bid}/{verb}", f"{verb}: {bid}")

        async def _box_restart(self) -> None:
            b = self._box()
            if b is None:
                return
            bid = b.get("id")
            if b.get("state") != "running":
                self._note(f"[$warning]{_esc(bid)} is stopped: s starts it[/]")
                return
            busy = (f" {b.get('inflight')} turn(s) running in it are cut off."
                    if b.get("inflight") else "")
            fresh = "container" if b.get("runtime") == "docker" else "overlay"
            if await self._confirm(
                    f"Restart box {bid}?",
                    f"Stops it and boots it again from a fresh {fresh}: anything written "
                    f"inside it since it booted is gone. Project files live on the host and "
                    f"are not touched.{busy}"):
                await self._send("POST", f"/api/vm/boxes/{bid}/restart", f"restarted {bid}")

        async def _nuke(self) -> None:
            """BACKLOG "Nuke from /vms": x on the shared-box row."""
            b = self._box()
            if b is None:
                return
            if b.get("id") != "shared":
                self._note("[$warning]x nukes the shared box: d destroys a project box[/]")
                return
            if b.get("inflight"):
                n = b.get("inflight")
                self._note(f"[$warning]{n} turn{'s' * (n != 1)} in flight — wait for "
                           f"{'them' if n != 1 else 'it'} to finish before nuking[/]")
                return
            if not await self._confirm(
                    "Nuke the shared box?",
                    "Its overlay disk is discarded and it reboots fresh from the golden image."):
                return
            if await self._send("POST", "/api/vm/nuke", "nuked the shared box",
                                json={"confirm": True}):
                ver = str(self.last.get("image_version") or "?")
                self._note(f"[$success]nuked the shared box — fresh from main {_esc(ver)}[/]")

        async def _box_destroy(self) -> None:
            b = self._box()
            if b is None:
                return
            bid = b.get("id")
            if bid == "shared":
                q, detail = ("Stop the shared box?",
                             "The shared box cannot be destroyed; this stops it (x nukes it).")
            else:
                busy = (f" {b.get('inflight')} turn(s) running in it are cut off."
                        if b.get("inflight") else "")
                q = f"Destroy box {bid}?"
                detail = ("Stops it, releases its reservation and deletes its directory "
                          "(overlay, EFI vars, console log). Its data disk is kept unless "
                          f"you say so next.{busy}")
            if not await self._confirm(q, detail):
                return
            wipe = False
            if bid != "shared" and (b.get("disk") or {}).get("data_bytes"):
                wipe = bool(await self.app.push_screen_wait(Confirm(
                    f"Also delete {bid}'s data disk?",
                    "y deletes it for good; n (or esc or enter) keeps it.",
                    strict=True)))
            await self._send("POST", f"/api/vm/boxes/{bid}/destroy", f"destroyed {bid}",
                             json={"confirm": True, "delete_data": wipe})

        async def _clean(self) -> None:
            items = [i for i in _jlist(self.leftovers.get("items"))
                     if isinstance(i, dict) and i.get("cleanable")]
            if not items:
                self._note("[$text-muted]no leftovers to clean[/]")
                return
            names = ", ".join(str(i.get("name")) for i in items[:5])
            more = f" and {len(items) - 5} more" if len(items) > 5 else ""
            n = len(items)
            if not await self._confirm(
                    f"Clean {n} leftover{'s' * (n != 1)}?",
                    f"Removes {names}{more}. Only what this server identifies as its own "
                    "(Jav3's container label and its own box directories); each is checked "
                    "again first. Network interfaces are listed, never removed."):
                return
            if await self._send("POST", "/api/vm/leftovers/clean", "cleaned",
                                json={"confirm": True}):
                gone = _jlist(self.last.get("removed"))
                bad = [x for x in _jlist(self.last.get("failed")) if isinstance(x, dict)]
                self.leftovers = self.last.get("left") or self.leftovers
                self.entries["boxes"] = self.box_entries(
                    [e["raw"] for e in self.entries["boxes"] if e["type"] == "box"],
                    self.leftovers)
                await self.rebuild()
                self._note(f"[$success]cleaned {len(gone)} leftover{'s' * (len(gone) != 1)}[/]"
                           + "".join(f"  [$error]{_esc(str(x.get('id')))}: "
                                     f"{_esc(str(x.get('error')))}[/]" for x in bad))

        async def _build(self) -> None:
            e = self.selected()
            if e is None or e["type"] not in ("variant", "version"):
                return
            name = e["raw"].get("name") if e["type"] == "variant" else e["raw"].get("variant")
            if (self.vm.get("build") or {}).get("running"):
                self._fail("a build is already running")
                return
            if await self._confirm(
                    f"Build a new version of {name}?",
                    "Boots a builder box on the monitored path, replays the recipe (every "
                    "download goes through the proxy and is logged) and freezes a new "
                    "version. Minutes on the Pi; boxes switch to it at their next boot."):
                await self._send("POST", f"/api/vm/images/{name}/build",
                                 f"building {name}", json={"confirm": True})

        async def _image_log(self) -> None:
            """l: the whole build log of the selected variant (its running or
            newest finished build) or version, in a pane. Builder output is
            untrusted: shown as text."""
            e = self.selected()
            if e is None or e["type"] not in ("variant", "version"):
                return
            if e["type"] == "variant":
                name, ver = e["raw"].get("name"), None
            else:
                name, ver = e["raw"].get("variant"), e["raw"].get("version")
            r = await self._get("images", "build log", f"/api/vm/images/{name}/log", "",
                                quiet404=True, params={"version": ver} if ver else {})
            if r is None:
                self._note(f"[$text-muted]no build log for {_esc(str(name))}"
                           f"{' v' + _esc(str(ver)) if ver else ''}[/]")
                return
            state = ("running" + (f", {r.get('phase')}" if r.get("phase") else "")
                     if r.get("running") else "built" if r.get("ok") else "failed")
            lines = [str(x) for x in _jlist(r.get("lines"))]
            head = (f"[b]{_esc(str(name))} v{_esc(str(r.get('version') or '?'))}[/] "
                    f"[{'$warning' if r.get('running') else '$success' if r.get('ok') else '$error'}]"
                    f"{_esc(state)}[/]"
                    + (f"  [$error]{_esc(str(r['error']))}[/]" if r.get("error") else "")
                    + f"\n[$text-muted]{len(lines)} line{'s' * (len(lines) != 1)} · builder "
                    "output, untrusted: shown as text[/]")
            body = "\n".join(_esc(x) for x in lines) or "[$text-muted](empty)[/]"
            await self.app.push_screen_wait(View(f"Build log · {name}", f"{head}\n\n{body}"))

    class Palette(Provider):
        """Every slash command in ctrl+p."""

        async def discover(self):
            for name, cmd in self.app.unique_commands():
                yield DiscoveryHit(f"/{name}", self._runner(name), help=cmd.help)

        async def search(self, query: str):
            matcher = self.matcher(query)
            for name, cmd in self.app.unique_commands():
                score = matcher.match(f"/{name} {cmd.help}")
                if score > 0:
                    yield Hit(score, matcher.highlight(f"/{name}"), self._runner(name),
                              help=cmd.help)

        def _runner(self, name: str):
            return lambda: self.app.dispatch(f"/{name}")

