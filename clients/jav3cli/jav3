def _fmt_tokens(n: int | None) -> str:
    if not n:
        return "0"
    return f"{n / 1000:.1f}k" if n >= 10_000 else f"{n:,}"


class TurnState:
    """What one streaming turn has on screen so far."""

    def __init__(self) -> None:
        self.started = time.monotonic()
        self.cid: int | None = None       # from `start`; set even for a temporary chat
        self.model: str | None = None
        self.md = None                    # the Markdown widget text is streaming into
        self.stream = None
        self.seg = ""                     # that widget's text
        self.printed: list[str] = []      # finished text segments
        self.running: dict = {}           # tool id -> ToolView
        self.tools: list[dict] = []       # finished calls
        self.done = False                 # a final arrived (not an error)
        self.local = False                # this turn opened a new /local chat
        # the running status line and the ▣ footer
        self.ntools = 0                   # calls started
        self.agents = 0                   # sub-agents / teams / research started
        self.plans = 0                    # jobs announced (orchestrate)
        self.cost0: float | None = None   # the chat's cost when this view started watching
        self.cost: float | None = None    # spent since, from /info
        self.polled = self.started - 5    # first /info poll after ~5 s
        self.ended: float | None = None
        self.interrupted = False
        self.failed = False
        self.idle = False                 # attached, and nothing was running
        self.footer = None
        self.sent: str | None = None      # the message this turn answers (to find it again)
        self.seeded: list[dict] = []      # calls drawn before this view followed the turn
        # after a re-attach: calls drawn from the saved transcript that the live stream
        # may repeat for a moment, and the ids of the ones already matched
        self.synced: list[dict] = []
        self.skip: set = set()
        self.claim_until = 0.0

    def claim(self, ev: dict) -> bool:
        """True when this live tool event repeats a call the saved transcript already
        put on screen (the stream is opened before the transcript is read, so a call
        that ends in between shows up in both): drop it."""
        if time.monotonic() > self.claim_until:
            self.synced = []
            return False
        name, eid = ev.get("name"), ev.get("id")
        if ev.get("type") == "tool":
            for i, c in enumerate(self.synced):
                if c["name"] == name and c["args"] == (ev.get("args") or {}):
                    del self.synced[i]
                    self.skip.add(eid)
                    return True
        elif eid in self.skip:
            return True
        elif eid not in self.running:
            for i, c in enumerate(self.synced):
                if c["name"] == name:
                    del self.synced[i]
                    return True
        return False

    def count(self, name: str) -> None:
        self.ntools += 1
        if name in DELEGATION_TOOLS:
            self.agents += 1

    def stats(self, now: float | None = None) -> list[str]:
        """["2m 13s", "14 tools", "2 agents", "$0.02"]: what the status line
        says while the turn runs and the ▣ footer keeps after it."""
        end = self.ended if self.ended is not None else (now or time.monotonic())
        bits = [_elapsed(end - self.started)]
        if self.ntools:
            bits.append(_plural(self.ntools, "tool"))
        if self.agents:
            bits.append(_plural(self.agents, "agent"))
        if self.plans:
            bits.append(_plural(self.plans, "plan"))
        if self.cost is not None:
            bits.append(_fmt_cost(self.cost))
        return bits


def _subsequence_gaps(q: str, t: str) -> int | None:
    """Letters of q in order inside t: how many letters of t lie between the
    first and the last hit beyond q's own (None = not all found)."""
    pos, first = 0, None
    for ch in q:
        pos = t.find(ch, pos)
        if pos < 0:
            return None
        first = pos if first is None else first
        pos += 1
    return (pos - first) - len(q)


def picker_score(query: str, value, label: str = "", meta: str = "") -> int:
    """How closely a picker row matches what was typed; 0 = not at all. An
    exact name beats a prefix, beats a word that starts with it, beats a
    substring (earlier is better), beats its letters in order (tighter is
    better), beats a hit in the row's detail text only."""
    import re
    q = (query or "").strip().lower()
    if not q:
        return 1
    best = 0
    for text in (label or "", str(value or "")):
        t = text.lower()
        if not t:
            continue
        if t == q:
            sc = 1000
        elif t.startswith(q):
            sc = 900 - min(len(t) - len(q), 99)
        elif any(w.startswith(q) for w in re.split(r"[\s/_.:\-]+", t)):
            sc = 800 - min(len(t), 99)
        elif q in t:
            sc = 700 - min(t.index(q), 99)
        else:
            gaps = _subsequence_gaps(q, t)
            sc = 0 if gaps is None else 400 - min(gaps, 99)
        best = max(best, sc)
    if not best and q in (meta or "").lower():
        best = 200
    return best


class Command:
    def __init__(self, fn, help: str, usage: str = "", busy_ok: bool = False,
                 takes_arg: bool = False, leader: str = "", page: str = ""):
        self.fn, self.help, self.usage = fn, help, usage
        self.busy_ok, self.takes_arg, self.leader = busy_ok, takes_arg, leader
        self.page = page              # the registry name when this command opens a page


# --- pages: the registry behind `/page [args] [panel]` ---------------------------------------
#
# jav3.2 turns the terminal client into the web app, keyboard-first: a slash command
# that names a PAGE opens it in the area above the one prompt line (a widget mounted
# in a PageHost, with a back stack: esc returns to the page before, the chat by
# default). A page is a registry entry (below) and, for the ones the terminal has, a
# `Page` widget class inside build_tui. The line is parsed once, in
# `Jav3App.run_command`: the arguments the page gets, and a trailing `panel` that asks
# for a new panel instead of replacing the view (panels arrive in the next step; for
# now it opens in place and says so).

