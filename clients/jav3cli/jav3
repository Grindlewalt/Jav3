def help_view(keys: list[tuple[str, str]], cmds: list[tuple[str, str, str]]):
    """/help as (a Rich renderable, its plain text). The keys come first, they are
    what a new user needs; each command is two lines, its usage with the leader key
    at the right edge and its description under it, so nothing is squeezed into a
    narrow column and a `<path>` in a usage is only text."""
    from rich.console import Group
    from rich.table import Table
    from rich.text import Text

    kt = Table.grid(padding=(0, 2), expand=True)
    kt.add_column(no_wrap=True, max_width=24, style="bold")
    kt.add_column(ratio=1)
    for k, v in keys:
        kt.add_row(Text(k), Text(v))
    ct = Table.grid(expand=True)
    ct.add_column(ratio=1)
    ct.add_column(justify="right", no_wrap=True, style="dim")
    for usage, help_, lead in cmds:
        ct.add_row(Text(usage, style="bold"), Text(lead))
        ct.add_row(Text("  " + help_, style="dim"), "")
    view = Group(Text("Keys", style="bold underline"), Text(""), kt, Text(""),
                 Text("Commands", style="bold underline"), Text(""), ct)
    plain = ["Keys", ""] + [f"{k}  {v}" for k, v in keys] + ["", "Commands", ""]
    for usage, help_, lead in cmds:
        plain += [f"{usage}  {lead}".rstrip(), f"  {help_}"]
    return view, "\n".join(plain)


def ask_view(ev: dict, question: str) -> tuple[str, str]:
    """(headline, detail markup) for an ask. A permission ask's headline already
    names the command or the path and its detail repeats it, so each is said once:
    `Run in the VM` over the command, `Write a.txt` over what goes into it, the
    old and new text of an edit in red and green."""
    detail = str(ev.get("detail") or "").strip("\n")
    if not detail:
        return question, ""
    cut = len(detail) > 2000
    lines = detail[:2000].splitlines()
    tool = ev.get("tool") if ev.get("kind") == "permission" else None
    head, contents = question, False
    if tool == "run_code" and question.startswith("Run in the VM: "):
        cmd = question[len("Run in the VM: "):].rstrip("…").strip()
        if " ".join(detail.split()).startswith(cmd):
            head = "Run in the VM"
    elif tool in ("write_file", "edit_file"):
        path = question.split(" ", 1)[1] if " " in question else ""
        if path and lines[0].strip() == path:
            lines, contents = lines[1:], tool == "write_file"
    out = ["[$text-muted]contents[/]"] if contents else []
    if contents and not lines:
        lines = ["(empty file)"]
    for ln in lines:
        if tool == "edit_file" and ln.startswith("- "):
            out.append(f"[$error]{_esc(ln)}[/]")
        elif tool == "edit_file" and ln.startswith("+ "):
            out.append(f"[$success]{_esc(ln)}[/]")
        else:
            out.append(f"[$text-muted]{_esc(ln)}[/]")
    if cut:
        out.append("[$text-muted]…[/]")
    return head, "\n".join(out)


# --- /local: the agent's file and shell tools, run on this machine ----------------------
#
# `/local` makes the next new chat a local session: the model still runs through
# the server (which keeps the key), but its local_* tools come back to THIS client
# as `local_tool` events on the turn's stream, run here in the directory `jav3`
# was launched from, and are answered with POST /api/chat/<id>/local_result.
# Reads inside that directory run at once; a read, list or search outside it, and
# writes, edits and shell commands, ask the operator first (y once, a for the rest
# of the session, or for that folder; n no), and keys, tokens and the client's own
# login are refused outright (LOCAL_DENY_*). Everything the server sends is a
# request, never a command: arguments are checked here, errors come back as text,
# and nothing runs without the approval callback saying so.

LOCAL_OUT_CAP = 100_000            # chars of any one result sent back (server caps too)
LOCAL_READ_MAX = 20 * 1024 * 1024  # bytes: a file bigger than this is not read whole
LOCAL_SHELL_DEFAULT = 120
LOCAL_SHELL_MAX = 600              # the server gives up on a call after 15 minutes
LOCAL_LIST_MAX = 1000
LOCAL_SEARCH_MAX = 200
LOCAL_SEARCH_FILE_MAX = 2 * 1024 * 1024
LOCAL_DIFF_LINES = 400
LOCAL_SKIP_DIRS = frozenset({".git", ".hg", ".svn", "node_modules", "__pycache__",
                             ".venv", "venv", ".tox", ".mypy_cache", ".pytest_cache",
                             ".ruff_cache", ".next", ".cache", "dist", "build",
                             ".idea", ".DS_Store"})


# Places a local tool never reads, lists, searches or writes, whatever the operator
# answers: keys, tokens, browser profiles, this client's own login. Under the home
# directory, and a few absolute paths. `.env` files outside the working directory too.
LOCAL_DENY_HOME = (".ssh", ".gnupg", ".aws", ".azure", ".kube", ".config/jav3", ".config/gcloud",
                   ".config/gh", ".docker/config.json", ".netrc", ".npmrc", ".pypirc",
                   ".git-credentials", ".password-store", ".mozilla", ".config/google-chrome",
                   ".config/chromium", ".config/BraveSoftware", "Library/Keychains",
                   "Library/Cookies", "Library/Application Support/Google/Chrome",
                   "Library/Application Support/Firefox",
                   "Library/Application Support/BraveSoftware",
                   "Library/Application Support/Microsoft Edge")
LOCAL_DENY_ABS = ("/etc/shadow", "/etc/gshadow", "/etc/sudoers", "/etc/sudoers.d", "/etc/ssh")
LOCAL_ENV_SAMPLES = (".example", ".sample", ".template", ".dist")


class LocalError(Exception):
    """A refusal or failure, returned to the model as the tool's error text."""


def local_spec(cwd: str | os.PathLike | None = None) -> dict:
    """Where this client runs — the `local` object a new /local chat is opened
    with. The server puts it in the model's system prompt."""
    shell = os.environ.get("SHELL") or ("cmd" if os.name == "nt" else "/bin/sh")
    osname = platform.system() or os.name
    if platform.release():
        osname += f" {platform.release()}"
    return {"cwd": str(Path(cwd or os.getcwd()).resolve()),
            "hostname": socket.gethostname() or "localhost",
            "os": osname, "shell": shell}


class LocalExecutor:
    """The six local_* tools against one working directory.

    `approve(kind, summary)` is asked before every write ("write"), edit
    ("edit") and command ("shell") and returns "yes", "always" (this kind, for
    the rest of this executor's life) or "no"; it may be a coroutine function.
    With no callback nothing that changes anything runs. Reads inside the working
    directory never ask; a read, list or search outside it asks too ("read"; `a`
    remembers that folder, not every folder), and a short list of secret places
    (LOCAL_DENY_*) is refused outright."""

    def __init__(self, cwd, approve=None, shell: str | None = None):
        self.cwd = Path(cwd).expanduser().resolve()
        self.approve = approve
        self.shell = shell or os.environ.get("SHELL") or "/bin/sh"
        self.always: set[str] = set()
        self.read_ok: list[tuple[Path, bool]] = []     # (folder, everything beneath it)
        home = Path.home()
        self._deny = [(home / rel).resolve() for rel in LOCAL_DENY_HOME]
        self._deny += [Path(a).resolve() for a in LOCAL_DENY_ABS]
        with contextlib.suppress(OSError, RuntimeError):
            self._deny.append(config_dir().resolve())

    async def run(self, name: str, args) -> tuple[bool, str]:
        fn = {"local_read_file": self.read_file, "local_write_file": self.write_file,
              "local_edit_file": self.edit_file, "local_list_files": self.list_files,
              "local_search": self.search, "local_shell": self.shell_run}.get(name)
        if fn is None:
            return False, f"unknown local tool {name!r}"
        if not isinstance(args, dict):
            return False, "arguments must be an object"
        try:
            out = await fn(**args)
        except TypeError as e:
            return False, f"bad arguments for {name}: {e}"
        except LocalError as e:
            return False, str(e)
        except (OSError, ValueError, UnicodeError) as e:
            return False, f"{type(e).__name__}: {e}"
        if len(out) > LOCAL_OUT_CAP:
            out = out[:LOCAL_OUT_CAP] + f"\n…(cut at {LOCAL_OUT_CAP} characters)"
        return True, out

    # -- helpers -----------------------------------------------------------------------

    def _path(self, p) -> Path:
        if not isinstance(p, str) or not p.strip() or "\x00" in p:
            raise LocalError("path must be a non-empty string")
        q = Path(p.strip()).expanduser()
        return (q if q.is_absolute() else self.cwd / q).resolve()

    def _show(self, path: Path) -> str:
        try:
            return str(path.relative_to(self.cwd))
        except ValueError:
            return str(path)

    def _where(self, path: Path) -> str:
        rel = self._show(path)
        return rel if rel != str(path) else f"{path}  (outside {self.cwd})"

    def _inside(self, p: Path) -> bool:
        return p == self.cwd or self.cwd in p.parents

    def _denied(self, p: Path) -> str | None:
        """Why no local tool may touch p, or None."""
        for d in self._deny:
            if p == d or d in p.parents:
                return (f"{self._show(p)} is one of the places this client never lets an "
                        "agent touch (keys, tokens, browser profiles, its own login); "
                        "the operator can open it themselves.")
        name = p.name
        if (name == ".env" or name.startswith(".env.")) and not name.endswith(LOCAL_ENV_SAMPLES) \
                and not self._inside(p):
            return (f"{self._show(p)} is a .env file outside {self.cwd}; agents do not "
                    "read those here.")
        return None

    def _refuse_denied(self, p: Path) -> None:
        why = self._denied(p)
        if why:
            raise LocalError(why)

    async def _ask(self, kind: str, summary: str, outside: bool = False) -> None:
        # outside the working directory "always" does not carry: each write there asks
        if kind in self.always and not outside:
            return
        if self.approve is None:
            raise LocalError(f"not approved: no one is here to approve a {kind}")
        ans = self.approve(kind, summary)
        if asyncio.iscoroutine(ans) or isinstance(ans, asyncio.Future):
            ans = await ans
        if ans == "always":
            self.always.add(kind)
        elif ans != "yes":
            raise LocalError(f"the operator did not approve this {kind}. Do not retry "
                             "it; say what you wanted to do and ask.")

    async def _may_read(self, p: Path, what: str, tree: bool) -> None:
        """Refuse the secret places; ask about anything outside the working
        directory (`tree`: it covers everything beneath p, as a listing or a
        search does). `always` remembers the folder, not every folder."""
        self._refuse_denied(p)
        if self._inside(p):
            return
        base = p if tree else p.parent
        for d, deep in self.read_ok:
            if (p == d or d in p.parents) if deep else (p.parent == d or p == d):
                return
        if self.approve is None:
            raise LocalError("not approved: no one is here to approve a read outside "
                             f"{self.cwd}")
        summary = (f"{what}\n(outside {self.cwd})\n"
                   f"folder: {base}" + ("  and everything beneath it" if tree else ""))
        ans = self.approve("read", summary)
        if asyncio.iscoroutine(ans) or isinstance(ans, asyncio.Future):
            ans = await ans
        if ans == "always":
            self.read_ok.append((base, tree))
        elif ans != "yes":
            raise LocalError("the operator did not approve this read outside the working "
                             "directory. Do not retry it; say what you wanted to look at "
                             "and ask.")

    @staticmethod
    def _read_text(path: Path) -> str:
        if not path.exists():
            raise LocalError(f"no such file: {path}")
        if path.is_dir():
            raise LocalError(f"{path} is a directory — use local_list_files")
        if path.stat().st_size > LOCAL_READ_MAX:
            raise LocalError(f"{path} is over {LOCAL_READ_MAX // (1024 * 1024)} MB")
        data = path.read_bytes()
        if b"\x00" in data[:8192]:
            raise LocalError(f"{path} looks binary; not reading it as text")
        return data.decode("utf-8", "replace")

    def _diff(self, path: Path, old: str, new: str) -> str:
        import difflib
        rel = self._show(path)
        lines = list(difflib.unified_diff(old.splitlines(), new.splitlines(),
                                          f"a/{rel}", f"b/{rel}", lineterm="", n=3))
        if len(lines) > LOCAL_DIFF_LINES:
            more = len(lines) - LOCAL_DIFF_LINES
            lines = lines[:LOCAL_DIFF_LINES] + [f"… {more} more diff lines"]
        return "\n".join(lines) or "(no change)"

    # -- the tools -------------------------------------------------------------------

    async def read_file(self, path, offset=1, limit=2000) -> str:
        p = self._path(path)
        await self._may_read(p, f"read {p}", False)
        text = await asyncio.to_thread(self._read_text, p)
        lines = text.splitlines()
        start = max(1, int(offset or 1))
        count = max(1, min(int(limit or 2000), 5000))
        chunk = lines[start - 1:start - 1 + count]
        if not chunk:
            return f"(no lines at {start}: the file has {len(lines)})" if lines else "(empty file)"
        body = "\n".join(f"{i:>6}\t{ln}" for i, ln in enumerate(chunk, start))
        end = start + len(chunk) - 1
        if end < len(lines):
            body += f"\n… lines {start}-{end} of {len(lines)}; pass offset={end + 1} for more"
        return body

    async def write_file(self, path, content) -> str:
        if not isinstance(content, str):
            raise LocalError("content must be a string")
        p = self._path(path)
        self._refuse_denied(p)
        if p.is_dir():
            raise LocalError(f"{p} is a directory")
        old = await asyncio.to_thread(self._read_text, p) if p.exists() else None
        if old is None:
            n = content.count("\n") + (0 if content.endswith("\n") or not content else 1)
            summary = (f"new file {self._where(p)} ({n} lines)\n"
                       + self._diff(p, "", content))
        else:
            summary = f"overwrite {self._where(p)}\n" + self._diff(p, old, content)
        await self._ask("write", summary, outside=not self._inside(p))
        p.parent.mkdir(parents=True, exist_ok=True)
        await asyncio.to_thread(p.write_text, content, encoding="utf-8")
        verb = "created" if old is None else "wrote"
        return f"{verb} {self._show(p)} ({len(content.encode())} bytes)"

    async def edit_file(self, path, find, replace, all=False) -> str:  # noqa: A002
        if not isinstance(find, str) or not find:
            raise LocalError("find must be non-empty text")
        if not isinstance(replace, str):
            raise LocalError("replace must be a string")
        p = self._path(path)
        self._refuse_denied(p)
        old = await asyncio.to_thread(self._read_text, p)
        n = old.count(find)
        if n == 0:
            raise LocalError(f"find text not found in {self._show(p)} — read the file and "
                             "copy the exact text, whitespace included")
        if n > 1 and not all:
            raise LocalError(f"find text occurs {n} times in {self._show(p)}; add context "
                             "so it is unique, or pass all: true")
        new = old.replace(find, replace) if all else old.replace(find, replace, 1)
        await self._ask("edit", f"edit {self._where(p)}\n" + self._diff(p, old, new),
                        outside=not self._inside(p))
        await asyncio.to_thread(p.write_text, new, encoding="utf-8")
        return f"edited {self._show(p)} ({n if all else 1} replacement{'s' if all and n > 1 else ''})"

    def _walk(self, root: Path, depth: int) -> list[str]:
        out: list[str] = []

        def rec(d: Path, level: int) -> None:
            try:
                kids = sorted(d.iterdir(), key=lambda x: (not x.is_dir(), x.name.lower()))
            except OSError as e:
                out.append(f"{'  ' * level}({e.strerror or e})")
                return
            for k in kids:
                if len(out) >= LOCAL_LIST_MAX:
                    return
                if k.name in LOCAL_SKIP_DIRS or self._denied(k):
                    continue
                isdir = k.is_dir() and not k.is_symlink()
                out.append(f"{'  ' * level}{k.name}{'/' if isdir else ''}")
                if isdir and level + 1 < depth:
                    rec(k, level + 1)
        rec(root, 0)
        return out

    async def list_files(self, path=".", depth=2) -> str:
        p = self._path(path or ".")
        await self._may_read(p, f"list {p}", True)
        if not p.is_dir():
            raise LocalError(f"not a directory: {p}")
        depth = max(1, min(int(depth or 2), 6))
        rows = await asyncio.to_thread(self._walk, p, depth)
        head = f"{p}/"
        if not rows:
            return head + "\n(empty)"
        tail = (f"\n… stopped at {LOCAL_LIST_MAX} entries; list a subdirectory"
                if len(rows) >= LOCAL_LIST_MAX else "")
        return head + "\n" + "\n".join(rows) + tail

    def _grep(self, root: Path, pat) -> list[str]:
        hits: list[str] = []
        files = [root] if root.is_file() else None

        def each():
            if files is not None:
                yield from files
                return
            for dirpath, dirnames, filenames in os.walk(root):
                dirnames[:] = sorted(d for d in dirnames if d not in LOCAL_SKIP_DIRS
                                     and not self._denied(Path(dirpath) / d))
                for f in sorted(filenames):
                    if not self._denied(Path(dirpath) / f):
                        yield Path(dirpath) / f

        for f in each():
            try:
                if f.is_symlink() or f.stat().st_size > LOCAL_SEARCH_FILE_MAX:
                    continue
                data = f.read_bytes()
            except OSError:
                continue
            if b"\x00" in data[:8192]:
                continue
            for i, line in enumerate(data.decode("utf-8", "replace").splitlines(), 1):
                if pat(line):
                    hits.append(f"{self._show(f)}:{i}: {line.strip()[:300]}")
                    if len(hits) >= LOCAL_SEARCH_MAX:
                        return hits
        return hits

    async def search(self, query, path=".", regex=False) -> str:
        import re
        if not isinstance(query, str) or not query:
            raise LocalError("query must be non-empty text")
        p = self._path(path or ".")
        await self._may_read(p, f"search {p} for {query!r}", True)
        if not p.exists():
            raise LocalError(f"no such path: {p}")
        if regex:
            try:
                rx = re.compile(query)
            except re.error as e:
                raise LocalError(f"bad regular expression: {e}")
            pat = lambda s: rx.search(s) is not None   # noqa: E731
        else:
            q = query.lower()
            pat = lambda s: q in s.lower()             # noqa: E731
        hits = await asyncio.to_thread(self._grep, p, pat)
        if not hits:
            return f"no matches for {query!r} in {self._show(p) if p != self.cwd else '.'}"
        more = (f"\n… stopped at {LOCAL_SEARCH_MAX} matches; narrow the query or path"
                if len(hits) >= LOCAL_SEARCH_MAX else "")
        return "\n".join(hits) + more

    async def shell_run(self, command, timeout_seconds=LOCAL_SHELL_DEFAULT) -> str:
        if not isinstance(command, str) or not command.strip():
            raise LocalError("command must be non-empty text")
        try:
            timeout = max(1, min(int(timeout_seconds or LOCAL_SHELL_DEFAULT), LOCAL_SHELL_MAX))
        except (TypeError, ValueError):
            timeout = LOCAL_SHELL_DEFAULT
        await self._ask("shell", f"$ {command}\n\n(in {self.cwd}, timeout {timeout}s)")
        if os.name == "nt":
            argv = ["cmd", "/c", command]
            extra = {}
        else:
            argv = [self.shell, "-lc", command]
            extra = {"start_new_session": True}    # so a timeout kills the whole tree
        proc = await asyncio.create_subprocess_exec(
            *argv, cwd=str(self.cwd), stdin=asyncio.subprocess.DEVNULL,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT, **extra)
        try:
            out, _ = await asyncio.wait_for(proc.communicate(), timeout)
        except asyncio.TimeoutError:
            self._kill(proc)
            with contextlib.suppress(Exception):
                await asyncio.wait_for(proc.wait(), 5)
            raise LocalError(f"timed out after {timeout}s (killed)")
        except asyncio.CancelledError:
            self._kill(proc)
            raise
        text = out.decode("utf-8", "replace")
        if len(text) > LOCAL_OUT_CAP - 200:
            keep = LOCAL_OUT_CAP - 200
            text = f"…(first {len(text) - keep} characters cut)\n" + text[-keep:]
        return f"exit {proc.returncode}\n{text}".rstrip()

    @staticmethod
    def _kill(proc) -> None:
        import signal
        with contextlib.suppress(ProcessLookupError, PermissionError, OSError):
            if os.name != "nt":
                os.killpg(proc.pid, signal.SIGKILL)
            else:
                proc.kill()


# -- Security > Calls: how the model key is used (pure markup, no Textual) -------------
#
# Rows come from GET /api/logs/calls: {"kind": "call", ...} for a model call the
# host made and {"kind": "refused", ...} for a request the gateway turned away.
# The SecurityScreen wraps these; they live here so tests can call them.

_REFUSED_WHY = {
    "unknown_op_id": "The op_id is not a turn the host registered for this caller (it is "
                     "unknown, or its token did not match). The gateway answered "
                     "unknown_op_id and nothing reached the provider.",
    "wrong_box": "The op_id belongs to a turn running in a different box. The gateway "
                 "answered unknown_op_id and nothing reached the provider.",
    "budget_exceeded": "The turn's token budget was already spent. The gateway refused "
                       "before contacting the provider.",
    "op_not_allowed": "This kind of box may not use that gateway op.",
    "unknown_op": "The guest asked for a gateway op that does not exist.",
    "no_package": "There is no guest package for this kind of box.",
}


def local_ts(v, full: bool = False) -> str:
    """The server's UTC times ('YYYY-MM-DD HH:MM:SS', ISO with a T, or epoch
    seconds) in THIS machine's time zone: 'MM-DD HH:MM', or the whole
    'YYYY-MM-DD HH:MM:SS' when `full`. '' when unreadable."""
    try:
        if isinstance(v, (int, float)):
            t = float(v)
        else:
            import calendar
            s = str(v).strip().replace("T", " ")[:19]
            t = calendar.timegm(time.strptime(s, "%Y-%m-%d %H:%M:%S"))
        return time.strftime("%Y-%m-%d %H:%M:%S" if full else "%m-%d %H:%M",
                             time.localtime(t))
    except (TypeError, ValueError, OverflowError, OSError):
        return ""


def collapse_errors(errs: list[str]) -> list[str]:
    """Per-endpoint load errors ('projects: could not reach ...', 'egress: could not
    reach ...') as one line per distinct cause, naming the endpoints that shared it."""
    causes: dict[str, list[str]] = {}
    for e in errs:
        what, sep, why = e.partition(": ")
        causes.setdefault(why if sep else e, []).append(what if sep else "")
    out = []
    for why, whats in causes.items():
        whats = [w for w in whats if w]
        out.append(why + (f" ({', '.join(whats)})" if len(whats) > 1 else "")
                   if len(whats) != 1 else f"{whats[0]}: {why}")
    return out


def row_ts(v) -> str:
    """A row's short local time; a text that is not a time is cut the old way."""
    return local_ts(v) or str(v or "")[5:16]


def full_ts(v) -> str:
    """A detail line's whole local time ('' stays '', an unreadable text is kept)."""
    return local_ts(v, True) or str(v or "")


def tz_label() -> str:
    """This machine's zone name for a footer ('PDT', or 'UTC' at offset 0)."""
    off = time.localtime().tm_gmtoff or 0
    return "UTC" if off == 0 else (time.strftime("%Z") or f"UTC{off // 3600:+d}")


def calls_tok(n) -> str:
    """Token counts in the row's short form: 812, 12.4k, 1.2M."""
    try:
        n = float(n or 0)
    except (TypeError, ValueError):
        return "?"
    if n < 1000:
        return f"{n:.0f}"
    if n < 1_000_000:
        return f"{n / 1000:.1f}k"
    return f"{n / 1_000_000:.1f}M"


def calls_usd(c, places: int = 4) -> str:
    try:
        c = float(c or 0)
    except (TypeError, ValueError):
        return "$?"
    if places == 2 and 0 < c < 0.01:      # a total too small for cents keeps its digits
        places = 4
    return f"${c:.2f}" if c >= 1 else f"${c:.{places}f}"


def calls_model(m) -> str:
    """The ledgered `provider/model`, with DeepSeek's own prefix dropped."""
    m = str(m or "?")
    return m[len("deepseek/"):] if m.startswith("deepseek/") else m


def calls_row(e: dict, compact: bool = False) -> str:
    """One Calls list row (spec: BACKLOG.md 'TUI: make the security story visible').
    Compact (a terminal under 100 columns) leaves out the op and the project, which
    the pane under the list has, so the tokens, cache and cost are not cut off."""
    r, ts = e["raw"], row_ts(e.get("ts"))
    if e["type"] == "refusal":
        return (f"[$error]●[/] [$text-muted]{ts}[/] [$error b]REFU[/] "
                f"{_esc(r.get('op_name') or '?')} {_esc(r.get('reason') or '?')} "
                f"[$text-muted]from box {_esc(r.get('box_id') or '-')}[/]")
    meta = []
    if r.get("op_id") and not compact:
        meta.append(f"op {_esc(_short(r['op_id'], 16))}")
    if r.get("project_slug") and not compact:
        meta.append(f"⌂ {_esc(r['project_slug'])}")
    if r.get("conversation_id") is not None:
        meta.append(f"#{r['conversation_id']}")
    model = calls_model(r.get("model"))
    return (f"[$primary]●[/] [$text-muted]{ts}[/] [$primary b]CALL[/] "
            f"{_esc(_short(model, 22) if compact else model)}"
            + (f" [$text-muted]{' '.join(meta)}[/]" if meta else "")
            + f" ↑{calls_tok(r.get('input_tokens'))} ↓{calls_tok(r.get('output_tokens'))} "
              f"[$text-muted]cache {calls_tok(r.get('cache_hit'))}[/] "
              f"{calls_usd(r.get('cost_usd'))}")


def calls_detail(e: dict) -> str:
    """The pane under the list for the selected row."""
    r = e["raw"]
    if e["type"] == "refusal":
        why = _REFUSED_WHY.get(r.get("reason") or "", "")
        return "\n".join([
            f"[$error b]REFUSED[/] [b]{_esc(r.get('op_name') or '?')}[/] · "
            f"{_esc(r.get('reason') or '?')}",
            f"[$text-muted]from box {_esc(r.get('box_id') or 'unknown')}"
            + (f" · ⌂ {_esc(r['project_slug'])}" if r.get("project_slug") else "")
            + f" · {_esc(full_ts(r.get('ts')))}[/]",
            *([_esc(why)] if why else [])])
    who = [f"op {_esc(r.get('op_id') or '-')}"]
    who.append(f"conversation #{r['conversation_id']}" if r.get("conversation_id") is not None
               else "no conversation")
    who += [f"box {_esc(r.get('box_id') or '-')}", _esc(calls_model(r.get("model")))]
    numbers = (f"{int(r.get('input_tokens') or 0):,} in ({int(r.get('cache_hit') or 0):,} "
               f"cached) · {int(r.get('output_tokens') or 0):,} out · "
               f"{calls_usd(r.get('cost_usd'))} · "
               + ("context stored" if r.get("has_context") else "context not stored"))
    keys = ("[$primary]enter[/] view context" if r.get("has_context")
            else "[$text-muted]enter: no context stored for this call[/]")
    return "\n".join([
        " · ".join(who), numbers,
        f"[$text-muted]{_esc(full_ts(r.get('ts')))}"
        + (f" · ⌂ {_esc(r['project_slug'])}" if r.get("project_slug") else "") + "[/]",
        f"{keys}   [$primary]c[/] this conversation only"])


def calls_sub(meta: dict, only: int | None = None) -> str:
    """The Calls header: where the key goes, then the window's totals."""
    if not meta:                      # not loaded yet: say only what is always true
        return "[$text-muted]key held by the host gateway · the guest never sees it[/]"
    hosts = [str(h) for h in (meta or {}).get("key_hosts") or []]
    sent =(f"sent only to {_esc(', '.join(hosts))}" if hosts
            else "no model key is set, so nothing is sent")
    t = (meta or {}).get("totals") or {}
    hrs = int((meta or {}).get("hours") or 24)
    span = f"last {hrs}h"
    if only is not None:
        totals = f"conversation #{only}, {span}: {int(t.get('calls') or 0)} calls"
    else:
        n = int(t.get("refused") or 0)
        totals = f"{span}: {int(t.get('calls') or 0)} calls"
    totals += f" · {calls_usd(t.get('cost_usd'), 2)}"
    if only is None:
        totals += (f" · [$error]{n} refused[/]" if n else " · 0 refused")
    trunc = (" [$text-muted](newest rows shown)[/]" if (meta or {}).get("truncated") else "")
    return (f"[$text-muted]key held by the host gateway · {sent} · the guest never "
            f"sees it[/]\n{totals}{trunc}")


def calls_context_markup(payload: dict, cap: int = 6000, total: int = 120_000) -> str:
    """A captured call's message array for the View dialog: role, then the text,
    each message and the whole cut to a size a terminal can hold."""
    msgs = payload.get("messages") or []
    head = (f"{int(payload.get('input_tokens') or 0):,} in "
            f"({int(payload.get('cache_hit') or 0):,} cached) · {len(msgs)} messages · "
            f"{int(payload.get('n_tools') or 0)} tools offered")
    out, used = [f"[$text-muted]{_esc(head)}[/]"], 0
    for i, m in enumerate(msgs):
        c = m.get("content")
        if isinstance(c, list):
            c = "\n".join(str(p.get("text") if isinstance(p, dict) and p.get("type") == "text"
                              else f"[{p.get('type') if isinstance(p, dict) else 'part'}]")
                          for p in c)
        text = str(c or "")
        for tc in m.get("tool_calls") or []:
            fn = tc.get("function") or {}
            text += f"\n→ {fn.get('name')}({fn.get('arguments')})"
        if len(text) > cap:
            text = text[:cap] + f"\n… {len(text) - cap:,} more characters"
        if used + len(text) > total:
            out.append(f"[$text-muted]… {len(msgs) - i} more messages not shown[/]")
            break
        used += len(text)
        out.append(f"\n[$primary b]{_esc(str(m.get('role') or '?'))}[/]\n{_esc(text)}")
    return "\n".join(out)


def build_tui(base: str, token: str, **kw):
    """Define the Textual app (imported only when the TUI actually runs, so the
    plain commands work without Textual) and return an instance."""
    from textual import on
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.command import DiscoveryHit, Hit, Provider
    from textual.containers import Horizontal, Vertical, VerticalScroll
    from textual.message import Message
    from textual.screen import ModalScreen
    from textual.theme import Theme
    from textual.widgets import Button, Input, Markdown, OptionList, Static, TextArea
    from textual.widgets._markdown import MarkdownFence
    from textual.widgets.option_list import Option

    # Boxes (docs/boxes-contract.md). Emphasis is a solid theme colour behind
    # the text: Terminal.app has 256 colours and turns a blend into grey, so
    # "red" here is a red block.
    RED = "[b $background on $error]"         # unexpected process, byte mismatch
    AMBER = "[b $background on $warning]"     # docker: less isolated than a VM
    PLACEMENTS = ("per_service", "per_project", "shared")
    PLACEMENT_SAYS = {
        "per_service": "its own service box (strongest; one box per service)",
        "per_project": "the project's service box, beside the project's other services",
        "shared": "the one shared service box, beside other projects' services",
    }
    RUNTIMES = ("kvm", "docker")
    IMAGE_BUILD = "__image_build__"   # builder boxes' pseudo-project: fixed policy

    # -- widgets ------------------------------------------------------------------------

    class Note(Static):
        """A one-off line in the transcript: info, a warning, an error."""

    class UserMsg(Static):
        pass

    class QueuedMsg(UserMsg):
        """A message typed while a turn runs, posted to /api/chat/{cid}/message:
        dimmed until the stream's operator_message says the agent has it."""

        def __init__(self, text: str, sent: str) -> None:
            super().__init__(self._markup(text, "queued — delivered at the next step"),
                             classes="pending")
            self.text, self.sent = text, sent

        @staticmethod
        def _markup(text: str, tag: str, colour: str = "$text-muted") -> str:
            return f"{_esc(text)}\n[{colour}]{_esc(tag)}[/]"

        def deliver(self) -> None:
            self.remove_class("pending")
            self.update(self._markup(self.text, "↳ delivered mid-turn"))

        def fail(self, why: str) -> None:
            self.remove_class("pending")
            self.add_class("failed")
            self.update(self._markup(self.text, why, "$error"))

    class WrapFence(MarkdownFence):
        """Textual's code fence scrolls sideways with its scrollbars hidden, so
        the rest of a long line was out of reach (TUI-17): this one wraps."""

        DEFAULT_CSS = """
        WrapFence { overflow-x: hidden; }
        WrapFence > #code-content { width: 1fr; }
        """

    class Reply(Markdown):
        BLOCKS = {**Markdown.BLOCKS, "fence": WrapFence, "code_block": WrapFence}

    class Footer(Static):
        pass

    class Home(Vertical):
        def compose(self) -> ComposeResult:
            yield Static(logo_markup(), id="logo")
            yield Static("", id="home-hints")

    class ToolView(Vertical):
        """One tool call on one line: state, title, what came back, how long.
        Open (enter on the picked row, a click, ctrl+o for all) it shows the
        diff, the output or the error, clipped to EXPANDED_LINES; → then shows
        everything in a dialog."""

        DEFAULT_CSS = """
        ToolView { height: auto; padding-left: 2; }
        ToolView #row { height: 1; }
        ToolView #head { width: 1fr; height: 1; text-wrap: nowrap; text-overflow: ellipsis; }
        ToolView #dur { width: auto; height: 1; padding: 0 0 0 2; color: $text-muted; }
        ToolView #body { display: none; }
        ToolView.block { margin: 1 0; }
        ToolView.block #body { border-left: solid $panel-lighten-2; padding: 0 1; margin-left: 1;
                               text-wrap: nowrap; text-overflow: ellipsis; }
        ToolView.-picked #row { background: $panel; }
        ToolView.-picked #head { text-style: bold; }
        """

        def __init__(self, name: str, args, *, ok: bool | None = None,
                     result: str | None = None, done: bool = False):
            super().__init__()
            self.tname, self.args, self.ok, self.result = name, args or {}, ok, result
            self.done, self.expanded, self.t0 = done, False, time.monotonic()
            self.t1: float | None = None      # finished (None for a row from history)
            self.interrupted, self.why = False, "interrupted"
            self.more = 0                     # body lines left out when open
            self._shown: tuple = ()           # what the widgets last got
            # held here, not queried: a result can land before the row's own
            # children are mounted (they mount after the row itself)
            self._head, self._dur = Static(id="head"), Static(id="dur")
            self._body = Static(id="body")

        def compose(self) -> ComposeResult:
            with Horizontal(id="row"):
                yield self._head
                yield self._dur
            yield self._body

        def on_mount(self) -> None:
            if not self.done:
                self.app.__dict__.setdefault("live_tools", set()).add(self)
            self.redraw()

        def on_unmount(self) -> None:
            self.app.__dict__.get("live_tools", set()).discard(self)

        def _ended(self) -> None:
            self.t1 = time.monotonic()
            self.app.__dict__.get("live_tools", set()).discard(self)

        def finish(self, ok: bool, result: str) -> None:
            self.ok, self.result, self.done = ok, result, True
            self._ended()
            self.redraw()

        def interrupt(self, why: str = "interrupted") -> None:
            """No result will come: the turn was stopped, failed or lost."""
            self.done, self.interrupted, self.why = True, True, why
            self._ended()
            self.redraw()

        def on_click(self) -> None:
            self.expanded = not self.expanded
            self.redraw()
            log = self.parent
            if isinstance(log, ChatLog):
                log.pick(self, scroll=False)

        def spin(self, frame: str) -> None:
            if not self.done:
                self.redraw(frame)

        def head_markup(self, frame: str = "") -> tuple[str, str]:
            """(title line, duration) as markup."""
            icon, title = tool_title(self.tname, self.args)
            if not self.done:
                head = f"[$warning]{frame or '~'}[/] {_esc(title)}"
            elif self.interrupted:
                head = (f"[$warning]{icon}[/] [strike]{_esc(title)}[/]  "
                        f"[$warning]{_esc(self.why)}[/]")
            elif self.ok is False:
                head = (f"[$error]✗ {_esc(title)}[/]  "
                        f"[$error]{_esc(result_hint(self.tname, self.args, False, self.result))}[/]")
            else:
                hint = result_hint(self.tname, self.args, self.ok, self.result)
                col = ("$warning" if hint.startswith("exit ") and not hint.startswith("exit 0")
                       else "$text-muted")
                head = f"[$text-muted]{icon}[/] {_esc(title)}" + (
                    f"  [{col}]{_esc(hint)}[/]" if hint else "")
            if not self.done:
                dur = _elapsed(time.monotonic() - self.t0)
            elif self.t1 is not None:
                dur = _elapsed(self.t1 - self.t0, precise=True)
            else:
                dur = ""
            return head, dur

        def redraw(self, frame: str = "") -> None:
            head, dur = self.head_markup(frame)
            body, more = (None, 0)
            if self.expanded:
                body, more = tool_body(self.tname, self.args, self.ok,
                                       self.result if self.done and not self.interrupted
                                       else None, True, cap=EXPANDED_LINES)
                if body is None and self.done:
                    body = "[$text-muted](no output)[/]"
                elif body is None and self.has_class("-picked"):
                    body = "[$text-muted]running — what it returns shows here[/]"
                if more:
                    body += f"\n[$text-muted]… {more} more lines · → shows all[/]"
            self.more = more
            if (head, dur, body) == self._shown:
                return                          # the tick redraws; most ticks change nothing
            old = self._shown
            self._shown = (head, dur, body)
            # a one-line title never changes the row's height
            self._head.update(head, layout=False)
            if not old or old[1] != dur:
                self._dur.update(dur, layout=not old or len(old[1]) != len(dur))
            if not old or old[2] != body:
                self.set_class(body is not None, "block")
                self._body.display = body is not None
                self._body.update(body or "")

        def full_markup(self) -> str:
            body, _ = tool_body(self.tname, self.args, self.ok,
                                self.result if self.done and not self.interrupted else None,
                                True, cap=5000)
            return body or "[$text-muted](no output)[/]"

    class NewHint(Static):
        """Under the transcript while the operator has scrolled up and more
        arrived below. A click jumps to the bottom."""

        DEFAULT_CSS = """
        NewHint { height: 1; padding: 0 4; color: $primary; text-style: bold; display: none; }
        """

        def on_click(self) -> None:
            self.app.log_view.scroll_end(animate=False)
            self.app.unseen = 0
            self.app._refresh_new_hint()

    class ChatLog(VerticalScroll):
        """The transcript. It follows the bottom until you scroll up. Tab from
        the prompt picks a tool row: ↑ ↓ move, enter or space opens and closes
        it, → shows all of an open row, home / end jump, esc or tab goes back
        (typing goes back too, with the key)."""

        FOCUS_ON_CLICK = False     # a click opens a row; the prompt keeps the keyboard
        BINDINGS = [
            Binding("up", "move(-1)", show=False),
            Binding("down", "move(1)", show=False),
            Binding("enter,space", "toggle", show=False),
            Binding("right", "more", show=False),
            Binding("left", "less", show=False),
            Binding("home", "edge(0)", show=False),
            Binding("end", "edge(1)", show=False),
            Binding("escape,tab", "leave", show=False),
        ]

        def __init__(self, *children, **kw) -> None:
            super().__init__(*children, **kw)
            self.picked = None
            self.picking = False       # focused (has_focus is not set yet in on_focus)

        def rows(self) -> list:
            return [w for w in self.children if isinstance(w, ToolView)]

        def pick(self, tv, scroll: bool = True) -> None:
            if self.picked is not None and self.picked is not tv:
                self.picked.remove_class("-picked")
            self.picked = tv
            if tv is not None:
                tv.set_class(self.picking, "-picked")
                if scroll:
                    self.scroll_to_widget(tv, animate=False)

        def on_focus(self) -> None:
            self.picking = True
            rows = self.rows()
            self.pick(self.picked if self.picked in rows else (rows[-1] if rows else None))
            self.app._refresh_status()

        def on_blur(self) -> None:
            self.picking = False
            if self.picked is not None:
                self.picked.remove_class("-picked")
            self.app._refresh_status()

        def action_move(self, d: int) -> None:
            rows = self.rows()
            if not rows:
                self.scroll_relative(y=d, animate=False)
                return
            i = rows.index(self.picked) if self.picked in rows else len(rows)
            self.pick(rows[max(0, min(len(rows) - 1, i + d))])

        def action_edge(self, end: int) -> None:
            rows = self.rows()
            if rows:
                self.pick(rows[-1] if end else rows[0])
            if end:
                self.scroll_end(animate=False)
            else:
                self.scroll_home(animate=False)

        def action_toggle(self) -> None:
            tv = self.picked
            if tv is not None:
                tv.expanded = not tv.expanded
                tv.redraw()
                self.call_after_refresh(self.scroll_to_widget, tv, animate=False)

        def action_more(self) -> None:
            tv = self.picked
            if tv is None:
                return
            if not tv.expanded:
                self.action_toggle()
            else:
                self.app.push_screen(View(tool_title(tv.tname, tv.args)[1], tv.full_markup()))

        def action_less(self) -> None:
            if self.picked is not None and self.picked.expanded:
                self.action_toggle()

        def action_leave(self) -> None:
            self.app.editor.focus()

        async def on_key(self, event) -> None:
            app = self.app
            if app.leader:
                event.stop()
                event.prevent_default()
                app.run_leader(event.key)
            elif event.is_printable and event.character and event.key != "space":
                # typing goes to the prompt, key included
                event.stop()
                event.prevent_default()
                app.editor.focus()
                app.editor.insert(event.character)

    class Editor(TextArea):
        """The prompt. Enter sends; ctrl+j / shift+enter / alt+enter (or a
        trailing backslash) add a line; ↑ on the first line walks history."""

        class Submitted(Message):
            def __init__(self, text: str) -> None:
                super().__init__()
                self.text = text

        async def _on_key(self, event) -> None:
            app = self.app
            key = event.key
            if app.leader:
                event.stop()
                event.prevent_default()
                app.run_leader(key)
                return
            if app.popup_open() and key in ("up", "down", "tab", "enter", "escape"):
                event.stop()
                event.prevent_default()
                app.popup_key(key)
                return
            if key == "shift+tab":
                event.stop()
                event.prevent_default()
                app.cycle_permission()
                return
            if key == "left" and not self.text:
                event.stop()
                event.prevent_default()
                app.action_agents_view()
                return
            if key == "enter":
                event.stop()
                event.prevent_default()
                if self.text.endswith("\\"):
                    self.text = self.text[:-1] + "\n"
                    self.move_cursor(self.document.end)
                else:
                    self.post_message(self.Submitted(self.text))
                return
            if key in ("shift+enter", "ctrl+j", "alt+enter"):
                event.stop()
                event.prevent_default()
                self.insert("\n")
                return
            if key == "up" and self.cursor_location[0] == 0 and app.history_step(-1):
                event.stop()
                event.prevent_default()
                return
            if key == "down" and self.cursor_location[0] == self.document.line_count - 1 \
                    and app.history_step(1):
                event.stop()
                event.prevent_default()
                return
            await super()._on_key(event)

    # -- dialogs ----------------------------------------------------------------------------

    class Picker(ModalScreen):
        """opencode's DialogSelect, arrow-first. It opens on the list: ↑ ↓ move,
        enter picks, esc closes. Any printable key (kept as the first letter of
        the text, `t` included) starts typing a filter: rows then sort by how
        closely they match (picker_score) with the closest highlighted, ↑ ↓
        still move, backspace edits (and on an empty filter goes back to the
        list). With `custom`, enter on text that matches nothing returns the
        text itself. Rows are (value, label, meta); a None value is a heading.
        `actions` maps a key, live in list mode only, to (label, async
        fn(value) -> new rows or None) — space toggling a model, say. `hidden`
        is a set of values that stay off the list until a filter is typed (a
        line at the end says how many); `wide` lets the dialog use up to 90% of
        the terminal for rows that carry a lot of meta."""

        BINDINGS = [Binding("escape", "cancel", show=False)]

        def __init__(self, title: str, rows: list[tuple[str, str, str]],
                     current: str | None = None, custom: bool = False,
                     hint: str = "", actions: dict | None = None,
                     hidden=(), wide: bool = False) -> None:
            super().__init__()
            self.title_text, self.rows, self.current = title, rows, current
            self.custom, self.hint = custom, hint
            self.actions = actions or {}
            self.hidden, self.wide = set(hidden), wide
            self.typing = False

        def compose(self) -> ComposeResult:
            with Vertical(id="dialog"):
                with Horizontal(id="dialog-head"):
                    yield Static(f"[b]{_esc(self.title_text)}[/]", id="dialog-title")
                    yield Static("[$text-muted]esc[/]", id="dialog-esc")
                yield Input(placeholder="Filter" + (" or type a name" if self.custom else ""),
                            id="filter", select_on_focus=False)
                yield OptionList(id="choices")
                yield Static(id="dialog-hint")

        def on_mount(self) -> None:
            self.query_one("#filter", Input).display = False
            if self.wide:
                dlg = self.query_one("#dialog")
                dlg.styles.width, dlg.styles.max_width = "90%", 110
            self.fill("")
            self.query_one("#choices", OptionList).focus()
            self._show_hint()

        def on_resize(self, event) -> None:
            self._fit()

        def _fit(self) -> None:
            """The list gives up rows so the hint under it stays on a short terminal:
            the dialog is at most 80% of the screen, less its padding, title, the
            filter box while typing and the hint's own lines."""
            text = getattr(self, "hint_text", "")
            inner = max(20, (self.app.size.width * 9 // 10 if self.wide else 72) - 4)
            lines = sum(max(1, -(-len(ln) // inner)) for ln in (text.split("\n") or [""]))
            room = self.app.size.height * 8 // 10 - 2 - 2 - (4 if self.typing else 0) - 1 - lines
            self.query_one("#choices", OptionList).styles.max_height = max(3, min(20, room))

        def _show_hint(self) -> None:
            keys = ["↑↓ move", "enter pick"]
            keys.append("backspace back to the list" if self.typing else "type to filter")
            if not self.typing:
                keys += [f"{'␣' if k == 'space' else k} {label}"
                         for k, (label, _) in self.actions.items()]
            text = "  ".join(keys) + (f"\n{self.hint}" if self.hint else "")
            self.hint_text = text
            self.query_one("#dialog-hint", Static).update(f"[$text-muted]{_esc(text)}[/]")
            self._fit()

        def fill(self, q: str, keep: str | None = None) -> None:
            ol = self.query_one("#choices", OptionList)
            ol.clear_options()
            rows = self.rows
            if q.strip():
                scored = [(picker_score(q, v, lb, m), i, (v, lb, m))
                          for i, (v, lb, m) in enumerate(rows) if v is not None]
                rows = [r for sc, _, r in sorted((x for x in scored if x[0] > 0),
                                                 key=lambda x: (-x[0], x[1]))]
            elif self.hidden:
                shown, head, n = [], None, 0
                for r in rows:
                    if r[0] is None:
                        head = r               # only kept with a row under it
                    elif r[0] in self.hidden:
                        n += 1
                    else:
                        if head is not None:
                            shown.append(head)
                            head = None
                        shown.append(r)
                rows = shown + ([(None, f"{n} more hidden (off or deprecated): type to find "
                                        "them", "")] if n else [])
            hit = None
            for value, label, meta in rows:
                if value is None:
                    ol.add_option(Option(f"[$accent b]{_esc(label)}[/]", disabled=True))
                    continue
                mark = "[$primary]●[/] " if value == self.current else "  "
                text = f"{mark}{_esc(label or value)}"
                if meta:
                    text += f"  [$text-muted]{_esc(meta)}[/]"
                ol.add_option(Option(text, id=value))
                if keep is not None and value == keep:
                    hit = ol.option_count - 1
                elif keep is None and not q.strip() and value == self.current and hit is None:
                    hit = ol.option_count - 1
            if hit is None:
                hit = next((i for i in range(ol.option_count)
                            if not ol.get_option_at_index(i).disabled), None)
            if hit is not None:
                ol.highlighted = hit

        def start_typing(self, text: str = "") -> None:
            f = self.query_one("#filter", Input)
            self.typing = True
            f.display = True
            f.value = text
            f.cursor_position = len(text)
            f.focus()
            self.fill(text)
            self._show_hint()

        def stop_typing(self) -> None:
            f = self.query_one("#filter", Input)
            ol = self.query_one("#choices", OptionList)
            keep = (ol.get_option_at_index(ol.highlighted).id
                    if ol.highlighted is not None and ol.option_count else None)
            self.typing = False
            f.value = ""
            f.display = False
            self.fill("", keep=keep)
            ol.focus()
            self._show_hint()

        @on(Input.Changed, "#filter")
        def _changed(self, ev) -> None:
            if self.typing:
                self.fill(ev.value)

        @on(Input.Submitted, "#filter")
        def _submitted(self, ev) -> None:
            ol = self.query_one("#choices", OptionList)
            if ol.highlighted is not None and ol.option_count:
                opt = ol.get_option_at_index(ol.highlighted)
                if not opt.disabled:
                    self.dismiss(opt.id)
                    return
            if self.custom and ev.value.strip():
                self.dismiss(ev.value.strip())

        @on(OptionList.OptionSelected)
        def _selected(self, ev) -> None:
            self.dismiss(ev.option.id)

        def on_key(self, event) -> None:
            ol = self.query_one("#choices", OptionList)
            key = event.key
            if key in ("up", "down", "pageup", "pagedown"):
                event.stop()
                event.prevent_default()
                if ol.option_count:
                    {"up": ol.action_cursor_up, "down": ol.action_cursor_down,
                     "pageup": ol.action_page_up, "pagedown": ol.action_page_down}[key]()
                return
            if self.typing:
                f = self.query_one("#filter", Input)
                if key == "backspace" and not f.value:
                    event.stop()
                    event.prevent_default()
                    self.stop_typing()
                elif event.is_printable and event.character:
                    # the filter stops every letter it gets, so one here was
                    # typed before its focus landed (fast typing, a paste):
                    # "e2e" used to filter on "e" alone
                    event.stop()
                    event.prevent_default()
                    f.insert_text_at_cursor(event.character)
                return
            if key in self.actions:
                event.stop()
                event.prevent_default()
                self.run_worker(self._run_action(key), group="picker-action")
                return
            ch = event.character
            if event.is_printable and ch and not ch.isspace():
                event.stop()
                event.prevent_default()
                self.start_typing(ch)

        async def _run_action(self, key: str) -> None:
            ol = self.query_one("#choices", OptionList)
            if ol.highlighted is None or not ol.option_count:
                return
            opt = ol.get_option_at_index(ol.highlighted)
            if opt.disabled or opt.id is None:
                return
            _, fn = self.actions[key]
            try:
                rows = await fn(opt.id)
            except CliError as e:
                self.app.notify(str(e), severity="error")
                return
            if rows is not None:
                self.rows = rows
                self.fill(self.query_one("#filter", Input).value if self.typing else "",
                          keep=opt.id)

        def action_cancel(self) -> None:
            self.dismiss(None)

    class Inert:
        """A dialog that can open by itself while the operator is typing (an
        agent's ask, a /local approval) takes no keys until they pause: the tail
        of a sentence must not answer a question they have not seen. Printable
        keys it turns away go back to the prompt they were typed at; enter and
        esc are dropped. Each turned-away key restarts the pause, up to a limit."""

        GRACE = DIALOG_GRACE
        MAX_INERT = DIALOG_MAX_INERT

        def _opened(self) -> None:
            self.opened = self._last_key = time.monotonic()
            self.ate = False

        def inert(self) -> bool:
            if self.GRACE <= 0:
                return False
            now = time.monotonic()
            return now - self.opened < self.MAX_INERT and now - self._last_key < self.GRACE

        def swallow(self, event) -> bool:
            """True when this key was turned away."""
            if not self.inert():
                return False
            self._last_key = time.monotonic()
            self.ate = True
            event.stop()
            event.prevent_default()
            if event.is_printable and event.character:
                self.app.type_ahead(event.character)
            return True

    class Confirm(ModalScreen):
        """y says yes, n / esc say no. `strict` (an approval, a delete, anything that
        cannot be taken back) answers only to y: enter, the key a hand reaches for
        twice, says no. Otherwise enter is yes, and the hint says so."""

        BINDINGS = [Binding("y", "yes", show=False),
                    Binding("enter", "enter", show=False),
                    Binding("n,escape", "no", show=False)]

        def __init__(self, question: str, detail: str = "", grace: float = 0.0,
                     strict: bool = False) -> None:
            super().__init__()
            self.question, self.detail, self.strict = question, detail, strict
            # a dialog that pops up on its own (not from the key just pressed)
            # ignores keys for `grace` seconds: the tail of what the operator
            # was typing must not answer a question they have not seen
            self.grace, self.opened = grace, time.monotonic()

        def compose(self) -> ComposeResult:
            with Vertical(id="dialog", classes="small"):
                yield Static(f"[b]{_esc(self.question)}[/]")
                if self.detail:
                    yield Static(f"[$text-muted]{_esc(self.detail)}[/]")
                yield Static("\n[$primary]y[/] yes   [$text-muted]n / esc / enter[/] no"
                             if self.strict else
                             "\n[$primary]y / enter[/] yes   [$text-muted]n / esc[/] no",
                             id="confirm-keys")

        def _early(self) -> bool:
            return time.monotonic() - self.opened < self.grace

        def action_yes(self) -> None:
            if not self._early():
                self.dismiss(True)

        def action_enter(self) -> None:
            if not self._early():
                self.dismiss(not self.strict)

        def action_no(self) -> None:
            if not self._early():
                self.dismiss(False)

    class LocalApprove(Inert, ModalScreen):
        """/local: may this read, write, edit or command run on this machine?"""

        BINDINGS = [Binding("y,enter", "answer('yes')", show=False),
                    Binding("a", "answer('always')", show=False),
                    Binding("n,escape", "answer('no')", show=False)]

        def __init__(self, kind: str, summary: str) -> None:
            super().__init__()
            self.kind, self.summary = kind, summary
            self._opened()

        def compose(self) -> ComposeResult:
            what = {"shell": "Run this command here?", "write": "Write this file?",
                    "edit": "Make this edit?",
                    "read": "Read this outside the working directory?"
                    }.get(self.kind, f"Allow this {self.kind}?")
            lines = []
            for ln in self.summary.splitlines():
                style = ("$success" if ln.startswith("+") and not ln.startswith("+++")
                         else "$error" if ln.startswith("-") and not ln.startswith("---")
                         else "$text")
                lines.append(f"[{style}]{_esc(ln)}[/]")
            with Vertical(id="dialog"):
                yield Static(f"[b]{_esc(what)}[/]  [$text-muted]the agent wants to "
                             f"{_esc(self.kind)} on this machine[/]")
                with VerticalScroll(id="approve-body"):
                    yield Static("\n".join(lines))
                always = ("[$primary]a[/] always for this folder" if self.kind == "read" else
                          f"[$primary]a[/] always ({_esc(self.kind)}, this session)")
                yield Static(f"\n[$primary]y[/] yes   {always}   "
                             "[$text-muted]n / esc[/] no")

        def on_key(self, event) -> None:
            self.swallow(event)

        def action_answer(self, what: str) -> None:
            if not self.inert():
                self.dismiss(what)

    class AskUser(Inert, ModalScreen):
        """ask_user / a permission ask (backend/operator_ask.py): the agent's
        questions, one at a time. ↑ ↓ move, 1-5 pick, space toggles (multi),
        typing goes to the free-text last option (and picks it), enter
        confirms and moves on, esc skips the whole ask, pgup/pgdn scroll a long
        command. Says which agent asks and how many more asks wait behind this
        one. Dismisses with a list of {selected, text} answers, None (skipped)
        or "gone" (answered or closed elsewhere: ask_done)."""

        BINDINGS = [Binding("escape", "skip", show=False)]
        AUTO_FOCUS = None    # open on the options, not the free-text line
        DEFAULT_CSS = """
        AskUser { align: center middle; background: $background 60%; }
        #ask-top { height: auto; }
        #ask-opts { margin-top: 1; }
        #ask-text { margin-top: 1; border: none; background: $panel; padding: 0 1;
                    height: 1; }
        #ask-text:focus { border: none; }
        #ask-foot { margin-top: 1; }
        """

        def __init__(self, ev: dict, who: str = "", waiting: int = 0) -> None:
            super().__init__()
            self.ev, self.who, self.waiting = ev, who, waiting
            self.qs = [q for q in ev.get("questions") or [] if isinstance(q, dict)]
            self.free_label = ev.get("free_text_label") or "Type something…"
            self.i, self.answers = 0, []
            self.resolved = self.gone = False
            self._skip_armed = False       # esc on a later question: once to warn, twice to skip
            self._opened()
            self._reset()

        def _reset(self) -> None:
            self.cur, self.sel = 0, set()

        @property
        def q(self) -> dict:
            return self.qs[self.i]

        @property
        def permission(self) -> bool:
            """A permission ask (one question: yes / always / type why not). Its last
            numbered row is a plain No, so declining has a number and not only esc."""
            return self.ev.get("kind") == "permission" and len(self.qs) == 1

        @property
        def opts(self) -> list:
            return [str(o) for o in self.q.get("options") or []] + (
                [NO_ROW] if self.permission else [])

        def compose(self) -> ComposeResult:
            with Vertical(id="dialog"):
                with VerticalScroll(id="ask-top"):
                    yield Static("", id="ask-head")
                yield Static("", id="ask-opts")
                yield Input(placeholder=self.free_label, id="ask-text")
                yield Static("", id="ask-foot")

        def on_mount(self) -> None:
            if not self.qs:
                self.dismiss(None)
                return
            self._draw()
            self.set_focus(None)
            self.call_after_refresh(self.set_focus, None)
            if self.GRACE > 0:
                self.set_timer(self.GRACE + 0.05, self._draw)     # the "just opened" note goes

        def on_resize(self, event) -> None:
            self._fit()

        def dismiss(self, result=None):
            """Once: a second dismiss (an ask_done racing an answer) would pop
            whatever dialog sits on top now."""
            if self.resolved:
                from textual.await_complete import AwaitComplete
                return AwaitComplete.nothing()
            self.resolved = True
            return super().dismiss(result)

        def close_gone(self) -> None:
            """ask_done: the server settled this ask. Buried under another dialog
            it closes when that one is answered (on_screen_resume)."""
            if self.resolved:
                return
            self.gone = True
            if self.app.screen is self:
                self.dismiss("gone")

        def on_screen_resume(self) -> None:
            if self.gone:
                self.dismiss("gone")

        def set_waiting(self, n: int) -> None:
            if n != self.waiting:
                self.waiting = n
                if self.is_mounted and self.qs:
                    self._draw()

        def _text(self) -> str:
            return self.query_one("#ask-text", Input).value.strip()

        @staticmethod
        def markup(ev: dict, qs: list, i: int, cur: int, sel: set, typed: str,
                   free_label: str, who: str = "", waiting: int = 0) -> tuple[str, str]:
            """(head, options) markup for question i; pure, for tests."""
            q = qs[i]
            opts = [str(o) for o in q.get("options") or []]
            if ev.get("kind") == "permission" and len(qs) == 1:
                opts.append(NO_ROW)
            multi = bool(q.get("multi_select"))
            if ev.get("kind") == "permission":
                title = "[$warning b]Permission[/]"
                if ev.get("reason"):
                    title += f"  [$text-muted]{_esc(str(ev['reason']))}[/]"
            else:
                title = "[$accent b]The agent asks[/]"
            if len(qs) > 1:
                title += f"  [$text-muted]{i + 1}/{len(qs)}[/]"
            head = title
            if who or waiting:
                line = f"[$text-muted]from[/] {_esc(who)}" if who else ""
                if waiting:
                    line += ("  " if line else "") + f"[$accent]{waiting} more waiting[/]"
                head += "\n" + line
            question, detail = ask_view(ev, str(q.get("question") or ""))
            head += f"\n[b]{_esc(question)}[/]"
            if detail:
                head += "\n" + detail
            rows = []
            for j, label in enumerate(opts + [free_label]):
                on = (j in sel) if j < len(opts) else bool(typed)
                box = (("[x]" if on else "[ ]") if multi else ("(•)" if on else "( )"))
                num = f"{j + 1}." if j < len(opts) else "  "
                text = _esc(label) if j < len(opts) else f"[i]{_esc(label)}[/]"
                line = f"{num} {box} {text}"
                rows.append(f"[reverse]{line}[/]" if j == cur else line)
            return head, "\n".join(rows)

        def _foot_text(self) -> str:
            n = len(self.opts)
            multi = bool(self.q.get("multi_select"))
            pick = "" if n == 0 else "1 picks it" if n == 1 else f"1-{n} pick"
            if self.ate and self.inert():
                return "just opened: keys go back to your prompt for a moment"
            if self._skip_armed:
                return ("esc again skips the whole ask: the answers to the earlier "
                        "questions are dropped · any other key goes on")
            return ("↑↓ move" + (f" · {pick}" if pick else "")
                    + (" · space toggles" if multi else "")
                    + (" · or type" if n else " · type your answer")
                    + " · enter confirms · "
                    + ("esc declines" if self.permission else "esc skips"))

        def _draw(self) -> None:
            head, rows = self.markup(self.ev, self.qs, self.i, self.cur, self.sel,
                                     self._text(), self.free_label, self.who, self.waiting)
            self.query_one("#ask-head", Static).update(head)
            self.query_one("#ask-opts", Static).update(rows)
            self.query_one("#ask-foot", Static).update(f"[$text-muted]{_esc(self._foot_text())}[/]")
            inp = self.query_one("#ask-text", Input)
            inp.display = self.cur == self._free_row() or bool(self._text())
            self._fit()

        def _fit(self) -> None:
            """The options and the key line stay on screen whatever the command
            is: what is left of the terminal goes to the head, which scrolls."""
            if not self.is_mounted or not self.qs:
                return
            height, width = self.app.size.height, self.app.size.width
            inner = max(20, min(72, int(width * 0.9)) - 4)
            foot = -(-len(self._foot_text()) // inner)
            typing = self.query_one("#ask-text", Input).display
            # "2. ( ) " leads each option, and a long label wraps onto more rows
            rows = sum(max(1, -(-(7 + len(label)) // inner))
                       for label in [*self.opts, self.free_label])
            fixed = rows + 1 + (2 if typing else 0) + foot + 1      # options, gaps, input, foot
            room = max(4, height - 2 - 2 - fixed)                     # gutter, dialog padding
            self.query_one("#dialog").styles.max_height = max(8, height - 2)
            self.query_one("#ask-top").styles.max_height = room

        def _free_row(self) -> int:
            return len(self.opts)

        def _focus_text(self):
            """The free-text line is only on screen while it is in use: the row
            in the list already says what it is for."""
            inp = self.query_one("#ask-text", Input)
            inp.display = True
            inp.focus()
            return inp

        def _pick(self, j: int) -> None:
            if j >= len(self.opts):
                return
            if self.q.get("multi_select"):
                self.sel ^= {j}
            else:
                self.sel = {j}
                self.query_one("#ask-text", Input).value = ""
            self.cur = j

        def _move(self, d: int) -> None:
            self.cur = max(0, min(self._free_row(), self.cur + d))
            inp = self.query_one("#ask-text", Input)
            if self.cur == self._free_row():
                self._focus_text()
            elif inp.has_focus:
                self.set_focus(None)

        def _confirm(self) -> None:
            if self.inert():
                return
            typed = self._text()
            if not self.sel and not typed:
                if self.cur < len(self.opts):
                    self.sel = {self.cur}
                else:
                    self._focus_text()
                    return
            if self.permission and len(self.opts) - 1 in self.sel:
                self.dismiss(None)         # the No row: the server reads a skip as a decline
                return
            self.answers.append({"selected": [self.opts[j] for j in sorted(self.sel)],
                                 "text": typed or None})
            if self.i + 1 >= len(self.qs):
                self.dismiss(self.answers)
                return
            self.i += 1
            self._reset()
            inp = self.query_one("#ask-text", Input)
            inp.value = ""
            self.set_focus(None)
            self._draw()

        def on_key(self, event) -> None:
            if self.swallow(event):
                self._draw()
                return
            key = event.key
            if key != "escape" and self._skip_armed:
                self._skip_armed = False
            typing = self.query_one("#ask-text", Input).has_focus
            if key in ("pageup", "pagedown"):
                event.stop()
                top = self.query_one("#ask-top")
                (top.scroll_page_up if key == "pageup" else top.scroll_page_down)(animate=False)
                return
            if key in ("up", "down"):
                event.stop()
                self._move(-1 if key == "up" else 1)
            elif key == "enter" and not typing:
                event.stop()
                self._confirm()
            elif typing:
                return
            elif key.isdigit() and 1 <= int(key) <= len(self.opts):
                event.stop()
                self._pick(int(key) - 1)
            elif key == "space":
                event.stop()
                if self.cur < len(self.opts):
                    self._pick(self.cur)
                else:
                    self._focus_text()
            elif event.is_printable and event.character:
                # typing jumps to the free-text option and picks it
                event.stop()
                self.cur = self._free_row()
                self._focus_text().insert_text_at_cursor(event.character)
            else:
                return
            self._draw()

        @on(Input.Changed, "#ask-text")
        def _typed(self, ev) -> None:
            if ev.value.strip() and not self.q.get("multi_select"):
                self.sel = set()
            if ev.value.strip():
                self.cur = self._free_row()
            self._draw()

        @on(Input.Submitted, "#ask-text")
        def _submitted(self, ev) -> None:
            ev.stop()
            self._confirm()

        def action_skip(self) -> None:
            if self.inert():
                return
            if self.i > 0 and not self._skip_armed:
                # the server takes all the answers or none: skipping here would drop
                # the ones already given, so say so once before doing it
                self._skip_armed = True
                self._draw()
                return
            self.dismiss(None)

