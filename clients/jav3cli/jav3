        async def _startup(self) -> None:
            self.client = self._new_client()
            resume, cont, prompt = self.initial
            if not await self._check_login():
                if prompt:                 # keep it for after /login
                    self.editor.text = prompt
                    self.editor.move_cursor(self.editor.document.end)
                return
            await self._after_login()
            if not self.options:
                await self.note("this server predates the TUI's pickers (/api/chat/options): "
                                "/model, /agent and /project take typed names", "warn")
            self.refresh_chrome()
            try:
                if cont and self.convs:
                    await self.open_conversation(self.convs[0]["id"])
                elif resume is not None:
                    await self.open_conversation(resume)
            except CliError as e:
                await self.note(str(e), "error")
            if prompt:
                self.send(prompt)

        async def _check_login(self) -> bool:
            """Who the saved credential is. No credential, or a 401: the
            not-logged-in state (the TUI runs; /login fixes it)."""
            if not self.token or not self.base:
                self.logged_in = False
                await self.note(NOT_LOGGED_IN, "warn")
                self.refresh_chrome()
                return False
            try:
                who = await self.api("GET", "/api/devices/whoami")
            except NotLoggedIn:
                self.logged_in = False
                await self.note("the saved login was refused (revoked or expired) — /login",
                                "warn")
                self.refresh_chrome()
                return False
            except CliError as e:
                await self.note(str(e), "error")
                return False
            self.whoami = who.get("username") or "?"
            self.logged_in = True
            return True

        async def _after_login(self) -> None:
            await asyncio.gather(self.refresh_options(), self.refresh_convs())
            if is_session(self.token):
                self.run_worker(self._notice_loop(), group="notices", exclusive=True)
            self.refresh_chrome()

        @property
        def full_access(self) -> bool:
            return is_session(self.token) and self.logged_in is not False

        def _access_label(self) -> str:
            if not self.token or self.logged_in is False:
                return "not logged in"
            return "full access" if is_session(self.token) else "chat only"

        def _need_full(self, what: str) -> None:
            if not self.full_access:
                raise CliError(f"{what} needs full access — /login with your password "
                               "(a device token from Settings → Add computer is chat only)")

        async def _notice_loop(self) -> None:
            """The server's notice stream (agent runs the operator started
            finishing elsewhere) -> notifications. Operator session only."""
            backoff = 2.0
            while is_session(self.token) and self.client is not None:
                try:
                    async with self.client.stream("GET", "/api/agents/notices/stream") as r:
                        if r.status_code in (401, 403):
                            return
                        if r.status_code < 400:
                            backoff = 2.0
                            async for ev in aiter_sse(r.aiter_lines()):
                                if ev.get("type") == "agent_run_done":
                                    self._agent_notice(ev)
                except (httpx.HTTPError, ValueError):
                    pass
                await asyncio.sleep(backoff)
                backoff = min(backoff * 2, 60.0)

        def _agent_notice(self, ev: dict) -> None:
            who = ev.get("agent") or ev.get("slug") or "an agent"
            where = f" #{ev['conversation_id']}" if ev.get("conversation_id") else ""
            if ev.get("ok") is False:
                self.push_notice(f"◆ {who}{where} failed after {ev.get('took', '?')}: "
                                 f"{_short(ev.get('error') or 'error', 120)}", "error")
            else:
                tail = f" — {_short(ev['summary'], 120)}" if ev.get("summary") else ""
                self.push_notice(f"◆ {who}{where} finished in {ev.get('took', '?')}{tail}",
                                 "done")

        # -- notifications ---------------------------------------------------------------------

        def sidebar_shown(self) -> bool:
            return bool(self.sidebar_pref)

        def push_notice(self, text: str, kind: str = "info", toast: bool = True) -> None:
            """Newest first, capped. With the sidebar hidden it also counts as
            unread (the badge in the status row) and shows as a toast."""
            from textual.css.query import NoMatches
            self.notices.insert(0, (time.time(), kind, text))
            del self.notices[NOTICE_CAP:]
            if not self.sidebar_shown():
                self.unread += 1
                if toast:
                    self.notify(text, timeout=5, severity={"error": "error", "warn": "warning"}
                                .get(kind, "information"))
            try:
                self._refresh_sidebar()
                self._refresh_status()
            except NoMatches:
                pass          # a dialog is on top; the next refresh catches up

        async def on_unmount(self) -> None:
            if self.client is not None:
                await self.client.aclose()

        # -- settings and history ------------------------------------------------------------

        def _settings_path(self) -> Path:
            return config_dir() / "tui.json"

        def _load_settings(self) -> dict:
            try:
                d = json.loads(self._settings_path().read_text())
                return d if isinstance(d, dict) else {}
            except (OSError, ValueError):
                return {}

        def _save_settings(self, **kw) -> None:
            d = self._load_settings()
            d.update(kw)
            try:
                config_dir().mkdir(parents=True, exist_ok=True)
                self._settings_path().write_text(json.dumps(d))
            except OSError:
                pass

        def _history_path(self) -> Path:
            return config_dir() / "history.jsonl"

        def _load_history(self) -> None:
            try:
                for ln in self._history_path().read_text().splitlines()[-500:]:
                    try:
                        self.history.append(json.loads(ln))
                    except ValueError:
                        pass
            except OSError:
                pass

        def _remember(self, text: str) -> None:
            if not text.strip() or (self.history and self.history[-1] == text):
                return
            self.history.append(text)
            try:
                config_dir().mkdir(parents=True, exist_ok=True)
                fd = os.open(self._history_path(), os.O_WRONLY | os.O_CREAT | os.O_APPEND,
                             0o600)
                with os.fdopen(fd, "a") as f:
                    f.write(json.dumps(text) + "\n")
            except OSError:
                pass

        def history_step(self, d: int) -> bool:
            if not self.history:
                return False
            ed = self.editor
            if self.hist_pos is None:
                if d > 0:
                    return False
                self.hist_draft, self.hist_pos = ed.text, len(self.history)
            pos = self.hist_pos + d
            if pos < 0:
                return True
            if pos >= len(self.history):
                self.hist_pos = None
                ed.text = self.hist_draft
            else:
                self.hist_pos = pos
                ed.text = self.history[pos]
            ed.move_cursor(ed.document.end)
            return True

        # -- HTTP --------------------------------------------------------------------------

        def _new_client(self):
            return httpx.AsyncClient(
                base_url=self.base, follow_redirects=False, transport=self.transport,
                headers={"User-Agent": "jav3-cli", **auth_headers(self.token)},
                timeout=httpx.Timeout(30.0, read=None))

        async def api(self, method: str, path: str, **kw):
            if not self.base or self.client is None or not self.token:
                raise NotLoggedIn(NOT_LOGGED_IN)
            try:
                r = await self.client.request(method, path, **kw)
            except httpx.HTTPError as e:
                raise CliError(f"could not reach {self.base}: {e}")
            if r.is_redirect:
                raise CliError(redirect_hint(self.base, r.headers.get("location", "")))
            if r.status_code == 401:
                self._login_lost()
                raise NotLoggedIn(SESSION_LOST)
            if r.status_code >= 400:
                raise CliError(f"server said {r.status_code}: {_detail(r)}")
            try:
                return r.json()
            except ValueError:
                return {}

        def _login_lost(self) -> None:
            if self.logged_in:
                self.logged_in = False
                self.push_notice("the server refused the login (expired or revoked) — /login",
                                 "warn")

        async def refresh_options(self) -> None:
            try:
                self.options = await self.api("GET", "/api/chat/options")
            except CliError:
                self.options = {}

        async def refresh_convs(self) -> list[dict]:
            try:
                self.convs = (await self.api("GET", "/api/conversations"))["conversations"]
            except (CliError, KeyError, TypeError):
                pass
            return self.convs

        async def refresh_info(self) -> None:
            if self.cid is None:
                self.info = None
            else:
                try:
                    self.info = await self.api("GET", f"/api/conversations/{self.cid}/info")
                    if self.info.get("title"):
                        self.title_text = self.info["title"]
                except CliError:
                    self.info = None
            self.refresh_chrome()

        # -- transcript -------------------------------------------------------------------------

        async def mount_log(self, widget) -> None:
            home = self.query(Home)
            if home:
                await home.remove()
            await self.log_view.mount(widget)

        async def note(self, text: str, kind: str = "info") -> None:
            await self.mount_log(Note(_esc(text), classes=kind))
            if kind == "error":
                self.push_notice(text, "error")

        async def clear_log(self) -> None:
            await self.log_view.remove_children()

        async def show_home(self) -> None:
            await self.clear_log()
            await self.log_view.mount(Home())
            self.refresh_chrome()

        # -- chrome: prompt meta, status row, sidebar ----------------------------------------------

        def _model_label(self) -> str:
            return self.model or self.shown_model or (self.options or {}).get("default") or "default"

        def _project_label(self) -> str | None:
            if self.project:
                return self.project
            if self.project_mode == "none":
                return "no project"
            return (self.info or {}).get("project") or (self.options or {}).get("active_project")

        def refresh_chrome(self) -> None:
            if not self.is_mounted:
                return
            try:
                prompt = self.query_one("#prompt")
            except Exception:  # noqa: BLE001 — a dialog is on top
                return
            prompt.set_class(bool(self.agent), "agent")
            prompt.set_class(self.ephemeral, "temp")
            prompt.set_class(self.busy, "busy")
            who = f"[$secondary b]{_esc(self.agent)}[/]" if self.agent else "[$primary b]Jav3[/]"
            model = self._model_label()
            bits = [who, f"[$text]{_esc(model.split('/')[-1])}[/]"]
            if self.orchestrator:
                bits.insert(1, "[$accent b]orchestrator[/]")
            if "/" in model:
                bits.append(f"[$text-muted]{_esc(model.split('/')[0])}[/]")
            proj = self._project_label()
            if proj:
                bits.append(f"[$text-muted]⌂ {_esc(proj)}[/]")
            if self.ephemeral:
                bits.append("[$warning]temporary[/]")
            if self.attachments:
                bits.append(f"[$accent]+{len(self.attachments)} attached[/]")
            self.query_one("#meta", Static).update("  ".join(bits))
            self._refresh_status()
            self._refresh_sidebar()
            try:
                home_hints = self.query_one("#home-hints", Static)
            except Exception:  # noqa: BLE001
                home_hints = None
            if home_hints is not None:
                who = (f"[$text-muted]{_esc(self.whoami)} @ {_esc(self.base)} · "
                       f"{self._access_label()}[/]" if self.logged_in else
                       "[$warning]not logged in[/] [$text-muted]— /login[/]"
                       if self.logged_in is False else f"[$text-muted]{_esc(self.base)}[/]")
                home_hints.update(
                    f"{who}\n\n"
                    "[$text]/help[/]       [$text-muted]commands and keys[/]\n"
                    "[$text]ctrl+x l[/]    [$text-muted]sessions[/]\n"
                    "[$text]ctrl+x m[/]    [$text-muted]models[/]\n"
                    "[$text]ctrl+p[/]      [$text-muted]command palette[/]")
            show = self.sidebar_shown()        # hidden unless the operator opened it
            self.query_one("#sidebar").display = show
            header = self.query_one("#header", Static)
            header.display = not show
            header.update(f"[b]{_esc(self.title_text or 'New chat')}[/]"
                          + (f"  [$text-muted]#{self.cid}[/]" if self.cid else "")
                          + "  [$text-muted]ctrl+b notifications[/]")

        def _refresh_status(self) -> None:
            left = self.query_one("#status-left", Static)
            right = self.query_one("#status-right", Static)
            if self.leader:
                keys = "  ".join(f"[$primary]{c.leader}[/] {name}"
                                 for name, c in self.unique_commands() if c.leader)
                left.update(f"[$warning b]ctrl+x[/]  {keys}  [$primary]b[/] notifications")
                right.update("")
                return
            if self.busy and self.turn is not None:
                t = self.turn
                spin = SPINNER[self.frame % len(SPINNER)]
                verb = ("Interrupting" if self.stop_requested else
                        "Running tools" if t.running else
                        "Writing" if t.seg else "Thinking")
                secs = int(time.monotonic() - t.started)
                esc = ("[$warning]esc again to interrupt[/]"
                       if time.monotonic() - self.esc_armed < 2 else "esc interrupt")
                nq = len(self.queue) + len(self.pending)
                q = f"  [$accent]{nq} queued[/]" if nq else ""
                left.update(f"[$accent]{spin}[/] {verb}…  [$text-muted]{secs}s · {esc}[/]{q}")
            elif self.logged_in is False:
                left.update("[$warning]not logged in[/] [$text-muted]— /login · "
                            "/ commands[/]")
            else:
                left.update("[$text-muted]enter send · ctrl+j newline · / commands · "
                            "@ file · ! shell[/]")
            badge = (f"[$warning b]● {self.unread}[/] [$text-muted]ctrl+b[/]  "
                     if self.unread else "")
            right.update(f"{badge}[$text-muted]ctrl+x leader · ctrl+p commands[/]")

        def _refresh_sidebar(self) -> None:
            info = self.info or {}
            title = self.title_text or ("New chat" if self.cid is None else f"Chat #{self.cid}")
            sub = [f"#{self.cid}"] if self.cid else []
            if self.agent:
                sub.append(f"@{self.agent}")
            proj = self._project_label()
            if proj:
                sub.append(f"⌂ {proj}")
            self.query_one("#sb-title", Static).update(
                f"[b]{_esc(title)}[/]\n[$text-muted]{_esc(' · '.join(sub))}[/]")
            # the chat, compactly: usage on one line, the model on the next
            ctx = []
            if info:
                line = (f"{_fmt_tokens(info.get('input_tokens', 0) + info.get('output_tokens', 0))}"
                        f" tok · ${info.get('cost_usd', 0):.4f}")
                c = info.get("context") or {}
                if c.get("used") and c.get("window"):
                    pct = min(100, round(100 * c["used"] / c["window"]))
                    colour = "$error" if pct > 85 else "$warning" if pct > 60 else "$primary"
                    line += f" · [{colour}]{pct}%[/] ctx"
                ctx.append(line)
            else:
                ctx.append("[$text-muted]no usage yet[/]")
            self.query_one("#sb-context", Static).update("\n".join(ctx))
            model = self._model_label()
            self.query_one("#sb-model", Static).update(
                f"{_esc(model.split('/')[-1])}"
                + (f" [$text-muted]· {_esc(model.split('/')[0])}[/]" if "/" in model else ""))
            files = info.get("files") or []
            fw = self.query_one("#sb-files", Static)
            fw.display = bool(files)
            if files:
                lines = ["[b]Modified Files[/]"]
                for f in files[-12:]:
                    n = f.get("writes", 1)
                    lines.append(f"{_esc(_short(f['path'], 30))}"
                                 + (f" [$text-muted]×{n}[/]" if n > 1 else ""))
                fw.update("\n".join(lines))
            tw = self.query_one("#sb-todo", Static)
            tw.display = bool(self.todos)
            if self.todos:
                tw.update("[b]Todo[/]\n" + "\n".join(
                    f"[$success]✓[/] [$text-muted strike]{_esc(_short(t, 32))}[/]" if done
                    else f"[$warning]☐[/] {_esc(_short(t, 32))}" for done, t in self.todos))
            icons = {"error": "[$error]✗[/]", "warn": "[$warning]![/]",
                     "done": "[$success]✓[/]"}
            notes = ["[b]Notifications[/]"]
            for ts, kind, text in self.notices:
                notes.append(f"[$text-muted]{time.strftime('%H:%M', time.localtime(ts))}[/] "
                             f"{icons.get(kind, '[$primary]·[/]')} {_esc(_short(text, 160))}")
            if not self.notices:
                notes.append("[$text-muted]nothing yet[/]")
            self.query_one("#sb-notes", Static).update("\n".join(notes))
            access = self._access_label()
            colour = {"full access": "$success", "chat only": "$primary"}.get(access, "$warning")
            self.query_one("#sb-foot", Static).update(
                f"[{colour}]●[/] [b]Jav3[/] [$text-muted]{_esc(self.whoami)} · {access}[/]\n"
                f"[$text-muted]{_esc(self.base.split('://')[-1] or '(no server)')}[/]")

        def _tick(self) -> None:
            from textual.css.query import NoMatches
            self.frame += 1
            try:
                if self.busy and self.turn is not None:
                    for tv in self.turn.running.values():
                        tv.spin(SPINNER[self.frame % len(SPINNER)])
                self._refresh_status()
            except NoMatches:
                pass          # shutting down, or a screen without the status row

        def on_resize(self, event) -> None:
            self.refresh_chrome()

        def watch_theme(self, theme: str) -> None:
            if self.is_mounted:
                for tv in self.query(ToolView):
                    tv.redraw()

        # -- turns ------------------------------------------------------------------------------

        def _body(self, message: str) -> dict:
            body: dict = {"message": message, "conversation_id": self.cid}
            if self.cid is None:
                if self.project_mode:
                    body["project_mode"] = self.project_mode
                if self.project and self.project_mode == "pin":
                    body["project"] = self.project
                if self.agent:
                    body["agent"] = self.agent
                if self.ephemeral:
                    body["ephemeral"] = True
                if self.orchestrator:
                    body["mode"] = "orchestrate"
            if self.model:
                body["model"] = self.model
            return body

        def send(self, text: str) -> None:
            if self.busy:
                # the turn has an id: the server hands it to the agent at its next
                # step; before `start` it waits here and is posted when the id comes
                if self.turn is not None and self.turn.cid is not None \
                        and not self.stop_requested:
                    self.run_worker(self._midturn([text]), group="midturn")
                else:
                    self.queue.append(text)
                self._refresh_status()
                return
            self.busy = True           # claimed now, so a fast second Enter queues
            self.run_worker(self._turn(text), group="turn")

        async def _turn(self, text: str) -> None:
            self.busy, self.stop_requested = True, False
            self.turn = TurnState()
            self.refresh_chrome()
            try:
                await self.mount_log(UserMsg(_esc(text)))
                message, attached, skipped = expand_attachments(text)
                for a in attached:
                    await self.note(f"attached {a}")
                for s in skipped:
                    await self.note(f"not attached: {s}", "warn")
                if self.attachments:
                    message += "\n\n" + "\n\n".join(self.attachments)
                    self.attachments = []
                self.last_user = text
                await self._post(self._body(message))
            except CliError as e:
                await self.note(str(e), "error")
            except httpx.HTTPError as e:
                await self.note(f"connection to {self.base} failed: {e}", "error")
            finally:
                await self._end_turn()
            if self.queue and not self.busy:
                self.send(self.queue.pop(0))

        async def _post(self, body: dict) -> None:
            for _ in range(2):
                async with self.client.stream("POST", "/api/chat", json=body) as r:
                    if r.status_code == 409:
                        await r.aread()
                        why = _detail(r)
                        if why == "peak_confirmation_required" and not body.get("confirm_peak"):
                            if await self.push_screen_wait(Confirm(
                                    "Peak pricing right now", "This reply costs 2×. "
                                    "Send anyway?")):
                                body["confirm_peak"] = True
                                continue
                            await self.note("not sent")
                            return
                        if why == "turn_in_progress":
                            raise CliError("a turn is still running in this chat — wait, "
                                           "or /stop it")
                        raise CliError(f"server said 409: {why}")
                    if r.is_redirect:
                        raise CliError(redirect_hint(self.base, r.headers.get("location", "")))
                    if r.status_code == 401:
                        self._login_lost()
                        raise NotLoggedIn(SESSION_LOST)
                    if r.status_code >= 400:
                        await r.aread()
                        raise CliError(f"server said {r.status_code}: {_detail(r)}")
                    await self._consume(r.aiter_lines())
                    return

        async def _consume(self, lines) -> bool:
            """Render a stream; True if it carried anything but `idle`."""
            seen = False
            async for ev in aiter_sse(lines):
                seen = seen or ev.get("type") != "idle"
                if await self.handle_event(ev):
                    break
            return seen

        async def _midturn(self, texts: list[str]) -> None:
            """Post messages to the running turn (in order). Shown dimmed until the
            stream's operator_message; a 409 means the turn just ended, so they go
            as the next turn instead."""
            for text in texts:
                cid = self.turn.cid if self.turn is not None else None
                if cid is None:
                    self._later(text)
                    continue
                message, attached, skipped = expand_attachments(text)
                for s in skipped:
                    await self.note(f"not attached: {s}", "warn")
                w = QueuedMsg(text, message)
                self.pending.append(w)
                await self.mount_log(w)
                try:
                    r = await self.client.post(f"/api/chat/{cid}/message",
                                               json={"text": message})
                except httpx.HTTPError as e:
                    self._unpend(w)
                    w.fail(f"not sent: {e}")
                    continue
                if r.status_code in (404, 405, 409):
                    # 409 no_turn_running: it just ended. 404/405: a server without
                    # mid-turn messages. Either way it becomes the next turn.
                    self._unpend(w)
                    await w.remove()
                    self._later(text)
                elif r.status_code >= 400:
                    self._unpend(w)
                    w.fail(f"not sent — server said {r.status_code}: {_detail(r)}")
            self._refresh_status()

        def _unpend(self, w) -> None:
            if w in self.pending:
                self.pending.remove(w)

        def _later(self, text: str) -> None:
            """Send after the running turn, or now if none is running."""
            if self.busy:
                self.queue.append(text)
            else:
                self.send(text)

        def _match_pending(self, sent: str):
            return (next((w for w in self.pending if w.sent == sent), None)
                    or next((w for w in self.pending if w.sent.strip() == sent.strip()), None))

        async def _undelivered(self, texts: list[str]) -> None:
            """The turn ended before these reached the agent: they become the next
            turn — or, after an interrupt, go back to the prompt."""
            back = []
            for u in texts:
                w = self._match_pending(u)
                if w is not None:
                    self._unpend(w)
                    await w.remove()
                    back.append(w.text)
                else:
                    back.append(u)
            if not back:
                return
            if self.stop_requested:
                ed = self.editor
                ed.text = "\n".join(back + ([ed.text] if ed.text else []))
                ed.move_cursor(ed.document.end)
            else:
                self.queue.insert(0, "\n\n".join(back))

        async def _drain_queue(self) -> None:
            if self.queue and not self.busy:
                self.send(self.queue.pop(0))

        async def handle_event(self, ev: dict) -> bool:
            """Render one event; True when the turn is over."""
            t, turn = ev.get("type"), self.turn
            if turn is None:
                return True
            if t == "start":
                if ev.get("conversation_id") is not None:
                    turn.cid = ev["conversation_id"]
                    if not self.ephemeral:
                        self.cid = turn.cid
                turn.model = ev.get("model") or turn.model
                self.shown_model = turn.model or self.shown_model
                self.refresh_chrome()
                if self.stop_requested:
                    await self._stop_remote()
                elif self.queue and turn.cid is not None:
                    texts, self.queue = self.queue, []
                    self.run_worker(self._midturn(texts), group="midturn")
            elif t == "token":
                chunk = ev.get("text", "")
                if turn.md is None:
                    if not chunk.strip():
                        return False
                    turn.md = Reply("")
                    await self.mount_log(turn.md)
                    turn.stream = Markdown.get_stream(turn.md)
                turn.seg += chunk
                await turn.stream.write(chunk)
            elif t == "tool":
                await self._close_seg()
                tv = ToolView(ev.get("name", "?"), ev.get("args") or {})
                tv.expanded = self.tools_expanded
                turn.running[ev.get("id")] = tv
                await self.mount_log(tv)
            elif t == "tool_result":
                tv = turn.running.pop(ev.get("id"), None)
                if tv is None:
                    tv = ToolView(ev.get("name", "?"), {})
                    await self.mount_log(tv)
                ok = ev.get("ok") is not False
                res = ev.get("result", "")
                tv.finish(ok, res)
                turn.tools.append({"name": tv.tname, "args": tv.args, "ok": ok, "result": res})
                if tv.tname == "todo_update" and ok and parse_todos(res):
                    self.todos = parse_todos(res)
                    self._refresh_sidebar()
            elif t == "job":
                await self.note(f"◆ job: {ev.get('title', '')}")
            elif t == "inbox":
                await self.note(f"✉ {_short(ev.get('text', ''), 200)}")
            elif t == "operator_message":
                await self._close_seg()
                text = ev.get("text") or ""
                w = self._match_pending(text)
                if w is not None:
                    self._unpend(w)
                    w.deliver()
                elif text.strip():
                    # sent from elsewhere (the web UI, another terminal)
                    await self.mount_log(UserMsg(QueuedMsg._markup(text, "↳ delivered mid-turn")))
            elif t == "final":
                turn.done = True
                await self._finish(ev.get("content") or "")
                if ev.get("undelivered"):
                    await self._undelivered([str(u) for u in ev["undelivered"]])
                return True
            elif t == "error":
                await self._close_seg()
                await self.note(ev.get("message") or "error", "error")
                return True
            elif t == "idle":
                return True
            return False

        async def _close_seg(self) -> None:
            turn = self.turn
            if turn is None:
                return
            if turn.stream is not None:
                await turn.stream.stop()
                turn.stream = None
            if turn.md is not None:
                if turn.seg.strip():
                    turn.printed.append(turn.seg)
                else:
                    await turn.md.remove()
            turn.md, turn.seg = None, ""

        async def _finish(self, final: str) -> None:
            turn = self.turn
            for tv in turn.running.values():
                tv.interrupt()
            turn.running.clear()
            secs = int(time.monotonic() - turn.started)
            who = self.agent or "Jav3"
            model = (turn.model or self._model_label()).split("/")[-1]
            if final.startswith(INTERRUPTED):
                await self._close_seg()
                await self.mount_log(Footer(f"[$warning]▣[/] {_esc(who)} · {_esc(model)} · "
                                            f"{secs}s · [$warning]interrupted[/]"))
                return
            if turn.stream is not None:
                await turn.stream.stop()
                turn.stream = None
            # the final reply is authoritative (the rules pass can rewrite it): it
            # replaces the text that streamed, or is added if none did
            if turn.md is not None:
                if final.strip() and final.strip() != turn.seg.strip():
                    await turn.md.update(final)
                turn.printed.append(final or turn.seg)
                turn.md, turn.seg = None, ""
            elif final.strip() and final.strip() not in "".join(turn.printed):
                await self.mount_log(Reply(final))
            self.last_reply = final or "".join(turn.printed)
            await self.mount_log(Footer(f"[$primary]▣[/] {_esc(who)} · {_esc(model)} · {secs}s"))

        async def _end_turn(self) -> None:
            t = self.turn
            if t is not None and t.done and t.cid is not None and not self.ephemeral \
                    and (t.cid != self.cid or not self.sidebar_shown()):
                name = (self.title_text if t.cid == self.cid and self.title_text
                        else f"#{t.cid}")
                self.push_notice(f"reply ready in {_short(name, 60)} · "
                                 f"{int(time.monotonic() - t.started)}s", "done")
            if self.turn is not None:
                self.last_turn = self.turn
            self.turn, self.busy = None, False
            for w in self.pending:        # the server never said either way
                w.fail("not confirmed — the turn ended without delivering it")
            self.pending.clear()
            if self.ephemeral:
                self.cid = None          # a temporary chat is wiped when its turn ends
            self.refresh_chrome()
            await self.refresh_info()

        async def _stop_remote(self) -> None:
            cid = self.turn.cid if self.turn and self.turn.cid else self.cid
            if cid is None:
                return
            try:
                await self.api("POST", f"/api/chat/{cid}/stop")
            except CliError:
                pass

        def interrupt(self) -> None:
            """Stop the turn server-side (every tail then gets its final) and hand
            queued messages back to the prompt."""
            if not self.busy:
                return
            self.stop_requested = True
            if self.queue:
                ed = self.editor
                ed.text = "\n".join(self.queue + ([ed.text] if ed.text else []))
                ed.move_cursor(ed.document.end)
                self.queue.clear()
            if self.turn and self.turn.cid is not None:
                self.run_worker(self._stop_remote(), group="stop")
            # no start event yet: on_event("start") sends the stop when the id arrives

        async def attach(self, cid: int) -> None:
            """Watch a turn that is still running server-side."""
            self.busy, self.stop_requested = True, False
            self.turn = TurnState()
            self.turn.cid = cid
            self.refresh_chrome()
            try:
                # a job's agents stream from their own endpoint: try it when the
                # chat stream 404s or only says idle
                for path in (f"/api/chat/{cid}/stream", f"/api/chat/agents/{cid}/stream"):
                    async with self.client.stream("GET", path) as r:
                        if r.status_code >= 400:
                            await r.aread()
                            continue
                        if await self._consume(r.aiter_lines()):
                            break
            except httpx.HTTPError as e:
                await self.note(f"lost the stream: {e}", "error")
            finally:
                await self._end_turn()
            await self._drain_queue()

        # -- input ---------------------------------------------------------------------------

        @on(Editor.Submitted)
        def _submitted(self, ev) -> None:
            text = ev.text
            if not text.strip():
                return
            self._remember(text)
            self.hist_pos = None
            self.editor.text = ""
            self.hide_popup()
            self.dispatch(text)

        def dispatch(self, text: str) -> None:
            s = text.strip()
            if is_exit(s):
                self.exit()
                return
            if s == "?":
                s = "/help"
            if s.startswith("/") and not s.startswith("//"):
                self.run_worker(self.run_command(s), group="cmd")
            elif s.startswith("!"):
                self.run_worker(self.local_shell(s[1:].strip()), group="shell")
            elif not self.token or self.logged_in is False:
                self.run_worker(self.note(NOT_LOGGED_IN, "warn"), group="cmd")
            else:
                self.send(text[text.index("/") + 1:] if s.startswith("//") else text)

        async def run_command(self, line: str) -> None:
            name, _, arg = line[1:].partition(" ")
            cmd = self.commands.get(name.lower())
            if cmd is None:
                await self.note(f"unknown command /{name} — /help lists them", "error")
                return
            if self.busy and not cmd.busy_ok:
                self.notify(f"/{name} waits for the turn to finish — esc interrupts it",
                            severity="warning")
                return
            try:
                await cmd.fn(arg.strip())
            except CliError as e:
                await self.note(str(e), "error")

        async def local_shell(self, command: str) -> None:
            """`!cmd` runs on THIS machine; its output rides along with the next message."""
            if not command:
                await self.note("usage: !<command> — runs here; the output is attached to "
                                "your next message")
                return
            tv = ToolView("local_shell", {"command": command})
            await self.mount_log(tv)
            try:
                proc = await asyncio.create_subprocess_shell(
                    command, stdout=asyncio.subprocess.PIPE,
                    stderr=asyncio.subprocess.STDOUT, stdin=asyncio.subprocess.DEVNULL)
                out, _ = await asyncio.wait_for(proc.communicate(), 300)
                code = proc.returncode
            except asyncio.TimeoutError:
                proc.kill()
                tv.finish(False, "timed out after 5 minutes")
                return
            text = out.decode("utf-8", "replace").rstrip()
            tv.finish(code == 0, text + (f"\nexit {code}" if code else ""))
            self.attachments.append(f"I ran `{command}` on my machine (exit {code}):\n"
                                    f"```\n{text[-SHELL_KEEP:]}\n```")
            self.refresh_chrome()
            self.notify("output attached to your next message (/detach drops it)")

        # -- completion popup ---------------------------------------------------------------------

        def popup_open(self) -> bool:
            return self.query_one("#popup", OptionList).display

        def hide_popup(self) -> None:
            self.query_one("#popup", OptionList).display = False

        @on(TextArea.Changed, "#editor")
        def _editor_changed(self, ev) -> None:
            self.update_popup()

        def _word_before_cursor(self) -> str:
            ed = self.editor
            row, col = ed.cursor_location
            before = ed.document.get_line(row)[:col]
            return "" if not before or before[-1].isspace() else before.split()[-1]

        def update_popup(self) -> None:
            ed = self.editor
            text = ed.text
            pop = self.query_one("#popup", OptionList)
            items: list[tuple[str, str, str]] = []     # (kind, value, label markup)
            if text.startswith("/") and "\n" not in text:
                if " " not in text:
                    q = text[1:].lower()
                    for name, cmd in self.unique_commands():
                        if name.startswith(q):
                            items.append(("cmd", name, f"[b]/{name}[/] "
                                          f"[$text-muted]{_esc(cmd.usage)}  {_esc(cmd.help)}[/]"))
                else:
                    head, _, arg = text.partition(" ")
                    for value, meta in self.arg_options(head[1:].lower()):
                        if value.startswith(arg) or (arg and arg.lower() in meta.lower()):
                            items.append(("arg", value, f"{_esc(value)}  "
                                          f"[$text-muted]{_esc(meta)}[/]"))
            else:
                word = self._word_before_cursor()
                if word.startswith("@"):
                    paths = self._paths(word[1:])
                    # a word that already names a file needs no menu (Enter sends)
                    if paths != [word[1:]]:
                        for path in paths:
                            items.append(("path", path, _esc(path)))
            self.popup_items = [(k, v) for k, v, _ in items[:40]]
            if not items or (len(items) == 1 and items[0][0] == "cmd"
                             and items[0][1] == text[1:]
                             and not self.commands[items[0][1]].takes_arg):
                pop.display = False
                return
            pop.clear_options()
            for _, _, label in items[:40]:
                pop.add_option(Option(label))
            pop.highlighted = 0
            pop.display = True

        def _paths(self, frag: str) -> list[str]:
            d, _, prefix = frag.rpartition("/")
            base = Path(os.path.expanduser(d or ".")) if d or not frag.startswith("/") \
                else Path("/")
            if frag.startswith("/") and not d:
                base = Path("/")
            try:
                entries = sorted(base.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower()))
            except OSError:
                return []
            out = []
            for p in entries:
                if not p.name.startswith(prefix) or (p.name.startswith(".")
                                                     and not prefix.startswith(".")):
                    continue
                out.append((f"{d}/" if d else "") + p.name + ("/" if p.is_dir() else ""))
                if len(out) >= 40:
                    break
            return out

        def popup_key(self, key: str) -> None:
            pop = self.query_one("#popup", OptionList)
            if key == "escape":
                self.hide_popup()
            elif key == "up":
                pop.action_cursor_up()
            elif key == "down":
                pop.action_cursor_down()
            elif key in ("tab", "enter"):
                i = pop.highlighted or 0
                if not self.popup_items:
                    self.hide_popup()
                    return
                kind, value = self.popup_items[min(i, len(self.popup_items) - 1)]
                self.accept_popup(kind, value, submit=(key == "enter"))

        def accept_popup(self, kind: str, value: str, submit: bool) -> None:
            ed = self.editor
            if kind == "cmd":
                cmd = self.commands[value]
                if cmd.takes_arg:
                    ed.text = f"/{value} "
                    ed.move_cursor(ed.document.end)
                    self.update_popup()
                    if not self.popup_open() and submit and not self.arg_options(value):
                        self.hide_popup()
                    return
                ed.text = f"/{value}"
                ed.move_cursor(ed.document.end)
                self.hide_popup()
                if submit:
                    ed.post_message(Editor.Submitted(ed.text))
                return
            if kind == "arg":
                head = ed.text.partition(" ")[0]
                ed.text = f"{head} {value}"
                ed.move_cursor(ed.document.end)
                self.hide_popup()
                if submit:
                    ed.post_message(Editor.Submitted(ed.text))
                return
            # an @path: swap the word before the cursor
            row, col = ed.cursor_location
            word = self._word_before_cursor()
            start = col - len(word)
            ed.replace(f"@{value}" + ("" if value.endswith("/") else " "),
                       (row, start), (row, col))
            if value.endswith("/"):
                self.update_popup()
            else:
                self.hide_popup()

        # -- keys ---------------------------------------------------------------------------------

        def check_action(self, action: str, parameters) -> bool | None:
            if action in self._MAIN_ONLY and isinstance(self.screen, (ModalScreen,
                                                                      AgentsScreen)):
                return False
            return True

        def action_leader(self) -> None:
            self.leader = True
            if self._leader_timer is not None:
                self._leader_timer.stop()
            self._leader_timer = self.set_timer(2, self._leader_off)
            self._refresh_status()

        def _leader_off(self) -> None:
            self.leader = False
            self._refresh_status()

        def run_leader(self, key: str) -> None:
            self._leader_off()
            if key == "b":
                self.action_toggle_sidebar()
                return
            for name, cmd in self.unique_commands():
                if cmd.leader == key:
                    self.dispatch(f"/{name}")
                    return

        def action_ctrl_c(self) -> None:
            if isinstance(self.screen, ModalScreen):
                self.screen.dismiss(None)
                return
            if isinstance(self.screen, AgentsScreen):
                self.pop_screen()
                return
            if self.editor.text:
                self.editor.text = ""
                self.hide_popup()
            elif self.busy:
                self.interrupt()
            elif time.monotonic() - self.ctrl_c_at < 2:
                self.exit()
            else:
                self.ctrl_c_at = time.monotonic()
                self.notify("ctrl+c again to quit", timeout=2)

        def action_ctrl_d(self) -> None:
            if self.editor.text:
                self.editor.action_delete_right()
            else:
                self.exit()

        def action_escape(self) -> None:
            if self.leader:
                self._leader_off()
            elif self.popup_open():
                self.hide_popup()
            elif self.busy:
                if time.monotonic() - self.esc_armed < 2:
                    self.esc_armed = 0.0
                    self.interrupt()
                else:
                    self.esc_armed = time.monotonic()
                self._refresh_status()
            elif self.editor.text:
                if time.monotonic() - self.esc_armed < 1:
                    self.editor.text = ""
                    self.esc_armed = 0.0
                else:
                    self.esc_armed = time.monotonic()
                    self.notify("esc again to clear the prompt", timeout=1)

        def action_new(self) -> None:
            self.dispatch("/new")

        def action_agents_view(self) -> None:
            if not isinstance(self.screen, AgentsScreen):
                self.hide_popup()
                self.push_screen(AgentsScreen(self.cid))

        async def open_node(self, node: dict) -> None:
            """Open an agents-screen node here: its transcript, and if it is
            running, its live stream (typing then messages it mid-turn)."""
            await self._leave_turn()
            try:
                await self.open_conversation(node["id"], running=bool(node.get("running")))
            except CliError as e:
                await self.note(str(e), "error")
                return
            if node.get("kind") == "orchestrator":
                self.orchestrator = True
            if node.get("title"):
                self.title_text = self.title_text or node["title"]
            self.refresh_chrome()

        async def _leave_turn(self) -> None:
            """Stop watching the turn on screen (it keeps running server-side)."""
            if not self.busy:
                return
            workers = [w for w in self.workers if w.group == "turn" and w.is_running]
            for w in workers:
                w.cancel()
            for w in workers:
                with contextlib.suppress(Exception):
                    await w.wait()
            if self.queue:
                ed = self.editor
                ed.text = "\n".join(self.queue + ([ed.text] if ed.text else []))
                ed.move_cursor(ed.document.end)
                self.queue.clear()
            self.pending.clear()
            self.turn, self.busy, self.stop_requested = None, False, False

        def action_toggle_sidebar(self) -> None:
            shown = self.query_one("#sidebar").display
            self.sidebar_pref = not shown
            if self.sidebar_pref:
                self.unread = 0
            self._save_settings(sidebar=self.sidebar_pref)
            self.refresh_chrome()

        def action_toggle_tools(self) -> None:
            self.tools_expanded = not self.tools_expanded
            for tv in self.query(ToolView):
                tv.expanded = self.tools_expanded
                tv.redraw()

        def action_scroll_log(self, direction: int) -> None:
            lv = self.log_view
            if direction < 0:
                lv.scroll_page_up()
            else:
                lv.scroll_page_down()

        def action_external_editor(self) -> None:
            import subprocess
            import tempfile
            editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
            with tempfile.NamedTemporaryFile("w+", suffix=".md", delete=False) as f:
                f.write(self.editor.text)
                path = f.name
            try:
                with self.suspend():
                    subprocess.call([*editor.split(), path])
                self.editor.text = Path(path).read_text().rstrip("\n")
                self.editor.move_cursor(self.editor.document.end)
            finally:
                os.unlink(path)

        # -- slash commands ---------------------------------------------------------------------

        def _commands(self) -> dict[str, Command]:
            c = {
                "help": Command(self.c_help, "commands and keys", busy_ok=True, leader="h"),
                "new": Command(self.c_new, "start a fresh chat", leader="n"),
                "sessions": Command(self.c_sessions, "switch to another chat", "[id]",
                                    takes_arg=True, leader="l"),
                "models": Command(self.c_model, "pick the model (full access: switch "
                                  "models on/off, set the default)", "[provider/id]",
                                  takes_arg=True, leader="m"),
                "provider": Command(self.c_provider, "add a provider's API key / base URL, "
                                    "then test it", "[id]", takes_arg=True, leader="k"),
                "agents": Command(self.c_agent, "start a new chat as an agent", "[slug]",
                                  takes_arg=True, leader="a"),
                "project": Command(self.c_project, "pin this chat to a project (or make "
                                   "a new one)", "[slug|none|follow]", takes_arg=True,
                                   leader="p"),
                "themes": Command(self.c_theme, "change the colours", "[name]",
                                  takes_arg=True, busy_ok=True, leader="t"),
                "temp": Command(self.c_temp, "toggle temporary chats (nothing saved)"),
                "rename": Command(self.c_rename, "rename this chat", "[title]",
                                  takes_arg=True, leader="r"),
                "star": Command(self.c_star, "star or unstar this chat"),
                "delete": Command(self.c_delete, "delete this chat (asks first)"),
                "retry": Command(self.c_retry, "send your last message again"),
                "stop": Command(self.c_stop, "stop the running turn", busy_ok=True),
                "copy": Command(self.c_copy, "copy the last reply", busy_ok=True, leader="y"),
                "export": Command(self.c_export, "save this chat as markdown", "[file]",
                                  takes_arg=True, busy_ok=True, leader="x"),
                "details": Command(self.c_details, "expand or collapse tool output (ctrl+o)",
                                   busy_ok=True),
                "detach": Command(self.c_detach, "drop pending !command output",
                                  busy_ok=True),
                "web": Command(self.c_web, "open this chat in the browser", busy_ok=True,
                               leader="w"),
                "status": Command(self.c_status, "server, chat, model, usage", busy_ok=True,
                                  leader="s"),
                "editor": Command(self.c_editor, "write the prompt in $EDITOR (ctrl+g)",
                                  busy_ok=True, leader="e"),
                "orchestration": Command(self.c_orchestrate, "brain-dump a problem; an "
                                         "orchestrator sends agents at it", "[project]",
                                         takes_arg=True, leader="o"),
                "agents-view": Command(self.c_agents_view, "every agent and chat that is "
                                       "working, across projects (← on an empty prompt)",
                                       busy_ok=True, leader="g"),
                "login": Command(self.c_login, "log in: the line from Settings (chat only) "
                                 "or your password (full access)", "[line|password]"),
                "logout": Command(self.c_logout, "log out (a device token is revoked)"),
                "exit": Command(self.c_exit, "quit (a running turn keeps going)",
                                busy_ok=True, leader="q"),
            }
            for alias, name in (("quit", "exit"), ("resume", "sessions"),
                                ("history", "sessions"), ("model", "models"),
                                ("agent", "agents"), ("theme", "themes"),
                                ("clear", "new"), ("tools", "details"),
                                ("providers", "provider"),
                                ("orchestrate", "orchestration")):
                c[alias] = c[name]
            return c

        def unique_commands(self):
            seen = set()
            for name, cmd in self.commands.items():
                if id(cmd) not in seen:
                    seen.add(id(cmd))
                    yield name, cmd

        def arg_options(self, name: str) -> list[tuple[str, str]]:
            cmd = self.commands.get(name)
            fn = cmd.fn if cmd else None
            o = self.options or {}
            if fn == self.c_model:
                return [(m["id"], m.get("label", "") + ("  (default)" if m["id"] == o.get("default")
                                                        else ""))
                        for m in o.get("models", [])]
            if fn == self.c_agent:
                return [("none", "plain Jav3")] + [(a["slug"], a.get("name", ""))
                                                  for a in o.get("agents", [])]
            if fn == self.c_project:
                return ([("none", "no project: files go to the chat's artifacts"),
                         ("follow", "whatever project is loaded")]
                        + [(p["slug"], p.get("name", "")) for p in o.get("projects", [])])
            if fn == self.c_orchestrate:
                return [(p["slug"], p.get("name", "")) for p in o.get("projects", [])]
            if fn == self.c_sessions:
                return [(str(cv["id"]), _short(cv.get("summary") or "(untitled)", 60))
                        for cv in self.convs[:60]]
            if fn == self.c_theme:
                return [(t, "") for t in sorted(self.available_themes)]
            if fn == self.c_login:
                return [("password", "full access"), ("line", "chat only")]
            return []

        async def pick(self, title: str, rows, current=None, custom=False, hint="",
                       actions=None):
            return await self.push_screen_wait(Picker(title, rows, current, custom, hint,
                                                      actions))

        async def c_help(self, arg: str) -> None:
            lines = ["# Jav3", "", "## Commands", "", "| command | | leader |", "|---|---|---|"]
            for name, cmd in self.unique_commands():
                lead = f"ctrl+x {cmd.leader}" if cmd.leader else ""
                usage = f"/{name} {cmd.usage}".rstrip().replace("|", "\\|")
                lines.append(f"| {usage} | {cmd.help} | {lead} |")
            lines += ["", "## Keys", "", "| key | |", "|---|---|"]
            for k, v in [("enter", "send (while a turn runs: the agent gets it at its "
                                   "next step)"),
                         ("← (empty prompt)", "agents screen: everything working, "
                                              "across projects"),
                         ("ctrl+j · shift+enter · alt+enter · \\⏎", "new line"),
                         ("esc esc", "interrupt the running turn"),
                         ("esc esc (idle)", "clear the prompt"),
                         ("ctrl+c", "clear prompt · interrupt · twice to quit"),
                         ("ctrl+x then a key", "leader: see the table above; "
                                               "b = notifications"),
                         ("ctrl+p", "command palette"),
                         ("ctrl+n", "new chat"),
                         ("ctrl+b", "notifications sidebar (● n = unread)"),
                         ("in a picker", "↑↓ enter esc · t or any letter filters"),
                         ("exit · quit", "alone on the prompt: quit"),
                         ("ctrl+o", "expand / collapse tool output (or click a tool)"),
                         ("ctrl+g", "edit the prompt in $EDITOR"),
                         ("pgup / pgdn", "scroll the transcript"),
                         ("↑ ↓", "prompt history"),
                         ("tab", "complete a /command, its argument or an @path"),
                         ("!cmd", "run a command here; output goes with your next message"),
                         ("@path", "attach a local file"),
                         ("//text", "send text that starts with a slash"),
                         ("ctrl+d", "quit on an empty prompt")]:
                lines.append(f"| `{k}` | {v} |")
            await self.push_screen_wait(Help("\n".join(lines)))

        async def c_new(self, arg: str = "") -> None:
            self.cid, self.title_text, self.last_reply = None, None, ""
            self.shown_model, self.info, self.todos = None, None, []
            self.orchestrator = False
            await self.show_home()

        async def c_sessions(self, arg: str) -> None:
            convs = await self.refresh_convs()
            if not arg:
                rows = []
                for cv in convs[:100]:
                    meta = (cv.get("started_at") or "")[:16]
                    if cv.get("project_slug"):
                        meta += f"  ⌂ {cv['project_slug']}"
                    if cv.get("running"):
                        meta += "  ● running"
                    if cv.get("starred"):
                        meta = "★ " + meta
                    rows.append((str(cv["id"]), cv.get("summary") or "(untitled)", meta))
                arg = await self.pick("Sessions", rows, str(self.cid) if self.cid else None,
                                      hint="type to filter · enter opens") or ""
                if not arg:
                    return
            if not arg.isdigit():
                hits = [cv for cv in convs if arg.lower() in (cv.get("summary") or "").lower()]
                if not hits:
                    raise CliError(f"no chat matches {arg!r}")
                arg = str(hits[0]["id"])
            await self.open_conversation(int(arg))

        async def open_conversation(self, cid: int, running: bool = False) -> None:
            r = await self.api("GET", f"/api/conversations/{cid}/messages")
            self.cid, self.ephemeral = cid, False
            self.orchestrator = r.get("kind") == "orchestrator" or r.get("mode") == "orchestrate"
            meta = next((cv for cv in self.convs if cv.get("id") == cid), {})
            self.title_text = meta.get("summary")
            self.agent = r.get("agent_slug") or None
            self.project = meta.get("project_slug") or None
            self.project_mode = "pin" if self.project else None
            self.todos, self.last_reply = [], ""
            await self.clear_log()
            msgs = [m for m in r.get("messages", []) if m.get("role") in ("user", "assistant")]
            if len(msgs) > 60:
                await self.note(f"… {len(msgs) - 60} earlier messages (/export has them all)")
            for m in msgs[-60:]:
                if m["role"] == "user":
                    await self.log_view.mount(UserMsg(_esc(m.get("content") or "")))
                    continue
                for a in m.get("activity") or []:
                    tv = ToolView(a["name"], a.get("args"), ok=a.get("ok"),
                                  result=a.get("result"), done=True)
                    await self.log_view.mount(tv)
                    if a["name"] == "todo_update" and parse_todos(a.get("result") or ""):
                        self.todos = parse_todos(a["result"])
                if (m.get("content") or "").strip():
                    await self.log_view.mount(Reply(m["content"]))
                if m.get("model"):
                    self.shown_model = m["model"]
                who = self.agent or "Jav3"
                await self.log_view.mount(Footer(
                    f"[$primary]▣[/] {_esc(who)} · {_esc((m.get('model') or '').split('/')[-1])}"))
                self.last_reply = m.get("content") or ""
            self.log_view.scroll_end(animate=False)
            await self.refresh_info()
            if r.get("running") or running:
                for a in r.get("pending_activity") or []:
                    await self.log_view.mount(ToolView(a["name"], a.get("args"), ok=a.get("ok"),
                                                       result=a.get("result"), done=True))
                await self.note("a turn is running — attached", "warn")
                self.run_worker(self.attach(cid), group="turn")

        async def c_model(self, arg: str) -> None:
            if not arg and self.full_access:
                await self._pick_model_full()
                return
            if not arg:
                rows = [(v, v.split("/")[-1], meta) for v, meta in self.arg_options("models")]
                cur = self.model or self.shown_model or (self.options or {}).get("default")
                arg = await self.pick("Models", rows, cur, custom=True,
                                      hint="provider/model · 'default' clears the pin") or ""
                if not arg:
                    return
            if arg in ("default", "none"):
                self.model = None
                self.notify("model: server default for new chats")
                self.refresh_chrome()
                return
            known = [m["id"] for m in (self.options or {}).get("models", [])]
            if known and arg not in known:
                near = [k for k in known if arg in k]
                if len(near) != 1:
                    raise CliError(f"not an enabled model: {arg}")
                arg = near[0]
            self.model = arg
            self.notify(f"model: {arg}" + (" — pinned to this chat from the next message"
                                           if self.cid else ""))
            self.refresh_chrome()

        async def c_agent(self, arg: str) -> None:
            if not arg:
                rows = [(v, meta or v, "") for v, meta in self.arg_options("agents")]
                arg = await self.pick("Agents", rows, self.agent or "none", custom=True,
                                      hint="a new chat starts as the agent you pick") or ""
                if not arg:
                    return
            self.agent = None if arg == "none" else arg
            await self.c_new()
            self.notify(f"new chat as {self.agent or 'Jav3'}")

        async def c_project(self, arg: str) -> None:
            if not arg:
                actions = {"l": ("load as active", self._load_project)} \
                    if self.full_access else None
                arg = await self.pick("Projects", await self._project_rows(),
                                      self.project or self.project_mode, custom=True,
                                      actions=actions,
                                      hint="enter pins this chat to it") or ""
                if not arg:
                    return
            if arg == NEW_PROJECT:
                arg = await self._new_project() or ""
                if not arg:
                    return
            mode = arg if arg in ("none", "follow") else "pin"
            slug = arg if mode == "pin" else None
            if self.cid is not None:
                body = {"mode": mode}
                if slug:
                    body["project"] = slug
                await self.api("PATCH", f"/api/conversations/{self.cid}", json=body)
            self.project, self.project_mode = slug, mode
            self.notify({"pin": f"project: {slug}",
                         "none": "project: none — file work goes to the chat's artifacts",
                         "follow": "project: follows whatever is loaded"}[mode])
            self.refresh_chrome()

        async def c_theme(self, arg: str) -> None:
            if not arg:
                before = self.theme
                rows = [(t, t, "") for t in sorted(self.available_themes)]
                arg = await self.pick("Themes", rows, before) or ""
                if not arg:
                    return
            if arg not in self.available_themes:
                raise CliError(f"no theme {arg!r}")
            self.theme = arg
            self._save_settings(theme=arg)

        async def c_temp(self, arg: str) -> None:
            self.ephemeral = not self.ephemeral
            if self.ephemeral:
                await self.c_new()
                self.notify("temporary: each message is a standalone chat, and nothing is "
                            "saved", severity="warning")
            else:
                self.notify("temporary off")
            self.refresh_chrome()

        async def c_rename(self, arg: str) -> None:
            if self.cid is None:
                raise CliError("no chat yet — send a message first")
            if not arg:
                arg = (await self.push_screen_wait(Ask("Rename chat",
                                                       value=self.title_text or "")) or "").strip()
                if not arg:
                    return
            r = await self.api("PATCH", f"/api/conversations/{self.cid}", json={"title": arg})
            self.title_text = r.get("title", arg)
            self.refresh_chrome()

        async def c_star(self, arg: str) -> None:
            if self.cid is None:
                raise CliError("no chat yet — send a message first")
            await self.refresh_convs()
            cur = next((cv.get("starred") for cv in self.convs if cv.get("id") == self.cid),
                       False)
            await self.api("PATCH", f"/api/conversations/{self.cid}", json={"starred": not cur})
            self.notify("starred" if not cur else "unstarred")

        async def c_delete(self, arg: str) -> None:
            cid = int(arg) if arg.isdigit() else self.cid
            if cid is None:
                raise CliError("no chat to delete")
            if not await self.push_screen_wait(Confirm(f"Delete chat #{cid}?",
                                                       "This cannot be undone.")):
                return
            await self.api("DELETE", f"/api/conversations/{cid}")
            self.notify(f"deleted #{cid}")
            if cid == self.cid:
                await self.c_new()

        async def c_retry(self, arg: str) -> None:
            if not self.last_user:
                raise CliError("nothing to retry")
            self.send(self.last_user)

        async def c_stop(self, arg: str) -> None:
            if not self.busy:
                self.notify("nothing is running")
                return
            self.interrupt()

        async def c_copy(self, arg: str) -> None:
            if not self.last_reply:
                raise CliError("no reply to copy yet")
            how = copy_to_clipboard(self.last_reply, osc52=self.copy_to_clipboard)
            self.notify(f"copied the last reply ({how})")

        async def c_export(self, arg: str) -> None:
            if self.cid is None:
                raise CliError("no chat to export")
            r = await self.api("GET", f"/api/conversations/{self.cid}/messages")
            path = Path(os.path.expanduser(arg or f"jav3-{self.cid}.md"))
            path.write_text(transcript_markdown(self.title_text or f"Jav3 chat #{self.cid}",
                                                r.get("messages", [])))
            self.notify(f"saved {path}")

        async def c_details(self, arg: str) -> None:
            self.action_toggle_tools()

        async def c_detach(self, arg: str) -> None:
            n, self.attachments = len(self.attachments), []
            self.refresh_chrome()
            self.notify(f"dropped {n} pending output{'s' * (n != 1)}")

        async def c_web(self, arg: str) -> None:
            import webbrowser
            url = self.base + (f"/shell/c/{self.cid}" if self.cid else "/shell")
            webbrowser.open(url)
            self.notify(f"opened {url}")

        async def c_status(self, arg: str) -> None:
            info = self.info or {}
            rows = [("server", self.base or "(none)"), ("signed in as", self.whoami),
                    ("access", self._access_label()),
                    ("chat", f"#{self.cid} {self.title_text or ''}" if self.cid else "(new)"),
                    ("model", self._model_label()),
