        @classmethod
        def build(cls, app, args) -> "SecurityPage":
            return cls(args, project=app.project, conversation=app.cid)

        @property
        def page_title(self) -> str:
            return f"{self.TITLE} · {self.LABELS[self.tab]}"

        def set_args(self, args) -> None:
            """/security calls while it is showing: switch to that tab."""
            super().set_args(args)
            tab = self.args[0].lower() if self.args else self.TABS[0]
            self.run_worker(self.switch_to(self.TABS.index(tab) if tab in self.TABS else 0),
                            group="sec-switch")

        def page_shown(self) -> None:
            if self.shown_count > 1 and not self.locked:    # back from another page
                self.run_worker(self.load(self.tab), group="sec-load", exclusive=True)

        @property
        def locked(self) -> bool:
            return not self.app.full_access

        def locked_text(self) -> str:
            """Said once, in the head: who is asking, and the one key that fixes it."""
            if not self.app.token or self.app.logged_in is False:
                return "not logged in — press enter to log in"
            return ("this login is chat only — press enter to log in with your password "
                    "for full access")

        async def _login_from_here(self) -> None:
            await self.app.run_command("/login password")
            if not self.locked:                  # the poll would notice in a few seconds
                await self._first_load()

        def compose(self) -> ComposeResult:
            with Horizontal(id="sec-tabs"):
                for t in self.TABS:
                    yield SecTab(t)
            yield Static(id="sec-sub")
            yield VerticalScroll(id="sec-list", can_focus=False)
            with VerticalScroll(id="sec-detail-wrap", can_focus=False):
                yield Static(id="sec-detail")
            yield Static(id="sec-foot")

        async def on_mount(self) -> None:
            # a widget has no size until its first layout: remember what the first
            # draw saw, so the first Resize (the real width) draws again if it differs
            self._narrow = self.size.width < 100
            self._was_tight = (self._tight(), self.size.width < 80)
            await self.rebuild()
            if not self.locked:
                self.run_worker(self._first_load(), group="sec-load")
            self.poll(self.POLL_SECONDS, self._tick)

        async def _first_load(self) -> None:
            await self.load(self.tab)
            for t in self.COUNTED:                    # the header's counts
                if t != self.tab:
                    await self.load(t, draw=False)
            await self.rebuild()

        def _tick(self) -> None:
            if not self.locked and self.active:
                self.run_worker(self.load(self.tab), group="sec-load", exclusive=True)

