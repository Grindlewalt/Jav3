        return "image builds (fixed policy)" if slug == IMAGE_BUILD else str(slug)

    def _pkg_card(r: dict) -> str:
        """The server's one-line card ("installs into `dev` — used by: a, b"),
        or the same built from the row when an older server sends none."""
        if r.get("card"):
            return str(r["card"])
        users = _jlist(r.get("variant_used_by"))
        return (f"installs into `{r.get('target_variant') or '?'}` — used by: "
                + (", ".join(map(str, users)) or "no project yet"))

    def _pkg_users(r: dict) -> str:
        """variant_used_by_detail: who is on the variant directly, who through
        a variant built from it."""
        d = r.get("variant_used_by_detail") or {}
        if not isinstance(d, dict) or not d:
            return ""
        bits = ["directly: " + (", ".join(map(str, _jlist(d.get("direct")))) or "none")]
        for v, slugs in dict(d.get("via") or {}).items():
            bits.append(f"via {v}: " + (", ".join(map(str, _jlist(slugs))) or "none"))
        return " · ".join(bits)

    def _row_policy(e) -> str:
        slug, p = e["raw"]["slug"], e["raw"].get("policy") or {}
        head = f"[$accent b]⌂ {_esc(slug)}[/]"
        if "project_allow" in p or "profile" in p:
            prof = p.get("profile") or {}
            allow, deny = _jlist(p.get("project_allow")), _jlist(p.get("project_deny"))
            off = f" {RED} network off [/]" if prof.get("network_off") else ""
            return (f"{head} [$text-muted]profile[/] [b]{_esc(prof.get('name') or '?')}[/]{off} "
                    f"[$text-muted]({_esc(prof.get('default') or '?')} by default) ·[/] "
                    f"[$success]allow {len(allow)}[/]"
                    f"{_esc(': ' + _short(', '.join(allow), 40)) if allow else ''} "
                    f"[$text-muted]·[/] [$error]deny {len(deny)}[/]"
                    f"{_esc(': ' + _short(', '.join(deny), 40)) if deny else ''}")
        if p:
            eff = _jlist(p.get("effective"))
            return (f"{head} [$text-muted]policy {_esc(p.get('mode') or '?')} · {len(eff)} "
                    f"host{'s' * (len(eff) != 1)}[/]")
        return f"{head} [$text-muted]no policy read[/]"

    def _row_group(e) -> str:
        return f"[$accent b]{_esc(e['raw'].get('slug') or '')}[/]"

    def _row_pbox(e) -> str:
        r = e["raw"]
        t = r.get("totals") or {}
        n = t.get("procs") if isinstance(t.get("procs"), int) else e.get("count", 0)
        orph = len(_jlist(r.get("orphan_conns")))
        first = not r.get("reported_at")             # booted, not yet heard from: not stale
        flags = (f" {AMBER} stale [/]" if r.get("stale") and not first else "")
        if orph:
            flags += f" {RED} {orph} possibly hidden process{'es' * (orph != 1)} [/]"
        if r.get("error"):
            flags += f" [$error]error: {_esc(_short(str(r['error']), 50))}[/]"
        if r.get("truncated"):
            flags += " [$warning]truncated[/]"
        if r.get("baseline") == "builtin":
            flags += " [$text-muted]builtin baseline[/]"
        return (f"[$accent b]▣ {_esc(r.get('box_id') or '?')}[/] [$text-muted]"
                f"{_esc(r.get('kind') or '')}"
                f"{' ⌂ ' + _esc(r['project']) if r.get('project') else ''} · "
                f"{n} process{'es' * (n != 1)}"
                + (f" · {t['unexpected']} unexpected" if t.get("unexpected") else "")
                + (" · not reported yet" if first else
                   f" · reported {_esc(local_ts(r.get('reported_at')) or str(r['reported_at']))}")
                + f"[/]{flags}")

    def _row_orphan(e) -> str:
        c = e["raw"]
        return (f"  {RED} ? possibly hidden process [/] "
                f"{_esc(c.get('proto') or '?')} → {_esc(c.get('host') or '')} "
                f"{_esc(str(c.get('raddr') or ''))}:{_esc(str(c.get('rport') or ''))} "
                f"[$text-muted]no reported process owns it · host ↑"
                f"{_bytes(c.get('host_bytes_out'))} ↓{_bytes(c.get('host_bytes_in'))}[/]")

    def _row_proc(e) -> str:
        r, depth = e["raw"], e.get("depth", 1)
        kids = r.get("children") or []
        arrow = ("▾" if e.get("open") else "▸") if kids else "·"
        tag = r.get("tag") or ""
        if tag == "unexpected":
            badge = f"{RED} UNEXPECTED [/] "
        elif tag == "service":
            badge = f"[$success]svc:{_esc(str(r.get('service_id') or '?'))}[/] "
        elif tag:
            badge = f"[$secondary]{_esc(tag)}[/] "
        else:
            badge = ""
        flags = [_conn_flag(c) for c in r.get("conns") or []]
        conns = (f" [$text-muted]{len(flags)} conn{'s' * (len(flags) != 1)}[/]"
                 if flags else "")
        if "mismatch" in flags:
            conns += f" {RED} bytes mismatch [/]"
        below = (f" {RED} ! below [/]" if e.get("hidden_bad") else "")
        more = f" [$text-muted](+{_tree_count(kids)})[/]" if kids and not e.get("open") else ""
        return ("  " * (depth - 1) + f"{arrow} {badge}[b]{_esc(str(r.get('pid') or '?'))}[/] "
                f"{_esc(_short(r.get('cmd') or r.get('exe') or '?', 60))} "
                f"[$text-muted]{_esc(r.get('user') or '')} {_bytes(r.get('rss'))}B "
                f"{_num(r.get('cpu_pct')) or 0:.0f}%[/]{conns}{more}{below}")

    def _row_svc(e) -> str:
        r = e["raw"]
        st = r.get("state") or "?"
        col = {"running": "$success", "failed": "$error", "unreported": "$warning"}.get(
            st, "$text-muted")
        want = (" [$text-muted](stopped by the operator)[/]"
                if r.get("desired_state") == "stopped" else "")
        err = f" [$error]{_esc(_short(str(r['error']), 60))}[/]" if r.get("error") else ""
        return (f"[{col}]●[/] [b]{_esc(r.get('name') or '?')}[/] [$text-muted]#{r.get('id')} "
                f"⌂ {_esc(r.get('project_slug') or '?')} · placement[/] "
                f"[b]{_esc(r.get('placement') or '?')}[/] [$text-muted]·[/] [{col}]{_esc(st)}[/]"
                f"{want} [$text-muted]· box {_esc(r.get('box_id') or '-')}[/]{err}")

    def _row_profile(e) -> str:
        p = e["raw"]
        projects = _jlist(p.get("projects"))
        return (f"[b]{_esc(p.get('name') or '?')}[/]"
                + (" [$text-muted]default[/]" if p.get("is_default") else "")
                + f"  {_runtime_tag(p.get('box_runtime'))} [$text-muted]· placement[/] "
                  f"{_esc(p.get('service_placement') or 'NOT SET')} [$text-muted]· "
                  f"{_esc(p.get('default_verdict') or '?')} by default"
                + (" · network off" if p.get("network_off") else "")
                + f" · {len(projects)} project{'s' * (len(projects) != 1)}[/]")

