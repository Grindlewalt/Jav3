        BINDINGS = [Binding("escape", "cancel", show=False),
                    Binding("ctrl+s", "save", show=False)]
        DEFAULT_CSS = """
        .te-row { height: 1; }
        .te-gap { height: 1; }
        .te-cell { width: 1fr; height: 1; }
        .te-label { width: 12; }
        .te-cell Input, .te-row Input { width: 9; background: $panel; }
        #th-name { width: 30; }
        .te-swatch { width: 1fr; margin-left: 1; }
        """

        def __init__(self, base: dict, reserved) -> None:
            super().__init__()
            self.base, self.reserved = base, reserved

        def _cell(self, k: str) -> ComposeResult:
            with Horizontal(classes="te-cell"):
                yield Static(k, classes="te-label")
                yield Input(value=self.base.get(k, ""), placeholder="#rrggbb", max_length=7,
                            id=f"th-{k}", compact=True)
                yield Static("", id=f"sw-{k}", classes="te-swatch")

        def compose(self) -> ComposeResult:
            with Vertical(id="dialog"):
                with Horizontal(id="dialog-head"):
                    yield Static("[b]New theme[/]", id="dialog-title")
                    yield Static("[$text-muted]tab next · ctrl+s save · esc cancel[/]",
                                 id="dialog-esc")
                with VerticalScroll(id="view-body"):
                    with Horizontal(classes="te-row"):
                        yield Static("name", classes="te-label")
                        yield Input(value=self.base.get("name", ""), placeholder="My theme",
                                    max_length=40, id="th-name", compact=True)
                    with Horizontal(classes="te-row"):
                        yield Static("mode", classes="te-label")
                        yield ModeToggle(bool(self.base.get("dark", True)), id="th-dark")
                    yield Static("", classes="te-gap")
                    for i in range(0, len(THEME_COLOURS), 2):
                        with Horizontal(classes="te-row"):
                            for k in THEME_COLOURS[i:i + 2]:
                                yield from self._cell(k)
                yield Static("", id="dialog-hint")

        def on_mount(self) -> None:
            self.before = self.app.theme
            self.query_one("#th-name", Input).focus()
            self.preview()

        def values(self) -> dict:
            d = {"name": self.query_one("#th-name", Input).value.strip(),
                 "dark": self.query_one("#th-dark", ModeToggle).dark}
            for k in THEME_COLOURS:
                v = self.query_one(f"#th-{k}", Input).value.strip()
                if v:
                    d[k] = v
            return d

        def hint(self, text: str, error: bool = False, warn: str = "") -> None:
            self.query_one("#dialog-hint", Static).update(
                f"[{'$error' if error else '$text-muted'}]{_esc(text)}[/]"
                + (f"\n[$warning]{_esc(warn)}[/]" if warn else ""))

        def preview(self) -> None:
            d = self.values()
            for k in THEME_COLOURS:
                v = d.get(k, "")
                v = NAMED_COLOURS.get(v.lower(), v)
                if _HEX.fullmatch(v) and not self.app.truecolor:
                    v = snap_colour(v)              # the swatch shows what the terminal will
                self.query_one(f"#sw-{k}", Static).update(
                    f"[on {v}]      [/]" if _HEX.fullmatch(v) else
                    ("" if not v else "[$error]✗[/]"))
            try:
                clean = validate_theme({**d, "name": "preview"})
            except ThemeError as e:
                self.hint(str(e), True)
                return
            self.app.add_theme({**clean, "name": THEME_PREVIEW})
            self.app.theme = THEME_PREVIEW
            problems = theme_problems(resolved_theme_spec(self.app.theme_src[THEME_PREVIEW]),
                                      self.app.truecolor)
            self.hint("previewing — ctrl+s saves to " + str(themes_dir()),
                      warn=("⚠ " + problems[0] + (f" (+{len(problems) - 1} more)"
                                                   if len(problems) > 1 else ""))
                      if problems else "")

        def on_input_changed(self, event) -> None:
            self.preview()

        def on_mode_toggle_changed(self, event) -> None:
            self.preview()

        def _restore(self) -> None:
            if self.app.theme == THEME_PREVIEW:
                self.app.theme = self.before
            self.app.drop_theme(THEME_PREVIEW)

        def action_cancel(self) -> None:
            self._restore()
            self.dismiss(None)

        def action_save(self) -> None:
            try:
                clean = validate_theme(self.values(), self.reserved)
                save_theme(clean)
            except ThemeError as e:
                self.hint(str(e), True)
                return
            self.app.add_theme(clean)
            self._restore()
            self.dismiss(clean["name"])

    class ServiceApprove(ModalScreen):
        """A service request's review: the definition and its diff, then two
        explicit choices. Placement: 1 per_service · 2 per_project · 3 shared,
        preselected from the profile; no pick, no approval. Ports: ↑↓ pick a
        port, space cycles none → host → lan (lan only when the server has a
        services LAN IP). Enter goes on to the confirm; esc drops it."""

        BINDINGS = [Binding("escape", "cancel", show=False),
                    Binding("1", "place(0)", show=False),
                    Binding("2", "place(1)", show=False),
                    Binding("3", "place(2)", show=False),
                    Binding("up,k", "port(-1)", show=False),
                    Binding("down,j", "port(1)", show=False),
                    Binding("space,e", "expose", show=False),
                    Binding("enter", "ok", show=False)]

        def __init__(self, req: dict, diff: str | None, lan_ip: str) -> None:
            super().__init__()
            self.req, self.diff, self.lan_ip = req, diff, lan_ip
            pl = req.get("placement")
            self.profile_placement = pl if pl in PLACEMENTS else None
            self.placement = self.profile_placement
            self.ports = [p for p in _jlist(req.get("ports")) if isinstance(p, dict)]
            self.expose = ["none"] * len(self.ports)
            self.cur = 0
            self.error = ""

        def compose(self) -> ComposeResult:
            r = self.req
            with Vertical(id="dialog", classes="wide"):
                with Horizontal(id="dialog-head"):
                    yield Static(f"[b]Approve service {_esc(r.get('name') or '?')}[/]  "
                                 f"[$text-muted]⌂ {_esc(r.get('project_slug') or '?')} · "
                                 f"#{r.get('id')}[/]", id="dialog-title")
                    yield Static("[$text-muted]esc[/]", id="dialog-esc")
                body = [_esc(r.get("description") or "")] + _svc_definition(r)
                if r.get("supersedes_id"):
                    body += ["", f"[b]changes against approved #{r['supersedes_id']}:[/]",
                             _diff_markup(self.diff) if self.diff
                             else "[$warning]diff unavailable[/]"]
                with VerticalScroll(id="sa-body"):
                    yield Static("\n".join(body))
                yield Static(id="sa-choice")
                yield Static(id="sa-hint")

        def on_mount(self) -> None:
            self.redraw()

        def options(self) -> list[str]:
            return ["none", "host", "lan"] if self.lan_ip else ["none", "host"]

        def redraw(self) -> None:
            lines = ["[b]placement[/] (required)  "
                     + "  ".join((f"[b $background on $primary] {i + 1} {p} [/]"
                                  if p == self.placement else f"[$text-muted]{i + 1}[/] {p}")
                                 for i, p in enumerate(PLACEMENTS))
                     + (f"  [$text-muted]profile: {_esc(self.profile_placement)}[/]"
                        if self.profile_placement else "  [$warning]the profile sets none[/]")]
            if self.placement:
                lines.append(f"[$text-muted]runs in {PLACEMENT_SAYS[self.placement]}[/]")
            lines.append("")
            if not self.ports:
                lines.append("[b]ports[/] none requested: nothing is exposed")
            for i, p in enumerate(self.ports):
                cur = "[$primary]►[/]" if i == self.cur else " "
                opts = "  ".join(
                    f"[b $background on $primary] {o} [/]" if o == self.expose[i]
                    else f"[$text-muted]{o}[/]" for o in self.options())
                lines.append(f"{cur} port [b]{_esc(str(p.get('port')))}[/]/"
                             f"{_esc(p.get('protocol') or 'tcp')} "
                             f"[$text-muted]{_esc(p.get('purpose') or '')} · asked "
                             f"{_esc(p.get('expose') or 'none')}[/]  {opts}")
            if not self.lan_ip and self.ports:
                lines.append("[$text-muted]lan: unavailable, the server has no services "
                             "LAN IP[/]")
            if self.error:
                lines.append(f"[$error b]{_esc(self.error)}[/]")
            self.query_one("#sa-choice", Static).update("\n".join(lines))
            self.query_one("#sa-hint", Static).update(
                "[$primary]1 2 3[/] placement  [$primary]↑↓[/] port  [$primary]space[/] "
                "expose  [$primary]enter[/] review and confirm  [$text-muted]esc[/] cancel")

        def action_place(self, i: int) -> None:
            self.placement, self.error = PLACEMENTS[i], ""
            self.redraw()

        def action_port(self, d: int) -> None:
            if self.ports:
                self.cur = max(0, min(len(self.ports) - 1, self.cur + d))
                self.redraw()

        def action_expose(self) -> None:
            if self.ports:
                opts = self.options()
                i = opts.index(self.expose[self.cur]) if self.expose[self.cur] in opts else 0
                self.expose[self.cur] = opts[(i + 1) % len(opts)]
                self.redraw()

        def action_ok(self) -> None:
            if self.placement not in PLACEMENTS:
                self.error = "pick a placement first: 1, 2 or 3"
                self.redraw()
                return
            self.dismiss({"placement": self.placement,
                          "expose": [(p.get("port"), x) for p, x in zip(self.ports, self.expose)
                                     if x != "none"]})

        def action_cancel(self) -> None:
            self.dismiss(None)

    class ProfileForm(ModalScreen):
        """Create or edit a security profile, one field per row: ↑↓ move, enter
        (or space) edits, toggles or picks; the Save row or ctrl+s saves; esc
        cancels. A new profile starts with NO box runtime and NO service
        placement, and the form refuses to save until both are picked."""

        BINDINGS = [Binding("escape", "cancel", show=False),
                    Binding("up,k", "move(-1)", show=False),
                    Binding("down,j", "move(1)", show=False),
                    Binding("enter,space", "edit", show=False),
                    Binding("ctrl+s", "save", show=False, priority=True)]

        # (key, label, kind): text, int, list, bool, or a tuple of choices
        FIELDS = [("name", "name", "text"),
                  ("box_runtime", "box runtime (required)", RUNTIMES),
                  ("service_placement", "service placement (required)", PLACEMENTS),
                  ("default_verdict", "default verdict", ("deny", "allow")),
                  ("network_off", "network off", "bool"),
                  ("allow_hosts", "allow hosts", "list"),
                  ("deny_hosts", "deny hosts", "list"),
                  ("secrets", "secrets (names)", "list"),
                  ("auto_handle", "reviewer auto-handles routine alerts", "bool"),
                  ("separate_box", "separate box per project", "bool"),
                  ("box_image", "box image variant", "text"),
                  ("box_mem_mb", "box RAM MB (empty = default)", "int"),
                  ("allow_services", "may request services", "bool"),
                  ("allow_package_requests", "may request packages", "bool")]

        def __init__(self, profile: dict | None, secret_names: list[str] | None = None,
                     variants: list[str] | None = None,
                     runtimes: dict | None = None) -> None:
            super().__init__()
            self.editing = profile
            p = profile or {}
            self.v = {
                "name": p.get("name") or "",
                # explicit picks only: a new profile has neither
                "box_runtime": p.get("box_runtime") if profile else None,
                "service_placement": p.get("service_placement") if profile else None,
                "default_verdict": p.get("default_verdict") or "deny",
                "network_off": bool(p.get("network_off")),
                "allow_hosts": _jlist(p.get("allow_hosts")),
                "deny_hosts": _jlist(p.get("deny_hosts")),
                "secrets": [str(x) for x in _jlist(p.get("secrets"))],
                "auto_handle": bool(p.get("auto_handle")),
                "separate_box": bool(p.get("separate_box")),
                "box_image": p.get("box_image") or "main",
                "box_mem_mb": p.get("box_mem_mb"),
                "allow_services": bool(p.get("allow_services")),
                "allow_package_requests": bool(p.get("allow_package_requests")),
            }
            self.secret_names = secret_names or []
            self.variants = variants or []
            self.runtimes = runtimes or {}        # GET /api/vm/boxes `runtimes`
            self.cur = 0
            self.error = ""

        def compose(self) -> ComposeResult:
            what = (f"Edit profile {self.editing.get('name')}" if self.editing
                    else "New security profile")
            with Vertical(id="dialog", classes="wide"):
                with Horizontal(id="dialog-head"):
                    yield Static(f"[b]{_esc(what)}[/]", id="dialog-title")
                    yield Static("[$text-muted]esc[/]", id="dialog-esc")
                with VerticalScroll(id="view-body", can_focus=False):   # ↑↓ move the cursor
                    yield Static(id="pf-body")
                yield Static(id="pf-hint")

        def on_mount(self) -> None:
            self.redraw()

        def _show(self, key: str, kind) -> str:
            v = self.v[key]
            if isinstance(kind, tuple):
                if v is None:
                    return f"{RED} not chosen [/]"
                return _runtime_tag(v) if key == "box_runtime" else f"[b]{_esc(v)}[/]"
            if kind == "bool":
                return "[$success b]yes[/]" if v else "[$text-muted]no[/]"
            if kind == "list":
                return _esc(", ".join(v)) if v else "[$text-muted]none[/]"
            if v in (None, ""):
                return "[$text-muted]default[/]" if kind == "int" else "[$text-muted]empty[/]"
            return _esc(str(v))

        def redraw(self) -> None:
            lines = []
            for i, (key, label, kind) in enumerate(self.FIELDS + [("", "Save", "save")]):
                sel = i == self.cur
                if kind == "save":
                    lab = " Save profile "
                    lines.append("")
                    lines.append(f"[b $background on $primary]{lab}[/]" if sel
                                 else f"[b]{lab}[/]")
                    continue
                name = (f"[b $background on $primary] {label:<38}[/]" if sel
                        else f" [$text-muted]{label:<38}[/]")
                lines.append(f"{name} {self._show(key, kind)}")
            if self.v["box_runtime"] == "docker":
                lines.append(f"\n{AMBER} docker [/] less isolated than a KVM box: the "
                             "container shares the host kernel")
                lines += _docker_notes(self.runtimes)
            if self.error:
                lines.append(f"\n[$error b]{_esc(self.error)}[/]")
            self.query_one("#pf-body", Static).update("\n".join(lines))
            # one line that fits 80 columns; the body scrolls, the hint never does
            self.query_one("#pf-hint", Static).update(
                "[$primary]↑↓[/] field  [$primary]enter[/] edit  [$primary]ctrl+s[/] save  "
                "[$text-muted]esc[/] cancel"
                + ("\n[$text-muted]secrets are names only: "
                   + _esc(_short(", ".join(self.secret_names), 50)) + "[/]"
                   if self.secret_names else ""))
            # keep the field under the cursor on screen (the Save row is the 16th line)
            from textual.geometry import Region
            row = self.cur if self.cur < len(self.FIELDS) else len(self.FIELDS) + 1
            body = self.query_one("#view-body", VerticalScroll)
            self.call_after_refresh(
                lambda: body.scroll_to_region(Region(0, row, 1, 1), animate=False))

        def action_move(self, d: int) -> None:
            self.cur = max(0, min(len(self.FIELDS), self.cur + d))
            self.redraw()

        def action_edit(self) -> None:
            if self.cur == len(self.FIELDS):
                self.action_save()
                return
            key, label, kind = self.FIELDS[self.cur]
            if kind == "bool":
                self.v[key] = not self.v[key]
                self.redraw()
                return
            self.run_worker(self._edit(key, label, kind), group="pf-edit", exclusive=True)

        async def _edit(self, key: str, label: str, kind) -> None:
            if isinstance(kind, tuple):
                says = {"kvm": "a KVM virtual machine (strongest)",
                        "docker": "a hardened container: less isolated than a VM",
                        **PLACEMENT_SAYS}
                off = {}
                if key == "box_runtime":
                    for rt in kind:
                        info = self.runtimes.get(rt)
                        if isinstance(info, dict) and info.get("available") is False:
                            off[rt] = str(info.get("reason") or "unavailable")
                            says[rt] = f"UNAVAILABLE: {off[rt]}"
                        elif rt == "docker" and isinstance(info, dict) and info.get("weak"):
                            says[rt] += " — WEAK here: " + ("; ".join(
                                map(str, _jlist(info.get("warnings")))) or "no user namespace")
                rows = [(c, c, says.get(c, "")) for c in kind]
                v = await self.app.push_screen_wait(Picker(label, rows, self.v[key]))
                if v is not None and v in off:
                    self.error = f"{v} is unavailable on this host: {off[v]}"
                    self.redraw()
                    return
                if v is not None:
                    self.v[key] = v
            else:
                cur = self.v[key]
                shown = ", ".join(cur) if kind == "list" else ("" if cur is None else str(cur))
                hint = {"list": " (comma-separated)",
                        "int": " (a number; empty = the default)"}.get(kind, "")
                if key == "secrets":
                    hint = " (comma-separated NAMES; values stay in Secrets)"
                ans = await self.app.push_screen_wait(Ask(f"{label}{hint}", value=shown))
                if ans is None:
                    return
                ans = ans.strip()
                if kind == "list":
                    self.v[key] = [x.strip() for x in ans.split(",") if x.strip()]
                    if key == "secrets":
                        self.v[key] = [x.upper() for x in self.v[key]]
                elif kind == "int":
                    if ans and not ans.isdigit():
                        self.error = f"{label}: a whole number, or empty"
                        self.redraw()
                        return
                    self.v[key] = int(ans) if ans else None
                else:
                    self.v[key] = ans
            self.error = ""
            self.redraw()

        def action_save(self) -> None:
            missing = []
            if not str(self.v["name"]).strip():
                missing.append("a name")
            if self.v["box_runtime"] not in RUNTIMES:
                missing.append("a box runtime (kvm or docker)")
            if self.v["service_placement"] not in PLACEMENTS:
                missing.append("a service placement (per_service, per_project or shared)")
            if missing:
                self.error = ("not saved — choose " + "; ".join(missing)
                              + ". There is no default.")
                self.redraw()
                return
            self.dismiss(dict(self.v))

        def action_cancel(self) -> None:
            self.dismiss(None)

