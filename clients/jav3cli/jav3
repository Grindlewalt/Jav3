        @staticmethod
        def persistent_entries(boxes, services, open_nodes) -> list[dict]:
            """One block per box: the box row, then its non-OS processes as a tree
            (a row's children show once Enter opens it), then every decided
            service with its placement."""
            out = []

            def walk(box_id, nodes, depth):
                for nd in nodes or []:
                    key = f"N{box_id}:{nd.get('pid')}"
                    kids = nd.get("children") or []
                    out.append({"type": "proc", "key": key, "depth": depth,
                                "open": key in open_nodes, "box": box_id,
                                "hidden_bad": (key not in open_nodes
                                               and _tree_bad(kids)),
                                "raw": nd})
                    if key in open_nodes:
                        walk(box_id, kids, depth + 1)

            for b in boxes:
                bid = b.get("box_id") or "?"
                out.append({"type": "pbox", "key": f"B{bid}",
                            "raw": {k: v for k, v in b.items() if k != "tree"},
                            "count": _tree_count(b.get("tree"))})
                # host-seen traffic no reported process owns: first, in red
                out += [{"type": "orphan", "key": f"O{bid}:{i}", "box": bid, "raw": c}
                        for i, c in enumerate(_jlist(b.get("orphan_conns")))
                        if isinstance(c, dict)]
                walk(bid, b.get("tree"), 1)
            decided = [s for s in services if s.get("status") not in ("pending", "rejected")]
            if decided:
                out.append({"type": "group", "key": "Gsvc",
                            "raw": {"slug": "services (approved definitions)"}})
                out += [{"type": "svc", "key": f"S{s.get('id')}", "raw": s} for s in decided]
            return out

