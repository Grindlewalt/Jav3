#!/usr/bin/env python3
"""jav3 — a terminal client for a Jav3 server: an interactive agent TUI.

    jav3                       the interactive TUI (/help inside it)
    jav3 fix the flaky test    the TUI, starting with that message
    jav3 -c | -r ID            resume the latest chat | chat ID
    jav3 -p "message"          one turn, plain output (also: cmd | jav3 -p)
    jav3 login                 paste the line from Settings -> Add computer
                               (or /login inside the TUI: that line, or a password)
    jav3 chat [message]        one turn, or the TUI with no message
    jav3 whoami
    jav3 logout

Credentials live in $XDG_CONFIG_HOME/jav3/credentials.json (default
~/.config/jav3), file 0600 in a 0700 directory: {"address", "token"} for a
device token (chat only), or {"address", "session", "username"} for an
operator password session (full access, like the web app).
Needs Python 3.11+ and httpx; the TUI also needs textual (the installer
provides it; without it `jav3` falls back to a plain REPL).
"""
from __future__ import annotations

import argparse
import asyncio
import contextlib
import getpass
import io
import json
import os
import platform
import secrets
import socket
import stat
import sys
import time
from pathlib import Path

try:
    import httpx
except ImportError:  # pragma: no cover — the installer provides it
    sys.exit("jav3 needs httpx: pip install httpx (or install your distro's python3-httpx)")

PROMPT = "Paste the line from Settings → Add computer: "
RELOGIN = "not logged in (token missing, revoked or expired) — run: jav3 login"
COOKIE_NAME = "jarvis_token"       # backend/auth.py: the operator session cookie
SESSION_PREFIX = "session:"        # a credential string that is a session, not a token


class CliError(Exception):
    """A message for the user; main() prints it and exits 1."""


class NotLoggedIn(CliError):
    """A 401, or no credential at all: the TUI's /login state."""


# --- credentials --------------------------------------------------------------------

def config_dir() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "jav3"


def cred_path() -> Path:
    return config_dir() / "credentials.json"


def save_credentials(address: str, token: str | None = None, *,
                     session: str | None = None, username: str | None = None) -> Path:
    """Write atomically, 0600 from the first byte, in a 0700 directory.

    Every step goes through a descriptor for the config dir itself, opened
    with O_NOFOLLOW: a `jav3` dir that is a symlink (or is swapped for one
    mid-write) is refused rather than followed and re-moded. The temp file has
    a random name and is created O_EXCL, so two concurrent `jav3 login`s each
    write their own file and the rename leaves one whole credentials.json —
    never a torn mix of both.
    """
    d = config_dir()
    d.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.mkdir(d, 0o700)
    except FileExistsError:
        pass
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    try:
        dfd = os.open(d, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | nofollow)
    except OSError as e:
        raise CliError(f"{d} is not a plain directory (a symlink?) — refusing to "
                       f"store credentials there ({e.strerror})")
    tmp = f".credentials.{secrets.token_hex(8)}.tmp"
    try:
        st = os.fstat(dfd)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
            raise CliError(f"{d} is not a directory you own — refusing to store "
                           "credentials there")
        os.fchmod(dfd, 0o700)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow, 0o600,
                     dir_fd=dfd)
        try:
            rec = ({"address": address, "session": session, "username": username or ""}
                   if session else {"address": address, "token": token})
            data = json.dumps(rec).encode()
            while data:
                data = data[os.write(fd, data):]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, "credentials.json", src_dir_fd=dfd, dst_dir_fd=dfd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dfd)
        except OSError:
            pass
        raise
    finally:
        os.close(dfd)
    return d / "credentials.json"


def load_credentials() -> dict | None:
    try:
        data = json.loads(cred_path().read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict) or not data.get("address") or not (
            data.get("token") or data.get("session")):
        return None
    return data


def cred_of(creds: dict) -> str:
    """The one credential string the HTTP helpers take: a device token as is,
    a password session as SESSION_PREFIX + the session JWT."""
    if creds.get("session"):
        return SESSION_PREFIX + creds["session"]
    return creds["token"]


def is_session(cred: str | None) -> bool:
    return bool(cred) and cred.startswith(SESSION_PREFIX)


def auth_headers(cred: str | None) -> dict:
    """A device token rides as a bearer; a session as the operator's cookie —
    the same one the web app holds, so it has the same (full) rights."""
    if not cred:
        return {}
    if is_session(cred):
        return {"Cookie": f"{COOKIE_NAME}={cred[len(SESSION_PREFIX):]}"}
    return {"Authorization": f"Bearer {cred}"}


def delete_credentials() -> bool:
    try:
        cred_path().unlink()
        return True
    except FileNotFoundError:
        return False


# --- the pasted line ------------------------------------------------------------------

def parse_login_line(line: str) -> tuple[str, str]:
    """`address=<host:port> code=<code>` -> (address, code). Order-free,
    tolerant of surrounding quotes/whitespace; refuses anything else."""
    fields: dict[str, str] = {}
    for part in (line or "").strip().strip("'\"`").split():
        k, sep, v = part.partition("=")
        if sep and k in ("address", "code") and v:
            fields[k] = v.strip("'\"`")
    if "address" not in fields or "code" not in fields:
        raise CliError("that doesn't look like the login line — expected "
                       "'address=<host:port> code=<code>' from Settings → Add computer")
    return fields["address"], fields["code"]


PLAIN_HTTP = ("warning: {base} is plain http — the login code, and the token it "
              "is traded for, cross the network unencrypted. Only use it on a "
              "network you trust.")


def base_url(address: str) -> str:
    """An address as shown in Settings -> a URL. Bare host:port means http (the
    LAN default); an explicit scheme is kept as given."""
    a = address.strip().rstrip("/")
    if not a:
        raise CliError("empty server address")
    if "://" in a:
        if not a.startswith(("http://", "https://")):
            raise CliError(f"unsupported scheme in {address!r}")
        return a
    return "http://" + a


# --- HTTP -------------------------------------------------------------------------------

def _client(base: str, token: str | None = None, timeout: float | None = 30.0) -> httpx.Client:
    headers = {"User-Agent": "jav3-cli", **auth_headers(token)}
    # no redirects: a bearer token is never replayed to wherever a 3xx points
    return httpx.Client(base_url=base, headers=headers, timeout=timeout,
                        follow_redirects=False)


def _detail(r: httpx.Response) -> str:
    try:
        return str(r.json().get("detail") or r.reason_phrase)
    except (ValueError, AttributeError):
        return r.reason_phrase or f"HTTP {r.status_code}"


def _check(r: httpx.Response) -> httpx.Response:
    if r.is_redirect:
        u = r.request.url
        raise CliError(redirect_hint(f"{u.scheme}://{u.netloc.decode()}",
                                     r.headers.get("location", "")))
    if r.status_code == 401:
        raise CliError(RELOGIN)
    if r.status_code >= 400:
        raise CliError(f"server said {r.status_code}: {_detail(r)}")
    return r


def _session(args) -> tuple[str, str]:
    creds = load_credentials()
    if not creds:
        raise CliError(RELOGIN)
    return base_url(args.server or creds["address"]), cred_of(creds)


# --- commands ---------------------------------------------------------------------------

def _read_login_line() -> str:
    """Hidden when interactive (the code is a credential until it is used —
    keep it out of scrollback and screenshots); a plain line from a pipe."""
    if sys.stdin.isatty():
        return getpass.getpass(PROMPT)
    return sys.stdin.readline()


def redirect_hint(base: str, location: str) -> str:
    """Why a redirect is a dead end for the CLI, in words the operator can act on.
    Redirects are never followed with a code or token attached."""
    if "cloudflareaccess.com" in location:
        return (f"{base} is behind Cloudflare Access, which sends the CLI to a browser "
                "login it cannot complete. Use the server's LAN address instead — "
                "jav3 --server <lan-ip>:8000 (the same login line still works; its code "
                "was not used) — or add an Access Bypass policy for /api/devices/*, "
                "/api/chat* and /api/conversations*")
    return f"{base} redirected to {location or '(nowhere)'} — pass the right address with --server"


def upgrade_to_https(base: str) -> str:
    """If a plain-http server only redirects to https on the same host, use https —
    found out with a request that carries nothing secret, before the code is sent."""
    if not base.startswith("http://"):
        return base
    try:
        with _client(base, timeout=10) as c:
            r = c.get("/api/health")
    except httpx.HTTPError:
        return base
    loc = r.headers.get("location", "")
    https = "https://" + base[len("http://"):]
    if r.is_redirect and (loc == https or loc.startswith(https + "/")):
        return https
    return base


def cmd_login(args, out=sys.stdout, read=_read_login_line) -> int:
    line = read()
    address, code = parse_login_line(line)
    if args.server:
        address = args.server
    base = upgrade_to_https(base_url(address))
    if base.startswith("https://") and not address.startswith("https://"):
        address = base
    if base.startswith("http://"):
        print(PLAIN_HTTP.format(base=base), file=sys.stderr)
    host = socket.gethostname()
    with _client(base) as c:
        try:
            r = c.post("/api/devices/login", json={
                "code": code, "name": host, "hostname": host,
                "platform": platform.system().lower()})
        except httpx.HTTPError as e:
            raise CliError(f"could not reach {base}: {e}")
        if r.is_redirect:
            raise CliError(redirect_hint(base, r.headers.get("location", "")))
        if r.status_code in (401, 429):
            raise CliError(_detail(r))
        try:
            token = _check(r).json()["token"]
        except (ValueError, KeyError, TypeError):
            raise CliError(f"{base} did not answer like a Jav3 server "
                           f"(HTTP {r.status_code}, {r.headers.get('content-type', '?')})")
    try:
        path = save_credentials(address, token)
    except (OSError, CliError) as e:
        # the code is spent and the token is live server-side: don't leave it
        # orphaned — revoke it with itself, then say what went wrong
        try:
            with _client(base, token, timeout=10) as c:
                c.delete("/api/devices/self")
        except httpx.HTTPError:
            pass
        raise CliError(f"could not save credentials: {e}. The new token was "
                       "revoked; fix that, then run jav3 login again with a new code")
    print(f"logged in to {base} — credentials in {path}", file=out)
    with _client(base, token) as c:
        who = _check(c.get("/api/devices/whoami")).json()
    print(f"you are {who.get('username')}", file=out)
    return 0


def cmd_whoami(args, out=sys.stdout) -> int:
    base, token = _session(args)
    with _client(base, token) as c:
        try:
            who = _check(c.get("/api/devices/whoami")).json()
        except httpx.HTTPError as e:
            raise CliError(f"could not reach {base}: {e}")
    print(f"{who.get('username')} @ {base}", file=out)
    return 0


REVOKE_HINT = ("the server did not confirm the revoke ({why}) — the token may "
               "still be live. Revoke this computer in Settings → Devices; the "
               "local copy is kept at {path} until then (delete it by hand, or "
               "run jav3 logout again)")


def cmd_logout(args, out=sys.stdout) -> int:
    """Revoke server-side FIRST; forget the local copy only once the server
    confirms. A 5xx, a 401/404 from the wrong --server, or no answer at all
    leaves the file in place — deleting the only copy of a still-live token
    would leave the operator nothing to identify it by."""
    creds = load_credentials()
    if not creds:
        print("not logged in", file=out)
        return 0
    base = base_url(args.server or creds["address"])
    if creds.get("session"):
        return _logout_session(base, creds, out)
    try:
        with _client(base, creds["token"], timeout=10) as c:
            r = c.delete("/api/devices/self")
    except httpx.HTTPError as e:
        raise CliError(REVOKE_HINT.format(why=f"unreachable: {e}", path=cred_path()))
    if r.status_code != 200:
        raise CliError(REVOKE_HINT.format(why=f"{r.status_code} {_detail(r)}",
                                          path=cred_path()))
    delete_credentials()
    print("logged out", file=out)
    return 0


def _logout_session(base: str, creds: dict, out) -> int:
    """A password session is a signed cookie with no server-side row to revoke:
    tell the server (it clears the cookie; harmless if unreachable) and forget
    the local copy, which is the only one."""
    try:
        with _client(base, cred_of(creds), timeout=10) as c:
            c.post("/api/auth/logout")
    except httpx.HTTPError:
        pass
    delete_credentials()
    print("logged out", file=out)
    return 0


PLAIN_HTTP_PASSWORD = ("warning: {base} is plain http — your password, and the session "
                       "it is traded for, cross the network unencrypted. Only use it on "
                       "a network you trust.")


def _session_cookie(r: httpx.Response) -> str | None:
    """The session JWT from Set-Cookie, read by hand: the server may mark it
    Secure, and a cookie jar would then drop it for a plain-http LAN address."""
    from http.cookies import CookieError, SimpleCookie
    for raw in r.headers.get_list("set-cookie"):
        jar = SimpleCookie()
        try:
            jar.load(raw)
        except CookieError:
            continue
        if COOKIE_NAME in jar and jar[COOKIE_NAME].value:
            return jar[COOKIE_NAME].value
    return None


def login_with_password(address: str, username: str, password: str,
                        server: str | None = None) -> tuple[str, str, str]:
    """POST /api/auth/login, the web app's own login — the operator session
    cookie, full rights. Saved to the credentials file; (base, cred, username)."""
    if server:
        address = server
    base = upgrade_to_https(base_url(address))
    if base.startswith("https://") and not address.startswith("https://"):
        address = base
    if base.startswith("http://"):
        print(PLAIN_HTTP_PASSWORD.format(base=base), file=sys.stderr)
    # the server slows repeated failures down (up to 8s each): leave room for it
    with _client(base, timeout=40) as c:
        try:
            r = c.post("/api/auth/login", json={"username": username, "password": password})
        except httpx.HTTPError as e:
            raise CliError(f"could not reach {base}: {e}")
    if r.is_redirect:
        raise CliError(redirect_hint(base, r.headers.get("location", "")))
    if r.status_code == 401:
        raise CliError("wrong username or password (each further miss waits a little "
                       "longer)")
    _check(r)
    jwt = _session_cookie(r)
    if not jwt:
        raise CliError(f"{base} did not answer like a Jav3 server (no session cookie)")
    try:
        who = r.json().get("username") or username
    except (ValueError, AttributeError):
        who = username
    try:
        save_credentials(address, session=jwt, username=who)
    except OSError as e:
        raise CliError(f"could not save credentials: {e}")
    return base, SESSION_PREFIX + jwt, who


def iter_sse(lines):
    """SSE `data:` lines -> event dicts. Blank lines separate events; the
    server sends one JSON object per `data:` line."""
    buf: list[str] = []
    for line in lines:
        if line == "":
            if buf:
                yield json.loads("\n".join(buf))
                buf = []
        elif line.startswith("data:"):
            buf.append(line[5:].lstrip(" "))
    if buf:
        yield json.loads("\n".join(buf))


def _short(v, n: int = 80) -> str:
    s = v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)
    s = " ".join(s.split())
    return s if len(s) <= n else s[: n - 1] + "…"


class Renderer:
    """Turn events into terminal text: answer text as it streams, each tool
    call as one line. If the final reply differs from what streamed (the
    server's rules pass can rewrite it), the final version is printed too."""

    def __init__(self, out=sys.stdout):
        self.out = out
        self.text = ""
        self.at_line_start = True
        self.conversation_id: int | None = None
        self.error: str | None = None

    def _w(self, s: str) -> None:
        if s:
            self.out.write(s)
            self.out.flush()
            self.at_line_start = s.endswith("\n")

    def _line(self, s: str) -> None:
        if not self.at_line_start:
            self._w("\n")
        self._w(s + "\n")

    def feed(self, ev: dict) -> bool:
        """Render one event; True when the turn is over."""
        t = ev.get("type")
        if t == "start" and ev.get("conversation_id") is not None:
            self.conversation_id = ev["conversation_id"]
        elif t == "token":
            self.text += ev.get("text", "")
            self._w(ev.get("text", ""))
        elif t == "tool":
            self._line(f"  · {ev.get('name', '?')}({_short(ev.get('args') or {})})")
        elif t == "tool_result":
            if ev.get("ok") is False:
                self._line(f"  ! {ev.get('name', '?')} failed: {_short(ev.get('result', ''))}")
        elif t == "job":
            self._line(f"  · job: {ev.get('title', '')}")
        elif t == "final":
            if ev.get("conversation_id") is not None:
                self.conversation_id = ev["conversation_id"]
            final = ev.get("content") or ""
            # the final carries the reply after the last tool call, so narration
            # streamed before a tool is no reason to print it again
            if not self.text.strip().endswith(final.strip()):
                if self.text.strip():
                    self._line("--- revised ---")
                self._w(final)
            if not self.at_line_start:
                self._w("\n")
            return True
        elif t == "error":
            self.error = ev.get("message") or "error"
            self._line(f"error: {self.error}")
            return True
        elif t == "idle":
            return True
        return False


def run_turn(c: httpx.Client, message: str, conversation_id: int | None,
             project: str | None, out=sys.stdout, confirm=input) -> int | None:
    """POST one chat turn and render it. Returns the conversation id."""
    body: dict = {"message": message, "conversation_id": conversation_id}
    if project and conversation_id is None:
        body["project"] = project
    for _ in range(2):
        with c.stream("POST", "/api/chat", json=body) as r:
            if r.status_code == 409:
                r.read()
                if _detail(r) == "peak_confirmation_required" and not body.get("confirm_peak"):
                    ans = confirm("Peak-pricing window — send anyway? [y/N] ")
                    if ans.strip().lower().startswith("y"):
                        body["confirm_peak"] = True
                        continue
                    raise CliError("not sent")
                raise CliError(f"server said 409: {_detail(r)}")
            if r.status_code >= 400:
                r.read()
                _check(r)
            rend = Renderer(out)
            header = r.headers.get("x-conversation-id")
            if header and header.isdigit():
                rend.conversation_id = int(header)
            for ev in iter_sse(r.iter_lines()):
                if rend.feed(ev):
                    break
            if rend.error:
                raise CliError(rend.error)
            return rend.conversation_id or conversation_id
    raise CliError("not sent")


EXIT_WORDS = ("exit", "quit", "/exit", "/quit")


def is_exit(text: str) -> bool:
    """Only a prompt that is nothing but exit/quit (slash optional, any case)
    quits; a message that merely contains the word is sent."""
    return (text or "").strip().lower() in EXIT_WORDS


def cmd_chat(args, out=sys.stdout, read=input) -> int:
    """One turn with a message; with none, the interactive TUI (or, when its
    libraries are missing or stdin is not a terminal, the plain REPL)."""
    if not args.message and sys.stdin.isatty() and tui_available():
        return cmd_tui(args)
    base, token = _session(args)
    # no read timeout: a turn can think for minutes between events
    with _client(base, token, timeout=httpx.Timeout(30.0, read=None)) as c:
        try:
            if args.message:
                run_turn(c, " ".join(args.message), None, args.project, out, read)
                return 0
            cid = None
            while True:
                try:
                    msg = read("› ")
                except EOFError:
                    print(file=out)
                    return 0
                if is_exit(msg):
                    return 0
                if not msg.strip():
                    continue
                cid = run_turn(c, msg, cid, args.project, out, read)
        except httpx.HTTPError as e:
            raise CliError(f"connection to {base} failed: {e}")
        except KeyboardInterrupt:
            print(file=out)
            return 130


# --- the interactive TUI ---------------------------------------------------------------
#
# A full-screen Textual app laid out like opencode: the transcript on the left, a
# sidebar on the right (title, context and cost, model, modified files, todos) that
# folds away on narrow terminals, and the prompt at the bottom with a status row
# under it. Pickers (sessions, models, agents, projects, themes) open from slash
# commands, the ctrl+x leader key or the ctrl+p palette. Without Textual, `jav3`
# falls back to the plain REPL above.

TUI_DEPS = ("textual",)
TUI_HINT = ("the interactive TUI needs textual — re-run the installer "
            "(curl -fsSL <server>/cli/install.sh | sh), or pip install textual")
INTERRUPTED = "[Request interrupted"
ATTACH_LIMIT = 256 * 1024          # per @file
SHELL_KEEP = 20_000                # chars of a `!command`'s output kept for the next turn
SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
EXAMPLES = ("Fix the failing test in tests/", "What changed in the last commit?",
            "Summarise this week's journal", "Research a quiet NAS for the rack",
            "Write a script that backs up ~/notes")
COLLAPSED_LINES = 10
NOTICE_CAP = 50                    # notifications kept in the sidebar
NOT_LOGGED_IN = ("not logged in — /login: paste the line from Settings → Add computer "
                 "(chat only), or use your password (full access)")
SESSION_LOST = "not logged in (session expired, or token revoked) — /login"
NEW_PROJECT = "+new"               # the /project picker's "+ New project" row


def tui_available() -> bool:
    try:
        for m in TUI_DEPS:
            __import__(m)
    except ImportError:
        return False
    return True


def _argstr(args, n: int = 70) -> str:
    """Tool args the way a person reads them: the one value when there is one,
    else key=value pairs."""
    if not isinstance(args, dict) or not args:
        return "" if args in ({}, None, "") else _short(args, n)
    if len(args) == 1:
        return _short(next(iter(args.values())), n)
    return _short(", ".join(f"{k}={v if isinstance(v, str) else json.dumps(v)}"
                            for k, v in args.items()), n)


def _summary(result: str, n: int = 110) -> str:
    lines = [ln for ln in (result or "").splitlines() if ln.strip()]
    if not lines:
        return "(no output)"
    head = _short(lines[0], n)
    return head + (f"  (+{len(lines) - 1} lines)" if len(lines) > 1 else "")


def expand_attachments(text: str, cwd: Path | None = None) -> tuple[str, list[str], list[str]]:
    """`@path` words that name a readable local text file are appended to the
    message as fenced blocks, since the agent runs on the server and cannot see
    this machine. Returns (message, attached, skipped-with-reason)."""
    import re
    cwd = cwd or Path.cwd()
    blocks, attached, skipped, seen = [], [], [], set()
    for m in re.finditer(r"(?:^|\s)@(\S+)", text):
        raw = m.group(1).rstrip(".,;:!?)\"'")
        p = Path(os.path.expanduser(raw))
        p = p if p.is_absolute() else cwd / p
        if raw in seen or not p.is_file():
            continue
        seen.add(raw)
        try:
            if p.stat().st_size > ATTACH_LIMIT:
                skipped.append(f"{raw} (over {ATTACH_LIMIT // 1024} KB)")
                continue
            body = p.read_bytes().decode("utf-8")
        except UnicodeDecodeError:
            skipped.append(f"{raw} (not text)")
            continue
        except OSError as e:
            skipped.append(f"{raw} ({e.strerror})")
            continue
        fence = "````" if "```" in body else "```"
        blocks.append(f"File `{raw}`:\n{fence}\n{body.rstrip()}\n{fence}")
        attached.append(raw)
    if blocks:
        text = text + "\n\n" + "\n\n".join(blocks)
    return text, attached, skipped


async def aiter_sse(lines):
    """iter_sse over an async line iterator."""
    buf: list[str] = []
    async for line in lines:
        if line == "":
            if buf:
                yield json.loads("\n".join(buf))
                buf = []
        elif line.startswith("data:"):
            buf.append(line[5:].lstrip(" "))
    if buf:
        yield json.loads("\n".join(buf))


