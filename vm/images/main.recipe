# Jav3 image recipe (format: backend/vm/images.py, "Recipe format").
# `main` IS the golden base: vm/build_base.sh bakes exactly these apt packages
# into base-vN.qcow2, so a KVM `main` box needs no layer until the operator
# approves an extra package for it. Docker builds it from debian:trixie-slim.
name main
from none
min_mem_mb 768

apt python3 python3-pip python3-venv python3-dev python3-pytest
apt git curl ca-certificates
apt nodejs npm
apt build-essential pkg-config
apt jq ripgrep sqlite3
apt unzip zip xz-utils
