# Monitored-egress ruleset for the brain guest (A1). Explicit-proxy model:
# the guest reaches ONLY the host (Pi), on the DNS + proxy ports. Its real
# egress originates from the host proxy, so the guest itself never forwards —
# guest_forward drops everything, so a process that ignores HTTP(S)_PROXY fails
# closed. Auto-cut (backend/vm/egress_proxy._nft_drop) adds IPs to cut_hosts,
# which the output hook drops so even the host proxy can't reach a cut host.
#
# Self-replacing: the two-line preamble means `nft -f` always starts clean.
table inet jarvis_vm
delete table inet jarvis_vm

table inet jarvis_vm {
    set cut_hosts { type ipv4_addr; flags interval; }

    chain input {
        type filter hook input priority -10; policy accept;
        iifname "jvtap0" jump guest_input
    }

    # Guest -> host: only DNS, DHCP, and the egress proxy port. Nothing else on
    # the Pi is reachable from the guest.
    chain guest_input {
        ct state established,related accept
        udp dport { 53, 67 } accept
        tcp dport 53 accept
        tcp dport 8443 accept
        icmp type echo-request accept
        limit rate 10/second counter log prefix "jvm-host-drop " drop
        counter drop
    }

    chain forward {
        type filter hook forward priority -10; policy drop;
        iifname "jvtap0" jump guest_forward
        oifname "jvtap0" ct state established,related accept
    }

    # The guest has no legitimate forward path (all egress is via the host proxy).
    chain guest_forward {
        ip daddr @cut_hosts counter log prefix "jvm-cut " drop
        counter log prefix "jvm-egress-drop " drop
    }

    # Host output: a cut host is unreachable even from the proxy itself, so the
    # auto-cut is a real network block, not just an app-level refusal.
    chain output {
        type filter hook output priority -10; policy accept;
        ip daddr @cut_hosts counter log prefix "jvm-cut-out " drop
    }
}
