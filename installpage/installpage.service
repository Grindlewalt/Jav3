# Jav3 install page — a system unit (not --user). See installpage/README.md.
#
#   sudo install -d /opt/installpage
#   sudo install -m 0644 installpage/server.py scripts/bootstrap.sh /opt/installpage/
#   sudo install -m 0644 installpage/installpage.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now installpage
#
# The files live under /opt, not a home directory: ProtectHome=yes hides /home,
# and DynamicUser's throwaway uid must be able to read them.
[Unit]
Description=Jav3 install page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -B /opt/installpage/server.py --bootstrap /opt/installpage/bootstrap.sh
Environment=INSTALLPAGE_BIND=::
Environment=INSTALLPAGE_PORT=8080
# Environment=INSTALLPAGE_TITLE=Jav3
# Environment="INSTALLPAGE_COMMAND=curl -fsSL http://install.example/bootstrap.sh | sh"
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

# --- Port 80 instead of 8080 ------------------------------------------------
# Set INSTALLPAGE_PORT=80 above, then REPLACE the empty CapabilityBoundingSet=
# below with the two lines here (the bounding set has to contain the cap the
# ambient set grants, or the grant is silently dropped):
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#   AmbientCapabilities=CAP_NET_BIND_SERVICE

# --- Sandbox ----------------------------------------------------------------
DynamicUser=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0077
# Resource ceilings: the server caps itself at --max-conns threads; these are
# the backstop if that ever fails.
TasksMax=128
MemoryMax=128M
LimitNOFILE=512

[Install]
WantedBy=multi-user.target
