# System (root) unit: tap + nftables lockdown for the Jarvis sandbox VM.
# Installed by setup_pi.sh, which substitutes @HOME@/@USER@.
[Unit]
Description=Jarvis VM tap network + deny-by-default egress
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=JARVIS_USER=@USER@
ExecStart=@HOME@/jarvis/vm/net/vm-net.sh up
ExecStop=@HOME@/jarvis/vm/net/vm-net.sh down

[Install]
WantedBy=multi-user.target
