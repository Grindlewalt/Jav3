# System (root) unit: logged DNS/DHCP for the Jarvis VM tap.
# Installed by setup_pi.sh, which substitutes @HOME@/@USER@.
[Unit]
Description=Jarvis VM DNS/DHCP (query-logged) on jvtap0
Requires=jarvis-vm-net.service
After=jarvis-vm-net.service

[Service]
ExecStartPre=/usr/bin/install -d -m 755 /var/log/jarvis-vm
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=@HOME@/jarvis/vm/net/dnsmasq-jarvis.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
